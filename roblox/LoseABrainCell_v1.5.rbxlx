		text = "**Your IQ is real-life rare.** Next to your IQ you'll see things like \"**Only 1 in 31,000** people are this smart\". Those are **real numbers**. Every point you earn really means something.",
		art = { "🧍🧍🧍🧍", "🧍🧍🧍🧍", "⭐" },
