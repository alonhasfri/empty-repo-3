	station("coffee", "Gain", "☕ Count 60 Beans", "Exactly 60. Not 59.", kcf * CFrame.new(0, 0.5, 8), Color3.fromRGB(110, 70, 40))

	-- Hospital: doctor job
	local hcf, hsize = building({
