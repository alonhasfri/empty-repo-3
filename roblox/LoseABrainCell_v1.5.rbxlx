		return UI.T[k]
	end,
})

local themeListeners = {}
function UI.onTheme(fn)
	table.insert(themeListeners, fn)
end

function UI.setTier(tier: string)
	if not UI.Themes[tier] or tier == UI.tier then
		return
	end
	UI.tier = tier
	UI.T = UI.Themes[tier]
	for _, fn in ipairs(themeListeners) do
		task.spawn(fn, UI.T)
	end
end

---------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------
---------------------------------------------------------------------
-- Device scale: the whole interface shrinks on phones and grows a bit on big screens.
-- Designed for a 1000x462 screen (a phone held sideways).
---------------------------------------------------------------------
UI.D = 1
local scaleListeners = {}
function UI.onScale(fn)
	table.insert(scaleListeners, fn)
	fn(UI.D)
end
local function computeScale()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1000, 462)
	local d = math.min(v.X / 1000, v.Y / 462)
	d = math.clamp(d, 0.55, 1.35)
	if math.abs(d - UI.D) > 0.01 then
		UI.D = d
		for _, fn in ipairs(scaleListeners) do
			task.spawn(fn, d)
		end
	end
end
task.defer(function()
	computeScale()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(computeScale)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		computeScale()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(computeScale)
		end
	end)
end)
computeScale()

-- Adds a UIScale that follows the device scale (times an optional extra factor)
function UI.autoScale(inst, extra: number?)
	local sc = inst:FindFirstChild("DeviceScale") or Instance.new("UIScale")
	sc.Name = "DeviceScale"
	sc.Parent = inst
	UI.onScale(function(d)
		sc.Scale = d * (extra or 1)
	end)
	return sc
end

UI.gui = Instance.new("ScreenGui")
UI.gui.Name = "BrainUI"
UI.gui.ResetOnSpawn = false
UI.gui.IgnoreGuiInset = false
UI.gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
UI.gui.Parent = player:WaitForChild("PlayerGui")

function UI.new(className: string, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(inst, radius: number?)
	local c = inst:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or UI.T.radius)
	c.Parent = inst
	return inst
end

function UI.stroke(inst, color: Color3?, thickness: number?, transparency: number?)
	local s = inst:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	s.Color = color or UI.T.stroke
	s.Thickness = thickness or UI.T.strokeW
	s.Transparency = transparency or UI.T.strokeT
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return inst
end

-- top-to-bottom shine gradient
function UI.gradient(inst, c1: Color3, c2: Color3?, rotation: number?)
	local g = inst:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2 or c1)
	g.Rotation = rotation or 90
	g.Parent = inst
	return g
end

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end
local function darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end
UI.lighten = lighten
UI.darken = darken

function UI.textSize(base: number): number
	return UI.settings.largeText and math.floor(base * 1.25) or base
end

function UI.styleText(t)
	t.Font = t:GetAttribute("Title") and UI.T.title or (t:GetAttribute("Body") and UI.T.body or UI.T.font)
	if UI.T.textStroke then
		t.TextStrokeTransparency = 0
		t.TextStrokeColor3 = Color3.new(0, 0, 0)
	else
		t.TextStrokeTransparency = 1
	end
end

function UI.label(parent, text: string, props)
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = UI.T.text,
		Font = UI.T.body,
		TextSize = UI.textSize(16),
		TextWrapped = true,
		RichText = true,
		Size = UDim2.new(1, 0, 0, 22),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	l:SetAttribute("Body", true)
	UI.styleText(l)
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	return l
end

-- Buttons: gradient, outline, bounce on press/hover/controller-select.
function UI.button(parent, text: string, onClick, props)
	local T = UI.T
	local b = UI.new("TextButton", {
		Text = text,
		TextColor3 = T.text,
		TextSize = UI.textSize(16),
		TextWrapped = true,
		RichText = true,
		BackgroundColor3 = T.panel2,
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 46),
		Selectable = true,
		Parent = parent,
	})
	UI.styleText(b)
	UI.corner(b)
	UI.stroke(b)
	local scale = UI.new("UIScale", { Parent = b })
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	local base = b.BackgroundColor3
	UI.gradient(b, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 210), 90)
	if T.shine then
		UI.gradient(b, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)
	end
	if T.wobble then
		b.Rotation = math.random(-3, 3)
	end
	local function tweenScale(s: number)
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = s }):Play()
	end
	b.MouseEnter:Connect(function()
		tweenScale(1.04)
		b.BackgroundColor3 = lighten(base, 0.12)
	end)
	b.MouseLeave:Connect(function()
		tweenScale(1)
		b.BackgroundColor3 = base
	end)
	b.SelectionGained:Connect(function()
		tweenScale(1.06)
		b.BackgroundColor3 = lighten(base, 0.15)
	end)
	b.SelectionLost:Connect(function()
		tweenScale(1)
		b.BackgroundColor3 = base
	end)
	b.MouseButton1Down:Connect(function()
		tweenScale(0.93)
	end)
	b.MouseButton1Up:Connect(function()
		tweenScale(1)
	end)
	b:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		-- remember colors set by callers (selected answers etc.)
		local c = b.BackgroundColor3
		if c ~= lighten(base, 0.12) and c ~= lighten(base, 0.15) then
			base = c
		end
	end)
	if onClick then
		local busy = false
		b.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			UI.sound("CartoonBoing", 0.25)
			task.spawn(function()
				local ok, err = pcall(onClick, b)
				if not ok then
					warn(err)
				end
				busy = false
			end)
		end)
	end
	return b
end

-- Small rounded "chip" label
function UI.chip(parent, text: string, color: Color3?, props)
	local c = UI.new("TextLabel", {
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = UI.textSize(14),
		RichText = true,
		BackgroundColor3 = color or UI.T.accent,
		Size = UDim2.fromOffset(10, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = parent,
	}, {
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	})
	UI.styleText(c)
	UI.corner(c, 12)
	for k, v in pairs(props or {}) do
		c[k] = v
	end
	return c
end

-- Soft drop shadow behind a frame
function UI.shadow(frame)
	local s = UI.new("Frame", {
		Name = "Shadow",
		AnchorPoint = frame.AnchorPoint,
		Position = frame.Position + UDim2.fromOffset(0, 6),
		Size = frame.Size,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		ZIndex = math.max(0, frame.ZIndex - 1),
		Parent = frame.Parent,
	})
	UI.corner(s, UI.T.radius + 2)
	for _, c in ipairs(frame:GetChildren()) do
		if c:IsA("UISizeConstraint") then
			c:Clone().Parent = s
		end
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		s.Visible = frame.Visible
	end)
	frame.Destroying:Connect(function()
		s:Destroy()
	end)
	return s
end

---------------------------------------------------------------------
-- Sounds
---------------------------------------------------------------------
function UI.sound(name: string?, volumeScale: number?)
	if not name then
		return
	end
	local id = Config.Sounds[name]
	if not id or id == 0 then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(id)
	s.Volume = (UI.settings.sfx or 0.8) * (volumeScale or 1)
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
	task.delay(15, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

---------------------------------------------------------------------
-- Toasts: slide in from the right
---------------------------------------------------------------------
local toastHolder = UI.new("Frame", {
	Name = "Toasts",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 150),
	Size = UDim2.new(0.4, 0, 0, 10),
	AutomaticSize = Enum.AutomaticSize.Y,
	ZIndex = 50,
	Parent = UI.gui,
}, {
	UI.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(360, 600), MinSize = Vector2.new(220, 0) }),
})
UI.autoScale(toastHolder)

local toastOrder = 0
function UI.toast(text: string, color: Color3?, seconds: number?)
	toastOrder += 1
	local T = UI.T
	local holder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = -toastOrder, ZIndex = 50, Parent = toastHolder })
	local card = UI.new("Frame", {
		BackgroundColor3 = T.bg,
		BackgroundTransparency = T.bgT,
		Position = UDim2.fromScale(1.2, 0),
		Size = UDim2.new(1, 0, 0, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 50,
		Parent = holder,
	}, {
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }),
	})
	UI.corner(card)
	UI.stroke(card)
	local bar = UI.new("Frame", { BackgroundColor3 = color or T.accent, Position = UDim2.new(0, -16, 0, -10), Size = UDim2.new(0, 6, 1, 20), ZIndex = 51, Parent = card })
	UI.corner(bar, 3)
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.text,
		TextSize = UI.textSize(15),
		TextWrapped = true,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 18),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 51,
		Parent = card,
	})
	l:SetAttribute("Body", true)
	UI.styleText(l)
	TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0, 0) }):Play()
	task.delay(seconds or 4, function()
		local t = TweenService:Create(card, TweenInfo.new(0.25), { Position = UDim2.fromScale(1.2, 0) })
		t:Play()
		t.Completed:Wait()
		holder:Destroy()
	end)
end

---------------------------------------------------------------------
-- Modals (one at a time). Controller: B closes, first button selected.
---------------------------------------------------------------------
local current = nil

function UI.closeModal()
	if current then
		local c = current
		current = nil
		ContextActionService:UnbindAction("BrainCloseModal")
		GuiService.SelectedObject = nil
		if c.onClose then
			pcall(c.onClose)
		end
		local scale = c.frame:FindFirstChildOfClass("UIScale")
		if scale then
			TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 0.9 * UI.D }):Play()
		end
		task.delay(0.1, function()
			c.backdrop:Destroy()
		end)
	end
end

function UI.isModalOpen(): boolean
	return current ~= nil
end

function UI.modal(title: string, opts)
	UI.closeModal()
	opts = opts or {}
	local T = UI.T
	local accent = opts.color or T.accent

	local backdrop = UI.new("Frame", {
		Name = "ModalBackdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		ZIndex = 19,
		Parent = UI.gui,
	})
	local D = UI.D
	local phone = opts.phone == true
	local frame = UI.new("Frame", {
		Name = phone and "Phone" or "Modal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, phone and 0.5 or 0.52),
		-- sized so that AFTER the device scale it still fits the screen
		Size = phone and UDim2.fromScale(0.94 / D, 0.94 / D) or UDim2.fromScale(0.92 / D, 0.84 / D),
		BackgroundColor3 = phone and Color3.fromRGB(14, 14, 18) or T.bg,
		BackgroundTransparency = phone and 0 or T.bgT,
		ZIndex = 20,
		Parent = backdrop,
	}, {
		UI.new("UISizeConstraint", { MaxSize = phone and Vector2.new(400, 820) or (opts.maxSize or Vector2.new(580, 500)) }),
	})
	if phone then
		UI.new("UIAspectRatioConstraint", { AspectRatio = 0.52, DominantAxis = Enum.DominantAxis.Height, Parent = frame })
		UI.corner(frame, 34)
		UI.stroke(frame, Color3.fromRGB(10, 10, 12), 8, 0)
		-- notch
		local notch = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(90, 18), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 30, Parent = frame })
		UI.corner(notch, 9)
		-- status bar
		UI.new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 6), Size = UDim2.new(1, -36, 0, 18), Text = os.date("%H:%M") .. string.rep(" ", 40) .. "📶 🔋", TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), ZIndex = 29, Parent = frame })
	else
		UI.corner(frame, T.radius + 4)
		UI.stroke(frame, T.textStroke and Color3.new(0, 0, 0) or accent, T.strokeW + 1, 0)
		if T.wobble then
			frame.Rotation = math.random(-2, 2)
		end
	end
	local scale = UI.new("UIScale", { Scale = 0.85 * D, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = D }):Play()

	-- header bar
	local header = UI.new("Frame", {
		Name = "Header",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = phone and UDim2.fromOffset(0, 28) or UDim2.new(),
		Size = UDim2.new(1, 0, 0, phone and 44 or 56),
		ZIndex = 21,
		Parent = frame,
	})
	UI.corner(header, phone and 0 or (T.radius + 4))
	UI.gradient(header, accent, T.accent2, 0)
	-- square off the header's bottom corners
	local cover = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -14), Size = UDim2.new(1, 0, 0, 14), ZIndex = 21, Parent = header })
	UI.gradient(cover, accent, T.accent2, 0)
	local titleLabel = UI.new("TextLabel", {
		Text = title,
		TextSize = UI.textSize(24),
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -80, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 22,
		Parent = header,
	})
	titleLabel:SetAttribute("Title", true)
	UI.styleText(titleLabel)
	titleLabel.TextStrokeTransparency = T.textStroke and 0 or 0.6

	local closeBtn = nil
	if not opts.noClose then
		closeBtn = UI.button(header, "✕", function()
			UI.closeModal()
		end, {
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(40, 40),
			Position = UDim2.new(1, -10, 0.5, 0),
			BackgroundColor3 = Color3.fromRGB(255, 80, 100),
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 23,
		})
		UI.corner(closeBtn, 20)
	end

	local content = UI.new("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = phone and UDim2.fromOffset(8, 78) or UDim2.fromOffset(14, 66),
		Size = phone and UDim2.new(1, -16, 1, -128) or UDim2.new(1, -28, 1, -78),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = accent,
		BorderSizePixel = 0,
		ZIndex = 21,
		Selectable = false,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2) }),
	})

	if phone then
		-- home bar
		local home = UI.new("TextButton", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.fromOffset(150, 34),
			Text = opts.onHome and "⌂  Home" or "",
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Color3.fromRGB(60, 60, 70),
			ZIndex = 30,
			Parent = frame,
		})
		UI.corner(home, 17)
		home.Activated:Connect(function()
			if opts.onHome then
				opts.onHome()
			else
				UI.closeModal()
			end
		end)
	end

	current = { frame = frame, backdrop = backdrop, content = content, onClose = opts.onClose }
	if not opts.noClose then
		ContextActionService:BindAction("BrainCloseModal", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				UI.closeModal()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.ButtonB)
	end

	local handle = { frame = frame, content = content, closeButton = closeBtn }
	function handle.close()
		if current and current.frame == frame then
			UI.closeModal()
		end
	end
	function handle.alive(): boolean
		return frame.Parent ~= nil and backdrop.Parent ~= nil
	end
	function handle.clear()
		for _, c in ipairs(content:GetChildren()) do
			if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
				c:Destroy()
			end
		end
	end
	function handle.focus()
		if UserInputService.GamepadEnabled then
			task.defer(function()
				for _, d in ipairs(content:GetDescendants()) do
					if d:IsA("GuiButton") and d.Visible and d.Selectable then
						GuiService.SelectedObject = d
						return
					end
				end
				if closeBtn then
					GuiService.SelectedObject = closeBtn
				end
			end)
		end
	end
	return handle
end

function UI.isGamepad(): boolean
	return UserInputService.GamepadEnabled and not UserInputService.TouchEnabled
end

return UI
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX00000000000000000000000000000026"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[-- ClientMain: starts the player's screen (HUD, menus, styles, effects)
-- and listens to the server. Supports touch, keyboard/mouse and controllers.

local ContextActionService = game:GetService("ContextActionService")

local Client = script.Parent:WaitForChild("Client")
local UI = require(Client.UI)
local Remote = require(Client.Remote)
local Hud = require(Client.Hud)
local Stations = require(Client.Stations)
local Style = require(Client.Style)
local Effects = require(Client.Effects)
local AdminPanel = require(Client.AdminPanel)
local Tutorial = require(Client.Tutorial)
local Conversation = require(Client.Conversation)

Hud.onMenu = Stations.settings
Hud.onAdmin = AdminPanel.open
Hud.onStation = function(key)
	if key == "map" or key == "gadgets" or key == "together" or key == "phone" or key == "space" then
		Stations.open(key)
		return
	end
	local r = Remote.call("station", { key = key })
	if r.ok then
		Stations.open(key)
	elseif r.msg then
		UI.toast("⛔ " .. r.msg, UI.Colors.bad)
	end
end
Hud.onChoosePath = function(path)
	local r = Remote.call("choose_path", { path = path })
	if r and r.msg then
		UI.toast(r.msg)
	end
end
AdminPanel.onDebug = Hud.toggleDebug
Stations.dragCounter = Hud.dragCounter
-- Guided tutorial (1.4): Stations report what the player did, the tutorial reacts
Stations.onEvent = function(name)
	Tutorial.event(name)
	if name == "shop" then
		Tutorial.onShop()
	end
end
Hud.onTutorialEvent = Tutorial.event
-- 1.5: Unstuck button
Hud.onUnstuck = function()
	if Conversation.isOpen() then
		Conversation.close()
	end
	local r = Remote.call("unstuck")
	if r and r.msg then
		UI.toast(r.msg, r.ok and UI.Colors.good or nil)
	end
end
Tutorial.target = Hud.target
Stations.onReplayTutorial = Tutorial.replay
Stations.route = function(key)
	Hud.onStation(key)
end
Hud.onBuyPass = function(key)
	Stations.buyPass(key)
end
Hud.onSaveSettings = function(changes)
	for k, v in pairs(changes) do
		UI.settings[k] = v
	end
	Remote.call("settings", UI.settings)
end
Tutorial.save = Hud.onSaveSettings

---------------------------------------------------------------------
-- Server -> client events
---------------------------------------------------------------------
local function applyState(st)
	if not st then
		return
	end
	-- Town style timeline (what the world looks like) and the matching UI theme
	st.realTier = st.tier
	local look
	if st.path == "Gain" then
		if st.cells < 45e9 then
			look = "nonsense" -- Comeback mode's very start
		elseif st.iq < 95 then
			look = "cashgrab"
		elseif st.iq < 120 then
			look = "cozy"
		elseif st.iq < 135 then
			look = "realistic"
		elseif st.iq < 200 then
			look = "fancy"
		else
			look = "future" -- 1.4: Bloxburg plus futuristic touches
		end
	else
		if st.cells >= 70e9 then
			look = "cozycash" -- lobby + start of the Lose path
		elseif st.cells >= 45e9 then
			look = "cashgrab"
		else
			look = "nonsense"
		end
	end
	st.look = look
	local UI_THEME = { cozycash = "cashgrab", cashgrab = "cashgrab", nonsense = "nonsense", cozy = "cozy", realistic = "smart", fancy = "genius", future = "genius" }
	st.tier = UI_THEME[look]
	UI.state = st
	if st.settings then
		UI.settings = st.settings
	end
	Hud.update(st)
	Style.apply(st)
	Tutorial.onState(st)
	Conversation.onState(st)
end

Remote.on("state", applyState)

Remote.on("delta", function(d)
	Hud.delta(d.amount, d.up)
	UI.sound(d.up and "BrainCellGained" or "BrainCellLost", 0.5)
end)

Remote.on("narrator", function(d)
	Hud.say(d.text, d.mood)
end)

Remote.on("toast", function(d)
	UI.toast(d.text)
	UI.sound(d.sound)
end)

Remote.on("badge", Effects.badge)

Remote.on("openStation", function(d)
	Stations.open(d.station)
end)

Remote.on("reading", Stations.reading)
Remote.on("confirmSwitch", Stations.confirmSwitch)
Remote.on("warning", Stations.warning)
Remote.on("hide", Stations.hide)

Remote.on("death", function(d)
	UI.closeModal()
	Effects.death(d, function()
		Stations.deathScreen(d)
	end)
end)

Remote.on("deathScreen", function()
	Stations.deathScreen({})
end)

Remote.on("banCutscene", Effects.banCutscene)
Remote.on("viral", Effects.viral)
Remote.on("confetti", Effects.confetti)
Remote.on("friendsLaugh", Style.friendsLaugh)
Remote.on("kazoo", function(d)
	Style.kazoo(d.seconds or 60)
end)
Remote.on("weather", function(d)
	Style.weather(d.kind, d.seconds or 60)
end)
Remote.on("debug", Hud.toggleDebug)
Remote.on("swapDoors", Hud.swapDoorSigns)
Stations.openDoors = Hud.openDoors

-- Jobs and secret inventions
Remote.on("workMarker", function(d)
	Style.workMarker(d.pos, d.name)
end)
Remote.on("lowGravity", function(d)
	Style.lowGravity(d.seconds or 30)
end)
local function showEureka(choices)
	Effects.eureka(choices, function(key)
		local r = Remote.call("invention_choose", { key = key })
		if r.ok then
			Effects.inventionUnlocked(r)
		end
	end)
end
Remote.on("eureka", function(d)
	showEureka(d.choices)
end)

-- Update 1.3: Inventors
Remote.on("prize", function(d)
	Effects.prize(d, function()
		local r = Remote.call("prize_refuse")
		if r and r.msg then
			UI.toast(r.msg, UI.Colors.gold, 6)
		end
	end)
end)
Remote.on("testDay", Effects.testDay)
Remote.on("freeTaxi", function()
	Stations.map(true)
end)
Remote.on("inventionGift", Effects.inventionUnlocked)

-- Admin extras
Remote.on("quiz", Stations.quiz)
Remote.on("spectate", function(d)
	local cam = workspace.CurrentCamera
	local target = d.userId and game:GetService("Players"):GetPlayerByUserId(d.userId)
	local hum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	local myHum = game:GetService("Players").LocalPlayer.Character and game:GetService("Players").LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	cam.CameraSubject = hum or myHum
end)

-- Update 1.1: Comeback
Remote.on("comebackCutscene", Effects.comeback)
Remote.on("makeover", Effects.makeover)
Remote.on("friendVisit", function(d)
	Style.friendVisit(d.lines, d.seconds or 12)
end)

-- Update 1.2: Smart vs Dumb
Remote.on("social_start", Stations.socialStart)
Remote.on("social_step", Stations.socialStep)
Remote.on("social_wait", Stations.socialWait)
Remote.on("social_end", Stations.socialEnd)
Remote.on("sued", Stations.sued)
Remote.on("election_speech", Stations.electionSpeech)
Remote.on("election_vote", Stations.electionVote)
Remote.on("election_result", function(d)
	UI.toast(d.text, UI.Colors.gold, 10)
	Effects.confetti()
	UI.sound("GameShowJingle")
end)

-- Update 1.4: Space and secrets
Remote.on("launch", function(d)
	UI.closeModal()
	task.spawn(Effects.launch, d)
end)
Remote.on("worldsSmartest", function(d)
	task.spawn(Effects.worldsSmartest, d)
end)
Remote.on("retiredQuestion", Stations.retiredQuestion)
Remote.on("voidFall", function()
	UI.closeModal()
	task.spawn(Effects.voidFall)
end)
Remote.on("castleEnter", function()
	task.spawn(Effects.castleEnter)
end)
Remote.on("castleStep", Style.castleStep)
Remote.on("tutorialReset", function()
	Tutorial.reset()
	UI.toast("📖 Your tutorial was reset by staff.")
end)
Remote.on("castleWallOpen", Style.castleWallOpen)

Remote.on("announce", function(d)
	UI.toast((d.global and "📢 GLOBAL: " or "📢 ") .. tostring(d.text) .. "  (" .. tostring(d.by) .. ")", Color3.fromRGB(40, 60, 120), 8)
	UI.sound("GameShowJingle")
end)

---------------------------------------------------------------------
-- Controller and keyboard shortcuts
---------------------------------------------------------------------
ContextActionService:BindAction("BrainMenu", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		if UI.isModalOpen() then
			UI.closeModal()
		else
			Stations.settings()
		end
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.ButtonY, Enum.KeyCode.M)

ContextActionService:BindAction("BrainAdmin", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		if UI.isModalOpen() then
			UI.closeModal()
		else
			AdminPanel.open()
		end
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.ButtonSelect, Enum.KeyCode.P)

---------------------------------------------------------------------
-- Start
---------------------------------------------------------------------
task.spawn(function()
	for _ = 1, 20 do
		local r = Remote.call("hello")
		if r and r.ok and r.state then
			applyState(r.state)
			-- left during a Eureka cutscene? offer it again
			local e = Remote.call("eureka_pending")
			if e and e.ok and e.choices then
				showEureka(e.choices)
			end
			break
		end
		task.wait(1)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>