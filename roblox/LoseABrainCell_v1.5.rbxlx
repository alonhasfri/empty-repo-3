-- LEFT: activity grid
---------------------------------------------------------------------
local ACTIVITIES = {
	none = {},
	Lose = {
		{ key = "phone", icon = "📱", name = "Phone", color = Color3.fromRGB(150, 80, 250) },
		{ key = "together", icon = "🎭", name = "Vs Mode", color = Color3.fromRGB(250, 110, 60) },
		{ key = "map", icon = "🗺", name = "Map", color = Color3.fromRGB(70, 190, 110) },
	},
	Gain = {
		{ key = "phone", icon = "📱", name = "Phone", color = Color3.fromRGB(150, 80, 250) },
		{ key = "library", icon = "📚", name = "Library", color = Color3.fromRGB(150, 100, 60) },
		{ key = "gate", icon = "🚧", name = "Gate", color = Color3.fromRGB(240, 190, 40) },
		{ key = "work", icon = "🛠", name = "Work", color = Color3.fromRGB(90, 110, 140) },
		{ key = "lab", icon = "🔬", name = "Projects", color = Color3.fromRGB(40, 170, 200) },
		{ key = "gadgets", icon = "🎒", name = "Gadgets", color = Color3.fromRGB(60, 190, 190) },
		{ key = "coffee", icon = "☕", name = "Coffee", color = Color3.fromRGB(130, 85, 50) },
		{ key = "nap", icon = "😴", name = "Nap", color = Color3.fromRGB(100, 100, 190) },
		{ key = "pigeons", icon = "🐦", name = "Pigeons", color = Color3.fromRGB(140, 140, 150) },
	},
}

local grid = UI.new("ScrollingFrame", {
	Name = "Activities",
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 8, 0, 74),
	Size = UDim2.new(0, 132, 1, -250),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 3,
	BorderSizePixel = 0,
	Selectable = false,
	Parent = UI.gui,
}, {
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(60, 60), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	UI.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 2) }),
	UI.new("UISizeConstraint", { MinSize = Vector2.new(132, 140) }),
})

local function iconButton(parent, item, order: number, onClick)
	local T = UI.T
	local b = UI.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = item.color,
		LayoutOrder = order,
		Selectable = true,
		Size = UDim2.fromOffset(60, 60),
		Parent = parent,
	})
	UI.corner(b, T.radius >= 12 and 14 or 6)
	UI.stroke(b, Color3.new(0, 0, 0), T.textStroke and 3 or 1.5, T.textStroke and 0 or 0.5)
	UI.gradient(b, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 180), 90)
	text(b, { Position = UDim2.fromOffset(6, 2), Size = UDim2.new(1, -12, 0, 36), Text = item.icon })
	local name = text(b, { Position = UDim2.new(0, 0, 1, -22), Size = UDim2.new(1, 0, 0, 20), Text = item.name, Font = T.font })
	outlined(name, 1.6)
	local scale = UI.new("UIScale", { Parent = b })
	local function s(v)
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = v }):Play()
	end
	b.MouseEnter:Connect(function()
		s(1.08)
	end)
	b.MouseLeave:Connect(function()
		s(1)
	end)
	b.SelectionGained:Connect(function()
		s(1.1)
	end)
	b.SelectionLost:Connect(function()
		s(1)
	end)
	b.MouseButton1Down:Connect(function()
		s(0.9)
	end)
	b.Activated:Connect(function()
		s(1)
		UI.sound("CartoonBoing", 0.25)
		onClick()
	end)
	if T.wobble then
		b.Rotation = math.random(-6, 6)
	end
	return b
end

local gridPath = "?"
local function buildGrid(path: string?)
	local key = path or "none"
	if key == gridPath then
		return
	end
	gridPath = key
	for _, c in ipairs(grid:GetChildren()) do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	Hud.targets = {}
	for i, item in ipairs(ACTIVITIES[key] or {}) do
		Hud.targets[item.key] = iconButton(grid, item, i, function()
			if Hud.onStation then
				Hud.onStation(item.key)
			end
		end)
	end
end
UI.onTheme(function()
	local p = gridPath
	gridPath = "?"
	buildGrid(p ~= "none" and p or nil)
end)

