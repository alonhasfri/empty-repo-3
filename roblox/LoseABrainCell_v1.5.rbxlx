-- Longest ban each level may give (seconds). -1 = permanent allowed.
Config.BanLimits = {
	[2] = 86400, -- Moderator: up to 1 day
	[3] = -1, -- Head Moderator: any, including permanent
	[4] = -1, -- Owner
}

