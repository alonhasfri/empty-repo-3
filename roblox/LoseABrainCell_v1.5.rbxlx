	local t = text(b, { Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 0, 32), Text = label })
	outlined(t, 2.5)
	local s = text(b, { Position = UDim2.fromOffset(8, 36), Size = UDim2.new(1, -16, 0, 16), Text = sub, TextColor3 = Color3.fromRGB(255, 250, 200) })
