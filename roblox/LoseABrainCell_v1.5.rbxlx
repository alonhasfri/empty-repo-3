	end,
}

ACT.experiment = {
	name = "🔬 Animal Experiments",
	desc = "A scientist studies a player who turned into an animal. The animal must act dumb.",
	a = { label = "Scientist", path = "Gain", minIQ = 130, jobs = { "scientist" } },
	b = { label = "Animal", path = "Lose", animalOnly = true },
	rounds = 3,
	setup = function(sess)
		local stage = sess.players.b and stageOf(sess.players.b) or pick({ "dog", "mouse", "octopus", "bee", "worm" })
		sess.exp = EXPERIMENTS[stage] or EXPERIMENTS.dog
		sess:line(sess.exp.title)
	end,
	round = function(sess)
		return {
			{
				role = "a",
				prompt = function()
					return sess.exp.title .. "\nRun the experiment."
				end,
				options = function()
					return sess.exp.scientist
				end,
				onPick = function(i)
					sess:line("🔬 Scientist: " .. sess.exp.scientist[i])
				end,
			},
			{
				role = "b",
				prompt = function()
					sess.ao = shuffle({ "smart", "dumb", "other" })
					return "React! (The dumbest reaction is best for you.)"
				end,
				options = function()
					local out = {}
					for i, k in ipairs(sess.ao) do
						out[i] = sess.exp.animal[k]
					end
					return out
				end,
				onPick = function(i)
					local kind = sess.ao[i]
					if kind == "smart" then
						sess:gain("b", 1)
						sess:gain("a", 2)
						sess:line("📈 The animal LEARNED something. Science wins.")
					elseif kind == "dumb" then
						sess:lose("b", 2)
						sess:gain("a", 0.3)
						sess:line("📉 " .. sess.exp.animal.dumb .. ". Perfectly dumb.")
					else
						sess:line("🤷 " .. sess.exp.animal.other .. ". Inconclusive.")
					end
				end,
			},
		}
	end,
}

---------------------------------------------------------------------
-- Eligibility and queues
---------------------------------------------------------------------
local queues = {} -- [act][roleKey] = { player... }
local inSession = {} -- [player] = session
local sessions = {} -- [id] = session
local nextId = 0

for key in pairs(ACT) do
	queues[key] = { a = {}, b = {} }
end

local function eligible(player, actKey: string, roleKey: string): (boolean, string?)
	local act = ACT[actKey]
	local role = act and act[roleKey]
	if not role then
		return false, "Unknown role."
	end
	if pathOf(player) ~= role.path then
		return false, "Needs the " .. role.path .. " path."
	end
	if role.minIQ then
		local hasJob = role.jobs and table.find(role.jobs, jobOf(player) or "") ~= nil
		if iqOf(player) < role.minIQ and not hasJob then
			return false, "Needs IQ " .. role.minIQ .. "+" .. (role.jobs and (" or the right job") or "")
		end
	end
	local stage = stageOf(player)
	if role.humanOnly and stage ~= "human" and stage ~= "barelyhuman" then
		return false, "You're a " .. stage .. ". Animals can't go to school."
	end
	if role.animalOnly and (stage == "human" or stage == "barelyhuman" or stage == "dead") then
		return false, "Only players who turned into animals."
	end
	if role.minStress then
		local d = DataService.get(player)
		if not d or d.stress < role.minStress then
			return false, "You're not stressed enough to need therapy. 😎"
		end
	end
	return true
end

local function removeFromQueues(player)
	for _, q in pairs(queues) do
		for _, list in pairs(q) do
			local i = table.find(list, player)
			if i then
				table.remove(list, i)
			end
		end
	end
end

---------------------------------------------------------------------
-- Session engine
---------------------------------------------------------------------
local Session = {}
Session.__index = Session

function Session:line(text: string)
	table.insert(self.transcript, text)
end
function Session:gain(role: string, points: number)
	local p = self.players[role]
	if p and p.Parent then
		BrainService.gain(p, points, "social")
	end
end
function Session:lose(role: string, points: number)
	local p = self.players[role]
	if p and p.Parent then
		BrainService.lose(p, points, "social")
	end
end
function Session:stress(role: string, amount: number)
	local p = self.players[role]
	if p and p.Parent then
		BrainService.stress(p, amount)
	end
end

local function partnerName(sess, role: string): string
	local other = role == "a" and "b" or "a"
	local p = sess.players[other]
	return p and p.DisplayName or (sess.act[other].label .. " (NPC)")
end

local function sendTo(sess, role: string, kind: string, payload)
	local p = sess.players[role]
	if p and p.Parent then
		payload.sessionId = sess.id
		payload.title = sess.act.name
		payload.role = sess.act[role].label
		payload.partner = partnerName(sess, role)
		payload.transcript = { table.unpack(sess.transcript, math.max(1, #sess.transcript - 5)) }
		Net.send(p, kind, payload)
	end
end

local function runSession(sess)
	local act = sess.act
	for _, role in ipairs({ "a", "b" }) do
		sendTo(sess, role, "social_start", { text = act.desc })
	end
	if act.setup then
		act.setup(sess)
	end
	for r = 1, act.rounds do
		local okRound, steps = pcall(act.round, sess)
		for _, step in ipairs(okRound and steps or {}) do
			local okP, prompt = pcall(step.prompt)
			local okO, options = pcall(step.options)
			if not okP or not okO or typeof(options) ~= "table" or #options == 0 then
				warn("[Social] skipped a broken step in " .. act.name)
				continue
			end
			local human = sess.players[step.role]
			local choice = nil
			if human and human.Parent then
				sess.waiting = { role = step.role, count = #options }
				sess.answer = nil
				sendTo(sess, step.role, "social_step", { prompt = prompt, options = options, seconds = STEP_SECONDS, round = r, rounds = act.rounds })
				local other = step.role == "a" and "b" or "a"
				sendTo(sess, other, "social_wait", { text = "Waiting for " .. partnerName(sess, other) .. "…", round = r, rounds = act.rounds })
				local t = os.clock()
				while sess.answer == nil and os.clock() - t < STEP_SECONDS + 1 and human.Parent do
					task.wait(0.2)
				end
				choice = sess.answer
			else
				task.wait(1.2) -- NPC "thinks"
			end
			if not choice or choice < 1 or choice > #options then
				choice = math.random(1, #options)
			end
			sess.waiting = nil
			pcall(step.onPick, choice)
		end
	end
	if act.finish then
		pcall(act.finish, sess)
	end
	for _, role in ipairs({ "a", "b" }) do
		sendTo(sess, role, "social_end", { lines = sess.transcript })
		local p = sess.players[role]
		if p then
			inSession[p] = nil
		end
	end
	sessions[sess.id] = nil
end

local function startSession(actKey: string, a: Player?, b: Player?)
	nextId += 1
	local sess = setmetatable({
		id = nextId,
		act = ACT[actKey],
		players = { a = a, b = b },
		transcript = {},
	}, Session)
	sessions[sess.id] = sess
	if a then
		inSession[a] = sess
	end
	if b then
		inSession[b] = sess
	end
	task.spawn(runSession, sess)
end

local function tryMatch(actKey: string)
	local q = queues[actKey]
	while #q.a > 0 and #q.b > 0 do
		local a = table.remove(q.a, 1)
		local b = table.remove(q.b, 1)
		if a.Parent and b.Parent and a ~= b then
			startSession(actKey, a, b)
		end
	end
end

Net.on("social_list", function(player)
	local list = {}
	for key, act in pairs(ACT) do
		local roles = {}
		for _, roleKey in ipairs({ "a", "b" }) do
			local ok, why = eligible(player, key, roleKey)
			table.insert(roles, { key = roleKey, label = act[roleKey].label, ok = ok, why = why, waiting = #queues[key][roleKey] })
		end
		table.insert(list, { key = key, name = act.name, desc = act.desc, roles = roles })
	end
	table.sort(list, function(x, y)
		return x.name < y.name
	end)
	local queued = nil
	for key, q in pairs(queues) do
		for roleKey, l in pairs(q) do
			if table.find(l, player) then
				queued = ACT[key].name .. " as " .. ACT[key][roleKey].label
			end
		end
	end
	return {
		ok = true,
		activities = list,
		queued = queued,
		canJournal = pathOf(player) == "Gain" and iqOf(player) >= 100,
	}
end)

Net.on("social_join", function(player, d)
	local actKey, roleKey = tostring(d.act), tostring(d.role)
	if inSession[player] then
		return { ok = false, msg = "You're already in an activity." }
	end
	local ok, why = eligible(player, actKey, roleKey)
	if not ok then
		return { ok = false, msg = why }
	end
	if BrainService.blocked(player) then
		return { ok = false, msg = BrainService.blocked(player) }
	end
	removeFromQueues(player)
	table.insert(queues[actKey][roleKey], player)
	tryMatch(actKey)
	if not inSession[player] then
		-- nobody else? an NPC takes the other role after a few seconds
		task.delay(NPC_WAIT, function()
			local list = queues[actKey][roleKey]
			local i = table.find(list, player)
			if i and player.Parent and not inSession[player] then
				table.remove(list, i)
				if roleKey == "a" then
					startSession(actKey, player, nil)
				else
					startSession(actKey, nil, player)
				end
			end
		end)
		return { ok = true, msg = "Looking for a partner… (an NPC joins in " .. NPC_WAIT .. "s if nobody does)" }
	end
	return { ok = true, msg = "Matched!" }
end)

Net.on("social_leave", function(player)
	removeFromQueues(player)
	return { ok = true, msg = "Left the queue." }
end)

Net.on("social_answer", function(player, d)
	local sess = inSession[player]
	if not sess or tonumber(d.sessionId) ~= sess.id or not sess.waiting then
		return { ok = false }
	end
	if sess.players[sess.waiting.role] ~= player then
		return { ok = false }
	end
	local c = tonumber(d.choice)
	if c and c >= 1 and c <= sess.waiting.count then
		sess.answer = c
	end
	return { ok = true }
end)

-- Get sued (called by the Lose path after a dumb action)
function SocialService.maybeSue(player)
	if inSession[player] or math.random() > 0.06 then
		return
	end
	Net.send(player, "sued", { case = pick(CASES) })
end

Net.on("sued_accept", function(player)
	local ok, why = eligible(player, "courtroom", "b")
	if not ok then
		return { ok = false, msg = why }
	end
	removeFromQueues(player)
	table.insert(queues.courtroom.b, player)
	tryMatch("courtroom")
	if not inSession[player] then
		task.delay(4, function()
			local i = table.find(queues.courtroom.b, player)
			if i and player.Parent and not inSession[player] then
				table.remove(queues.courtroom.b, i)
				startSession("courtroom", nil, player)
			end
		end)
	end
	return { ok = true, msg = "⚖️ Court is in session…" }
end)

---------------------------------------------------------------------
-- Journalist (solo): write headlines that become clickbait for dumb players
---------------------------------------------------------------------
local HEADLINE_PARTS = {
	starts = { "You Won't BELIEVE", "Scientists HATE", "Doctors Don't Want You to Know", "This One Weird Trick:", "BREAKING:", "Top 10 Reasons" },
	subjects = { "This Pigeon", "A Local Toaster", "The Mayor's Sock", "Your Brain Cells", "A Banana", "This Microwave" },
	endings = { "(GONE WRONG) 😱", "Will SHOCK You", "…Number 7 Is Crazy", "In Just 5 Seconds", "(NOT CLICKBAIT)", "And Nobody Noticed" },
}

Net.on("journal_parts", function(player)
	if pathOf(player) ~= "Gain" or iqOf(player) < 100 then
		return { ok = false, msg = "Journalists need the Gain path and IQ 100+." }
	end
	return { ok = true, parts = HEADLINE_PARTS }
end)

Net.on("journal_publish", function(player, d)
	if pathOf(player) ~= "Gain" or iqOf(player) < 100 then
		return { ok = false }
	end
	local s = HEADLINE_PARTS.starts[tonumber(d.s) or 0]
	local m = HEADLINE_PARTS.subjects[tonumber(d.m) or 0]
	local e = HEADLINE_PARTS.endings[tonumber(d.e) or 0]
	if not s or not m or not e then
		return { ok = false, msg = "Pick all three parts." }
	end
	local headline = s .. " " .. m .. " " .. e
	LoseService.addJournalistHeadline(headline, player.UserId)
	BrainService.gain(player, 0.5, "journal")
	return { ok = true, msg = "📰 Published: \"" .. headline .. "\". You'll get brain cells every time a dumb player clicks it." }
end)

---------------------------------------------------------------------
-- The Election (server event)
---------------------------------------------------------------------
local SPEECHES = {
	Gain = { "I will build more libraries.", "I promise free tutoring for everyone.", "Science funding for all!" },
	Lose = { "Free microwaves for everyone!!", "I will ban reading. Forever.", "Every day is Skibidi Day." },
}
local election = nil

local function runElection()
	if election then
		return false
	end
	local gainers, losers = {}, {}
	for _, p in ipairs(Players:GetPlayers()) do
		local path = pathOf(p)
		if path == "Gain" then
			table.insert(gainers, p)
		elseif path == "Lose" then
			table.insert(losers, p)
		end
	end
	local cands = {
		{ path = "Gain", player = #gainers > 0 and pick(gainers) or nil, npc = "Professor Noodle (NPC)" },
		{ path = "Lose", player = #losers > 0 and pick(losers) or nil, npc = "Mayor McBrainface (NPC)" },
	}
	election = { cands = cands, votes = { 0, 0 }, voted = {} }
	for i, c in ipairs(cands) do
		c.name = c.player and c.player.DisplayName or c.npc
		c.speech = pick(SPEECHES[c.path])
		if c.player then
			Net.send(c.player, "election_speech", { options = SPEECHES[c.path], index = i })
		end
	end
	Net.broadcast("announce", { text = "🗳 ELECTION TIME! " .. cands[1].name .. " (smart) vs " .. cands[2].name .. " (dumb). Speeches in 15s, then vote!", by = "Dr. Wrinkles" })
	task.wait(15)
	Net.broadcast("election_vote", {
		cands = { { name = cands[1].name, speech = cands[1].speech, path = "Gain" }, { name = cands[2].name, speech = cands[2].speech, path = "Lose" } },
		seconds = 20,
	})
	task.wait(21)
	-- a few NPC voters keep it interesting
	for _ = 1, 3 do
		local i = math.random(1, 2)
		election.votes[i] += 1
	end
	local winner = election.votes[1] >= election.votes[2] and 1 or 2
	local w = cands[winner]
	BrainService.boost.Gain, BrainService.boost.Lose = 1, 1
	if w.path == "Gain" then
		BrainService.boost.Gain = 1.25
	else
		BrainService.boost.Lose = 1.25
	end
	WorldService.setBanner("🏆 MAYOR " .. string.upper(w.name), w.path == "Gain" and Color3.fromRGB(60, 120, 255) or Color3.fromRGB(255, 50, 170))
	Net.broadcast("election_result", {
		text = "🏆 " .. w.name .. " wins (" .. election.votes[1] .. " – " .. election.votes[2] .. ")! " .. (w.path == "Gain" and "Gain path: +25% brain cells for 10 minutes." or "Lose path: losing brain cells is 25% faster for 10 minutes."),
	})
	election = nil
	task.delay(600, function()
		BrainService.boost.Gain, BrainService.boost.Lose = 1, 1
	end)
	return true
end
SocialService.runElection = runElection

Net.on("election_speech", function(player, d)
	if not election then
		return { ok = false }
	end
	for _, c in ipairs(election.cands) do
		if c.player == player then
			local s = SPEECHES[c.path][tonumber(d.choice) or 0]
			if s then
				c.speech = s
			end
		end
	end
	return { ok = true }
end)

Net.on("election_cast", function(player, d)
	if not election or election.voted[player] then
		return { ok = false, msg = "You already voted." }
	end
	local i = tonumber(d.choice)
	if i ~= 1 and i ~= 2 then
		return { ok = false }
	end
	election.voted[player] = true
	election.votes[i] += 1
	return { ok = true, msg = "🗳 Vote counted!" }
end)

function SocialService.start()
	LoseService.onDumbAction = SocialService.maybeSue
	Players.PlayerRemoving:Connect(function(p)
		removeFromQueues(p)
		inSession[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait((Config.ElectionMinutes or 20) * 60)
			if #Players:GetPlayers() >= 1 then
				pcall(runElection)
			end
		end
	end)
end

return SocialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000018"><Properties><string name="Name">SpaceService</string><ProtectedString name="Source"><![CDATA[-- SpaceService (update 1.4: Space and secrets)
--   * Astronaut job: IQ 160+ AND Space Travel has been invented by anyone, ever
--     (or the honest 100 R$ Early Access pass, only offered while nobody has invented it)
--   * Launch Pad east of town -> rocket launch -> the Moon (low gravity)
--   * Space Lab: astronaut training minigames, Space Gates, space-only Major Projects
--   * World's Smartest (IQ 200): cutscene, title choice, badge, statue, Retired Genius
--   * Retired Genius: random people walk up and ask you questions

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)
local ProjectService = require(script.Parent.ProjectService)
local Props = require(script.Parent.Props)

local SpaceService = {}

-- The Moon is far away from town (absolute position, not scaled)
local MOON = Vector3.new(6000, 1500, 0)
SpaceService.MoonCenter = MOON
local MOON_RADIUS = 160
local PAD_RAW = Vector3.new(400, 0.6, 0)

local folder = Instance.new("Folder")
folder.Name = "Space"
folder.Parent = workspace

local smartestStore = nil
pcall(function()
	smartestStore = DataStoreService:GetDataStore("BrainWorldsSmartest_v1")
end)

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or folder
	return p
end

local function sign(cf: CFrame, text: string, size: Vector3?, color: Color3?)
	local p = part({ Name = "SpaceSign", Size = size or Vector3.new(14, 3, 0.4), CFrame = cf, Color = color or Color3.fromRGB(25, 30, 45), Material = Enum.Material.SmoothPlastic, CanCollide = false })
	local sg = Instance.new("SurfaceGui")
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.Parent = p
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Color3.fromRGB(220, 240, 255)
	l.Text = text
	l.Parent = sg
	return p
end

local function prompt(p: BasePart, action: string, object: string, fn)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0.3
	pp.RequiresLineOfSight = false
	pp.MaxActivationDistance = 14
	pp.Parent = p
	pp.Triggered:Connect(fn)
	return pp
end

---------------------------------------------------------------------
-- Who is an Astronaut?
---------------------------------------------------------------------
local function spaceInvented(): boolean
	return ProjectService.everInvented("space")
end

local function isAstronaut(player): boolean
	local data = DataService.get(player)
	if not data or data.path ~= "Gain" or data.dead then
		return false
	end
	if Brain.iq(data.cells) < Config.Space.AstronautIQ then
		return false
	end
	return spaceInvented() or data.perks.AstronautEarly == true or (data.projectsDone ~= nil and data.projectsDone.space == true)
end
SpaceService.isAstronaut = isAstronaut

local function inSpace(player): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root ~= nil and (root.Position - MOON).Magnitude < 420
end
SpaceService.inSpace = inSpace

---------------------------------------------------------------------
-- Building: Launch Pad (town) + the Moon + Space Lab
---------------------------------------------------------------------
local function rocket(cf: CFrame, parent)
	local m = Instance.new("Model")
	m.Name = "Rocket"
	m.Parent = parent or folder
	part({ Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(30, 8, 8), CFrame = cf * CFrame.new(0, 17, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(240, 240, 245), Material = Enum.Material.Metal, Parent = m })
	part({ Name = "Stripe", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 8.2, 8.2), CFrame = cf * CFrame.new(0, 24, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 90, 200), Material = Enum.Material.SmoothPlastic, Parent = m })
	part({ Name = "Nose", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), CFrame = cf * CFrame.new(0, 32, 0), Color = Color3.fromRGB(220, 40, 40), Material = Enum.Material.SmoothPlastic, Parent = m })
	part({ Name = "Window", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), CFrame = cf * CFrame.new(0, 26, -3.6), Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.Glass, Transparency = 0.2, Parent = m })
	for i = 0, 3 do
		local a = i * math.pi / 2
		part({ Name = "Fin", Size = Vector3.new(0.6, 7, 4), CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 4.5, -5.5), Color = Color3.fromRGB(220, 40, 40), Material = Enum.Material.SmoothPlastic, Parent = m })
	end
	part({ Name = "Engine", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 5, 5), CFrame = cf * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.DiamondPlate, Parent = m })
	return m
end

local launchPad: BasePart = nil

local function buildLaunchPad()
	local c = WorldService.sp(PAD_RAW)
	local base = CFrame.new(c)
	launchPad = part({ Name = "LaunchPad", Size = Vector3.new(34, 1, 34), CFrame = base, Color = Color3.fromRGB(150, 150, 150), Material = Enum.Material.Concrete })
	part({ Name = "PadMark", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 16, 16), CFrame = base * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.SmoothPlastic, CanCollide = false })
	-- gantry tower
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			part({ Name = "Gantry", Size = Vector3.new(0.8, 40, 0.8), CFrame = base * CFrame.new(12 + x * 2, 20, z * 2), Color = Color3.fromRGB(220, 90, 30), Material = Enum.Material.Metal })
		end
	end
	for y = 4, 36, 8 do
		part({ Name = "GantryBar", Size = Vector3.new(5, 0.5, 5), CFrame = base * CFrame.new(12, y, 0), Color = Color3.fromRGB(220, 90, 30), Material = Enum.Material.DiamondPlate })
	end
	rocket(base * CFrame.new(0, 0.5, 0))
	local s = sign(base * CFrame.new(0, 4, 17.5) * CFrame.Angles(0, math.pi, 0), "🚀 LAUNCH PAD\nAstronauts only (IQ 160+)", Vector3.new(16, 6, 0.4))
	prompt(s, "Launch to the Moon", "🚀 Rocket", function(player)
		SpaceService.launch(player)
	end)
	prompt(launchPad, "Launch to the Moon", "🚀 Rocket", function(player)
		SpaceService.launch(player)
	end)
	WorldService.Spots.launchpad = PAD_RAW + Vector3.new(0, 3, 28)
	table.insert(WorldService.Places, { key = "launchpad", name = "🚀 Launch Pad", path = "Gain" })
end

local moonParts = {}
local function buildMoon()
	-- ground: a huge flat disc with craters
	local ground = part({ Name = "MoonGround", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, MOON_RADIUS * 2, MOON_RADIUS * 2), CFrame = CFrame.new(MOON - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(175, 175, 180), Material = Enum.Material.Slate })
	moonParts.ground = ground
	local rng = Random.new(1969)
	for _ = 1, 28 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(40, MOON_RADIUS - 20)
		local size = rng:NextNumber(6, 22)
		part({ Name = "Crater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, size, size), CFrame = CFrame.new(MOON + Vector3.new(math.cos(a) * r, 0.05, math.sin(a) * r)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(135, 135, 142), Material = Enum.Material.Slate, CanCollide = false })
		part({ Name = "CraterRim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, size + 2, size + 2), CFrame = CFrame.new(MOON + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(195, 195, 200), Material = Enum.Material.Slate, CanCollide = false })
	end
	-- Earth in the sky
	part({ Name = "Earth", Shape = Enum.PartType.Ball, Size = Vector3.new(120, 120, 120), CFrame = CFrame.new(MOON + Vector3.new(-200, 260, -520)), Color = Color3.fromRGB(60, 120, 220), Material = Enum.Material.SmoothPlastic, CanCollide = false, CastShadow = false })
	part({ Name = "EarthLand", Shape = Enum.PartType.Ball, Size = Vector3.new(121, 70, 90), CFrame = CFrame.new(MOON + Vector3.new(-190, 270, -520)), Color = Color3.fromRGB(80, 170, 90), Material = Enum.Material.SmoothPlastic, CanCollide = false, CastShadow = false })
	-- flag
	part({ Name = "FlagPole", Size = Vector3.new(0.3, 10, 0.3), CFrame = CFrame.new(MOON + Vector3.new(30, 5, 30)), Color = Color3.fromRGB(220, 220, 220), Material = Enum.Material.Metal })
	sign(CFrame.new(MOON + Vector3.new(32.6, 8.5, 30)), "🧠 BRAINVILLE", Vector3.new(5, 3, 0.1), Color3.fromRGB(255, 255, 255)).SurfaceGui.TextLabel.TextColor3 = Color3.fromRGB(230, 60, 120)

	-- landing pad + return capsule
	local landing = CFrame.new(MOON + Vector3.new(0, 0.2, 70))
	part({ Name = "MoonPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 26, 26), CFrame = landing * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(90, 90, 100), Material = Enum.Material.DiamondPlate })
	rocket(landing * CFrame.new(-18, 0, 0))
	local ret = sign(landing * CFrame.new(-18, 3, -6), "🌍 Back to Earth", Vector3.new(8, 2.5, 0.4))
	prompt(ret, "Fly home", "🚀 Rocket", function(player)
		SpaceService.returnHome(player)
	end)

	-- THE SPACE LAB: a glass dome with real lab furniture
	local dome = CFrame.new(MOON)
	part({ Name = "LabFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 70, 70), CFrame = dome * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(235, 238, 245), Material = Enum.Material.SmoothPlastic })
	local glass = part({ Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(72, 72, 72), CFrame = dome, Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.75, CanCollide = false, CastShadow = false })
	local _ = glass
	sign(dome * CFrame.new(0, 26, -20), "🔬 SPACE LAB", Vector3.new(20, 4, 0.4), Color3.fromRGB(20, 40, 70))
	for i, x in ipairs({ -18, 0, 18 }) do
		local bench = Props.labBench(dome * CFrame.new(x, 0.6, 8) * CFrame.Angles(0, math.pi, 0))
		bench.Parent = folder
		local _ = i
	end
	-- stations inside the dome
	local function terminal(cf: CFrame, title: string, action: string, fn)
		local t = part({ Name = "Terminal", Size = Vector3.new(4, 5, 2), CFrame = cf * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(50, 55, 70), Material = Enum.Material.Metal })
		local screen = part({ Name = "Screen", Size = Vector3.new(3.4, 2.4, 0.2), CFrame = cf * CFrame.new(0, 3.6, -1.05), Color = Color3.fromRGB(40, 200, 255), Material = Enum.Material.Neon, CanCollide = false })
		local _ = screen
		sign(cf * CFrame.new(0, 7, 0), title, Vector3.new(8, 2, 0.3))
		prompt(t, action, title, fn)
	end
	terminal(dome * CFrame.new(-22, 0.6, -14), "🧑‍🚀 Training", "Train", function(player)
		Net.send(player, "openStation", { station = "astroTraining" })
	end)
	terminal(dome * CFrame.new(0, 0.6, -24), "🚧 Space Gate", "Answer", function(player)
		Net.send(player, "openStation", { station = "spaceGate" })
	end)
	terminal(dome * CFrame.new(22, 0.6, -14), "🔬 Space Projects", "Open", function(player)
		Net.send(player, "openStation", { station = "lab" })
	end)
	-- Tesla's pigeons somehow followed you to space
	for i = 1, 5 do
		local a = i * 1.2
		local p = part({ Name = "SpacePigeon", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.2, 1.8), CFrame = dome * CFrame.new(math.cos(a) * 10, 1.4, math.sin(a) * 10 + 20), Color = Color3.fromRGB(150, 150, 165), Material = Enum.Material.SmoothPlastic })
		part({ Name = "Helmet", Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), CFrame = p.CFrame * CFrame.new(0, 0.6, -0.7), Color = Color3.fromRGB(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.5, CanCollide = false })
		if i == 1 then
			sign(p.CFrame * CFrame.new(0, 3, 0), "🐦 Tesla's pigeons. How did they get here?", Vector3.new(10, 1.6, 0.2))
		end
	end
end

-- Space project effects (shown on the Moon)
ProjectService.EFFECTS.spacefarm = function(on)
	if not on then
		return
	end
	for row = -2, 2 do
		part({ Name = "MoonLettuceBed", Size = Vector3.new(14, 1, 2.5), CFrame = CFrame.new(MOON + Vector3.new(0, 1.1, -6 + row * 3.5)), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.Ground })
		for k = -3, 3 do
			part({ Name = "MoonLettuce", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.2, 1.4), CFrame = CFrame.new(MOON + Vector3.new(k * 2, 2, -6 + row * 3.5)), Color = Color3.fromRGB(110, 210, 90), Material = Enum.Material.Grass, CanCollide = false })
		end
	end
end
ProjectService.EFFECTS.asteroid = function(on)
	if not on then
		return
	end
	local rock = part({ Name = "Asteroid", Shape = Enum.PartType.Ball, Size = Vector3.new(40, 34, 38), CFrame = CFrame.new(MOON + Vector3.new(120, 60, -90)), Color = Color3.fromRGB(110, 95, 85), Material = Enum.Material.Rock, CanCollide = false })
	for i = 1, 12 do
		local a = i * 0.52
		part({ Name = "Ore", Size = Vector3.new(3, 3, 3), CFrame = rock.CFrame * CFrame.Angles(a, a * 2, 0) * CFrame.new(0, 0, -18), Color = Color3.fromRGB(255, 210, 90), Material = Enum.Material.Neon, CanCollide = false })
	end
end
ProjectService.EFFECTS.marshab = function(on)
	if not on then
		return
	end
	part({ Name = "MarsPlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(50, 50, 50), CFrame = CFrame.new(MOON + Vector3.new(300, 140, 260)), Color = Color3.fromRGB(200, 90, 50), Material = Enum.Material.Sand, CanCollide = false, CastShadow = false })
	part({ Name = "MarsDome", Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), CFrame = CFrame.new(MOON + Vector3.new(300, 166, 260)), Color = Color3.fromRGB(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.4, CanCollide = false })
end

---------------------------------------------------------------------
-- Launch / return
---------------------------------------------------------------------
local launching = {}

function SpaceService.launch(player)
	if launching[player] then
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	if not isAstronaut(player) then
		if data.path == "Gain" and Brain.iq(data.cells) >= Config.Space.AstronautIQ and not spaceInvented() then
			Net.send(player, "openStation", { station = "space" })
		else
			BrainService.toast(player, "🧑‍🚀 Astronauts only: Gain path, IQ " .. Config.Space.AstronautIQ .. "+, and someone has to invent 🚀 Space Travel first.", "NotificationPing")
		end
		return
	end
	local blocked = BrainService.blocked(player)
	if blocked then
		BrainService.toast(player, blocked)
		return
	end
	launching[player] = true
	data.timesLaunched = (data.timesLaunched or 0) + 1
	Net.send(player, "launch", { first = data.timesLaunched == 1 })
	task.delay(6.5, function()
		launching[player] = nil
		local char = player.Character
		if char and player.Parent then
			char:PivotTo(CFrame.new(MOON + Vector3.new(math.random(-4, 4), 4, 66)))
			BrainService.toast(player, "🌙 Welcome to the Moon. Gravity is 1/6 here. Jump!", "LevelUp")
		end
	end)
end

function SpaceService.returnHome(player)
	local char = player.Character
	if not char then
		return
	end
	Net.send(player, "launch", { home = true })
	task.delay(3.5, function()
		if char.Parent then
			char:PivotTo(CFrame.new(WorldService.sp(PAD_RAW) + Vector3.new(0, 4, 26)))
		end
	end)
end

---------------------------------------------------------------------
-- Net
---------------------------------------------------------------------
Net.on("space_info", function(player)
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	local iq = Brain.iq(data.cells)
	local pass = Config.GamePasses.AstronautEarly
	return {
		ok = true,
		astronaut = isAstronaut(player),
		invented = spaceInvented(),
		iq = math.floor(iq),
		needIQ = Config.Space.AstronautIQ,
		path = data.path,
		passOwned = data.perks.AstronautEarly == true,
		-- honest: the pass is ONLY offered while nobody has invented space travel
		passOffered = (not spaceInvented()) and data.perks.AstronautEarly ~= true and data.path == "Gain" and iq >= Config.Space.AstronautIQ,
		passPrice = pass.price,
		passId = pass.id,
		trained = data.astroTrained or {},
		inSpace = inSpace(player),
	}
end)

Net.on("space_launch", function(player)
	if not WorldService.near(player, WorldService.sp(PAD_RAW), 40) then
		local data = DataService.get(player)
		if data and isAstronaut(player) then
			WorldService.teleport(player, "launchpad")
			return { ok = true, msg = "🚕 Taxi to the Launch Pad. Walk up to the rocket and launch!" }
		end
	end
	SpaceService.launch(player)
	return { ok = true }
end)

local trainCooldown = {}
Net.on("astro_train_done", function(player, d)
	local data = DataService.get(player)
	if not data or not isAstronaut(player) then
		return { ok = false, msg = "Only Astronauts can train here." }
	end
	if not inSpace(player) then
		return { ok = false, msg = "Training happens in the Space Lab on the Moon." }
	end
	local key = tostring(d.key)
	local valid = false
	for _, t in ipairs(Content.AstroTraining) do
		if t.key == key then
			valid = true
		end
	end
	if not valid then
		return { ok = false }
	end
	local cdKey = player.UserId .. key
	if (trainCooldown[cdKey] or 0) > os.clock() then
		return { ok = false, msg = "Catch your breath first (" .. math.ceil(trainCooldown[cdKey] - os.clock()) .. "s)." }
	end
	trainCooldown[cdKey] = os.clock() + 15
	if d.success ~= true then
		BrainService.stress(player, 4)
		return { ok = true, msg = "💫 Bonk. Try again, space cadet." }
	end
	data.astroTrained = data.astroTrained or {}
	local firstTime = not data.astroTrained[key]
	data.astroTrained[key] = true
	BrainService.gain(player, firstTime and 2 or 0.6, "astro")
	BrainService.stress(player, -6)
	local all = true
	for _, t in ipairs(Content.AstroTraining) do
		if not data.astroTrained[t.key] then
			all = false
		end
	end
	if all and firstTime then
		Net.send(player, "confetti", {})
		return { ok = true, msg = "🧑‍🚀 FULLY TRAINED ASTRONAUT! NASA would hire you. (We are not NASA.)" }
	end
	return { ok = true, msg = "✅ Training complete!" }
end)

local gateQ = {}
Net.on("space_gate", function(player)
	if not isAstronaut(player) or not inSpace(player) then
		return { ok = false, msg = "Space Gates are in the Space Lab on the Moon (Astronauts only)." }
	end
	local blocked = BrainService.blocked(player)
	if blocked then
		return { ok = false, msg = blocked }
	end
	local q = Content.SpaceGates[math.random(1, #Content.SpaceGates)]
	gateQ[player] = q
	return { ok = true, q = q.q, options = q.options }
end)

Net.on("space_gate_answer", function(player, d)
	local q = gateQ[player]
	gateQ[player] = nil
	if not q then
		return { ok = false }
	end
	if tonumber(d.choice) == q.answer then
		BrainService.gain(player, 2.5, "spacegate")
		BrainService.stress(player, 6)
		return { ok = true, correct = true, msg = "✅ Correct! Orbital mechanics: understood." }
	end
	BrainService.stress(player, 10)
	return { ok = true, correct = false, msg = "❌ Wrong. The right answer was: " .. q.options[q.answer] }
end)

---------------------------------------------------------------------
-- World's Smartest (IQ 200) + Retired Genius
---------------------------------------------------------------------
local TITLES = { Man = true, Woman = true, Person = true }

local function onSmartest(player)
	local spots = WorldService.Spots
	local lib = spots.library and WorldService.sp(spots.library) or nil
	Net.send(player, "worldsSmartest", { name = player.DisplayName, headlines = Content.SmartestHeadlines, library = lib })
end

local smartestStatues = 0
Net.on("smartest_title", function(player, d)
	local data = DataService.get(player)
	if not data or not data.worldsSmartest or data.smartestTitle then
		return { ok = false }
	end
	local title = tostring(d.title)
	if not TITLES[title] then
		title = "Person"
	end
	data.smartestTitle = title
	data.retired = true
	BrainService.awardBadge(player, "WorldsSmartest")
	BrainService.applyCharacter(player)
	BrainService.push(player)
	Net.broadcast("announce", { text = "👑 " .. player.DisplayName .. " is now THE WORLD'S SMARTEST " .. string.upper(title) .. "!", by = "Dr. Wrinkles", global = false })
	if smartestStatues < 12 then
		smartestStatues += 1
		ProjectService.addStatue(player.UserId, player.DisplayName, "👑", "World's Smartest " .. title)
	end
	if smartestStore and not data.adminTouched then
		task.spawn(function()
			pcall(function()
				smartestStore:UpdateAsync("list", function(old)
					old = old or {}
					for _, e in ipairs(old) do
						if e.userId == player.UserId then
							return nil
						end
					end
					if #old >= 12 then
						return nil
					end
					table.insert(old, { userId = player.UserId, name = player.DisplayName, title = title })
					return old
				end)
			end)
		end)
	end
	return { ok = true, msg = "You are now Retired Genius. People will ask you things. Constantly." }
end)

local retiredQ = {}
Net.on("retired_answer", function(player, d)
	local q = retiredQ[player]
	retiredQ[player] = nil
	if not q then
		return { ok = false }
	end
	if tonumber(d.choice) == q.answer then
		BrainService.gain(player, 0.5, "retired")
		return { ok = true, msg = q.who .. ": \"Wow. Thank you, genius!\"" }
	end
	return { ok = true, msg = q.who .. ": \"…are you sure you're the smartest?\"" }
end)

local function retiredLoop()
	while true do
		task.wait(150 + math.random(0, 90))
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.get(player)
			if data and data.retired and data.path == "Gain" and not BrainService.blocked(player) then
				local q = Content.RetiredQuestions[math.random(1, #Content.RetiredQuestions)]
				retiredQ[player] = q
				Net.send(player, "retiredQuestion", { who = q.who, q = q.q, options = q.options })
			end
		end
	end
end

---------------------------------------------------------------------
-- Start
---------------------------------------------------------------------
function SpaceService.start()
	BrainService.isAstronaut = isAstronaut
	BrainService.spaceInvented = spaceInvented
	ProjectService.spaceCheck = function(player)
		if not isAstronaut(player) then
			return false, "🧑‍🚀 Space projects are for Astronauts (IQ " .. Config.Space.AstronautIQ .. "+)."
		end
		if not inSpace(player) then
			return false, "🌙 Space projects happen in the Space Lab on the Moon. Launch from the Launch Pad!"
		end
		return true
	end
	BrainService.hooks.onAstronautIQ = function(player)
		if isAstronaut(player) then
			BrainService.toast(player, "🧑‍🚀 IQ " .. Config.Space.AstronautIQ .. "! You're an ASTRONAUT now. 🚀 Launch Pad is east of town.", "LevelUp")
			Net.send(player, "confetti", {})
		else
			Net.send(player, "openStation", { station = "space" })
		end
		BrainService.push(player)
	end
	BrainService.hooks.onSmartest = onSmartest
	ProjectService.onInvented = function(key)
		if key ~= "space" then
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if isAstronaut(player) then
				BrainService.toast(player, "🚀 Someone invented SPACE TRAVEL! The Astronaut job is unlocked for you. Launch Pad: east of town.", "LevelUp")
				BrainService.push(player)
			end
		end
	end
	buildLaunchPad()
	buildMoon()
	Players.PlayerRemoving:Connect(function(p)
		launching[p] = nil
		gateQ[p] = nil
		retiredQ[p] = nil
	end)
	task.spawn(retiredLoop)
	task.spawn(function()
		if not smartestStore then
			return
		end
		local ok, list = pcall(function()
			return smartestStore:GetAsync("list")
		end)
		if ok and typeof(list) == "table" then
			for _, e in ipairs(list) do
				if smartestStatues < 12 and typeof(e) == "table" and e.userId then
					smartestStatues += 1
					ProjectService.addStatue(e.userId, tostring(e.name), "👑", "World's Smartest " .. tostring(e.title or "Person"))
				end
			end
		end
	end)
	local _ = moonParts
end

return SpaceService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000019"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- WorldService: builds the TOWN with code.
--   Center: Town Plaza (spawn, the two doors, fountain, Perfectly Average guy)
--   West (Lose side): Brainrot Mall, Microwave Diner, Wall Alley, Supermarket, houses
--   East (Gain side): School, University, Jack B Cinema, Beethoven's Café, Hospital,
--                     Office Tower, Job Center, Courthouse, Science Lab, Park
-- Every decorative part is tagged "Styled" so each player's screen restyles it to
-- match their own brain (genius, average, cash grab, nonsense).

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Content = require(ReplicatedStorage.Shared.Content)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local FriendService = require(script.Parent.FriendService)
local Props = require(script.Parent.Props)
local Rooms = require(script.Parent.Rooms)

local WorldService = {}

local mapFolder = Instance.new("Folder")
mapFolder.Name = "Town"
mapFolder.Parent = workspace

WorldService.Spots = { lobby = Vector3.new(0, 3, 30) }
WorldService.Places = {} -- taxi list: { key, name, path }
WorldService.Workplaces = {} -- [placeKey] = Vector3
WorldService.Zones = {}
WorldService.onStation = nil
WorldService.onCashGrab = nil
WorldService.onAverageGuy = nil
WorldService.onWork = nil

---------------------------------------------------------------------
-- Building helpers
---------------------------------------------------------------------
-- The whole town is designed at full size, then shrunk horizontally by S
-- so it's compact and quick to walk around. Heights are not shrunk.
local S = 0.55
WorldService.Scale = S
local function sp(v: Vector3): Vector3
	return Vector3.new(v.X * S, v.Y, v.Z * S)
end
local function scf(cf: CFrame): CFrame
	return CFrame.new(sp(cf.Position)) * cf.Rotation
end
WorldService.sp = sp

local SKIP = { Parent = true, ClassName = true, NoScale = true, NoScaleSize = true }
local function part(props, role: string?)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if not SKIP[k] then
			p[k] = v
		end
	end
	if not props.NoScale then
		p.CFrame = scf(p.CFrame)
		if not props.NoScaleSize then
			if p.Shape == Enum.PartType.Cylinder then
				p.Size = Vector3.new(p.Size.X, p.Size.Y * S, p.Size.Z * S)
			elseif p.Shape ~= Enum.PartType.Ball then
				p.Size = Vector3.new(p.Size.X * S, p.Size.Y, p.Size.Z * S)
			end
		end
	end
	if role then
		p:SetAttribute("Role", role)
		CollectionService:AddTag(p, "Styled")
	end
	p.Parent = props.Parent or mapFolder
	return p
end

local function tagSign(label: TextLabel, text: string)
	label.Text = text
	label:SetAttribute("BaseText", text)
	CollectionService:AddTag(label, "Sign")
end

-- Billboard sign (sized in studs so it shrinks with distance)
local function sign(adornee: BasePart, text: string, offsetY: number, width: number?, height: number?)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new((width or 260) / 20, 0, (height or 70) / 20, 0)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Name = "SignText"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	tagSign(label, text)
	return label
end

-- Painted sign on a part's front face
local function surfaceSign(board: BasePart, text: string)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0.3
	sg.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = label
	tagSign(label, text)
	return label
end

local function prompt(parentPart: BasePart, actionText: string, objectText: string, distance: number?)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText
	pp.HoldDuration = 0
	pp.MaxActivationDistance = distance or 12
	pp.RequiresLineOfSight = false
	pp.Parent = parentPart
	return pp
end

-- A building with walls, a door gap facing local -Z, windows, roof and a painted sign.
-- Returns the building CFrame (origin at ground center, front = -Z) and size.
local function building(o)
	local cf = CFrame.new(o.center) * CFrame.Angles(0, o.yaw or 0, 0)
	local w, h, d = o.size.X, o.size.Y, o.size.Z
	local t = 1.2
	local wall = o.wall or Color3.fromRGB(220, 210, 190)
	local model = Instance.new("Model")
	model.Name = o.name
	model.Parent = mapFolder
	local function p(localCf, size, color, role, extra)
		local props = { CFrame = cf * localCf, Size = size, Color = color, Parent = model }
		for k, v in pairs(extra or {}) do
			props[k] = v
		end
		return part(props, role)
	end
	local doorW, doorH = o.door or 16, 13
	-- floor + walls
	local wm = { Material = o.wallMaterial or Enum.Material.Plaster }
	p(CFrame.new(0, 0.25, 0), Vector3.new(w, 0.5, d), o.floor or Color3.fromRGB(200, 195, 185), "floor", { Material = o.floorMaterial or Enum.Material.CeramicTiles })
	p(CFrame.new(0, h / 2, d / 2 - t / 2), Vector3.new(w, h, t), wall, "wall", wm)
	p(CFrame.new(-w / 2 + t / 2, h / 2, 0), Vector3.new(t, h, d), wall, "wall", wm)
	p(CFrame.new(w / 2 - t / 2, h / 2, 0), Vector3.new(t, h, d), wall, "wall", wm)
	local side = (w - doorW) / 2
	p(CFrame.new(-(doorW / 2 + side / 2), h / 2, -d / 2 + t / 2), Vector3.new(side, h, t), wall, "wall", wm)
	p(CFrame.new(doorW / 2 + side / 2, h / 2, -d / 2 + t / 2), Vector3.new(side, h, t), wall, "wall", wm)
	p(CFrame.new(0, doorH + (h - doorH) / 2, -d / 2 + t / 2), Vector3.new(doorW, h - doorH, t), wall, "wall", wm)
	-- base trim along the bottom of the front
	p(CFrame.new(0, 0.9, -d / 2 - 0.1), Vector3.new(w + 0.4, 1.8, 0.4), Color3.fromRGB(110, 105, 100), "trim", { Material = Enum.Material.Concrete })
	-- windows (glass strips, outside)
	local glass = { Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false }
	local floors = math.max(1, math.floor(h / 14))
	for f = 1, floors do
		local y = (f - 1) * 14 + 8
		if y < h - 3 then
			p(CFrame.new(-(doorW / 2 + side / 2), y, -d / 2 - 0.05), Vector3.new(side * 0.75, 4, 0.2), Color3.fromRGB(150, 200, 230), nil, glass)
			p(CFrame.new(doorW / 2 + side / 2, y, -d / 2 - 0.05), Vector3.new(side * 0.75, 4, 0.2), Color3.fromRGB(150, 200, 230), nil, glass)
			p(CFrame.new(-w / 2 - 0.05, y, 0), Vector3.new(0.2, 4, d * 0.7), Color3.fromRGB(150, 200, 230), nil, glass)
			p(CFrame.new(w / 2 + 0.05, y, 0), Vector3.new(0.2, 4, d * 0.7), Color3.fromRGB(150, 200, 230), nil, glass)
		end
	end
	-- roof with a little trim
	p(CFrame.new(0, h + 0.6, 0), Vector3.new(w + 3, 1.2, d + 3), o.roof or Color3.fromRGB(90, 80, 75), "trim", { Material = Enum.Material.RoofShingles })
	-- roof edge / parapet
	p(CFrame.new(0, h + 1.6, -d / 2 - 1.2), Vector3.new(w + 3, 1, 0.6), Color3.fromRGB(235, 235, 230), "trim", { Material = Enum.Material.Concrete })
	-- awning + painted sign above the door
	p(CFrame.new(0, doorH + 0.4, -d / 2 - 2), Vector3.new(doorW + 6, 0.6, 4), o.accent or Color3.fromRGB(200, 60, 60), "accent", { Material = Enum.Material.Fabric })
	-- glass doors (1.5: buildings with no use get a solid, locked door instead)
	if o.closed then
		local shut = p(CFrame.new(0, doorH / 2, -d / 2 + 0.6), Vector3.new(doorW - 1, doorH - 0.5, 0.6), Color3.fromRGB(120, 80, 55), "trim", { Material = Enum.Material.WoodPlanks })
		shut.Name = "ClosedDoor"
		sign(shut, Content.Rooms.Closed, 2, 200, 30)
	else
		p(CFrame.new(0, doorH / 2, -d / 2 + 0.6), Vector3.new(doorW - 1, doorH - 0.5, 0.2), Color3.fromRGB(170, 210, 230), nil, { Material = Enum.Material.Glass, Transparency = 0.6, CanCollide = false })
	end
	local boardH = math.max(4, math.min(8, h - doorH - 1.5))
	local board = p(CFrame.new(0, doorH + 1.2 + boardH / 2, -d / 2 - 0.4), Vector3.new(math.min(w - 6, 46), boardH, 0.5), o.signColor or Color3.fromRGB(40, 40, 60), "accent")
	surfaceSign(board, o.sign or o.name)
	-- interior light
	local lamp = p(CFrame.new(0, h - 0.6, 0), Vector3.new(4, 0.4, 4), Color3.fromRGB(255, 250, 230), nil, { Material = Enum.Material.Neon })
	local light = Instance.new("PointLight")
	light.Range = math.min(60, math.max(w, d))
	light.Brightness = 1.2
	light.Parent = lamp
	return cf, o.size, model
end

local function addPlace(key: string, name: string, cf: CFrame, size: Vector3, path: string?)
	local spot = (cf * CFrame.new(0, 3, -size.Z / 2 - 10)).Position
	WorldService.Spots[key] = spot
	table.insert(WorldService.Places, { key = key, name = name, path = path })
	-- 1.5: furniture, people and things to do inside (only buildings that have a use)
	Rooms.furnish(key, scf(cf), Vector3.new(size.X * S / 2, size.Y, size.Z * S / 2), key)
end
-- 1.5 exit doors: step outside the front of the building
Rooms.onLeave = function(player, key)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		Rooms.standUp(hum)
	end
	WorldService.teleport(player, key)
end
Rooms.onJobs = function(player)
	if WorldService.onStation then
		WorldService.onStation(player, "jobs", "Gain")
	end
end

-- A kiosk/counter station inside a building, facing the building's front (-Z)
local STATION_PROPS = {
	clickbait = function(cf)
		return Props.newsstand(cf)
	end,
	steal = function(cf)
		Props.arcade(cf * CFrame.new(-2.2, 0, 0), "STEAL A ???")
		return Props.arcade(cf * CFrame.new(2.2, 0, 0), "STEAL A ROCK")
	end,
	comments = function(cf)
		return Props.desk(cf, true)
	end,
	scroller = function(cf)
		return Props.phoneTable(cf)
	end,
	shop = function(cf)
		return Props.shopCounter(cf)
	end,
	library = function(cf)
		Props.bookshelf(cf * CFrame.new(-4, 0, 3), 6)
		Props.bookshelf(cf * CFrame.new(4, 0, 3), 6)
		return Props.desk(cf * CFrame.new(0, 0, -1), false)
	end,
	theater = function(cf)
		return Props.ticketBooth(cf)
	end,
	gate = function(cf)
		return Props.examDesk(cf)
	end,
	jobs = function(cf)
		return Props.bulletinBoard(cf)
	end,
	coffee = function(cf)
		return Props.cafeCounter(cf)
	end,
	nap = function(cf)
		return Props.bench(cf)
	end,
	pigeons = function(cf)
		return Props.birdFeeder(cf)
	end,
	lab = function(cf)
		return Props.labBench(cf)
	end,
}

local function station(key: string, path: string, title: string, desc: string, cf: CFrame, color: Color3)
	local real = scf(cf)
	local builder = STATION_PROPS[key]
	if builder then
		builder(real)
	end
	-- invisible spot the prompt sits on, in front of the prop
	local counter = part({ Name = "Station_" .. key, CFrame = real * CFrame.new(0, 3, -2.5), Size = Vector3.new(4, 4, 1), Transparency = 1, CanCollide = false, NoScale = true })
	local board = sign(counter, title, 6.5, 300, 46)
	board.TextColor3 = Color3.fromRGB(255, 240, 160)
	sign(counter, desc, 4.6, 260, 28)
	local _ = color
	local pp = prompt(counter, "Open", title, 12)
	pp.Triggered:Connect(function(player)
		if WorldService.onStation then
			WorldService.onStation(player, key, path)
		end
	end)
	return counter
end

-- Where a job is done
local WORK_PROPS = {
	supermarket = function(cf)
		return Props.shopCounter(cf)
	end,
	hospital = function(cf)
		Props.hospitalBed(cf * CFrame.new(7, 0, 2))
		return Props.desk(cf, true)
	end,
	lab = function(cf)
		return Props.labBench(cf)
	end,
	street = function(cf)
		return Props.cleaningCart(cf)
	end,
}

local function workplace(placeKey: string, label: string, cf: CFrame)
	local real = scf(cf)
	local builder = WORK_PROPS[placeKey]
	if builder then
		builder(real)
	else
		Props.desk(real, true)
	end
	local desk = part({ Name = "Work_" .. placeKey, CFrame = real * CFrame.new(0, 3, -2.5), Size = Vector3.new(4, 4, 1), Transparency = 1, CanCollide = false, NoScale = true })
	sign(desk, "💼 " .. label, 5, 220, 34)
	WorldService.Workplaces[placeKey] = desk.Position
	prompt(desk, "Work", label, 12).Triggered:Connect(function(player)
		if WorldService.onWork then
			WorldService.onWork(player, placeKey)
		end
	end)
	return desk
end

local function tree(pos: Vector3, scale: number?)
	local s = scale or 1
	pos = sp(pos)
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, CFrame = CFrame.new(pos + Vector3.new(0, 5 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)), Size = Vector3.new(10, 1.8, 1.8) * s, Color = Color3.fromRGB(105, 75, 50), Material = Enum.Material.Wood, NoScale = true }, "nature")
	local greens = { Color3.fromRGB(60, 130, 60), Color3.fromRGB(75, 145, 65), Color3.fromRGB(55, 120, 55) }
	for i, off in ipairs({ Vector3.new(0, 11, 0), Vector3.new(2.5, 9.5, 1.5), Vector3.new(-2.2, 9.8, -1.6), Vector3.new(0.5, 13, -0.5) }) do
		local size = (i == 1 and 9 or 6.5) * s
		part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = pos + off * s, Color = greens[(i % #greens) + 1], Material = Enum.Material.LeafyGrass, NoScale = true }, "nature")
	end
end

local function streetLight(pos: Vector3)
	part({ Name = "LampPole", Size = Vector3.new(0.6, 14, 0.6), Position = pos + Vector3.new(0, 7, 0), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal, NoScaleSize = true }, "trim")
	part({ Name = "LampArm", Size = Vector3.new(0.3, 0.3, 2.4), Position = pos + Vector3.new(0, 13.8, -0.9), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal, NoScaleSize = true }, "trim")
	local head = part({ Name = "LampHead", Size = Vector3.new(1.4, 0.5, 1.4), Position = pos + Vector3.new(0, 13.6, -1.8), Color = Color3.fromRGB(255, 240, 200), Material = Enum.Material.Neon, NoScaleSize = true })
	local l = Instance.new("PointLight")
	l.Range = 26
	l.Brightness = 0.8
	l.Color = Color3.fromRGB(255, 230, 180)
	l.Parent = head
end

local function car(cf: CFrame)
	Props.car(scf(cf))
end

local function bench(cf: CFrame)
	Props.bench(scf(cf))
end

local function house(center: Vector3, yaw: number)
	local colors = { Color3.fromRGB(240, 220, 190), Color3.fromRGB(200, 225, 240), Color3.fromRGB(240, 200, 200), Color3.fromRGB(210, 235, 200) }
	building({
		name = "House",
		center = center,
		yaw = yaw,
		size = Vector3.new(30, 16, 26),
		wall = colors[math.random(1, #colors)],
		wallMaterial = math.random() < 0.5 and Enum.Material.Brick or Enum.Material.Plaster,
		floorMaterial = Enum.Material.WoodPlanks,
		roof = Color3.fromRGB(150, 70, 60),
		accent = Color3.fromRGB(120, 90, 70),
		door = 8,
		sign = "🏠",
		closed = true, -- 1.5: nothing to do in houses, so they stay closed
	})
end

---------------------------------------------------------------------
-- Ground and roads
---------------------------------------------------------------------
local function buildGround()
	local terrain = workspace.Terrain
	local ok = pcall(function()
		terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(940 * S + 40, 8, 940 * S + 40), Enum.Material.Grass)
		terrain:FillBlock(CFrame.new(0, -9, 0), Vector3.new(940 * S + 40, 4, 940 * S + 40), Enum.Material.Rock)
		if not terrain:FindFirstChildOfClass("Clouds") then
			local clouds = Instance.new("Clouds")
			clouds.Cover = 0.55
			clouds.Density = 0.6
			clouds.Parent = terrain
		end
	end)
	if not ok then
		part({ Name = "Grass", Size = Vector3.new(920, 2, 920), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(90, 170, 80), Material = Enum.Material.Grass }, "floor")
	end
	local asphalt = Color3.fromRGB(55, 55, 60)
	local function road(center: Vector3, length: number, alongX: boolean)
		local size = alongX and Vector3.new(length, 0.2, 28) or Vector3.new(28, 0.2, length)
		part({ Name = "Road", Size = size, Position = center + Vector3.new(0, 0.1, 0), Color = asphalt, Material = Enum.Material.Asphalt }, "trim")
		-- sidewalks
		local off = 17
		for _, sgn in ipairs({ -1, 1 }) do
			local sw = alongX and Vector3.new(length, 0.5, 6) or Vector3.new(6, 0.5, length)
			local pos = alongX and center + Vector3.new(0, 0.25, sgn * off) or center + Vector3.new(sgn * off, 0.25, 0)
			part({ Name = "Sidewalk", Size = sw, Position = pos, Color = Color3.fromRGB(190, 190, 185), Material = Enum.Material.Concrete }, "trim")
		end
		-- dashed center line
		local n = math.floor(length / 20)
		for i = 0, n - 1 do
			local offAlong = -length / 2 + 10 + i * 20
			local pos = alongX and center + Vector3.new(offAlong, 0.25, 0) or center + Vector3.new(0, 0.25, offAlong)
			local dash = alongX and Vector3.new(8, 0.1, 0.6) or Vector3.new(0.6, 0.1, 8)
			part({ Name = "Line", Size = dash, Position = pos, Color = Color3.fromRGB(240, 210, 60), CanCollide = false })
		end
		-- street lights every 60 studs
		for i = 0, math.floor(length / 60) do
			local a = -length / 2 + i * 60
			local pos = alongX and center + Vector3.new(a, 0, 21) or center + Vector3.new(21, 0, a)
			streetLight(pos)
		end
	end
	-- main avenue (west-east) and main street (north-south), split around the plaza
	road(Vector3.new(-237, 0, 0), 346, true)
	road(Vector3.new(237, 0, 0), 346, true)
	road(Vector3.new(0, 0, -237), 346, false)
	road(Vector3.new(0, 0, 237), 346, false)
	-- ring roads
	road(Vector3.new(-200, 0, -200), 400, false)
	road(Vector3.new(200, 0, -200), 400, false)
	road(Vector3.new(-200, 0, 200), 400, false)
	road(Vector3.new(200, 0, 200), 400, false)
	-- parked cars
	for i = 1, 14 do
		local x = math.random(-380, 380)
		if math.abs(x) > 80 then
			car(CFrame.new(x, 0, 9 * (i % 2 == 0 and 1 or -1)) * CFrame.Angles(0, math.rad(90), 0))
		end
	end
	for i = 1, 10 do
		local z = math.random(-380, 380)
		if math.abs(z) > 80 then
			car(CFrame.new(9 * (i % 2 == 0 and 1 or -1), 0, z))
		end
	end
end

---------------------------------------------------------------------
-- Town Plaza (lobby)
---------------------------------------------------------------------
local doorSigns = {}

local function buildDoor(path: string, x: number, color: Color3, title: string)
	part({ Name = path .. "PillarL", Size = Vector3.new(3, 24, 3), Position = Vector3.new(x, 12, -15), Color = color }, "accent")
	part({ Name = path .. "PillarR", Size = Vector3.new(3, 24, 3), Position = Vector3.new(x, 12, 15), Color = color }, "accent")
	local beam = part({ Name = path .. "Beam", Size = Vector3.new(4, 5, 33), Position = Vector3.new(x, 26, 0), Color = color }, "accent")
	local portal = part({
		Name = path .. "Portal",
		Size = Vector3.new(1, 22, 27),
		Position = Vector3.new(x, 11, 0),
		Color = color,
		Transparency = 0.2,
		CanCollide = false,
		Material = Enum.Material.ForceField,
	})
	doorSigns[path] = sign(beam, title, 5.5, 460, 80)
	local pp = prompt(portal, "Enter", title, 20)
	pp.Triggered:Connect(function(player)
		WorldService.enterDoor(player, path)
	end)
end

local function buildPlaza()
	part({ Name = "Plaza", Size = Vector3.new(146, 0.6, 146), Position = Vector3.new(0, 0.3, 0), Color = Color3.fromRGB(205, 200, 190), Material = Enum.Material.Cobblestone }, "floor")
	-- fountain
	part({ Name = "FountainBase", Shape = Enum.PartType.Cylinder, CFrame = CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Size = Vector3.new(2, 26, 26), Color = Color3.fromRGB(180, 180, 175), Material = Enum.Material.Marble }, "trim")
	part({ Name = "FountainWater", Shape = Enum.PartType.Cylinder, CFrame = CFrame.new(0, 2.3, 0) * CFrame.Angles(0, 0, math.rad(90)), Size = Vector3.new(0.4, 23, 23), Color = Color3.fromRGB(80, 170, 230), Material = Enum.Material.Glass, Transparency = 0.2 })
	local statue = part({ Name = "BrainStatue", Shape = Enum.PartType.Ball, Size = Vector3.new(7, 7, 7), Position = Vector3.new(0, 7, 0), Color = Color3.fromRGB(255, 150, 190) }, "accent")
	sign(statue, "🧠 BRAINVILLE", 6, 300, 50)
	for _, x in ipairs({ -55, 55 }) do
		for _, z in ipairs({ -55, 55 }) do
			tree(Vector3.new(x, 0.6, z), 0.9)
		end
	end
	bench(CFrame.new(-25, 0.6, 40))
	bench(CFrame.new(25, 0.6, 40))

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = sp(Vector3.new(0, 0.6, 30))
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = Enum.Material.Marble
	spawn.Color = Color3.fromRGB(230, 230, 235)
	spawn.Parent = mapFolder

	-- The two doors are on the SCREEN now (Hud door picker), not in the world.
	local _ = buildDoor

	local welcome = part({ Name = "WelcomeSign", Size = Vector3.new(60, 10, 1), Position = Vector3.new(0, 14, -60), Color = Color3.fromRGB(35, 30, 60) }, "accent")
	surfaceSign(welcome, "Are you smart enough to get smarter, or dumb enough to get dumber?")
	part({ Name = "WelcomePostL", Size = Vector3.new(1, 14, 1), Position = Vector3.new(-28, 7, -60), Color = Color3.fromRGB(60, 60, 60) }, "trim")
	part({ Name = "WelcomePostR", Size = Vector3.new(1, 14, 1), Position = Vector3.new(28, 7, -60), Color = Color3.fromRGB(60, 60, 60) }, "trim")

	-- Perfectly Average guy
	local guy
	local model = FriendService.npc("PerfectlyAverageGuy")
	if model then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		model:PivotTo(CFrame.new(sp(Vector3.new(30, 3.8, -35))) * CFrame.Angles(0, math.pi, 0))
		model.Parent = mapFolder
		guy = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	end
	if not guy then
		guy = part({ Name = "PerfectlyAverageGuy", Size = Vector3.new(2, 5, 1.5), Position = Vector3.new(30, 3.1, -35), Color = Color3.fromRGB(150, 150, 150) }, "accent")
	end
	sign(guy, "Perfectly Average Guy", 4, 220, 30)
	prompt(guy, "Talk", "Perfectly Average Guy").Triggered:Connect(function(player)
		if WorldService.onAverageGuy then
			WorldService.onAverageGuy(player)
		end
	end)

	-- Cash-grab BUY NOW stands on the east side (Gain path joke)
	for i, btn in ipairs(Content.CashGrabButtons) do
		local base = CFrame.new(sp(Vector3.new(85 + i * 22, 0.6, 30)))
		local colors = { Color3.fromRGB(230, 40, 120), Color3.fromRGB(30, 160, 230), Color3.fromRGB(250, 170, 20) }
		local machine = Props.vending(base, "BUY NOW!!", colors[i])
		for _, d in ipairs(machine:GetDescendants()) do
			if d:IsA("BasePart") then
				CollectionService:AddTag(d, "CashGrabOnly")
			end
		end
		local stand = part({ Name = "CashGrab_" .. btn.key, CFrame = base * CFrame.new(0, 3, -2.5), Size = Vector3.new(4, 4, 1), Transparency = 1, CanCollide = false, NoScale = true })
		CollectionService:AddTag(stand, "CashGrabOnly")
		sign(stand, btn.label, 6, 260, 50)
		local disclaimer = sign(stand, "(This button does nothing.)", 1.5, 200, 24)
		CollectionService:AddTag(disclaimer, "Disclaimer")
		prompt(stand, "BUY NOW", btn.label).Triggered:Connect(function(player)
			if WorldService.onCashGrab then
				WorldService.onCashGrab(player, btn)
			end
		end)
	end
	table.insert(WorldService.Places, 1, { key = "lobby", name = "🏙 Town Plaza" })
end

---------------------------------------------------------------------
-- West: the Lose side
---------------------------------------------------------------------
local FACE_SOUTH = math.pi -- front faces +Z (for buildings north of the avenue)
local FACE_NORTH = 0 -- front faces -Z (for buildings south of the avenue)

local function buildLoseSide()
	-- Brainrot Mall
	local cf, size = building({
		name = "BrainrotMall",
		center = Vector3.new(-100, 0.6, -100),
		yaw = FACE_SOUTH,
		size = Vector3.new(150, 26, 120),
		wall = Color3.fromRGB(230, 205, 220),
		wallMaterial = Enum.Material.Concrete,
		roof = Color3.fromRGB(120, 40, 120),
		accent = Color3.fromRGB(255, 220, 0),
		floor = Color3.fromRGB(240, 230, 250),
		signColor = Color3.fromRGB(150, 0, 120),
		door = 22,
		sign = "🛍 BRAINROT MALL",
	})
	addPlace("lose", "🛍 Brainrot Mall", cf, size, "Lose")
	station("clickbait", "Lose", "📰 Clickbait Newsstand", "Click the bait. Don't read!", cf * CFrame.new(-48, 0.5, -20), Color3.fromRGB(255, 80, 80))
	station("steal", "Lose", "🎮 Steal A Arcade", "Pick the dumbest game", cf * CFrame.new(-16, 0.5, -20), Color3.fromRGB(255, 200, 40))
	station("comments", "Lose", "💬 Internet Café", "Post the dumbest comment", cf * CFrame.new(16, 0.5, -20), Color3.fromRGB(80, 200, 255))
	station("scroller", "Lose", "📱 Phone Store", "Swipe. Swipe. Swipe.", cf * CFrame.new(48, 0.5, -20), Color3.fromRGB(140, 80, 255))
	station("shop", "Lose", "🛒 Cash Grab Store", "Joke passes (always optional)", cf * CFrame.new(0, 0.5, 30), Color3.fromRGB(60, 220, 120))

	-- Microwave Diner: stand inside to lose cells slowly
	local dcf, dsize = building({
		name = "MicrowaveDiner",
		center = Vector3.new(-300, 0.6, -100),
		yaw = FACE_SOUTH,
		size = Vector3.new(80, 20, 64),
		wall = Color3.fromRGB(240, 238, 232),
		wallMaterial = Enum.Material.Plaster,
		roof = Color3.fromRGB(200, 40, 40),
		accent = Color3.fromRGB(200, 40, 40),
		sign = "🍿 MICROWAVE DINER",
	})
	addPlace("diner", "🍿 Microwave Diner", dcf, dsize, "Lose")
	local mwModel, mwLabel = Props.microwave(scf(dcf * CFrame.new(0, 0.5, 18)), 2.2)
	WorldService.microwaveLabel = mwLabel
	local microwave = part({ Name = "MicrowaveSpot", CFrame = scf(dcf * CFrame.new(0, 0.5, 18)) * CFrame.new(0, 6, 0), Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, NoScale = true })
	sign(microwave, "🍿 Stand here and watch it spin", 6, 300, 34)
	local _ = mwModel
	-- diner tables
	for i = -1, 1 do
		Props.desk(scf(dcf * CFrame.new(i * 22, 0.5, -6)), false)
	end
	WorldService.Zones.microwave = { cframe = dcf * CFrame.new(0, 0.5, 0), size = Vector3.new(76, 18, 60) }

	-- Wall Alley: stare at the wall
	local wallPart = part({ Name = "StaringWall", Size = Vector3.new(60, 24, 3), Position = Vector3.new(-300, 12, 150), Color = Color3.fromRGB(150, 150, 150), Material = Enum.Material.Brick }, "wall")
	sign(wallPart, "🧱 Staring Contest With a Wall", 14, 340, 40)
	WorldService.Zones.wall = { cframe = CFrame.new(-300, 1, 128), size = Vector3.new(60, 14, 40) }
	WorldService.Spots.wall = Vector3.new(-300, 3, 110)
	table.insert(WorldService.Places, { key = "wall", name = "🧱 Wall Alley", path = "Lose" })
	house(Vector3.new(-340, 0.6, 70), FACE_NORTH)
	house(Vector3.new(-260, 0.6, 70), FACE_NORTH)

	-- Supermarket (cashier job)
	local smcf, ssize = building({
		name = "Supermarket",
		center = Vector3.new(-100, 0.6, 100),
		yaw = FACE_NORTH,
		size = Vector3.new(120, 22, 90),
		wall = Color3.fromRGB(235, 232, 222),
		wallMaterial = Enum.Material.Concrete,
		roof = Color3.fromRGB(40, 140, 70),
		accent = Color3.fromRGB(40, 140, 70),
		signColor = Color3.fromRGB(30, 110, 50),
		door = 20,
		sign = "🛒 SUPERMARKET",
	})
	addPlace("supermarket", "🛒 Supermarket", smcf, ssize, "Gain")
	workplace("supermarket", "Cashier Register", smcf * CFrame.new(0, 0.5, -20))
	for i = -2, 2 do
		Props.shopCounter(scf(smcf * CFrame.new(i * 22, 0.5, 18)))
	end

	-- houses
	for _, c in ipairs({ Vector3.new(-100, 0.6, -300), Vector3.new(-300, 0.6, -300) }) do
		house(c + Vector3.new(-40, 0, 0), FACE_SOUTH)
		house(c + Vector3.new(40, 0, 0), FACE_SOUTH)
		tree(c + Vector3.new(0, 0.6, 30))
	end
	for _, c in ipairs({ Vector3.new(-100, 0.6, 300), Vector3.new(-300, 0.6, 300) }) do
		house(c + Vector3.new(-40, 0, 0), FACE_NORTH)
		house(c + Vector3.new(40, 0, 0), FACE_NORTH)
		tree(c + Vector3.new(0, 0.6, -30))
	end
end

