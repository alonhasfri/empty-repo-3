<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000000000000000000000000000029"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Badges</string><ProtectedString name="Source"><![CDATA[-- Badges: the ONE combined list of every badge in the game.
-- Create each badge on create.roblox.com (your experience -> Engagement -> Badges)
-- and paste its ID into "id". Badges with id = 0 are tracked in save data only.
-- "version" = which update the badge arrives in.

local Badges = {
	-- Lose path
	SmoothBrain = { id = 0, version = "1.0", secret = false, name = "Certified Smooth Brain", desc = "Reach 0 brain cells." },
	ReadTOS = { id = 0, version = "1.0", secret = true, name = "Read the Terms of Service", desc = "Actually read the whole Terms of Service." },
	ClickedEverything = { id = 0, version = "1.0", secret = true, name = "Clicked Every Clickbait", desc = "Click 25 clickbait headlines." },
	Ratiod = { id = 0, version = "1.0", secret = false, name = "Ratio'd", desc = "Go viral 5 times with dumb comments." },
	WhereAmI = { id = 0, version = "1.0", secret = true, name = "Where am I?", desc = "Become a microbe (secret animal)." },
	PerfectlyAverage = { id = 0, version = "1.0", secret = true, name = "Perfectly Average", desc = "Talk to the Perfectly Average guy." },
	Speedrun = { id = 0, version = "1.0", secret = false, name = "Speedrun Smooth Brain", desc = "Reach 0 brain cells in under 60 minutes." },

	-- Gain path
	Gate1 = { id = 0, version = "1.0", secret = false, name = "The Average Gate", desc = "Pass the first Skill Gate." },
	Gate2 = { id = 0, version = "1.0", secret = false, name = "The Coder's Gate", desc = "Pass the second Skill Gate." },
	Gate3 = { id = 0, version = "1.0", secret = false, name = "The Gifted Gate", desc = "Pass the third Skill Gate." },
	Gate4 = { id = 0, version = "1.0", secret = false, name = "The Genius Gate", desc = "Pass the fourth Skill Gate." },
	FirstJob = { id = 0, version = "1.0", secret = false, name = "Employed", desc = "Get your first job." },
	Eureka = { id = 0, version = "1.0", secret = false, name = "Eureka!", desc = "Unlock your first secret invention." },
	AllInventions = { id = 0, version = "1.0", secret = true, name = "Mad Scientist", desc = "Unlock every secret invention." },
	Coffee60 ={ id = 0, version = "1.0", secret = true, name = "Beethoven Would Be Proud", desc = "Count exactly 60 coffee beans." },

	-- Comeback (1.1, basic version already in 1.0)
	CompleteMakeover = { id = 0, version = "1.1", secret = true, name = "Complete Makeover", desc = "Gain back your brain cells from zero." },

	-- Later updates (listed so everything is in one place)
	Inventor = { id = 0, version = "1.3", secret = false, name = "Inventor", desc = "Finish a Major Project." },
	FirstInvented = { id = 0, version = "1.3", secret = false, name = "First Invented", desc = "Be the first player ever to invent something." },
	RefusedPrize = { id = 0, version = "1.3", secret = true, name = "Perelman", desc = "Refuse your Noble Prize." },
	MaybeNextTime = { id = 0, version = "1.3", secret = true, name = "Maybe Next Time", desc = "Fail the Time Machine 10 times." },
	WorldsSmartest = { id = 0, version = "1.4", secret = true, name = "World's Smartest", desc = "Reach 200 IQ." },
	TooMuchBrain = { id = 0, version = "1.4", secret = true, name = "Too Much Brain", desc = "Reach 1 trillion brain cells. +1 IQ. Worth it?" },
	LostAndFound = { id = 0, version = "1.4", secret = true, name = "Lost and Found", desc = "Solve the Endless Castle." },
	SmallTalk = { id = 0, version = "1.5", secret = false, name = "Small Talk", desc = "Finish a conversation scene." },
	FooledYou ={ id = 0, version = "event", secret = false, name = "Fooled You", desc = "Find the April Fools rubber chicken." },
}

return Badges
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">Brain</string><ProtectedString name="Source"><![CDATA[-- Brain: shared math for brain cells, IQ, rarity, stages and text decay.
-- Used by both the server and the client.

local Config = require(script.Parent.Config)

local Brain = {}

---------------------------------------------------------------------
-- Numbers
---------------------------------------------------------------------
function Brain.formatNumber(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.floor(math.abs(n) + 0.5)
	local s = string.format("%.0f", n)
	local out = ""
	local count = 0
	for i = #s, 1, -1 do
		out = string.sub(s, i, i) .. out
		count += 1
		if count % 3 == 0 and i > 1 then
			out = "," .. out
		end
	end
	return (negative and "-" or "") .. out
end

---------------------------------------------------------------------
-- IQ (every 8 billion cells = 15 IQ points; overflow above ~200)
---------------------------------------------------------------------
function Brain.iq(cells: number): number
	if cells <= Config.OverflowCells then
		return 100 + 15 * (cells - Config.AverageCells) / Config.CellsPerSD
	end
	local overflowIq = 100 + 15 * (Config.OverflowCells - Config.AverageCells) / Config.CellsPerSD
	-- 1 trillion cells = only about +1 IQ
	local extra = math.log(cells / Config.OverflowCells) / math.log(1e12 / Config.OverflowCells)
	return overflowIq + extra
end

function Brain.cellsForIQ(iq: number): number
	return Config.AverageCells + (iq - 100) / 15 * Config.CellsPerSD
end

-- Chance of being at least this smart, as "1 in X".
local function upperTail(z: number): number
	if z <= 0 then
		return 0.5
	end
	if z > 3 then
		local phi = math.exp(-z * z / 2) / math.sqrt(2 * math.pi)
		return phi / z * (1 - 1 / (z * z) + 3 / (z ^ 4))
	end
	-- Abramowitz and Stegun 7.1.26
	local x = z / math.sqrt(2)
	local t = 1 / (1 + 0.3275911 * x)
	local y = 1
		- (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592)
			* t
			* math.exp(-x * x)
	return 0.5 * (1 - y)
end

function Brain.rarityOneIn(iq: number): number?
	if iq <= 100 then
		return nil
	end
	local p = upperTail((iq - 100) / 15)
	if p <= 0 then
		return nil
	end
	return 1 / p
end

-- IQ text. On the Lose path the display breaks below the human range.
function Brain.iqText(cells: number, path: string?): string
	if path == "Lose" or cells < Config.HumanFloorCells then
		if cells < 1e6 then
			return "IQ: ???"
		elseif cells < 1e9 then
			return "IQ: 🗿"
		elseif cells < 20e9 then
			return "IQ: banana"
		elseif cells < Config.HumanFloorCells then
			return "IQ: -12"
		end
	end
	local iq = Brain.iq(cells)
	if iq >= 200 then
		return string.format("IQ: %.2f", iq)
	end
	return "IQ: " .. tostring(math.floor(iq + 0.5))
end

function Brain.rarityText(cells: number, path: string?): string
	if path == "Lose" and cells < Config.AverageCells then
		return ""
	end
	local iq = Brain.iq(cells)
	if iq >= 200 then
		return "Smarter than any human. Your head is getting big."
	end
	local oneIn = Brain.rarityOneIn(iq)
	if not oneIn or oneIn < 2.5 then
		return ""
	end
	return "Only 1 in " .. Brain.formatNumber(oneIn) .. " people are this smart"
end

---------------------------------------------------------------------
-- Art style (how the world looks) and narrator mood
---------------------------------------------------------------------
function Brain.artTier(cells: number): string
	if cells >= Brain.cellsForIQ(145) then
		return "genius"
	elseif cells >= Brain.cellsForIQ(105) then
		return "smart"
	elseif cells >= Brain.cellsForIQ(95) then
		return "average"
	elseif cells >= Config.HumanFloorCells then
		return "cashgrab"
	end
	return "nonsense"
end

function Brain.narratorMood(cells: number): string
	local tier = Brain.artTier(cells)
	if tier == "genius" or tier == "smart" then
		return "librarian"
	elseif tier == "average" then
		return "host"
	elseif tier == "cashgrab" then
		return "brainrot"
	end
	return "caveman"
end

---------------------------------------------------------------------
-- Animal stages (real neuron counts, roughly)
---------------------------------------------------------------------
Brain.Stages = {
	{ key = "dead", max = 0, name = "Rock", emoji = "🪨", walk = 0, scale = 1 },
	{ key = "microbe", max = 10, name = "Microbe", emoji = "🦠", walk = 10, scale = 0.25, secret = true },
	{ key = "tardigrade", max = 200, name = "Tardigrade", emoji = "🐛", walk = 6, scale = 0.4, secret = true },
	{ key = "worm", max = 302, name = "Worm", emoji = "🪱", walk = 5, scale = 0.45 },
	{ key = "fly", max = 140000, name = "Fruit Fly", emoji = "🪰", walk = 22, scale = 0.5 },
	{ key = "bee", max = 1e6, name = "Honeybee", emoji = "🐝", walk = 20, scale = 0.55 },
	{ key = "mouse", max = 70e6, name = "Mouse", emoji = "🐭", walk = 18, scale = 0.6 },
	{ key = "octopus", max = 500e6, name = "Octopus", emoji = "🐙", walk = 12, scale = 0.85 },
	{ key = "dog", max = 2e9, name = "Dog", emoji = "🐶", walk = 20, scale = 0.8 },
	{ key = "barelyhuman", max = Config.HumanFloorCells, name = "Barely Human", emoji = "🫠", walk = 14, scale = 1 },
	{ key = "human", max = math.huge, name = "Human", emoji = "🧠", walk = 16, scale = 1 },
}

function Brain.stage(cells: number, secretAnimals: boolean?)
	for _, s in ipairs(Brain.Stages) do
		if cells <= s.max and (not s.secret or secretAnimals) then
			return s
		end
	end
	return Brain.Stages[#Brain.Stages]
end

---------------------------------------------------------------------
-- Gain multiplier
---------------------------------------------------------------------
function Brain.gainMultiplier(cells: number): (number, string)
	for _, m in ipairs(Config.GainMultipliers) do
		if cells < m.below then
			return m.mult, m.label
		end
	end
	return 1, ""
end

---------------------------------------------------------------------
-- Text decay for the dumb side
---------------------------------------------------------------------
local EMOJIS = { "🧱", "🥔", "🗿", "🤯", "👀", "🍌", "💀" }

local function hash(s: string): number
	local h = 0
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 1000003
	end
	return h
end

function Brain.decayLevel(cells: number): number
	if cells >= 70e9 then
		return 0
	elseif cells >= Config.HumanFloorCells then
		return 1
	elseif cells >= 1e9 then
		return 2
	end
	return 3
end

function Brain.degradeText(text: string, cells: number): string
	local level = Brain.decayLevel(cells)
	if level == 0 then
		return text
	end
	if level == 3 then
		return EMOJIS[(hash(text) % #EMOJIS) + 1]
	end
	local t = string.lower(text)
	t = string.gsub(t, "[%.,;:]", "")
	t = string.gsub(t, "%f[%a]you%f[%A]", "u")
	t = string.gsub(t, "%f[%a]to%f[%A]", "2")
	t = string.gsub(t, "%f[%a]for%f[%A]", "4")
	t = string.gsub(t, "%f[%a]the%f[%A]", "da")
	t = string.gsub(t, "ing%f[%A]", "in")
	t = string.gsub(t, "welcome", "welcom")
	if level == 2 then
		local words = {}
		for w in string.gmatch(t, "%S+") do
			table.insert(words, w)
			if #words >= 2 then
				break
			end
		end
		return table.concat(words, " ") .. "?"
	end
	return t
end

return Brain
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config: every number, ID and setting for the game lives here.
-- Fill in the "0" IDs after you create them on the Roblox Creator Dashboard.

local Config = {}

Config.GameName = "Lose a Brain Cell / Gain a Brain Cell"
Config.Version = "1.5"

---------------------------------------------------------------------
-- COMMUNITY (GROUP) RANKS -> IN-GAME RANKS
---------------------------------------------------------------------
-- Put the ID of "Cult of the 39" here. Find it in the community page link:
-- roblox.com/communities/1234567/... -> the number is the ID.
Config.GroupId = 0

-- In-game rank levels
Config.Levels = { Player = 0, Tester = 1, Moderator = 2, HeadModerator = 3, Owner = 4 }
Config.RankNames = { [0] = "Player", [1] = "Tester", [2] = "Moderator", [3] = "Head Moderator", [4] = "Owner" }
Config.RankColors = {
	[1] = Color3.fromRGB(120, 200, 255),
	[2] = Color3.fromRGB(120, 255, 140),
	[3] = Color3.fromRGB(255, 170, 60),
	[4] = Color3.fromRGB(255, 80, 80),
}

-- Community rank NUMBER -> in-game level. Checked from the top down.
-- Only rank 255 (the real community owner) becomes Owner.
Config.GroupRankMap = {
	{ minRank = 100, level = 3 }, -- Head Moderator
	{ minRank = 50, level = 2 }, -- Moderator
	{ minRank = 10, level = 1 }, -- Tester
}

-- If true, whoever presses Play in Roblox Studio becomes Owner (only for testing an
-- unpublished file). Keep it false: once the game is published under the community,
-- Studio uses everyone's real community rank (Owner, Head Moderator, ...).
Config.StudioIsOwner = false

-- Extra Owners by Roblox user ID (optional). The community owner (rank 255) is always Owner.
Config.OwnerUserIds = {}

---------------------------------------------------------------------
-- BRAIN NUMBERS (based on real neuroscience)
---------------------------------------------------------------------
Config.AverageCells = 86e9 -- average adult human
Config.CellsPerSD = 8e9 -- every 8 billion cells = 15 IQ points
Config.LoseStartCells = 86e9
Config.GainStartCells = 70e9 -- 80 IQ, slightly below average
Config.HumanFloorCells = 45e9 -- "dumbest man alive"
Config.OverflowCells = 140e9 -- about 200 IQ
Config.ElephantCells = 257e9

-- How fast cells change. These can be changed live by Head Moderators.
Config.Rates = {
	GainRate = 0.002, -- fraction of your cells gained per activity point (Gain path)
	LoseRate = 0.014, -- fraction of your cells lost per activity point (Lose path; lower = harder to lose)
	MinLoss = 1, -- the smallest loss per point (so you can actually reach 0)
}

-- Multipliers shrink as you climb. Applied to each gain, never to your total.
Config.GainMultipliers = {
	{ below = 1e6, mult = 999, label = "🔥🔥 MEGA ULTRA ×999 BRAIN BOOST 🔥🔥" },
	{ below = 1e9, mult = 100, label = "SUPER BOOST ×100!!" },
	{ below = 50e9, mult = 10, label = "Boost ×10" },
	{ below = 86e9, mult = 2, label = "Learning bonus: ×2" },
	{ below = 110e9, mult = 1.1, label = "Retention coefficient: 1.1" },
	{ below = 140e9, mult = 1.01, label = "Marginal cognitive gain factor: 1.01" },
	{ below = math.huge, mult = 999, label = "Overflow ×999 (it doesn't matter anymore)" },
}

---------------------------------------------------------------------
-- SKILL GATES (the PLAYER must be smart)
---------------------------------------------------------------------
Config.Gates = {
	{ id = "gate1", iq = 100, tier = 1, name = "The Average Gate" },
	{ id = "gate2", iq = 115, tier = 2, name = "The Coder's Gate" },
	{ id = "gate3", iq = 130, tier = 3, name = "The Gifted Gate" },
	{ id = "gate4", iq = 145, tier = 4, name = "The Genius Gate" },
}
Config.GateQuestionCount = 3
Config.GateSeconds = 60
Config.GateExtraTimeMultiplier = 1.5 -- accessibility setting
Config.GateFailCooldown = 30
Config.GateHints = 1 -- hints per attempt (Extra Hints pass adds 2)
Config.HintCostFraction = 0.01 -- a hint costs 1% of your cells

---------------------------------------------------------------------
-- LOSE PATH
---------------------------------------------------------------------
Config.ReadingSeconds = 10 -- reading this long = you actually read it
Config.ReadingPopupMin = 25
Config.ReadingPopupMax = 45
Config.TOSChance = 0.05 -- chance a reading popup is the giant Terms of Service
Config.TOSSeconds = 60

Config.Embarrassment = {
	Max = 100,
	HideAt = 50, -- over half -> run and hide behind a bush
	HideSeconds = 10,
	DecayPerSecond = 0.5,
	BreaksBelowCells = 50e6, -- too dumb to care
}

Config.PetBelowCells = 20e9
Config.LeakBelowCells = 20e9
Config.ViralBadgeCount = 5

---------------------------------------------------------------------
-- GAIN PATH
---------------------------------------------------------------------
Config.Stress = { Max = 100, FreezeAt = 100 }
Config.EurekaTasks = 6 -- job tasks needed to fill the idea meter (Eureka cutscene)
Config.WorkRadius = 45 -- how close to your workplace you must be to work
Config.TaxiCooldown = 8
Config.ElectionMinutes = 20 -- an election starts this often (update 1.2)
Config.ComebackMakeoverIQ = 145 -- Comeback players who reach this get Complete Makeover

---------------------------------------------------------------------
-- SAVING
---------------------------------------------------------------------
Config.DataStoreName = "BrainCellData_v1"
Config.AutosaveSeconds = 60

---------------------------------------------------------------------
-- SOUNDS AND MUSIC
-- Upload the sound files on create.roblox.com (Development Items -> Audio),
-- then paste each asset ID number here. 0 = silent.
---------------------------------------------------------------------
Config.Sounds = {
	GameShowJingle = 0,
	LibrarianChime = 0,
	CartoonBoing = 0,
	KazooTune = 0,
	LevelUp = 0,
	SadTrombone = 0,
	AirHorn = 0,
	CavemanBonk = 0,
	BrainCellLost = 0,
	BrainCellGained = 0,
	NotificationPing = 0,
	DeathBoom = 0,
	BadgeSparkle = 0,
	RecordScratch = 0,
	-- 1.4
	Whoosh = 0, -- rocket launch, falling into the void
	TypeTick = 0, -- tutorial typewriter (very short, quiet click)
	ImportantSlam = 0, -- tutorial "IMPORTANT" title slam
}

-- One music track per art style (from the Creator Store audio library).
Config.Music = {
	genius = 0, -- search "lofi" / "piano"
	smart = 0, -- search "calm" / "classical"
	average = 0, -- search "casual" / "happy"
	cashgrab = 0, -- search "hype" / "arcade"
	nonsense = 0, -- search "kazoo" / "silly"
}

---------------------------------------------------------------------
-- GAME PASSES (create them on the Creator Dashboard, paste the IDs)
---------------------------------------------------------------------
Config.GamePasses = {
	GoldenSkip = {
		id = 0,
		price = 75,
		path = "Lose",
		cellsLost = 1e9,
		name = "Golden Skip Button",
		desc = "Your skip button turns gold and goes cha-ching. Cosmetic.",
	},
	BuyBrain = {
		id = 0,
		price = 5,
		path = "Lose",
		cellsLost = 10e9,
		name = "BUY BRAIN 🧠🔥",
		desc = "Gives you a dunce cap. That's it. That's the pass.",
	},
	ExtraLoudDeath = {
		id = 0,
		price = 25,
		path = "Lose",
		cellsLost = 0,
		name = "Extra Loud Death",
		desc = "Even more sounds when you hit 0.",
	},
	VIPLibrary = {
		id = 0,
		price = 199,
		path = "Gain",
		cellsLost = 0,
		name = "VIP Library Card",
		desc = "VIP tag and +10% from the library. Never helps with Skill Gates.",
	},
	ExtraHints = {
		id = 0,
		price = 99,
		path = "Gain",
		cellsLost = 0,
		name = "Extra Hints",
		desc = "+2 hints per Skill Gate attempt. Still limited.",
	},
	-- Update 1.4. Only offered at IQ 160+ while NOBODY has invented Space Travel yet.
	-- Once anyone invents it, every player gets Astronaut free, so the pass disappears.
	AstronautEarly = {
		id = 0,
		price = 100,
		path = "Gain",
		cellsLost = 0,
		name = "Astronaut Early Access",
		desc = "Unlocks the Astronaut job right now, for every run. Heads up: once ANY player invents Space Travel, Astronaut becomes free for everyone.",
	},
}

-- Update 1.4: Space and secrets
Config.Space = {
	AstronautIQ = 160,
	SmartestIQ = 200,
	MoonGravity = 35, -- normal Roblox gravity is 196.2
}
Config.Castle = {
	Steps = 6, -- lefts/rights in a row to reach the brick wall
	BoostMinutes = 30,
	RewardPoints = 40,
}

---------------------------------------------------------------------
-- UPDATE 1.5: REAL PLACES
---------------------------------------------------------------------
Config.Rooms = {
	SpotCooldown = 4, -- seconds between uses of the same room spot (per player)
	PromptDistance = 9, -- how close you must be to use a room spot
	SeatPromptDistance = 6,
	-- brain points for the small things to do in rooms
	Actions = {
		arcade = { path = "Lose", lose = 2 },
		plushie = { path = "Lose", lose = 1.5 },
		cereal = { path = "Lose", lose = 1 },
	},
	BoardPoints = { Lose = 0.5, Gain = 0.3 }, -- writing on a whiteboard
	FridgeOpenAngle = 110, -- degrees
	StandUpDelay = 0.25, -- seconds between standing up from a seat and being moved
}

-- Unstuck button (1.5): takes you outside the building you're in, or to the nearest street.
Config.Unstuck = {
	Cooldown = 10, -- seconds
}

-- Conversation scenes (1.5). For every choice: { meter change, brain points }.
-- Brain points > 0 = gain brain cells, < 0 = lose brain cells (times BrainScale).
-- Endings: good if the meter ends >= GoodAt, bad if <= BadAt, otherwise mid.
-- Ending rewards: coins, gain, lose, path (gain on Gain / lose on Lose), stress, embarrass, idea, confetti.
Config.Conversations = {
	BrainScale = 0.6,
	GoodAt = 65,
	BadAt = 25,
	StartRadius = 14, -- you must be this close to the spot to start
	Cooldown = 3, -- seconds between conversations
	TypeSpeed = 38, -- letters per second
	SmartTypeSpeed = 60, -- smart players (IQ >= SmartIQ) read faster
	SmartIQ = 120,
	CameraTween = 0.55, -- seconds for each camera cut
	PauseAfterLine = 0.5, -- seconds after a line finishes
	OpenDelay = 0.9, -- seconds of the wide shot before the first line
	Scenes = {
		therapist = { meter = 50, allowFrozen = true,
			a = { { 15, 1 }, { -5, -1 }, { -10, 0 } }, b = { { 15, 1 }, { -10, -2 }, { 5, 0 } }, c = { { 20, 1 }, { 10, 0 }, { -10, -2 } },
			good = { stress = -45, embarrass = -30 }, mid = { stress = -15 }, bad = {} },
		doctorG = { meter = 50,
			a = { { 20, 2 }, { -25, -1 }, { -15, -1 } }, b = { { 25, 2 }, { -15, -1 }, { 5, 0 } }, c = { { 20, 1 }, { -20, 0 }, { -5, -1 } },
			good = { coins = 30 }, mid = { coins = 10 }, bad = { stress = 10 } },
		doctorL = { meter = 60,
			a = { { -5, -1 }, { -10, -2 }, { 5, 1 } }, b = { { -10, -2 }, { 10, 1 }, { -5, -1 } }, c = { { -15, -2 }, { 15, 2 }, { -5, -1 } },
			good = {}, mid = {}, bad = { lose = 2 } },
		courtL = { meter = 60,
			a = { { 15, 1 }, { -15, -2 }, { -10, -1 } }, b = { { 15, 1 }, { -15, -2 }, { -5, -1 } }, c = { { 15, 1 }, { -20, -2 }, { -10, -1 } },
			good = {}, mid = {}, bad = { embarrass = 35 } },
		courtG = { meter = 50,
			a = { { 30, 2 }, { -20, -1 }, { -10, -1 } }, b = { { 25, 2 }, { -25, -1 }, { -5, 0 } }, c = { { 25, 2 }, { -10, 0 }, { 5, 0 } },
			good = { coins = 40, gain = 2 }, mid = { coins = 10 }, bad = { stress = 15 } },
		debate = { meter = 50,
			a = { { 20, 2 }, { -10, -2 }, { 5, -1 } }, b = { { 20, 2 }, { -15, -1 }, { -5, -1 } }, c = { { 20, 1 }, { -10, -2 }, { 0, -1 } },
			good = { confetti = true }, mid = {}, bad = { embarrass = 20 } },
		journalistL = { meter = 40,
			a = { { 20, -2 }, { -15, 1 }, { 10, -1 } }, b = { { 15, -2 }, { -10, 2 }, { 5, -1 } }, c = { { 20, -2 }, { -15, 1 }, { 10, -1 } },
			good = { lose = 3 }, mid = { lose = 1 }, bad = {} },
