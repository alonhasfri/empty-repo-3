		yaw = FACE_NORTH,
		size = Vector3.new(120, 40, 100),
		wall = Color3.fromRGB(240, 243, 245),
		wallMaterial = Enum.Material.Plaster,
		roof = Color3.fromRGB(180, 190, 200),
		accent = Color3.fromRGB(220, 40, 40),
		signColor = Color3.fromRGB(200, 30, 30),
		door = 22,
		sign = "🏥 BRAINVILLE HOSPITAL",
	})
	addPlace("hospital", "🏥 Hospital", hcf, hsize, "Gain")
	workplace("hospital", "Doctor's Office", hcf * CFrame.new(0, 0.5, -10))
	for i = -1, 1 do
		Props.hospitalBed(scf(hcf * CFrame.new(-35 + i * 16, 0.5, 30)))
	end

	-- Office Tower + Job Center
	local ocf, osize = building({
		name = "OfficeTower",
		center = Vector3.new(80, 0.6, -300),
		yaw = FACE_SOUTH,
		size = Vector3.new(70, 70, 70),
		wall = Color3.fromRGB(95, 125, 155),
		wallMaterial = Enum.Material.Glass,
		roof = Color3.fromRGB(60, 70, 80),
		accent = Color3.fromRGB(40, 60, 90),
		door = 16,
		sign = "🏢 OFFICE TOWER",
	})
	addPlace("office", "🏢 Office Tower", ocf, osize, "Gain")
	workplace("office", "Office Desk", ocf * CFrame.new(0, 0.5, 0))

	local jcf, jsize = building({
		name = "JobCenter",
		center = Vector3.new(160, 0.6, -300),
		yaw = FACE_SOUTH,
		size = Vector3.new(50, 20, 46),
		wall = Color3.fromRGB(225, 210, 160),
		wallMaterial = Enum.Material.Plaster,
		roof = Color3.fromRGB(70, 110, 70),
		accent = Color3.fromRGB(60, 160, 90),
		door = 12,
		sign = "💼 JOB CENTER",
	})
	addPlace("jobcenter", "💼 Job Center", jcf, jsize, "Gain")
	station("jobs", "Gain", "💼 Job Board", "Get a job", jcf * CFrame.new(0, 0.5, 6), Color3.fromRGB(60, 160, 90))

	-- Courthouse: lawyer job
	local tcf, tsize = building({
		name = "Courthouse",
		center = Vector3.new(300, 0.6, -300),
		yaw = FACE_SOUTH,
		size = Vector3.new(110, 34, 90),
		wall = Color3.fromRGB(230, 225, 210),
		wallMaterial = Enum.Material.Marble,
		roof = Color3.fromRGB(110, 100, 90),
		accent = Color3.fromRGB(90, 70, 50),
		door = 20,
		sign = "⚖️ COURTHOUSE",
	})
	addPlace("courthouse", "⚖️ Courthouse", tcf, tsize, "Gain")
	workplace("courthouse", "Lawyer's Desk", tcf * CFrame.new(0, 0.5, 0))
	for i = -3, 3 do
		part({ Name = "Column", CFrame = tcf * CFrame.new(i * 12, 12, -tsize.Z / 2 - 6), Size = Vector3.new(3, 24, 3), Color = Color3.fromRGB(240, 238, 230), Material = Enum.Material.Marble }, "trim")
	end

	-- Science Lab: scientist job
	local lcf, lsize = building({
		name = "ScienceLab",
		center = Vector3.new(300, 0.6, 300),
		yaw = FACE_NORTH,
		size = Vector3.new(110, 30, 90),
		wall = Color3.fromRGB(225, 235, 240),
		wallMaterial = Enum.Material.Concrete,
		roof = Color3.fromRGB(60, 80, 110),
		accent = Color3.fromRGB(60, 200, 220),
		signColor = Color3.fromRGB(20, 90, 120),
		door = 20,
		sign = "🔬 SCIENCE LAB",
	})
	addPlace("lab", "🔬 Science Lab", lcf, lsize, "Gain")
	workplace("lab", "Lab Bench", lcf * CFrame.new(0, 0.5, 0))
	station("lab", "Gain", "🔬 Major Projects", "Invent something for the world", lcf * CFrame.new(-30, 0.5, -10), Color3.fromRGB(40, 170, 200))
	for i = -1, 1 do
		Props.labBench(scf(lcf * CFrame.new(i * 22, 0.5, 30)))
	end

	-- Park: nap bench, pigeons, trees, pond
	local parkCenter = Vector3.new(100, 0.6, 300)
	part({ Name = "ParkPath", Size = Vector3.new(120, 0.3, 10), Position = parkCenter + Vector3.new(0, 0.1, 0), Color = Color3.fromRGB(200, 180, 140), Material = Enum.Material.Sand }, "trim")
	pcall(function()
		workspace.Terrain:FillCylinder(CFrame.new(sp(parkCenter + Vector3.new(30, -1.6, 40))), 3, 20 * S, Enum.Material.Water)
	end)
	for i = 1, 8 do
		tree(parkCenter + Vector3.new(math.random(-70, 70), 0, math.random(-70, 70)), 0.8 + math.random() * 0.4)
	end
	local napBench = CFrame.new(parkCenter + Vector3.new(-30, 0, -25))
	bench(napBench)
	station("nap", "Gain", "😴 Edison's Nap Bench", "Wake up when the key drops", napBench * CFrame.new(0, 0, 6), Color3.fromRGB(90, 90, 160))
	station("pigeons", "Gain", "🐦 Tesla's Pigeons", "Feed the pigeons", CFrame.new(parkCenter + Vector3.new(-30, 0, 30)), Color3.fromRGB(150, 150, 150))
	WorldService.Spots.park = parkCenter + Vector3.new(0, 3, -60)
	table.insert(WorldService.Places, { key = "park", name = "🌳 Brainville Park", path = "Gain" })

	-- Street sweeper workplace: a cleaning cart on Main Street
	workplace("street", "Street Cleaning Cart", CFrame.new(18, 0.6, -120))
	WorldService.Spots.street = Vector3.new(10, 3, -110)
	table.insert(WorldService.Places, { key = "street", name = "🧹 Main Street", path = "Gain" })
end

---------------------------------------------------------------------
-- Doors, teleporting, zones
---------------------------------------------------------------------
function WorldService.teleport(player: Player, where: string)
	local char = player.Character
	local spot = WorldService.Spots[where]
	if char and spot then
		char:PivotTo(CFrame.new(sp(spot) + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))))
	end
end

function WorldService.enterDoor(player: Player, path: string)
	local data = DataService.get(player)
	if not data then
		return
	end
	if data.dead then
		Net.send(player, "deathScreen", {})
		return
	end
	if data.path == nil then
		BrainService.startPath(player, path)
		BrainService.narrate(player, path == "Lose" and "choseLose" or "choseGain")
		WorldService.teleport(player, string.lower(path))
	elseif data.path == path then
		WorldService.teleport(player, string.lower(path))
	else
		Net.send(player, "confirmSwitch", { path = path })
	end
end

function WorldService.inZone(player: Player, zoneName: string): boolean
	local zone = WorldService.Zones[zoneName]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not zone or not root then
		return false
	end
	local raw = Vector3.new(root.Position.X / S, root.Position.Y, root.Position.Z / S)
	local rel = zone.cframe:PointToObjectSpace(raw)
	local half = zone.size / 2
	return math.abs(rel.X) <= half.X and rel.Y >= -2 and rel.Y <= zone.size.Y and math.abs(rel.Z) <= half.Z
end

-- Places with their real (shrunk) map positions, for the drawn town map
function WorldService.placeList()
	local out = {}
	for _, p in ipairs(WorldService.Places) do
		local spot = WorldService.Spots[p.key]
		if spot then
			local pos = sp(spot)
			table.insert(out, { key = p.key, name = p.name, path = p.path, x = pos.X, z = pos.Z })
		end
	end
	return out, 260 * S + 20
end

function WorldService.near(player: Player, pos: Vector3, radius: number): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root ~= nil and (root.Position - pos).Magnitude <= radius
end

---------------------------------------------------------------------
-- Fun / admin / invention world effects
---------------------------------------------------------------------
function WorldService.swapDoors()
	local a, b = doorSigns.Lose, doorSigns.Gain
	if a and b then
		local ta, tb = a:GetAttribute("BaseText"), b:GetAttribute("BaseText")
		a:SetAttribute("BaseText", tb)
		b:SetAttribute("BaseText", ta)
		a.Text = tb
		b.Text = ta
	end
end

function WorldService.spawnChicken()
	local chicken = part({ Name = "RubberChicken", Size = Vector3.new(2, 3, 2), Position = Vector3.new(math.random(-60, 60), 2.1, math.random(-60, 60)), Color = Color3.fromRGB(255, 230, 40) })
	sign(chicken, "🐔", 3, 60, 60)
	Debris:AddItem(chicken, 300)
end

function WorldService.spawnRubberDuck()
	local duck = part({ Name = "GiantRubberDuck", Size = Vector3.new(12, 12, 12), Position = Vector3.new(0, 7, 55), Color = Color3.fromRGB(255, 220, 0), Shape = Enum.PartType.Ball })
	sign(duck, "🦆 The Rubber Duck (secret invention)\nExplain your problem to it.", 9, 340, 60)
	prompt(duck, "Talk", "Rubber Duck").Triggered:Connect(function(player)
		BrainService.say(player, "🦆 *quack* (You explained your problem out loud and suddenly understood it. That's rubber duck debugging!)")
	end)
	return duck
end

local function rain(center: Vector3, radius: number, seconds: number, color: Color3, label: string?)
	task.spawn(function()
		local t = os.clock()
		while os.clock() - t < seconds do
			for _ = 1, 5 do
				local b = Instance.new("Part")
				b.Name = "RainItem"
				b.Shape = Enum.PartType.Ball
				b.Size = Vector3.new(2, 2, 2)
				b.Color = color
				b.Material = Enum.Material.SmoothPlastic
				b.CanCollide = true
				b.Position = center + Vector3.new(math.random(-radius, radius), 70, math.random(-radius, radius))
				if label then
					local g = Instance.new("BillboardGui")
					g.Size = UDim2.new(2.5, 0, 2.5, 0)
					local l = Instance.new("TextLabel")
					l.Size = UDim2.fromScale(1, 1)
					l.BackgroundTransparency = 1
					l.TextScaled = true
					l.Text = label
					l.Parent = g
					g.Parent = b
				end
				b.Parent = workspace
				Debris:AddItem(b, 8)
			end
			task.wait(0.5)
		end
	end)
end

function WorldService.brainRain(seconds: number, center: Vector3?)
	rain(center or Vector3.zero, center and 30 or 70, seconds, Color3.fromRGB(255, 150, 190), "🧠")
end

function WorldService.pigeonBurst(origin: Vector3)
	for _ = 1, 12 do
		local p = Instance.new("Part")
		p.Name = "Pigeon"
		p.Size = Vector3.new(1, 1, 1.5)
		p.Color = Color3.fromRGB(140, 140, 150)
		p.CanCollide = false
		p.Position = origin + Vector3.new(0, 3, 0)
		p.AssemblyLinearVelocity = Vector3.new(math.random(-40, 40), math.random(40, 70), math.random(-40, 40))
		local g = Instance.new("BillboardGui")
		g.Size = UDim2.new(2, 0, 2, 0)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.TextScaled = true
		l.Text = "🐦"
		l.Parent = g
		g.Parent = p
		p.Parent = workspace
		Debris:AddItem(p, 6)
	end
end

local banner = nil
function WorldService.setBanner(text: string, color: Color3)
	if not banner then
		banner = part({ Name = "MayorBanner", Size = Vector3.new(40, 7, 0.6), Position = Vector3.new(0, 26, -60), Color = color }, "accent")
		banner:SetAttribute("BannerText", text)
		surfaceSign(banner, text)
	end
	banner.Color = color
	local label = banner:FindFirstChildOfClass("SurfaceGui"):FindFirstChildOfClass("TextLabel")
	label.Text = text
	label:SetAttribute("BaseText", text)
end

local function buildLighting()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.25
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.35
		bloom.Size = 24
		bloom.Threshold = 0.95
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.06
		rays.Spread = 0.6
		rays.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.SunAngularSize = 14
		sky.Parent = Lighting
	end
end

function WorldService.build()
	buildLighting()
	buildGround()
	buildPlaza()
	buildLoseSide()
	buildGainSide()
	-- microwave countdown text
	task.spawn(function()
		local seconds = 600
		while true do
			task.wait(1)
			seconds -= 1
			if seconds < 0 then
				seconds = 600
			end
			if WorldService.microwaveLabel then
				WorldService.microwaveLabel.Text = string.format("%d:%02d", seconds // 60, seconds % 60)
			end
		end
	end)
end

return WorldService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000000000000000000000000000028"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000000000000000000000000000027"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000025"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000001C"><Properties><string name="Name">AdminPanel</string><ProtectedString name="Source"><![CDATA[-- AdminPanel: staff panel with tabs (Players, Server, Fun, Game, Logs).
-- Dark rounded panel with a top tab row, player list and big buttons.
-- Only shows buttons your rank can use. Works with touch, mouse and controller.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local UI = require(script.Parent.UI)
local Remote = require(script.Parent.Remote)

local player = Players.LocalPlayer
local C = UI.Colors

local AdminPanel = {}
AdminPanel.onDebug = nil

local TABS = { "Players", "Server", "Fun", "Game", "Logs" }
local selectedTarget = nil -- userId
local selectedName = nil
local currentTab = "Players"

local function myRank(): number
	return player:GetAttribute("Rank") or 0
end

local function commandsFor(cat: string)
	local list = {}
	for name, def in pairs(Config.Commands) do
		if def.cat == cat and myRank() >= def.min then
			table.insert(list, { name = name, def = def })
		end
	end
	table.sort(list, function(a, b)
		if a.def.min ~= b.def.min then
			return a.def.min < b.def.min
		end
		return a.def.label < b.def.label
	end)
	return list
end

function AdminPanel.open()
	if myRank() < 1 then
		UI.toast("Staff only.")
		return
	end
	local m = UI.modal("🛠 Staff Panel  •  " .. Config.RankNames[myRank()], { color = Config.RankColors[myRank()], maxSize = Vector2.new(640, 520) })

	-- Tab row
	local tabRow = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, Parent = m.content }, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
	})
	local body = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = m.content }, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	-- shared argument box
	local argBox = UI.new("TextBox", {
		PlaceholderText = "Text box (reason, number, duration…)",
		Text = "",
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		TextSize = UI.textSize(15),
		TextColor3 = C.text,
		PlaceholderColor3 = C.muted,
		BackgroundColor3 = C.panel,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 2,
		Parent = m.content,
	})
	UI.corner(argBox, 8)

	local function run(name: string, def)
		local res = Remote.call("admin", { cmd = name, target = def.target and selectedTarget or nil, arg = argBox.Text })
		UI.toast((res.ok and "✅ " or "⛔ ") .. tostring(res.msg), res.ok and C.panel or C.bad, 6)
		if name == "debug" and res.ok and AdminPanel.onDebug then
			AdminPanel.onDebug()
		end
	end

	local function clearBody()
		for _, c in ipairs(body:GetChildren()) do
			if not c:IsA("UIListLayout") then
				c:Destroy()
			end
		end
	end

	local function commandGrid(cat: string, order: number)
		local grid = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = body }, {
			UI.new("UIGridLayout", { CellSize = UDim2.new(0.48, 0, 0, 46), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		for i, c in ipairs(commandsFor(cat)) do
			local text = c.def.label .. (c.def.arg and "  ✎" or "")
			UI.button(grid, text, function()
				run(c.name, c.def)
			end, { LayoutOrder = i, TextSize = UI.textSize(14), BackgroundColor3 = c.def.min >= 4 and Color3.fromRGB(110, 30, 30) or C.panel2 })
		end
		UI.label(body, "✎ = uses the text box above. Args: " .. (function()
			local hints = {}
			for _, c in ipairs(commandsFor(cat)) do
				if c.def.arg then
					table.insert(hints, c.def.label .. ": " .. c.def.arg)
				end
			end
			return #hints > 0 and table.concat(hints, " • ") or "none"
		end)(), { TextColor3 = C.muted, TextSize = UI.textSize(12), LayoutOrder = order + 1 })
	end

	local function showTab(tab: string)
		currentTab = tab
		clearBody()
		if tab == "Players" then
			local res = Remote.call("admin_players")
			UI.label(body, "Selected: " .. (selectedName or "nobody (tap a player)"), { Font = Enum.Font.GothamBold, TextColor3 = C.gold, LayoutOrder = 1 })
			if res.ok then
				for i, p in ipairs(res.players) do
					local tag = p.rank > 0 and ("[" .. Config.RankNames[p.rank] .. "] ") or ""
					UI.button(body, tag .. p.display .. " (@" .. p.name .. ")  •  " .. tostring(p.path) .. "  •  🧠 " .. p.cells, function()
						selectedTarget = p.userId
						selectedName = p.display
						showTab("Players")
					end, {
						LayoutOrder = 1 + i,
						Size = UDim2.new(1, 0, 0, 40),
						TextXAlignment = Enum.TextXAlignment.Left,
						TextSize = UI.textSize(14),
						BackgroundColor3 = selectedTarget == p.userId and C.accent or C.panel,
					})
				end
			end
			commandGrid("Players", 100)
		elseif tab == "Logs" then
			commandGrid("Logs", 1)
			local res = Remote.call("admin_logs")
			if res.ok then
				for i, line in ipairs(res.logs) do
					UI.label(body, line, { TextSize = UI.textSize(13), TextColor3 = C.muted, LayoutOrder = 10 + i })
				end
				if #res.logs == 0 then
					UI.label(body, "No staff actions yet.", { LayoutOrder = 10 })
				end
			else
				UI.label(body, "Head Moderator or Owner only.", { LayoutOrder = 10 })
			end
		else
			commandGrid(tab, 1)
		end
		m.focus()
	end

	for _, tab in ipairs(TABS) do
		UI.button(tabRow, tab, function()
			showTab(tab)
		end, { Size = UDim2.new(0.19, 0, 1, 0), TextSize = UI.textSize(14), BackgroundColor3 = C.panel })
	end
	showTab(currentTab)
end

return AdminPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001D"><Properties><string name="Name">Conversation</string><ProtectedString name="Source"><![CDATA[-- Conversation (update 1.5): the cinematic look of a conversation scene.
--   Letterbox bars, the camera moves in and cuts to whoever is talking,
--   lines are typed out with little blips, and you pick what to say from the
--   bottom-left (like bargaining in a football game). Each choice plays your line.
-- The server (ConversationService) decides everything; this only shows it.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Content = require(ReplicatedStorage.Shared.Content)
local UI = require(script.Parent.UI)
local Remote = require(script.Parent.Remote)

local Conversation = {}

local player = Players.LocalPlayer
local CC = Config.Conversations
local T = Content.ConvUI

local gui = Instance.new("ScreenGui")
gui.Name = "ConversationUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false -- stay below Roblox's own top bar buttons
gui.DisplayOrder = 20
gui.Enabled = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

-- The black bars live in their own layer that ignores phone safe areas, so they reach the edges
local bars = Instance.new("ScreenGui")
bars.Name = "ConversationBars"
bars.ResetOnSpawn = false
bars.IgnoreGuiInset = true
bars.ScreenInsets = Enum.ScreenInsets.None
bars.DisplayOrder = 19
bars.Enabled = false
bars.Parent = gui.Parent

local cur = nil -- the open conversation

-- Your friends (the people who follow you around) step out of the shot
local function hideFriends()
	local hidden = {}
	for _, m in ipairs(workspace:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("FriendName") then
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") or d:IsA("Decal") then
					table.insert(hidden, d)
					d.LocalTransparencyModifier = 1
				elseif d:IsA("BillboardGui") and d.Enabled then
					table.insert(hidden, d)
					d.Enabled = false
				end
			end
		end
	end
	return hidden
end

local function showFriends(hidden)
	for _, d in ipairs(hidden or {}) do
		if d.Parent then
			if d:IsA("BillboardGui") then
				d.Enabled = true
			else
				d.LocalTransparencyModifier = 0
			end
		end
	end
end

---------------------------------------------------------------------
-- Building the screen
---------------------------------------------------------------------
local function new(className: string, props, parent)
	local i = Instance.new(className)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = parent
	return i
end

local function corner(i, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 10) }, i)
end

local function maxText(i, size)
	new("UITextSizeConstraint", { MaxTextSize = size, MinTextSize = 9 }, i)
end

local function build()
	gui:ClearAllChildren()
	bars:ClearAllChildren()
	local r = {}
	r.top = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0.09, 0), Position = UDim2.new(0, 0, -0.09, 0) }, bars)
	r.bottom = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Size = UDim2.new(1, 0, 0.09, 0), Position = UDim2.new(0, 0, 1.09, 0) }, bars)

	-- meter (top center, just under the bar)
	local meter = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.03, 0), Size = UDim2.new(0.36, 0, 0.075, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 28), BackgroundTransparency = 0.25 }, gui)
	corner(meter, 8)
	r.meterName = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(0.42, 0, 1, 0), Position = UDim2.new(0.02, 0, 0, 0), Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, meter)
	maxText(r.meterName, 18)
	local bar = new("Frame", { Position = UDim2.new(0.46, 0, 0.3, 0), Size = UDim2.new(0.51, 0, 0.4, 0), BackgroundColor3 = Color3.fromRGB(60, 60, 70) }, meter)
	corner(bar, 6)
	r.fill = new("Frame", { Size = UDim2.new(0.5, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 210, 60) }, bar)
	corner(r.fill, 6)

	-- leave (top right, always there: the way out)
	r.leave = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0.98, 0, 0.03, 0), Size = UDim2.new(0.11, 0, 0.075, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 50), TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.FredokaOne, TextScaled = true, Text = T.Leave, AutoButtonColor = true, Name = "Leave" }, gui)
	corner(r.leave, 8)
	maxText(r.leave, 18)
	new("UISizeConstraint", { MinSize = Vector2.new(70, 32) }, r.leave)

	-- subtitles (bottom right): who is talking + the line. Tap to finish the line.
	r.sub = new("TextButton", { AutoButtonColor = false, Text = "", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.98, 0, 0.87, 0), Size = UDim2.new(0.5, 0, 0.27, 0), BackgroundColor3 = Color3.fromRGB(16, 16, 24), BackgroundTransparency = 0.15 }, gui)
	corner(r.sub, 12)
	new("UIStroke", { Color = Color3.fromRGB(255, 210, 60), Thickness = 2, Transparency = 0.3 }, r.sub)
	r.name = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0.04, 0, 0.05, 0), Size = UDim2.new(0.92, 0, 0.24, 0), Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(255, 210, 60), TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, r.sub)
	maxText(r.name, 20)
	r.text = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0.04, 0, 0.3, 0), Size = UDim2.new(0.92, 0, 0.66, 0), Font = Enum.Font.GothamMedium, TextScaled = true, TextWrapped = true, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "" }, r.sub)
	maxText(r.text, 22)

	-- choices (bottom left)
	r.opts = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.02, 0, 0.87, 0), Size = UDim2.new(0.44, 0, 0.52, 0), BackgroundTransparency = 1, Visible = false }, gui)
	new("UIListLayout", { Padding = UDim.new(0.03, 0), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder }, r.opts)
	return r
end

---------------------------------------------------------------------
-- Camera
---------------------------------------------------------------------
-- Only the town's buildings (walls, roofs) can block the camera
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include

-- Moves the camera from `from` toward `want`, stopping in front of any wall in between
local function clearSpot(from: Vector3, want: Vector3): Vector3
	local town = workspace:FindFirstChild("Town")
	if not town then
		return want
	end
	wallParams.FilterDescendantsInstances = { town }
	local dir = want - from
	local hit = workspace:Raycast(from, dir, wallParams)
	if hit then
		return hit.Position - dir.Unit * 0.8
	end
	return want
end

local function tweenCam(from: Vector3, want: Vector3, lookAt: Vector3)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local cf = CFrame.lookAt(clearSpot(from, want), lookAt)
	TweenService:Create(cam, TweenInfo.new(CC.CameraTween, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = cf }):Play()
end

local function shot(kind: string)
	if not cur then
		return
	end
	local me, npc = cur.stand.Position, cur.npc.Position
	local meHead, npcHead = me + Vector3.new(0, 4.4, 0), npc + Vector3.new(0, 4.4, 0)
	if kind == "wide" then
		local mid = (meHead + npcHead) / 2
		tweenCam(mid, cur.wide, mid)
	elseif kind == "npc" then
		-- over your shoulder, looking at them
		local back = (me - npc).Unit
		local right = back:Cross(Vector3.yAxis).Unit
		tweenCam(meHead, meHead + back * 3.4 + right * 4.6 + Vector3.new(0, 1, 0), npcHead + right * 0.4)
	else
		-- over their shoulder, looking at you
		local back = (npc - me).Unit
		local right = back:Cross(Vector3.yAxis).Unit
		tweenCam(npcHead, npcHead + back * 3.4 + right * 4.6 + Vector3.new(0, 1, 0), meHead + right * 0.4)
	end
end

---------------------------------------------------------------------
-- Lines and choices
---------------------------------------------------------------------
local function setMeter(v: number)
	if not cur then
		return
	end
	local color = v >= CC.GoodAt and Color3.fromRGB(47, 191, 113) or (v <= CC.BadAt and Color3.fromRGB(229, 72, 77) or Color3.fromRGB(255, 210, 60))
	TweenService:Create(cur.r.fill, TweenInfo.new(0.4), { Size = UDim2.new(math.clamp(v / 100, 0, 1), 0, 1, 0), BackgroundColor3 = color }):Play()
end

local function typeSpeed(): number
	local st = UI.state
	if st and st.iq and st.iq >= CC.SmartIQ then
		return CC.SmartTypeSpeed
	end
	return CC.TypeSpeed
end

-- Types a line; returns when it's done (or tapped to finish)
local function typeLine(name: string, text: string)
	local c = cur
	if not c then
		return
	end
	c.r.name.Text = name
	c.r.text.Text = text
	c.r.text.MaxVisibleGraphemes = 0
	c.skip = false
	local total = utf8.len(text) or #text
	local shown = 0
	local step = 1 / typeSpeed()
	while c == cur and shown < total do
		if c.skip then
			shown = total
		else
			shown += 1
		end
		c.r.text.MaxVisibleGraphemes = shown
		if shown % 3 == 0 then
			UI.sound("TypeTick", 0.25)
		end
		task.wait(step)
	end
	if c == cur then
		c.r.text.MaxVisibleGraphemes = -1
		task.wait(CC.PauseAfterLine)
	end
end

local function floatText(text: string, color: Color3)
	if not cur then
		return
	end
	local l = new("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.12, 0), Size = UDim2.new(0.4, 0, 0.06, 0), Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = color, TextStrokeTransparency = 0.3, Text = text }, gui)
	TweenService:Create(l, TweenInfo.new(1.2), { Position = UDim2.new(0.5, 0, 0.08, 0), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.3, function()
		l:Destroy()
	end)
end

local function objection()
	local l = new("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.42, 0), Size = UDim2.new(0.7, 0, 0.2, 0), Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(255, 60, 60), TextStrokeColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, Rotation = -6, Text = T.Objection }, gui)
	local sc = new("UIScale", { Scale = 2.2 }, l)
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	UI.sound("ImportantSlam", 0.8)
	task.delay(1.1, function()
		l:Destroy()
	end)
end

local pick -- forward

local function unbindKeys()
	ContextActionService:UnbindAction("ConvChoice")
end

local function showChoices(list, onChoose)
	local c = cur
	if not c then
		return
	end
	for _, ch in ipairs(c.r.opts:GetChildren()) do
		if ch:IsA("GuiButton") then
			ch:Destroy()
		end
	end
	local buttons = {}
	for i, text in ipairs(list) do
		local b = new("TextButton", { LayoutOrder = i, Size = UDim2.new(1, 0, 0.3, 0), BackgroundColor3 = Color3.fromRGB(18, 22, 36), BackgroundTransparency = 0.1, AutoButtonColor = true, Text = "", Selectable = true }, c.r.opts)
		corner(b, 8)
		new("UIStroke", { Color = UI.T.accent or Color3.fromRGB(150, 90, 255), Thickness = 2, Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
		local num = new("TextLabel", { Size = UDim2.new(0.13, 0, 1, 0), BackgroundColor3 = UI.T.accent or Color3.fromRGB(150, 90, 255), Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = tostring(i) }, b)
		corner(num, 8)
		new("UIPadding", { PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0) }, num)
		local l = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0.16, 0, 0.06, 0), Size = UDim2.new(0.81, 0, 0.88, 0), Font = Enum.Font.GothamBold, TextScaled = true, TextWrapped = true, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left, Text = text }, b)
		maxText(l, 18)
		-- slide in from the left, one after another
		local sc = new("UIScale", { Scale = 0.6 }, b)
		TweenService:Create(sc, TweenInfo.new(0.18 + i * 0.05, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		b.Activated:Connect(function()
			onChoose(i)
		end)
		buttons[i] = b
	end
	c.r.opts.Visible = true
	-- keys 1/2/3 and controllers
	ContextActionService:BindActionAtPriority("ConvChoice", function(_, state, input)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		local map = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.KeypadOne] = 1, [Enum.KeyCode.KeypadTwo] = 2, [Enum.KeyCode.KeypadThree] = 3 }
		local i = map[input.KeyCode]
		if i and buttons[i] then
			onChoose(i)
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, 3000, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.KeypadOne, Enum.KeyCode.KeypadTwo, Enum.KeyCode.KeypadThree)
	if UI.isGamepad and UI.isGamepad() then
		GuiService.SelectedObject = buttons[1]
	end
end

local function hideChoices()
	if cur then
		cur.r.opts.Visible = false
	end
	unbindKeys()
	GuiService.SelectedObject = nil
end

local function sayNode(node)
	local c = cur
	if not c then
		return
	end
	c.node = node
	shot("npc")
	typeLine(c.who, node.say)
	if c ~= cur then
		return
	end
	showChoices(node.opts, function(i)
		pick(i)
	end)
end

local function close()
	local c = cur
	if not c then
		return
	end
	cur = nil
	ContextActionService:UnbindAction("ConvLeave")
	hideChoices()
	task.spawn(function()
		Remote.call("conv_close")
	end)
	TweenService:Create(c.r.top, TweenInfo.new(0.3), { Position = UDim2.new(0, 0, -0.09, 0) }):Play()
	TweenService:Create(c.r.bottom, TweenInfo.new(0.3), { Position = UDim2.new(0, 0, 1.09, 0) }):Play()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum then
		cam.CameraSubject = hum
	end
	if root then
		root.Anchored = false
	end
	if UI.gui then
		UI.gui.Enabled = true
	end
	pcall(function()
		GuiService.TouchControlsEnabled = true
	end)
	showFriends(c.hidden)
	task.delay(0.3, function()
		if not cur then
			gui.Enabled = false
			bars.Enabled = false
			gui:ClearAllChildren()
			bars:ClearAllChildren()
		end
	end)
end
Conversation.close = close

local function finish(ended)
	local c = cur
	if not c then
		return
	end
	shot("wide")
	typeLine(c.who, ended.line)
	if c ~= cur then
		return
	end
	UI.sound(ended.tier == "good" and "LevelUp" or (ended.tier == "bad" and "SadTrombone" or "NotificationPing"), 0.6)
	showChoices({ "✓ " .. ended.result .. "  ·  " .. T.Done }, function()
		close()
	end)
end

pick = function(i: number)
	local c = cur
	if not c or c.busy then
		return
	end
	c.busy = true
	hideChoices()
	local said = c.node.opts[i]
	local result
	task.spawn(function()
		result = Remote.call("conv_pick", { i = i })
	end)
	shot("me")
	typeLine(T.You, said)
	while c == cur and result == nil do
		task.wait()
	end
	if c ~= cur then
		return
	end
	c.busy = false
	if not result or not result.ok then
		close()
		return
	end
	if result.slam then
		objection()
	end
	setMeter(result.meter)
	if result.delta > 0 then
		floatText("▲ " .. c.meterName, Color3.fromRGB(125, 255, 176))
	elseif result.delta < 0 then
		floatText("▼ " .. c.meterName, Color3.fromRGB(255, 125, 154))
	end
	if result.next then
		task.wait(0.3)
		sayNode(result.next)
	elseif result.ended then
		task.wait(0.4)
		finish(result.ended)
	end
end

---------------------------------------------------------------------
-- Open
---------------------------------------------------------------------
function Conversation.open(d)
	if cur then
		close()
	end
	UI.closeModal()
	local r = build()
	cur = { r = r, who = d.who, meterName = d.meterName, stand = d.stand, npc = d.npc, wide = d.wide }
	local c = cur
	r.meterName.Text = d.meterName
	r.fill.Size = UDim2.new(math.clamp(d.meter / 100, 0, 1), 0, 1, 0)
	setMeter(d.meter)
	r.sub.Activated:Connect(function()
		if cur then
			cur.skip = true
		end
	end)
	r.leave.Activated:Connect(close)
	-- controller B / Backspace also leave
	ContextActionService:BindActionAtPriority("ConvLeave", function(_, state)
		if state == Enum.UserInputState.Begin then
			close()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, 3000, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)
	if d.seen then
		r.name.Text = T.Fast
	end
	-- hold still and hide the normal HUD
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		task.delay(0.15, function()
			if c == cur then
				root.Anchored = true
			end
		end)
	end
	if UI.gui then
		UI.gui.Enabled = false
	end
	cur.hidden = hideFriends()
	gui.Enabled = true
	bars.Enabled = true
	pcall(function()
		GuiService.TouchControlsEnabled = false
	end)
	TweenService:Create(r.top, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = UDim2.new(0, 0, 0, 0) }):Play()
	TweenService:Create(r.bottom, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = UDim2.new(0, 0, 1, 0) }):Play()
	UI.sound("ImportantSlam", 0.5)
	shot("wide")
	task.spawn(function()
		task.wait(CC.OpenDelay)
		if c == cur then
			sayNode(d.node)
		end
	end)
end

function Conversation.isOpen(): boolean
	return cur ~= nil
end

---------------------------------------------------------------------
-- Prompt text per path ("Get checked" on Lose, "See a patient" on Gain...)
---------------------------------------------------------------------
local lastPath = nil
local function labelOne(pp: ProximityPrompt, path: string?)
	if pp:GetAttribute("LoseAction") or pp:GetAttribute("GainAction") then
		-- not for your path (or no path yet): just "Talk"
		pp.ActionText = (path and pp:GetAttribute(path .. "Action")) or Content.Rooms.Talk
	end
end
local function relabel(path: string?)
	local rooms = workspace:FindFirstChild("Rooms")
	if not rooms then
		return
	end
	for _, pp in ipairs(rooms:GetDescendants()) do
		if pp:IsA("ProximityPrompt") then
			labelOne(pp, path)
		end
	end
end

function Conversation.onState(st)
	if st.path ~= lastPath then
		lastPath = st.path
		relabel(st.path)
	end
end

Remote.on("conv_open", Conversation.open)
Remote.on("conv_close", close)
task.spawn(function()
	local rooms = workspace:WaitForChild("Rooms", 30)
	if rooms then
		-- the rooms may arrive after the first state: label what's already there,
		-- and again shortly after (attributes can replicate a moment later)
		relabel(lastPath)
		task.delay(3, function()
			relabel(lastPath)
		end)
		rooms.DescendantAdded:Connect(function(d)
			if d:IsA("ProximityPrompt") then
				task.defer(labelOne, d, lastPath)
			end
		end)
	end
end)

return Conversation
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001E"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Effects: cutscenes and screen effects (death ending, Brain Shredder ban,
-- confetti, viral video, badges).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local C = UI.Colors

local Effects = {}

local function overlay(color: Color3, transparency: number, z: number?)
	return UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		ZIndex = z or 60,
		Parent = UI.gui,
	})
end

local function bigText(parent, text: string, z: number?)
	return UI.new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		ZIndex = (z or 60) + 1,
		Parent = parent,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 120 }) })
end

---------------------------------------------------------------------
-- Confetti
---------------------------------------------------------------------
function Effects.confetti()
	local colors = { C.bad, C.good, C.gold, C.accent, Color3.fromRGB(80, 200, 255) }
	for _ = 1, (UI.settings.reduceFlashing and 25 or 70) do
		local p = UI.new("Frame", {
			Size = UDim2.fromOffset(math.random(6, 12), math.random(10, 18)),
			Position = UDim2.new(math.random(), 0, 0, -20),
			BackgroundColor3 = colors[math.random(1, #colors)],
			Rotation = math.random(0, 360),
			ZIndex = 70,
			Parent = UI.gui,
		})
		local t = TweenService:Create(p, TweenInfo.new(math.random(20, 40) / 10, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(p.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0),
			Rotation = p.Rotation + math.random(-360, 360),
		})
		t:Play()
		t.Completed:Connect(function()
			p:Destroy()
		end)
	end
end

---------------------------------------------------------------------
-- Death ending
---------------------------------------------------------------------
function Effects.death(d, onDone)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	-- zoom in
	if head then
		camera.CameraType = Enum.CameraType.Scriptable
		local from = camera.CFrame
		local to = CFrame.lookAt(head.Position + head.CFrame.LookVector * 6 + Vector3.new(0, 1, 0), head.Position)
		TweenService:Create(camera, TweenInfo.new(1.2), { CFrame = to }):Play()
		local _ = from
	end
	local o = overlay(Color3.new(0, 0, 0), 1)
	local label = bigText(o, "")
	for _, n in ipairs({ "3", "2", "1" }) do
		label.Text = n
		UI.sound("NotificationPing")
		task.wait(0.9)
	end
	-- half a second of silence
	label.Text = ""
	task.wait(0.5)
	-- EVERYTHING AT ONCE
	for _, s in ipairs({ "AirHorn", "RecordScratch", "DeathBoom", "KazooTune", "SadTrombone", "CartoonBoing" }) do
		UI.sound(s, d.loud and 1.5 or 1)
	end
	if d.loud then
		task.delay(0.3, function()
			UI.sound("AirHorn", 1.5)
			UI.sound("DeathBoom", 1.5)
		end)
	end
	if not UI.settings.reduceFlashing then
		o.BackgroundTransparency = 0.2
		o.BackgroundColor3 = Color3.new(1, 1, 1)
		TweenService:Create(o, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	end
	label.Text = "💀"
	-- the tiny brain floats away
	local brain = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(90, 90),
		BackgroundTransparency = 1,
		Text = "🧠👋",
		TextScaled = true,
		ZIndex = 62,
		Parent = UI.gui,
	})
	TweenService:Create(brain, TweenInfo.new(3, Enum.EasingStyle.Sine), { Position = UDim2.fromScale(0.7, -0.2), Rotation = 30 }):Play()
	task.wait(3)
	brain:Destroy()
	o:Destroy()
	camera.CameraType = Enum.CameraType.Custom
	Effects.confetti()
	if onDone then
		onDone()
	end
end

