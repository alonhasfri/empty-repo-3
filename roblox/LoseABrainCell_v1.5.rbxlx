			} },
			b = { say = "Next: 'Study shows chocolate makes you a genius.' Your note?", opts = {
				{ t = "Check who paid for the study and how many people were in it.", n = "c" },
				{ t = "Publish it, I love chocolate.", n = "c" },
				{ t = "Only dark chocolate.", n = "c" },
			} },
			c = { say = "Last one. A quote with no source. Run it?", opts = {
				{ t = "No. Find the original source first." },
				{ t = "Yes, it sounds smart." },
				{ t = "Attribute it to Albert Zweistein." },
			} },
		},
		ends = {
			good = { line = "The Brainville Times prints a correction, thanks to you.", result = "🪙 +30, 🧠 brain cells" },
			mid = { line = "Mostly right. Good work.", result = "🪙 +10" },
			bad = { line = "The fake news got printed. Oops.", result = "😰 Stress +10" },
		},
	},
	election = {
		who = "Voters of Brainville",
		meter = "🗳 Votes",
		action = "Give an election speech",
		nodes = {
			a = { say = "Citizens gather at the podium. 'Why should we vote for you?'", opts = {
				{ t = { Lose = "FREE BRAINTOK FOR EVERYONE", Gain = "More libraries and free tutoring." }, n = "b" },
				{ t = "Because I said so.", n = "b" },
				{ t = "I promise a pigeon in every home.", n = "b" },
			} },
			b = { say = "A voter asks: 'What will you do about the potholes?'", opts = {
				{ t = "Fix the worst ones first and publish a plan.", n = "c" },
				{ t = "Turn them into tiny swimming pools.", n = "c" },
				{ t = "What's a pothole?", n = "c" },
			} },
			c = { say = "Final words before the vote!", opts = {
				{ t = "Vote for me. I'll listen to you." },
				{ t = "VOTE OR ELSE (please)" },
				{ t = "*throws confetti at the crowd*" },
			} },
		},
		ends = {
			good = { line = "YOU WON THE ELECTION! Your path gets a boost.", result = "🏛 Mayor of Brainville (temporary)" },
			mid = { line = "You lost, but it was close!", result = "🗳 Close race" },
			bad = { line = "You got 3 votes. One was a pigeon.", result = "🐦 3 votes" },
		},
	},
	classroomL = {
		who = "Teacher",
		meter = "😤 Teacher patience",
		action = "Take the pop quiz",
		nodes = {
			a = { say = "Pop quiz! What is the capital of France?", opts = {
				{ t = "F.", n = "b" },
				{ t = "Paris.", n = "b" },
				{ t = "France is a fake country.", n = "b" },
			} },
			b = { say = "…OK. How many legs does a spider have?", opts = {
				{ t = "Spiders are just ants that gave up.", n = "c" },
				{ t = "Eight.", n = "c" },
				{ t = "*throws paper airplane*", n = "c" },
			} },
			c = { say = "Last question. What is 7 × 8?", opts = {
				{ t = "78" },
				{ t = "56" },
				{ t = "*falls asleep*" },
			} },
		},
		ends = {
			good = { line = "The teacher is proud. You feel… smarter. Gross.", result = "📝 A+. Oh no." },
			mid = { line = "C−. Perfectly average.", result = "📝 C−" },
			bad = { line = "The teacher gives up and puts on a movie.", result = "📺 Movie day. Brain off." },
		},
	},
	classroomG = {
		who = "The class",
		meter = "🙋 Class attention",
		action = "Teach the class",
		nodes = {
			a = { say = "Students: 'Why do we need fractions?!'", opts = {
				{ t = "Pizza. If you share a pizza with 4 friends, that's quarters.", n = "b" },
				{ t = "Because the test says so.", n = "b" },
				{ t = "You don't. Class dismissed.", n = "b" },
			} },
			b = { say = "A student says: 'Is ½ bigger than ⅓?'", opts = {
				{ t = "Yes. Cut a pizza in 2 vs 3: halves are bigger slices.", n = "c" },
				{ t = "No, 3 is bigger than 2.", n = "c" },
				{ t = "Ask your parents.", n = "c" },
			} },
			c = { say = "Students: 'Can we have a fun fact?'", opts = {
				{ t = "Octopuses have three hearts!" },
				{ t = "Homework is a fun fact." },
				{ t = "Wombat poop is cube-shaped." },
			} },
		},
		ends = {
			good = { line = "The whole class claps. One kid says you're the best teacher ever.", result = "🪙 +35, 💡 idea +1" },
			mid = { line = "Half the class was listening. Not bad.", result = "🪙 +15" },
			bad = { line = "A paper airplane hits you in the head.", result = "✈️ Stress +12" },
		},
	},
	experiment = {
		who = "Lab assistant",
		meter = "🐭 Mouse progress",
		action = "Mouse maze experiment",
		nodes = {
			a = { say = "The mouse needs to learn the maze. How should we start?", opts = {
				{ t = "Put a treat at the end and let it explore.", n = "b" },
				{ t = "Yell directions at it.", n = "b" },
				{ t = "Show it a BrainTok tutorial.", n = "b" },
			} },
			b = { say = "Should we change the maze every time?", opts = {
				{ t = "No. Keep it the same so we can measure learning.", n = "c" },
				{ t = "Yes! Chaos!", n = "c" },
				{ t = "Let the mouse design it.", n = "c" },
			} },
			c = { say = "How do we know it learned?", opts = {
				{ t = "Time it every run. If it gets faster, it learned." },
				{ t = "Ask the mouse." },
				{ t = "Vibes." },
			} },
		},
		ends = {
			good = { line = "The mouse runs the maze in 9 seconds! Science! 🎉", result = "🐭 Experiment success, 💡 idea +1" },
			mid = { line = "The mouse found the treat. Eventually.", result = "🐭 Partial success" },
			bad = { line = "The mouse is now in charge of the lab.", result = "🐭 New lab director" },
		},
	},
}

return Content
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">Narration</string><ProtectedString name="Source"><![CDATA[-- Narration: everything Dr. Wrinkles says, by mood.
-- Moods: host (average), librarian (smart), brainrot (dumb), caveman (too dumb)

local Narration = {}

Narration.Name = "Dr. Wrinkles"

Narration.Lines = {
	host = {
		welcome = { "WELCOME, contestant! Behind door number one: glory! Behind door number two: drool!", "It's SHOWTIME! Pick a door, any door!" },
		choseLose = { "Ooh, the BIG door! Let's see how fast you can lose it ALL!", "A bold choice! Your brain is now officially on a countdown!" },
		choseGain = { "The quiet door! A scholar! Let's see if you've got what it takes!", "Brains on the line, folks! Let's climb!" },
		lost = { "And there goes another batch!", "Ding ding ding! Brain cells: going, going…" },
		gained = { "Brain cells UP! The crowd goes mild!", "Look at that brain GROW!" },
		gatePass = { "CORRECT! Ladies and gentlemen, we have a thinker!" },
		gateFail = { "Ooh, so close! The buzzer says… NO!" },
		stage = { "A brand new you! Give it up for the contestant!" },
	},
	librarian = {
		welcome = { "Ah, welcome. Do keep your voice down; the books are thinking." },
		choseGain = { "A fine choice. Do mind the footnotes." },
		choseLose = { "…I see. I shall shelve your brain under 'Fiction'." },
		lost = { "A regrettable loss of grey matter." },
		gained = { "Splendid. Your neurons approve.", "Knowledge, accumulated. Most satisfactory." },
		gatePass = { "Impeccable reasoning. You may proceed." },
		gateFail = { "Incorrect. Revisit chapter one, perhaps." },
		stage = { "Your surroundings have… improved. As have you." },
		stressed = { "You appear frazzled. A routine might help. Beethoven counted his coffee beans." },
	},
	brainrot = {
		welcome = { "yo wsg 👋 pick a door bro" },
		choseLose = { "W choice no cap 🔥" },
		choseGain = { "bro wants to be smart 💀 aight" },
		lost = { "bro just lost like a billion brain cells 💀", "ong that was so dumb 😭 W", "no thoughts head empty fr" },
		gained = { "nah why did u read that 😭", "bro gained brain cells?? L" },
		embarrassed = { "bro walked into a wall 💀 no cap that's crazy", "chat is he fr 😭" },
		hiding = { "bro is HIDING 💀 behind a bush 😭" },
		viral = { "YOU WENT VIRAL 😭😭 BigReactz is reacting to ur comment" },
		stage = { "yo ur turning into smth 💀" },
		meterBroken = { "bro is too dumb to be embarrassed now 🗿" },
	},
	caveman = {
		welcome = { "OOGA." },
		lost = { "OOGA.", "Hrrng.", "*bonk*", "UGH." },
		gained = { "…hm?", "OOG??" },
		embarrassed = { "HRRNG." },
		hiding = { "*hides*" },
		viral = { "OOGA BOOGA??" },
		stage = { "OOGA OOGA." },
		meterBroken = { "wut" },
		death = { "*bonk*" },
	},
}

local FALLBACK = {
	host = "Let's keep the show going!",
	librarian = "Indeed.",
	brainrot = "bruh",
	caveman = "OOGA.",
}

function Narration.line(mood: string, event: string): string
	local set = Narration.Lines[mood]
	if set and set[event] then
		local list = set[event]
		return list[math.random(1, #list)]
	end
	return FALLBACK[mood] or "…"
end

return Narration
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000000000000000000000000001B"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main: starts every server system and handles players joining and leaving.
-- Lose a Brain Cell / Gain a Brain Cell, update 1.0

local Players = game:GetService("Players")

local Services = script.Parent:WaitForChild("Services")
local Net = require(Services.Net)
local DataService = require(Services.DataService)
local BrainService = require(Services.BrainService)
local WorldService = require(Services.WorldService)
local LoseService = require(Services.LoseService)
local GainService = require(Services.GainService)
local ShopService = require(Services.ShopService)
local AdminService = require(Services.AdminService)
local FriendService = require(Services.FriendService)
local SocialService = require(Services.SocialService)
local ProjectService = require(Services.ProjectService)
local SpaceService = require(Services.SpaceService)
local CastleService = require(Services.CastleService)
local ConversationService = require(Services.ConversationService)
AdminService.adminInvent = ProjectService.adminInvent
AdminService.runElection = SocialService.runElection

WorldService.build()

local STATION_PATH = {
	clickbait = "Lose",
	steal = "Lose",
	comments = "Lose",
	scroller = "Lose",
	library = "Gain",
	theater = "Gain",
	gate = "Gain",
	jobs = "Gain",
	coffee = "Gain",
	nap = "Gain",
	pigeons = "Gain",
	work = "Gain",
	lab = "Gain",
	shop = "Any",
}

-- Workplace desks around town
WorldService.onWork = function(player, placeKey)
	local data = DataService.get(player)
	if not data or data.path ~= "Gain" then
		BrainService.toast(player, "Jobs are on the Gain path.")
		return
	end
	local myPlace = nil
	for _, j in ipairs(require(game:GetService("ReplicatedStorage").Shared.Content).Jobs) do
		if j.id == data.job then
			myPlace = j.place
		end
	end
	if not myPlace then
		BrainService.toast(player, "💼 Get a job at the Job Center first.")
		return
	end
	if myPlace ~= placeKey then
		BrainService.toast(player, "This isn't your workplace.")
		return
	end
	local blocked = BrainService.blocked(player)
	if blocked then
		BrainService.toast(player, blocked)
		return
	end
	Net.send(player, "openStation", { station = "work" })
end

-- Returns nil if the player may open this station, or a reason why not.
local function stationProblem(player, key: string): string?
	local data = DataService.get(player)
	local path = STATION_PATH[key]
	if not data or not path then
		return "Not available."
	end
	if not data.path then
		return "Pick a path first: Lose or Gain."
	end
	if path ~= "Any" and data.path ~= path then
		return "That's for the " .. path .. " path."
	end
	if key ~= "shop" and key ~= "coffee" and key ~= "nap" and key ~= "pigeons" then
		return BrainService.blocked(player)
	end
	return nil
end

WorldService.onStation = function(player, key)
	local problem = stationProblem(player, key)
	if problem then
		BrainService.toast(player, problem)
		return
	end
	Net.send(player, "openStation", { station = key })
end

-- Activity dock on the screen (open activities from anywhere)
Net.on("station", function(player, d)
	local key = tostring(d.key)
	local problem = stationProblem(player, key)
	if problem then
		return { ok = false, msg = problem }
	end
	return { ok = true }
end)

-- Path picker on the screen (same as walking through a door)
Net.on("choose_path", function(player, d)
	if d.path ~= "Lose" and d.path ~= "Gain" then
		return { ok = false }
	end
	WorldService.enterDoor(player, d.path)
	return { ok = true }
end)
-- 1.5: the Unstuck button. Inside a building -> out the front door; anywhere else -> nearest street spot.
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Rooms = require(Services.Rooms)
local unstuckAt = {}
Net.on("unstuck", function(player)
	local now = os.clock()
	local last = unstuckAt[player]
	if last and now - last < Config.Unstuck.Cooldown then
		return { ok = false, msg = string.format(Content.Unstuck.Wait, math.ceil(Config.Unstuck.Cooldown - (now - last))) }
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then
		return { ok = false }
	end
	unstuckAt[player] = now
	ConversationService.stop(player)
	Rooms.standUp(hum)
	local key = Rooms.buildingAt(root.Position)
	if not (key and WorldService.Spots[key]) then
		local best = math.huge
		key = "lobby"
		for k, spot in pairs(WorldService.Spots) do
			local d = (WorldService.sp(spot) - root.Position).Magnitude
			if d < best then
				best, key = d, k
			end
		end
	end
	WorldService.teleport(player, key)
	return { ok = true, msg = Content.Unstuck.Done }
end)
game:GetService("Players").PlayerRemoving:Connect(function(p)
	unstuckAt[p] = nil
end)

WorldService.onCashGrab = GainService.cashGrab
WorldService.onAverageGuy = GainService.averageGuy

BrainService.hooks.onPathReset = function(player)
	LoseService.reset(player)
	GainService.reset(player)
end

Net.on("settings", function(player, d)
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	local s = data.settings
	if typeof(d.music) == "number" then
		s.music = math.clamp(d.music, 0, 1)
	end
	if typeof(d.sfx) == "number" then
		s.sfx = math.clamp(d.sfx, 0, 1)
	end
	if d.counterPos == "topleft" or d.counterPos == "topcenter" or d.counterPos == "topright" or d.counterPos == "bottomright" or d.counterPos == "custom" then
		s.counterPos = d.counterPos
	end
	if typeof(d.counterX) == "number" and typeof(d.counterY) == "number" then
		s.counterX = math.clamp(d.counterX, 0, 0.95)
		s.counterY = math.clamp(d.counterY, 0, 0.95)
	end
	for _, k in ipairs({ "tutLose", "tutGain", "tutLose2", "tutGain2" }) do
		if typeof(d[k]) == "number" then
			s[k] = math.clamp(math.floor(d[k]), 1, 30)
		end
	end
	-- guided tutorial (1.4): which notes you've seen (bit mask) + finished flags
	if typeof(d.tutNotes) == "number" then
		s.tutNotes = math.clamp(math.floor(d.tutNotes), 0, 2 ^ 30)
	end
	for _, k in ipairs({ "tutLose2Done", "tutGain2Done" }) do
		if typeof(d[k]) == "boolean" then
			s[k] = d[k]
		end
	end
	for _, k in ipairs({ "reduceFlashing", "largeText", "extraTime", "counterBig" }) do
		if typeof(d[k]) == "boolean" then
			s[k] = d[k]
		end
	end
	BrainService.push(player)
	return { ok = true }
end)

Net.on("hello", function(player)
	return { ok = true, state = BrainService.state(player) }
end)

local function onPlayerAdded(player: Player)
	local data = DataService.load(player)
	if not player.Parent then
		DataService.release(player)
		return
	end
	if not AdminService.onJoin(player) then
		return
	end
	FriendService.build(player)
	BrainService.setup(player, data)
	if data.inventions and data.inventions.duck then
		player:SetAttribute("DuckPet", true)
	end
	ShopService.checkOwned(player)

	local firstSpawn = true
	local function onCharacter(char)
		local humanoid = char:WaitForChild("Humanoid", 10)
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		BrainService.applyCharacter(player)
		if firstSpawn then
			firstSpawn = false
			-- come back exactly where you left off
			if data.position and data.path and not data.dead then
				local p = data.position
				char:PivotTo(CFrame.new(p.x, p.y + 3, p.z))
			end
			if data.dead then
				Net.send(player, "deathScreen", {})
			else
				BrainService.narrate(player, "welcome")
			end
		end
		if humanoid then
			humanoid.Died:Connect(function()
				local d = DataService.get(player)
				if d and d.path == "Lose" and not d.dead then
					-- fell or reset: no penalty, just a dumb moment
					BrainService.embarrass(player, 5, "Fell over for no reason")
				end
			end)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	DataService.release(player)
	BrainService.cleanup(player)
	FriendService.cleanup(player)
end)

DataService.start()
BrainService.start()
LoseService.start()
GainService.start()
ShopService.start()
AdminService.start()
SocialService.start()
ProjectService.start()
SpaceService.start()
CastleService.start()
ConversationService.start()

print("[Lose a Brain Cell] Server started (updates 1.0 – 1.5)")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">READ_ME</string><ProtectedString name="Source"><![CDATA[--[[
	LOSE A BRAIN CELL / GAIN A BRAIN CELL  -  updates 1.0 - 1.5

	WHERE THINGS ARE
	- ReplicatedStorage > Shared > Config     : all settings, IDs (group, sounds, passes), admin commands
	- ReplicatedStorage > Shared > Content    : all text (headlines, questions, jobs, glasses)
	- ReplicatedStorage > Shared > Badges     : the one combined badge list
	- ReplicatedStorage > Shared > Narration  : everything Dr. Wrinkles says
	- ServerScriptService > Main + Services   : the server (saving, brain cells, admin, activities)
	- StarterPlayer > StarterPlayerScripts    : the player's screen (HUD, menus, styles, admin panel)

	THE MAP IS BUILT BY CODE when you press Play (it appears in Workspace > Map).

	BEFORE PUBLISHING
	1. Home > Game Settings > Security > turn ON "Enable Studio Access to API Services" (so saving works).
	2. Paste your IDs into Config (sounds, music, game passes) and Badges (badge IDs). 0 = not set up yet.

	ADMIN
	- Ranks come from your community (group) ranks, in Studio too once the game is published under it:
	  255 = Owner, 100+ = Head Moderator, 50+ = Moderator, 10+ = Tester.
	- Open the staff panel with the 🛠 button, P on keyboard, or the Select button on a controller.
	- 1.4: SpaceService (Astronaut, Moon, World's Smartest), CastleService (the secret Endless Castle),
	  Client > Tutorial (the guided tutorial with the notes).
	- 1.5: Rooms (furniture, people, seats and exit doors inside buildings that have a use; houses stay
	  closed), ConversationService + Client > Conversation (the cinematic conversation scenes),
	  and the 🆘 Unstuck button (handled in Main).
	  Room furniture is in Workspace > Rooms when you press Play.
	- Chat commands also work, starting with ;  for example:  ;kick name reason   ;setcells me 1000
]]

return {}
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000000000000000000000000001A"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[-- AdminService: ranks (from the community + manual), admin commands, logs,
-- the Brain Shredder ban, live config and global messages.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local TextChatService = game:GetService("TextChatService")
local MessagingService = game:GetService("MessagingService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)
local ShopService = require(script.Parent.ShopService)

local AdminService = {}

AdminService.locked = false
local logs = {}
local muted = {}
local duck = nil

local liveStore = nil
local bugStore = nil
pcall(function()
	liveStore = DataStoreService:GetDataStore("BrainLiveConfig_v1")
	bugStore = DataStoreService:GetDataStore("BrainBugReports_v1")
end)

---------------------------------------------------------------------
-- Ranks
---------------------------------------------------------------------
local function groupId(): number
	if Config.GroupId ~= 0 then
		return Config.GroupId
	end
	if game.CreatorType == Enum.CreatorType.Group then
		return game.CreatorId
	end
	return 0
end

function AdminService.resolveRank(player: Player): number
	local level = 0
	if RunService:IsStudio() and Config.StudioIsOwner then
		level = 4
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId ~= 0 and player.UserId == game.CreatorId then
		level = 4
	end
	if table.find(Config.OwnerUserIds, player.UserId) then
		level = 4
	end
	local gid = groupId()
	if gid ~= 0 then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(gid)
		end)
		if ok and rank then
			if rank == 255 then
				level = math.max(level, 4)
			else
				for _, m in ipairs(Config.GroupRankMap) do
					if rank >= m.minRank then
						level = math.max(level, m.level)
						break
					end
				end
			end
		end
	end
	local data = DataService.get(player)
	if data and data.manualRank then
		level = math.max(level, math.clamp(data.manualRank, 0, 3))
	end
	player:SetAttribute("Rank", level)
	BrainService.applyCharacter(player)
	BrainService.push(player)
	return level
end

local function rankOf(player: Player): number
	return player:GetAttribute("Rank") or 0
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function addLog(actor: Player, cmd: string, target: Player?, arg: string?)
	local entry = string.format(
		"[%s] %s (%s) → %s%s%s",
		os.date("!%m-%d %H:%M", os.time()),
		actor.Name,
		Config.RankNames[rankOf(actor)],
		cmd,
		target and (" on " .. target.Name) or "",
		(arg and arg ~= "") and (" | " .. arg) or ""
	)
	table.insert(logs, 1, entry)
	while #logs > 200 do
		table.remove(logs)
	end
	print("[Admin] " .. entry)
end

local function filterBroadcast(text: string, fromUserId: number): string?
	text = string.sub(text, 1, 200)
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, fromUserId)
	end)
	if not ok or not result then
		return nil
	end
	local ok2, filtered = pcall(function()
		return result:GetNonChatStringForBroadcastAsync()
	end)
	return ok2 and filtered or nil
end

local function setMuted(target: Player, isMuted: boolean)
	muted[target.UserId] = isMuted or nil
	local channels = TextChatService:FindFirstChild("TextChannels")
	if channels then
		for _, channel in ipairs(channels:GetChildren()) do
			for _, src in ipairs(channel:GetChildren()) do
				if src:IsA("TextSource") and src.UserId == target.UserId then
					src.CanSend = not isMuted
				end
			end
		end
	end
end

local function parseDuration(token: string?): number?
	if not token then
		return nil
	end
	token = string.lower(token)
	if token == "perm" or token == "permanent" then
		return -1
	end
	local n, unit = string.match(token, "^(%d+)([hdm]?)$")
	n = tonumber(n)
	if not n then
		return nil
	end
	if unit == "h" then
		return n * 3600
	elseif unit == "m" then
		return n * 60
	end
	return n * 86400
end

local function publish(topic: string, message)
	pcall(function()
		MessagingService:PublishAsync(topic, message)
	end)
end

local function saveLiveConfig()
	local payload = { features = Config.Features, rates = Config.Rates }
	if liveStore then
		pcall(function()
			liveStore:SetAsync("config", payload)
		end)
	end
	publish("BrainLiveConfig", payload)
end

local function applyLiveConfig(payload)
	if typeof(payload) ~= "table" then
		return
	end
	if typeof(payload.features) == "table" then
		for k, v in pairs(payload.features) do
			if Config.Features[k] ~= nil and typeof(v) == "boolean" then
				Config.Features[k] = v
			end
		end
	end
	if typeof(payload.rates) == "table" then
		for k, v in pairs(payload.rates) do
			if Config.Rates[k] ~= nil and typeof(v) == "number" then
				Config.Rates[k] = v
			end
		end
	end
end

local function revertAfter(seconds: number, fn)
	task.delay(seconds, function()
		pcall(fn)
	end)
end

---------------------------------------------------------------------
-- Command handlers: function(actor, target, arg) -> message
---------------------------------------------------------------------
local H = {}

H.setcells = function(actor, target, arg)
	local n = tonumber((string.gsub(arg or "", ",", "")))
	if not n then
		return "Type a number, like 86000000000"
	end
	local data = DataService.get(target)
	data.adminTouched = true -- excluded from leaderboards / world firsts
	BrainService.setCells(target, n)
	return target.Name .. " now has " .. Brain.formatNumber(n) .. " brain cells."
end

H.setpath = function(actor, target, arg)
	local path = string.lower(arg or "") == "gain" and "Gain" or (string.lower(arg or "") == "lose" and "Lose" or nil)
	if not path then
		return "Type Lose or Gain"
	end
	BrainService.startPath(target, path)
	DataService.get(target).adminTouched = true
	WorldService.teleport(target, string.lower(path))
	return target.Name .. " is now on the " .. path .. " path."
end

H.resetme = function(actor)
	local data = DataService.get(actor)
	data.path = nil
	data.cells = Config.LoseStartCells
	data.dead = false
	data.gatesPassed = {}
	data.job = nil
	BrainService.setCells(actor, Config.LoseStartCells)
	data.path = nil
	BrainService.push(actor)
	WorldService.teleport(actor, "lobby")
	return "Your progress was reset."
end

H.replaydeath = function(actor)
	Net.send(actor, "death", { seconds = 1234, best = 1234, clickbait = 42, skipped = 99, moments = { "Walked into a wall for 2 minutes (test)" }, loud = true, test = true })
	return "Replaying the death ending (test only, nothing changes)."
end

H.teleportme = function(actor, _, arg)
	local where = string.lower(arg or "lobby")
	if not WorldService.Spots[where] then
		return "Type lobby, lose or gain"
	end
	WorldService.teleport(actor, where)
	return "Teleported to " .. where .. "."
end

H.debug = function(actor)
	Net.send(actor, "debug", {})
	return "Debug overlay toggled."
end

H.bug = function(actor, _, arg)
	if not arg or arg == "" then
		return "Describe the bug in the text box."
	end
	local char = actor.Character
	local pos = char and char:GetPivot().Position or Vector3.zero
	local data = DataService.get(actor)
	local report = string.format("%s | %s | cells %s | pos %d,%d,%d | %s", os.date("!%Y-%m-%d %H:%M"), actor.Name, Brain.formatNumber(data.cells), pos.X, pos.Y, pos.Z, string.sub(arg, 1, 300))
	if bugStore then
		pcall(function()
			bugStore:UpdateAsync("reports", function(old)
				old = old or {}
				table.insert(old, 1, report)
				while #old > 100 do
					table.remove(old)
				end
				return old
			end)
		end)
	end
	return "Bug report saved. Thank you, tester!"
end

H.refreshrank = function(actor)
	local level = AdminService.resolveRank(actor)
	return "Your rank: " .. Config.RankNames[level]
end

H.kick = function(actor, target, arg)
	target:Kick("You were kicked by staff. " .. (arg or ""))
	return target.Name .. " was kicked."
end

H.warn = function(actor, target, arg)
	local data = DataService.get(target)
	table.insert(data.warnings, { by = actor.Name, reason = arg or "", time = os.time() })
	Net.send(target, "warning", { reason = arg ~= "" and arg or "Please follow the rules." })
	return target.Name .. " was warned (" .. #data.warnings .. " total)."
end

H.mute = function(actor, target)
	setMuted(target, true)
	Net.send(target, "toast", { text = "🔇 You were muted by staff." })
	return target.Name .. " was muted."
end

H.unmute = function(actor, target)
	setMuted(target, false)
	return target.Name .. " was unmuted."
end

H.ban = function(actor, target, arg)
	local token, reason = string.match(arg or "", "^(%S+)%s*(.*)$")
	local seconds = parseDuration(token)
	if not seconds then
		return "Type a duration first: 1d, 7d, 30d or perm (then a reason)."
	end
	local limit = Config.BanLimits[rankOf(actor)] or 0
	if limit ~= -1 and (seconds == -1 or seconds > limit) then
		return "Your rank can only ban for up to " .. math.floor(limit / 3600) .. " hours."
	end
	reason = (reason and reason ~= "") and reason or "Breaking the rules"
	Net.send(target, "banCutscene", { by = actor.DisplayName })
	local userId = target.UserId
	task.delay(4.5, function()
		local ok, err = pcall(function()
			Players:BanAsync({
				UserIds = { userId },
				ApplyToUniverse = true,
				Duration = seconds,
				DisplayReason = "You were thrown into the Brain Shredder. Reason: " .. reason,
				PrivateReason = "Banned by " .. actor.Name .. ": " .. reason,
				ExcludeAltAccounts = false, -- also bans their alt accounts
			})
		end)
		if not ok then
			warn("[Admin] BanAsync failed: " .. tostring(err))
			local p = Players:GetPlayerByUserId(userId)
			if p then
				p:Kick("You were banned: " .. reason)
			end
		end
	end)
	return target.Name .. " goes into the Brain Shredder (" .. (seconds == -1 and "permanent" or token) .. ")."
end

H.unban = function(actor, _, arg)
	local id = tonumber(arg)
	if not id then
		return "Type the player's user ID."
	end
	local ok, err = pcall(function()
		Players:UnbanAsync({ UserIds = { id }, ApplyToUniverse = true })
	end)
	return ok and ("Unbanned user " .. id .. ".") or ("Unban failed: " .. tostring(err))
end

H.tp = function(actor, target)
	if actor.Character and target.Character then
		actor.Character:PivotTo(target.Character:GetPivot() * CFrame.new(0, 0, 4))
	end
	return "Teleported to " .. target.Name .. "."
end

H.bring = function(actor, target)
	if actor.Character and target.Character then
		target.Character:PivotTo(actor.Character:GetPivot() * CFrame.new(0, 0, -4))
	end
	return "Brought " .. target.Name .. "."
end

H.freeze = function(actor, target)
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = true
	end
	return target.Name .. " is frozen."
end

H.unfreeze = function(actor, target)
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = false
	end
	return target.Name .. " is unfrozen."
end

H.viewstats = function(actor, target)
	local data = DataService.get(target)
	return string.format(
		"%s | Path: %s | Cells: %s | %s | Coins: %d | Warnings: %d | Rank: %s",
		target.Name,
		tostring(data.path),
		Brain.formatNumber(data.cells),
		Brain.iqText(data.cells, data.path),
		data.coins,
		#data.warnings,
		Config.RankNames[rankOf(target)]
	)
end

H.smsg = function(actor, _, arg)
	local text = filterBroadcast(arg or "", actor.UserId)
	if not text or text == "" then
		return "Message blocked or empty."
	end
	Net.broadcast("announce", { text = text, by = actor.DisplayName })
	return "Sent."
end

H.secretanimals = function()
	BrainService.secretAnimals = not BrainService.secretAnimals
	for _, p in ipairs(Players:GetPlayers()) do
		BrainService.applyCharacter(p)
		BrainService.push(p)
	end
	return "Secret animals are now " .. (BrainService.secretAnimals and "ON (tardigrade, microbe)" or "OFF") .. " in this server."
end

H.rubberduck = function()
	if duck and duck.Parent then
		duck:Destroy()
		duck = nil
		return "Rubber Duck removed."
	end
	duck = WorldService.spawnRubberDuck()
	return "🦆 The Rubber Duck appeared in the lobby (this server only)."
end

H.setrank = function(actor, target, arg)
	local newRank = tonumber(arg)
	local limit = Config.RankGiveLimit[rankOf(actor)] or 0
	if not newRank or newRank < 0 or newRank > 3 then
		return "Type 0 (Player), 1 (Tester), 2 (Moderator) or 3 (Head Moderator)."
	end
	if newRank > limit then
		return "Your rank can give up to " .. Config.RankNames[limit] .. "."
	end
	DataService.get(target).manualRank = newRank
	local level = AdminService.resolveRank(target)
	return target.Name .. " is now " .. Config.RankNames[level] .. " (community ranks still apply)."
end

H.givepass = function(actor, target, arg)
	local wanted = string.lower(arg or "")
	for key in pairs(Config.GamePasses) do
		if string.lower(key) == wanted then
			ShopService.grant(target, key, false)
			return "Gave " .. key .. " to " .. target.Name .. "."
		end
	end
	local names = {}
	for key in pairs(Config.GamePasses) do
		table.insert(names, key)
	end
	return "Pass names: " .. table.concat(names, ", ")
end

H.lock = function()
	AdminService.locked = true
	return "Server locked. Only staff can join."
end

H.unlock = function()
	AdminService.locked = false
	return "Server unlocked."
end

H.shutdown = function(actor)
	for _, p in ipairs(Players:GetPlayers()) do
		DataService.save(p, true)
		p:Kick("This server was shut down by staff. Your progress is saved. Rejoin to keep playing!")
	end
	return "Shutting down."
end

H.announce = function(actor, _, arg)
	local text = filterBroadcast(arg or "", actor.UserId)
	if not text or text == "" then
		return "Message blocked or empty."
	end
	Net.broadcast("announce", { text = text, by = actor.DisplayName, global = true })
	publish("BrainAnnounce", { text = text, by = actor.DisplayName, from = game.JobId })
	return "Global announcement sent."
end

H.feature = function(actor, _, arg)
	local wanted = string.lower(arg or "")
	for k, v in pairs(Config.Features) do
		if string.lower(k) == wanted then
			Config.Features[k] = not v
			saveLiveConfig()
			return k .. " is now " .. (Config.Features[k] and "ON" or "OFF") .. " in all servers."
		end
	end
	local names = {}
	for k in pairs(Config.Features) do
		table.insert(names, k)
	end
	return "Features: " .. table.concat(names, ", ")
end

H.liveconfig = function(actor, _, arg)
	local k, v = string.match(arg or "", "^(%S+)%s+(%S+)$")
	v = tonumber(v)
	if not k or not v or Config.Rates[k] == nil then
		return "Type: GainRate 0.002  or  LoseRate 0.03  or  MinLoss 1"
	end
	if v < 0 or v > 1000 then
		return "That number is out of range."
	end
	Config.Rates[k] = v
	saveLiveConfig()
	return k .. " set to " .. v .. " in all servers."
end

H.election = function()
	if not AdminService.runElection then
		return "Elections aren't ready."
	end
	task.spawn(AdminService.runElection)
	return "🗳 Election started!"
end

-- More tools
local jails = {}
local quiz = nil
local QUIZ = {
	{ q = "How many brain cells does an average human have?", options = { "86 million", "86 billion", "86 trillion", "302" }, answer = 2 },
	{ q = "Which animal has exactly 302 neurons?", options = { "Bee", "C. elegans worm", "Mouse", "Octopus" }, answer = 2 },
	{ q = "Who counted exactly 60 coffee beans per cup?", options = { "Einstein", "Tesla", "Beethoven", "Darwin" }, answer = 3 },
	{ q = "What is 7 × 8?", options = { "54", "56", "58", "64" }, answer = 2 },
	{ q = "Which planet is the hottest?", options = { "Mercury", "Venus", "Mars", "Jupiter" }, answer = 2 },
}

H.pm = function(actor, target, arg)
	local text = filterBroadcast(arg or "", actor.UserId)
	if not text or text == "" then
		return "Message blocked or empty."
	end
	Net.send(target, "announce", { text = "✉️ " .. text, by = actor.DisplayName .. " (staff)" })
	return "Sent to " .. target.Name .. "."
end
H.spectate = function(actor, target)
	Net.send(actor, "spectate", { userId = target.UserId })
	return "Spectating " .. target.Name .. ". Use Stop Spectating to come back."
end
H.unspectate = function(actor)
	Net.send(actor, "spectate", {})
	return "Back to your own camera."
end
H.jail = function(actor, target)
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return "No character."
	end
	if jails[target.UserId] then
		jails[target.UserId]:Destroy()
	end
	local cage = Instance.new("Model")
	cage.Name = "Jail_" .. target.Name
	local c = CFrame.new(root.Position - Vector3.new(0, 3, 0))
	for _, info in ipairs({
		{ Vector3.new(0, 0, 0), Vector3.new(10, 0.6, 10) },
		{ Vector3.new(0, 11, 0), Vector3.new(10, 0.6, 10) },
		{ Vector3.new(5, 5.5, 0), Vector3.new(0.6, 11, 10) },
		{ Vector3.new(-5, 5.5, 0), Vector3.new(0.6, 11, 10) },
		{ Vector3.new(0, 5.5, 5), Vector3.new(10, 11, 0.6) },
		{ Vector3.new(0, 5.5, -5), Vector3.new(10, 11, 0.6) },
	}) do
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = info[2]
		p.CFrame = c * CFrame.new(info[1])
		p.Material = Enum.Material.ForceField
		p.Color = Color3.fromRGB(255, 80, 80)
		p.Parent = cage
	end
	cage.Parent = workspace
	jails[target.UserId] = cage
	return target.Name .. " is in jail. 🚔"
end
H.unjail = function(actor, target)
	if jails[target.UserId] then
		jails[target.UserId]:Destroy()
		jails[target.UserId] = nil
	end
	return target.Name .. " is free."
end
H.respawn = function(actor, target)
	target:LoadCharacter()
	return target.Name .. " respawned."
end
H.clearjunk = function()
	local n = 0
	for _, d in ipairs(workspace:GetChildren()) do
		if d.Name == "RainItem" or d.Name == "RainBrain" or d.Name == "Pigeon" or d.Name == "RubberChicken" then
			d:Destroy()
			n += 1
		end
	end
	return "Cleared " .. n .. " things."
end
local function numberArg(arg, lo, hi)
	local n = tonumber(arg)
	if not n then
		return nil
	end
	return math.clamp(n, lo, hi)
end
H.speed = function(actor, target, arg)
	local n = numberArg(arg, 0, 200)
	local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if not n or not hum then
		return "Type a number."
	end
	hum.WalkSpeed = n
	return target.Name .. " walk speed = " .. n .. " (resets on respawn)."
end
H.jump = function(actor, target, arg)
	local n = numberArg(arg, 0, 300)
	local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if not n or not hum then
		return "Type a number."
	end
	hum.UseJumpPower = true
	hum.JumpPower = n
	return target.Name .. " jump power = " .. n .. "."
end
H.size = function(actor, target, arg)
	local n = numberArg(arg, 0.3, 3)
	if not n or not target.Character then
		return "Type a size between 0.3 and 3."
	end
	pcall(function()
		target.Character:ScaleTo(n)
	end)
	target.Character:SetAttribute("AppliedScale", n)
	return target.Name .. " size = " .. n .. "."
end
H.coins = function(actor, target, arg)
	local n = numberArg(arg, -1e6, 1e6)
	if not n then
		return "Type a number."
	end
	local data = DataService.get(target)
	data.coins = math.max(0, data.coins + n)
	BrainService.push(target)
	return target.Name .. " now has " .. math.floor(data.coins) .. " coins."
end
H.stress = function(actor, target, arg)
	local n = numberArg(arg, 0, 100)
	if not n then
		return "Type 0 – 100."
	end
	local data = DataService.get(target)
	BrainService.stress(target, n - data.stress)
	return target.Name .. " stress = " .. n .. "."
end
H.embarrass = function(actor, target, arg)
	local n = numberArg(arg, 0, 100)
	if not n then
		return "Type 0 – 100."
	end
	DataService.get(target).embarrass = n
	BrainService.push(target)
	return target.Name .. " embarrassment = " .. n .. "."
end
H.givegadget = function(actor, target, arg)
	local key = string.lower(arg or "")
	local Content = require(ReplicatedStorage.Shared.Content)
	for _, inv in ipairs(Content.Inventions) do
		if inv.key == key then
			DataService.get(target).inventions[key] = true
			if key == "duck" then
				target:SetAttribute("DuckPet", true)
			end
			Net.send(target, "inventionGift", { icon = inv.icon, name = inv.name, desc = inv.desc })
			return "Gave " .. inv.name .. " to " .. target.Name .. "."
		end
	end
	return "Unknown gadget."
end
H.skipgate = function(actor, target)
	local gate = BrainService.nextGate(target)
	if not gate then
		return "No gate ahead."
	end
	DataService.get(target).gatesPassed[gate.id] = true
	DataService.get(target).adminTouched = true
	BrainService.resetGateNotice(target)
	BrainService.push(target)
	return target.Name .. " passed " .. gate.name .. "."
end
H.resettutorial = function(actor, target)
	local s = DataService.get(target).settings
	s.tutLose, s.tutGain = 1, 1
	s.tutNotes, s.tutLose2, s.tutGain2, s.tutLose2Done, s.tutGain2Done = 0, 1, 1, false, false
	BrainService.push(target)
	Net.send(target, "tutorialReset", {})
	return "Tutorial reset for " .. target.Name .. "."
end
H.bringall = function(actor)
	local root = actor.Character and actor.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return "No character."
	end
	for i, p in ipairs(Players:GetPlayers()) do
		if p ~= actor and p.Character then
			p.Character:PivotTo(root.CFrame * CFrame.new(math.cos(i) * 6, 0, math.sin(i) * 6))
		end
	end
	return "Everyone's here."
end
H.muteall = function()
	for _, p in ipairs(Players:GetPlayers()) do
		if rankOf(p) < 1 then
			setMuted(p, true)
		end
	end
	return "Everyone (except staff) is muted."
end
H.unmuteall = function()
	for _, p in ipairs(Players:GetPlayers()) do
		setMuted(p, false)
	end
	return "Everyone is unmuted."
end
H.invent = function(actor, _, arg)
	if not AdminService.adminInvent then
		return "Not ready."
	end
	return AdminService.adminInvent(string.lower(arg or ""), actor.DisplayName) and "🔬 Invention hour started in every server!" or "Unknown invention. Try: teleport, space, fusion, hunger, water, cure, translator, superconductor, battery, climate, robots, labfood"
end
H.quiz = function()
	local q = QUIZ[math.random(1, #QUIZ)]
	quiz = { id = os.clock(), answer = q.answer, winner = nil }
	Net.broadcast("quiz", { id = quiz.id, q = q.q, options = q.options })
	return "❓ Quiz sent to everyone. First correct answer wins 50 coins."
end
Net.on("quiz_answer", function(player, d)
	if not quiz or d.id ~= quiz.id then
		return { ok = false, msg = "Too late!" }
	end
	if quiz.winner then
		return { ok = false, msg = quiz.winner .. " already won!" }
	end
	if tonumber(d.choice) ~= quiz.answer then
		return { ok = true, msg = "❌ Wrong!" }
	end
	quiz.winner = player.DisplayName
	local data = DataService.get(player)
	if data then
		data.coins += 50
		BrainService.push(player)
	end
	Net.broadcast("announce", { text = "❓ " .. player.DisplayName .. " won the quiz! +50 coins", by = "Dr. Wrinkles" })
	return { ok = true, msg = "✅ You won! +50 coins" }
end)

H.logs = function()
	return "Logs refreshed."
end

-- Fun
H.brainrain = function()
	WorldService.brainRain(30)
	return "🧠 It's raining brains!"
end
H.chicken = function()
	WorldService.spawnChicken()
	return "🐔 A rubber chicken appeared somewhere in the lobby."
end
H.laugh = function()
	Net.broadcast("friendsLaugh", { all = true })
	return "😂 Everyone's friends laugh."
end
H.narrator = function(actor, _, arg)
	local text = filterBroadcast(arg or "", actor.UserId)
	if not text or text == "" then
		return "Message blocked or empty."
	end
	Net.broadcast("narrator", { text = text, mood = "host" })
	return "Dr. Wrinkles said it."
end
H.weather = function(actor, _, arg)
	local kind = string.lower(arg or "duckstorm")
	Net.broadcast("weather", { kind = kind, seconds = 60 })
	return "Weather: " .. kind .. " for 60 seconds."
end
H.bighead = function(actor, target)
	local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	local hs = hum and hum:FindFirstChild("HeadScale")
	if hs and hs:IsA("NumberValue") then
		local old = hs.Value
		hs.Value = 3
		revertAfter(60, function()
			hs.Value = old
		end)
		return "🎈 Big head for 60 seconds."
	end
	return "This avatar can't change head size (R15 only)."
end
H.crayon = function(actor, target)
	local char = target.Character
	if not char then
		return "No character."
	end
	local saved = {}
	local colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 160, 255), Color3.fromRGB(255, 220, 60), Color3.fromRGB(90, 220, 90) }
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			saved[d] = { d.Color, d.Material }
			d.Color = colors[math.random(1, #colors)]
			d.Material = Enum.Material.SmoothPlastic
		end
	end
	revertAfter(60, function()
		for p, v in pairs(saved) do
			if p.Parent then
				p.Color = v[1]
				p.Material = v[2]
			end
		end
	end)
	return "🖍 " .. target.Name .. " is a crayon drawing for 60 seconds."
end
H.kazoo = function()
	Net.broadcast("kazoo", { seconds = 60 })
	return "🎺 Kazoo mode for 60 seconds."
end
H.confetti = function()
	Net.broadcast("confetti", {})
	return "🎉 Confetti!"
end
H.gravity = function(actor, _, arg)
	local kind = string.lower(arg or "low")
	local values = { low = 40, normal = 196.2, high = 400 }
	local g = values[kind]
	if not g then
		return "Type low, normal or high"
	end
	workspace.Gravity = g
	if kind ~= "normal" then
		revertAfter(60, function()
			workspace.Gravity = 196.2
		end)
	end
	return "Gravity: " .. kind .. (kind ~= "normal" and " for 60 seconds." or ".")
end
H.swapdoors = function()
	WorldService.swapDoors()
	Net.broadcast("swapDoors", {})
	return "🚪 Door signs swapped. Chaos."
end

-- Owner only
H.shutdownall = function()
	publish("BrainShutdown", { reason = "Update" })
	for _, p in ipairs(Players:GetPlayers()) do
		DataService.save(p, true)
		p:Kick("The game is updating! Your progress is saved. Rejoin in a minute.")
	end
	return "All servers are shutting down."
end

H.wipedata = function(actor, _, arg)
	local id = tonumber(arg)
	if not id then
		return "Type the user ID."
	end
	local online = Players:GetPlayerByUserId(id)
	if online then
		online:Kick("Your data was deleted at your request.")
	end
	task.wait(1)
	return DataService.wipe(id) and ("Deleted data for user " .. id .. ".") or "Delete failed."
end

H.killswitch = function()
	Config.Features.Purchases = not Config.Features.Purchases
	saveLiveConfig()
	return "Purchases are now " .. (Config.Features.Purchases and "ON" or "PAUSED") .. " in all servers."
end

---------------------------------------------------------------------
-- Running a command (panel and chat)
---------------------------------------------------------------------
function AdminService.execute(actor: Player, cmd: string, targetUserId: number?, arg: string?)
	cmd = string.lower(cmd or "")
	local def = Config.Commands[cmd]
	local handler = H[cmd]
	if not def or not handler then
		return { ok = false, msg = "Unknown command." }
	end
	local level = rankOf(actor)
	if level < def.min then
		return { ok = false, msg = "Your rank can't use that." }
	end
	local target = nil
	if def.target then
		target = targetUserId and Players:GetPlayerByUserId(targetUserId) or nil
		if not target and def.selfBelow and level < def.selfBelow then
			target = actor
		end
		if not target then
			return { ok = false, msg = "Pick a player first." }
		end
		if target ~= actor then
			if def.selfBelow and level < def.selfBelow then
				return { ok = false, msg = "Your rank can only use this on yourself." }
			end
			if rankOf(target) >= level then
				return { ok = false, msg = "You can't use that on someone with an equal or higher rank." }
			end
		end
		if not DataService.get(target) then
			return { ok = false, msg = "That player is still loading." }
		end
	end
	local ok, result = pcall(handler, actor, target, arg or "")
	if not ok then
		warn("[Admin] " .. cmd .. " error: " .. tostring(result))
		return { ok = false, msg = "Command failed." }
	end
	if cmd ~= "logs" and cmd ~= "viewstats" and cmd ~= "debug" then
		addLog(actor, cmd, target, arg)
	end
	return { ok = true, msg = result }
end

Net.on("admin", function(player, d)
	return AdminService.execute(player, d.cmd, tonumber(d.target), typeof(d.arg) == "string" and d.arg or "")
end)

Net.on("admin_players", function(player)
	if rankOf(player) < 1 then
		return { ok = false }
	end
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local data = DataService.get(p)
		table.insert(list, {
			userId = p.UserId,
			name = p.Name,
			display = p.DisplayName,
			rank = rankOf(p),
			cells = data and Brain.formatNumber(data.cells) or "?",
			path = data and data.path or "Lobby",
		})
	end
	return { ok = true, players = list }
end)

Net.on("admin_logs", function(player)
	if rankOf(player) < 3 then
		return { ok = false }
	end
	return { ok = true, logs = logs }
end)

local function onChatted(player: Player, message: string)
	if string.sub(message, 1, 1) ~= ";" or rankOf(player) < 1 then
		return
	end
	local words = {}
	for w in string.gmatch(string.sub(message, 2), "%S+") do
		table.insert(words, w)
	end
	local cmd = string.lower(words[1] or "")
	local def = Config.Commands[cmd]
	if not def then
		Net.send(player, "toast", { text = "Unknown command: " .. cmd })
		return
	end
	local targetId = nil
	local argStart = 2
	if def.target and words[2] then
		local wanted = string.lower(words[2])
		if wanted == "me" then
			targetId = player.UserId
			argStart = 3
		else
			for _, p in ipairs(Players:GetPlayers()) do
				if string.sub(string.lower(p.Name), 1, #wanted) == wanted or string.sub(string.lower(p.DisplayName), 1, #wanted) == wanted then
					targetId = p.UserId
					argStart = 3
					break
				end
			end
		end
	end
	local arg = table.concat(words, " ", argStart)
	local result = AdminService.execute(player, cmd, targetId, arg)
	Net.send(player, "toast", { text = (result.ok and "✅ " or "⛔ ") .. tostring(result.msg) })
end

---------------------------------------------------------------------
-- Joining, live config, cross-server messages
---------------------------------------------------------------------
function AdminService.onJoin(player: Player)
	local level = AdminService.resolveRank(player)
	if AdminService.locked and level < 2 then
		player:Kick("This server is locked right now. Try another server!")
		return false
	end
	player.Chatted:Connect(function(msg)
		onChatted(player, msg)
	end)
	if muted[player.UserId] then
		setMuted(player, true)
	end
	return true
end

function AdminService.start()
	if liveStore then
		local ok, payload = pcall(function()
			return liveStore:GetAsync("config")
		end)
		if ok then
			applyLiveConfig(payload)
		end
	end
	pcall(function()
		MessagingService:SubscribeAsync("BrainLiveConfig", function(msg)
			applyLiveConfig(msg.Data)
		end)
	end)
	pcall(function()
		MessagingService:SubscribeAsync("BrainAnnounce", function(msg)
			local d = msg.Data
			if typeof(d) == "table" and d.from ~= game.JobId then
				Net.broadcast("announce", { text = d.text, by = d.by, global = true })
			end
		end)
	end)
	pcall(function()
		MessagingService:SubscribeAsync("BrainShutdown", function()
			for _, p in ipairs(Players:GetPlayers()) do
				DataService.save(p, true)
				p:Kick("The game is updating! Your progress is saved. Rejoin in a minute.")
			end
		end)
	end)
	-- Re-apply mutes when chat sources appear
	local channels = TextChatService:FindFirstChild("TextChannels")
	if channels then
		channels.DescendantAdded:Connect(function(d)
			if d:IsA("TextSource") and muted[d.UserId] then
				d.CanSend = false
			end
		end)
	end
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">BrainService</string><ProtectedString name="Source"><![CDATA[-- BrainService: brain cells, IQ, stages, meters, badges, narrator and character looks.

local Players = game:GetService("Players")
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Brain = require(Shared.Brain)
local Badges = require(Shared.Badges)
local Content = require(Shared.Content)
local Narration = require(Shared.Narration)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)

local BrainService = {}

BrainService.secretAnimals = false
BrainService.hooks = {} -- onDeath(player), onPathReset(player)
BrainService.boost = { Gain = 1, Lose = 1 } -- election boosts (update 1.2)
BrainService.spaceInvented = function()
	return false
end -- set by SpaceService (update 1.4)
BrainService.isAstronaut = function(_player)
	return false
end -- set by SpaceService (update 1.4)

-- Endless Castle reward (update 1.4): 2x speed in YOUR path's direction for 30 minutes
local function castleMult(data): number
	return (data.castleBoostUntil or 0) > os.time() and 2 or 1
end
BrainService.extraSpeed = function()
	return 0
end -- set by ProjectService (superconductor invention)

local runtime = {} -- [player] = { hidingUntil, frozen, lastStage, lastTier, gateNotified, dirty }

local function rt(player)
	local r = runtime[player]
	if not r then
		r = { hidingUntil = 0, frozen = false, lastStage = nil, lastTier = nil, gateNotified = false, dirty = true }
		runtime[player] = r
	end
	return r
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
function BrainService.data(player)
	return DataService.get(player)
end

function BrainService.feature(name: string): boolean
	return Config.Features[name] ~= false
end

function BrainService.toast(player, text, sound)
	Net.send(player, "toast", { text = text, sound = sound })
end

function BrainService.narrate(player, event)
	local data = DataService.get(player)
	if not data then
		return
	end
	local mood = Brain.narratorMood(data.cells)
	Net.send(player, "narrator", { text = Narration.line(mood, event), mood = mood })
end

function BrainService.say(player, text)
	local data = DataService.get(player)
	local mood = data and Brain.narratorMood(data.cells) or "host"
	Net.send(player, "narrator", { text = text, mood = mood })
end

function BrainService.awardBadge(player, badgeKey: string)
	local data = DataService.get(player)
	local badge = Badges[badgeKey]
	if not data or not badge or data.badges[badgeKey] then
		return
	end
	data.badges[badgeKey] = true
	if badge.id and badge.id > 0 then
		task.spawn(function()
			pcall(function()
				BadgeService:AwardBadge(player.UserId, badge.id)
			end)
		end)
	end
	Net.send(player, "badge", { name = badge.name, desc = badge.desc })
end

---------------------------------------------------------------------
-- Gates
---------------------------------------------------------------------
function BrainService.nextGate(player)
	local data = DataService.get(player)
	if not data or data.path ~= "Gain" or not BrainService.feature("Gates") then
		return nil
	end
	for _, gate in ipairs(Config.Gates) do
		if not data.gatesPassed[gate.id] then
			return gate
		end
	end
	return nil
end

function BrainService.gateCap(player): number?
	local gate = BrainService.nextGate(player)
	if gate then
		return Brain.cellsForIQ(gate.iq)
	end
	return nil
end

function BrainService.resetGateNotice(player)
	rt(player).gateNotified = false
end

function BrainService.atGate(player): boolean
	local cap = BrainService.gateCap(player)
	local data = DataService.get(player)
	return cap ~= nil and data ~= nil and data.cells >= cap - 1
end

---------------------------------------------------------------------
-- Glasses
---------------------------------------------------------------------
function BrainService.currentGlasses(player)
	local data = DataService.get(player)
	if not data or data.path ~= "Gain" then
		return nil
	end
	local iq = Brain.iq(data.cells)
	local best = nil
	for _, g in ipairs(Content.Glasses) do
		if iq >= g.minIQ then
			best = g
		end
	end
	return best
end

---------------------------------------------------------------------
-- State sent to the client
---------------------------------------------------------------------
function BrainService.state(player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local r = rt(player)
	local cells = data.cells
	local stage = Brain.stage(cells, BrainService.secretAnimals)
	local mult, multLabel = Brain.gainMultiplier(cells)
	local gate = BrainService.nextGate(player)
	local glasses = BrainService.currentGlasses(player)
	local job = nil
	for _, j in ipairs(Content.Jobs) do
		if j.id == data.job then
			job = j.name
		end
	end
	return {
		cells = cells,
		cellsText = Brain.formatNumber(cells),
		path = data.path,
		iq = Brain.iq(cells),
		iqText = Brain.iqText(cells, data.path),
		rarity = Brain.rarityText(cells, data.path),
		tier = Brain.artTier(cells),
		mood = Brain.narratorMood(cells),
		stage = stage.key,
		stageName = stage.name,
		stageEmoji = stage.emoji,
		mult = mult,
		multLabel = data.path == "Gain" and multLabel or "",
		embarrass = data.embarrass,
		meterBroken = data.path == "Lose" and cells < Config.Embarrassment.BreaksBelowCells,
		hiding = os.clock() < r.hidingUntil,
		stress = data.stress,
		frozen = r.frozen,
		coins = data.coins,
		job = job,
		glasses = glasses and glasses.name or nil,
		glassesDesc = glasses and glasses.desc or nil,
		gate = gate and gate.name or nil,
		atGate = BrainService.atGate(player),
		rank = player:GetAttribute("Rank") or 0,
		settings = data.settings,
		perks = data.perks,
		comeback = data.comeback,
		dead = data.dead == true,
		canSave = DataService.canSave(player),
		-- 1.4
		astronaut = BrainService.isAstronaut(player),
		spaceInvented = BrainService.spaceInvented(),
		retired = data.retired == true,
		smartestTitle = data.smartestTitle,
		castleMap = data.castleMap == true,
		castleBoostLeft = math.max(0, (data.castleBoostUntil or 0) - os.time()),
		overflow = data.cells > Config.OverflowCells,
		tutNotes = data.settings and data.settings.tutNotes or 0,
	}
end

function BrainService.push(player)
	rt(player).dirty = true
end

local function flush(player)
	local st = BrainService.state(player)
	if st then
		Net.send(player, "state", st)
		player:SetAttribute("BrainCells", st.cells)
		player:SetAttribute("Path", st.path)
		player:SetAttribute("ArtTier", st.tier)
		player:SetAttribute("Stage", st.stage)
		local ls = player:FindFirstChild("leaderstats")
		if ls then
			ls["Brain Cells"].Value = st.cellsText
			ls.Path.Value = st.path or "Lobby"
		end
	end
	rt(player).dirty = false
end

---------------------------------------------------------------------
-- Character looks: animal stage, scale, glasses, labels
---------------------------------------------------------------------
local function makeOverhead(player, char)
	local head = char:FindFirstChild("Head")
	if not head then
		return nil
	end
	local gui = head:FindFirstChild("Overhead")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "Overhead"
		gui.Size = UDim2.new(8, 0, 1.4, 0) -- studs, so it shrinks with distance
		gui.StudsOffset = Vector3.new(0, 2.4, 0)
		gui.AlwaysOnTop = false
		gui.MaxDistance = 80
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextStrokeTransparency = 0.4
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Parent = gui
	end
	return gui
end

local function weldTo(part, head, offset)
	part.CanCollide = false
	part.Massless = true
	part.Anchored = false
	part.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part
	part.Parent = head.Parent
end

function BrainService.applyCharacter(player)
	local char = player.Character
	local data = DataService.get(player)
	if not char or not data then
		return
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	if not humanoid or not head then
		return
	end
	local stage = Brain.stage(data.cells, BrainService.secretAnimals)
	if data.cells > 0 and humanoid.Health > 0 then
		humanoid.WalkSpeed = (rt(player).frozen and 0) or (stage.walk + BrainService.extraSpeed())
	end

	-- scale (animals are smaller)
	local wantScale = stage.scale
	if char:GetAttribute("AppliedScale") ~= wantScale then
		char:SetAttribute("AppliedScale", wantScale)
		pcall(function()
			char:ScaleTo(wantScale)
		end)
	end

	-- Overflow zone (1.4): too much brain, your head gets HUGE
	local headScale = humanoid:FindFirstChild("HeadScale")
	if headScale and headScale:IsA("NumberValue") then
		local want = 1
		if data.path == "Gain" and data.cells > Config.OverflowCells then
			want = math.clamp(1 + math.log10(data.cells / Config.OverflowCells) * 2, 1, 3)
		end
		if math.abs(headScale.Value - want) > 0.05 then
			headScale.Value = want
		end
	end

	-- glasses (Gain path)
	local old = char:FindFirstChild("BrainGlasses")
	if old then
		old:Destroy()
	end
	local glasses = BrainService.currentGlasses(player)
	if glasses then
		local g = Instance.new("Part")
		g.Name = "BrainGlasses"
		g.Size = Vector3.new(1.1, 0.25, 0.1) * (char:GetAttribute("AppliedScale") or 1)
		g.Color = glasses.color
		g.Material = Enum.Material.SmoothPlastic
		weldTo(g, head, CFrame.new(0, 0.15, -0.6 * (char:GetAttribute("AppliedScale") or 1)))
	end

	-- dunce cap (BUY BRAIN pass or the joke shop)
	local cap = char:FindFirstChild("DunceCap")
	if data.perks.DunceCap and not cap then
		local c = Instance.new("Part")
		c.Name = "DunceCap"
		c.Size = Vector3.new(0.8, 1.6, 0.8)
		c.Color = Color3.new(1, 1, 1)
		c.Material = Enum.Material.SmoothPlastic
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.Parent = c
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = "D"
		t.TextScaled = true
		t.Font = Enum.Font.GothamBlack
		t.Parent = sg
		weldTo(c, head, CFrame.new(0, 1.2, 0))
	end

	-- Comeback "scars of stupidity": a bandage from all that wall-walking
	if data.comeback and not char:FindFirstChild("Bandage") then
		local b = Instance.new("Part")
		b.Name = "Bandage"
		b.Size = Vector3.new(0.9, 0.3, 0.2)
		b.Color = Color3.fromRGB(245, 220, 190)
		b.Material = Enum.Material.Fabric
		weldTo(b, head, CFrame.new(0.3, 0.45, -0.6) * CFrame.Angles(0, 0, math.rad(30)))
	elseif not data.comeback and char:FindFirstChild("Bandage") then
		char.Bandage:Destroy()
	end

	-- punishment sign from court (update 1.2)
	local punished = player:GetAttribute("PunishSign")

	-- overhead label: rank tag, animal stage, VIP
	local gui = makeOverhead(player, char)
	if gui then
		local parts = {}
		local rank = player:GetAttribute("Rank") or 0
		if rank > 0 then
			table.insert(parts, "[" .. Config.RankNames[rank] .. "]")
		end
		if data.perks.VIPLibrary then
			table.insert(parts, "[VIP]")
		end
		if stage.key ~= "human" then
			table.insert(parts, stage.emoji .. " " .. stage.name)
		end
		if data.smartestTitle then
			table.insert(parts, "\n👑 World's Smartest " .. tostring(data.smartestTitle))
		elseif data.astronaut and data.path == "Gain" then
			table.insert(parts, "[🧑‍🚀 Astronaut]")
		end
		if punished then
			table.insert(parts, "\n🪧 " .. tostring(punished))
		end
		gui.Text.Text = table.concat(parts, " ")
		gui.Text.TextColor3 = Config.RankColors[rank] or Color3.new(1, 1, 1)
	end
end

---------------------------------------------------------------------
-- After any brain cell change
---------------------------------------------------------------------
local function afterChange(player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local r = rt(player)
	local stage = Brain.stage(data.cells, BrainService.secretAnimals)
	local tier = Brain.artTier(data.cells)

	if r.lastStage and r.lastStage ~= stage.key then
		BrainService.narrate(player, "stage")
		if stage.key ~= "human" and stage.key ~= "dead" then
			BrainService.toast(player, "You are now: " .. stage.emoji .. " " .. stage.name, "CartoonBoing")
		end
		if stage.key == "microbe" then
			BrainService.awardBadge(player, "WhereAmI")
		end
		BrainService.applyCharacter(player)
	end
	if r.lastTier and r.lastTier ~= tier then
		BrainService.applyCharacter(player)
	end
	-- Lose path: meter breaks when you're too dumb to care
	if data.path == "Lose" and data.cells < Config.Embarrassment.BreaksBelowCells and not data.meterBrokenShown then
		data.meterBrokenShown = true
		data.embarrass = 0
		BrainService.narrate(player, "meterBroken")
	end
	-- Comeback (update 1.1): friends apologize at milestones, then Complete Makeover
	if data.comeback and data.path == "Gain" then
		local iq = Brain.iq(data.cells)
		data.apologies = data.apologies or {}
		local APOLOGIES = {
			{ iq = 85, lines = { "wait… you can read now?", "ok that's actually kinda cool", "sorry we laughed 😅" } },
			{ iq = 100, lines = { "you're AVERAGE now?!", "we were wrong about you", "sorry for filming you 📸" } },
			{ iq = 115, lines = { "you're smarter than us 😳", "sorry, for real", "teach me?" } },
			{ iq = 130, lines = { "can u help with my homework?", "pls 🙏", "we're proud of you" } },
		}
		for _, a in ipairs(APOLOGIES) do
			if iq >= a.iq and not data.apologies[tostring(a.iq)] then
				data.apologies[tostring(a.iq)] = true
				Net.send(player, "friendVisit", { lines = a.lines, seconds = 12 })
			end
		end
		if iq >= Config.ComebackMakeoverIQ and not data.badges.CompleteMakeover then
			BrainService.awardBadge(player, "CompleteMakeover")
			Net.send(player, "makeover", { cells = Brain.formatNumber(data.cells), iq = math.floor(iq) })
			Net.broadcast("announce", { text = player.DisplayName .. " completed their COMPLETE MAKEOVER! 🧠✨ (0 → genius)", by = "Dr. Wrinkles", global = false })
		end
	end
	-- Update 1.4: Astronaut at 160, World's Smartest at 200, the Overflow zone
	if data.path == "Gain" and not data.dead then
		local iq = Brain.iq(data.cells)
		if iq >= Config.Space.AstronautIQ and not data.astroNotified and BrainService.hooks.onAstronautIQ then
			data.astroNotified = true
			task.spawn(BrainService.hooks.onAstronautIQ, player)
		end
		if iq >= Config.Space.SmartestIQ and not data.worldsSmartest and BrainService.hooks.onSmartest then
			data.worldsSmartest = true
			task.spawn(BrainService.hooks.onSmartest, player)
		end
		if data.cells >= 257e9 and not data.elephantJoke then
			data.elephantJoke = true
			BrainService.toast(player, "🐘 Congrats, you're as smart as an elephant. Wait…", "CartoonBoing")
		end
		if data.cells >= 1e12 and not data.badges.TooMuchBrain then
			BrainService.awardBadge(player, "TooMuchBrain")
			BrainService.toast(player, "🧠🧠🧠 1 TRILLION brain cells. +1 IQ. Worth it?", "BadgeSparkle")
		end
		if data.cells > Config.OverflowCells and not r.overflowHead then
			r.overflowHead = true
			BrainService.applyCharacter(player)
		end
	end
	if r.overflowHead and data.cells > Config.OverflowCells then
		local bucket = math.floor(math.log10(data.cells / Config.OverflowCells) * 10)
		if bucket ~= r.headBucket then
			r.headBucket = bucket
			BrainService.applyCharacter(player)
		end
	end
	r.lastStage = stage.key
	r.lastTier = tier
	BrainService.push(player)

	if data.path == "Lose" and data.cells <= 0 and not data.dead then
		data.cells = 0
		data.dead = true
		if BrainService.hooks.onDeath then
			task.spawn(BrainService.hooks.onDeath, player)
		end
	end
end

---------------------------------------------------------------------
-- Changing brain cells
---------------------------------------------------------------------
-- Gain points: the "good" direction for Gain players, the "bad" one for Lose players.
function BrainService.gain(player, points: number, reason: string?)
	local data = DataService.get(player)
	if not data or data.dead then
		return 0
	end
	local amount
	if data.path == "Gain" then
		local mult = Brain.gainMultiplier(data.cells)
		local glasses = BrainService.currentGlasses(player)
		local boost = glasses and glasses.boost or 1
		if reason == "library" and data.perks.VIPLibrary then
			boost *= 1.1
		end
		amount = math.max(1, data.cells * Config.Rates.GainRate) * mult * points * boost * BrainService.boost.Gain * castleMult(data)
		local cap = BrainService.gateCap(player)
		if cap and data.cells + amount > cap then
			amount = math.max(0, cap - data.cells)
			if not rt(player).gateNotified then
				rt(player).gateNotified = true
				BrainService.toast(player, "🚧 A Skill Gate blocks your way! Go to the Skill Gate to continue.", "NotificationPing")
			end
		end
	else
		amount = math.max(1, data.cells * Config.Rates.LoseRate) * points
	end
	data.cells += amount
	if amount >= 1 then
		Net.send(player, "delta", { amount = amount, up = true })
	end
	afterChange(player)
	return amount
end

-- Lose points: the goal on the Lose path.
function BrainService.lose(player, points: number, reason: string?)
	local data = DataService.get(player)
	if not data or data.dead then
		return 0
	end
	local amount
	if data.path == "Lose" then
		amount = math.max(data.cells * Config.Rates.LoseRate * points, Config.Rates.MinLoss * points) * BrainService.boost.Lose * castleMult(data)
	else
		amount = data.cells * 0.002 * points
	end
	amount = math.min(amount, data.cells)
	data.cells -= amount
	if amount >= 1 then
		Net.send(player, "delta", { amount = amount, up = false })
	end
	afterChange(player)
	return amount
end

function BrainService.setCells(player, value: number)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.cells = math.max(0, value)
	if data.cells > 0 then
		data.dead = false
	end
	rt(player).gateNotified = false
	afterChange(player)
	BrainService.applyCharacter(player)
end

-- Start or restart a path
function BrainService.startPath(player, path: string, comeback: boolean?)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.path = path
	data.dead = false
	data.comeback = comeback == true
	data.meterBrokenShown = false
	data.embarrass = 0
	data.stress = 0
	data.runStart = os.time()
	data.gatesPassed = {}
	data.job = nil
	data.astroNotified = nil
	data.worldsSmartest = nil
	data.retired = nil
	data.elephantJoke = nil
	data.astroTrained = nil
	if path == "Lose" then
		data.cells = Config.LoseStartCells
	elseif comeback then
		data.cells = 1
	else
		data.cells = Config.GainStartCells
	end
	local r = rt(player)
	r.gateNotified = false
	r.frozen = false
	r.hidingUntil = 0
	r.lastStage = nil
	r.lastTier = nil
	r.overflowHead = nil
	r.headBucket = nil
	afterChange(player)
	BrainService.applyCharacter(player)
	if BrainService.hooks.onPathReset then
		BrainService.hooks.onPathReset(player)
	end
end

---------------------------------------------------------------------
-- Meters
---------------------------------------------------------------------
function BrainService.embarrass(player, amount: number, moment: string?)
	local data = DataService.get(player)
	if not data or data.path ~= "Lose" or data.cells < Config.Embarrassment.BreaksBelowCells then
		return
	end
	data.embarrass = math.clamp(data.embarrass + amount, 0, Config.Embarrassment.Max)
	if moment then
		table.insert(data.embarrassingMoments, 1, moment)
		while #data.embarrassingMoments > 3 do
			table.remove(data.embarrassingMoments)
		end
	end
	Net.send(player, "friendsLaugh", {})
	BrainService.narrate(player, "embarrassed")
	local r = rt(player)
	if data.embarrass > Config.Embarrassment.HideAt and os.clock() >= r.hidingUntil then
		r.hidingUntil = os.clock() + Config.Embarrassment.HideSeconds
		BrainService.narrate(player, "hiding")
		Net.send(player, "hide", { seconds = Config.Embarrassment.HideSeconds })
	end
	BrainService.push(player)
end

function BrainService.stress(player, amount: number)
	local data = DataService.get(player)
	if not data or data.path ~= "Gain" then
		return
	end
	data.stress = math.clamp(data.stress + amount, 0, Config.Stress.Max)
	local r = rt(player)
	if data.stress >= Config.Stress.FreezeAt and not r.frozen then
		r.frozen = true
		BrainService.narrate(player, "stressed")
		BrainService.toast(player, "😵 Too stressed! You're frozen. Do a genius habit (coffee, nap, pigeons) to calm down.", "SadTrombone")
		BrainService.applyCharacter(player)
	elseif r.frozen and data.stress <= 70 then
		r.frozen = false
		BrainService.toast(player, "😌 You feel calm again.", "LibrarianChime")
		BrainService.applyCharacter(player)
	end
	BrainService.push(player)
end

-- Returns a reason string if the player can't do activities right now.
function BrainService.blocked(player): string?
	local data = DataService.get(player)
	if not data then
		return "Loading…"
	end
	if data.dead then
		return "You're dead. (You won!)"
	end
	local r = rt(player)
	if os.clock() < r.hidingUntil then
		return "You're hiding behind a bush from embarrassment!"
	end
	if r.frozen then
		return "You're too stressed! Do a habit first."
	end
	return nil
end

-- 1.5: frozen from stress? (the therapist still lets you in)
function BrainService.isFrozen(player): boolean
	return rt(player).frozen == true
end

---------------------------------------------------------------------
-- Player lifecycle
---------------------------------------------------------------------
function BrainService.setup(player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cellsValue = Instance.new("StringValue")
	cellsValue.Name = "Brain Cells"
	cellsValue.Parent = ls
	local pathValue = Instance.new("StringValue")
	pathValue.Name = "Path"
	pathValue.Parent = ls
	ls.Parent = player

	rt(player)
	afterChange(player)
	flush(player)
end

function BrainService.cleanup(player)
	runtime[player] = nil
end

function BrainService.start()
	-- meter decay + pushing state to clients
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.get(player)
				local r = runtime[player]
				if data and r then
					if data.path == "Lose" and data.embarrass > 0 then
						data.embarrass = math.max(0, data.embarrass - Config.Embarrassment.DecayPerSecond * 0.5)
						r.dirty = true
					end
					if r.dirty then
						flush(player)
					end
				end
			end
		end
	end)
end

return BrainService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">CastleService</string><ProtectedString name="Source"><![CDATA[-- CastleService (update 1.4): the secret Endless Castle
--
--   A plain default-looking house that doesn't fit the town -> a hole in the floor
--   -> the void (it catches you, no death) -> a white room with one cardboard box and
--   a "please $1 more" sign (a joke, nothing is for sale) -> climb in the box
--   -> the Endless Castle: an entrance hall with secret rooms + the Endless Hallway.
--
--   The hallway puzzle: every hallway ends in LEFT or RIGHT. Wrong turn = back to the
--   start (it looks the same, forever). Hints: graffiti, a painting and a humming knight,
--   all from our own rhyme. The route changes every season so guides go out of date.
--   Follow it exactly -> a brick wall -> knock -> it opens -> rewards.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)
local FriendService = require(script.Parent.FriendService)

local CastleService = {}

local HOUSE_RAW = Vector3.new(0, 0.6, -410) -- just outside town, on the grass
local WHITE = Vector3.new(0, 3000, 9000)
local CASTLE = Vector3.new(0, 3000, 12000) -- entrance hall
local HALL = CASTLE + Vector3.new(0, 0, -300) -- the Endless Hallway (start)
local WALL_ROOM = CASTLE + Vector3.new(300, 0, 0)
CastleService.Center = CASTLE
CastleService.White = WHITE

local folder = Instance.new("Folder")
folder.Name = "EndlessCastle"
folder.Parent = workspace

local STONE = Color3.fromRGB(95, 90, 100)
local DARKSTONE = Color3.fromRGB(60, 56, 66)
local CARPET = Color3.fromRGB(140, 25, 40)
local GOLD = Color3.fromRGB(230, 180, 60)

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or folder
	return p
end

local function text(p: BasePart, str: string, color: Color3?, font: Enum.Font?, face: Enum.NormalId?)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.Parent = p
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.TextWrapped = true
	l.Font = font or Enum.Font.Fantasy
	l.TextColor3 = color or Color3.fromRGB(240, 230, 210)
	l.Text = str
	l.Parent = sg
	return l
end

local function prompt(p: BasePart, action: string, object: string, fn, dist: number?)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0.2
	pp.RequiresLineOfSight = false
	pp.MaxActivationDistance = dist or 10
	pp.Parent = p
	pp.Triggered:Connect(fn)
	return pp
end

local function candle(pos: Vector3)
	part({ Name = "Candle", Size = Vector3.new(0.5, 1.4, 0.5), CFrame = CFrame.new(pos), Color = Color3.fromRGB(245, 240, 220), Material = Enum.Material.SmoothPlastic, CanCollide = false })
	local flame = part({ Name = "CandleFlame", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45), CFrame = CFrame.new(pos + Vector3.new(0, 0.95, 0)), Color = Color3.fromRGB(255, 190, 80), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 180, 90)
	light.Range = 16
	light.Brightness = 1.2
	light.Parent = flame
end

-- A closed stone box room
local function room(center: Vector3, size: Vector3, wall: Color3?, floor: Color3?, floorMat: Enum.Material?)
	local w = wall or STONE
	part({ Name = "Floor", Size = Vector3.new(size.X, 1, size.Z), CFrame = CFrame.new(center - Vector3.new(0, 0.5, 0)), Color = floor or DARKSTONE, Material = floorMat or Enum.Material.Cobblestone })
	part({ Name = "Ceiling", Size = Vector3.new(size.X, 1, size.Z), CFrame = CFrame.new(center + Vector3.new(0, size.Y + 0.5, 0)), Color = w, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(size.X, size.Y, 1), CFrame = CFrame.new(center + Vector3.new(0, size.Y / 2, size.Z / 2 + 0.5)), Color = w, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(size.X, size.Y, 1), CFrame = CFrame.new(center + Vector3.new(0, size.Y / 2, -size.Z / 2 - 0.5)), Color = w, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(1, size.Y, size.Z), CFrame = CFrame.new(center + Vector3.new(size.X / 2 + 0.5, size.Y / 2, 0)), Color = w, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(1, size.Y, size.Z), CFrame = CFrame.new(center + Vector3.new(-size.X / 2 - 0.5, size.Y / 2, 0)), Color = w, Material = Enum.Material.Brick })
end

local function tp(player, pos: Vector3, lookDir: Vector3?)
	local char = player.Character
	if char then
		local look = lookDir or Vector3.new(0, 0, -1)
		char:PivotTo(CFrame.lookAt(pos, pos + look))
	end
end

---------------------------------------------------------------------
-- The route (changes every season)
---------------------------------------------------------------------
local function seasonId(): number
	local t = os.date("!*t")
	return t.year * 4 + math.floor((t.month - 1) / 3)
end

local function route()
	local rng = Random.new(seasonId() * 7919)
	local r = {}
	for i = 1, Config.Castle.Steps do
		r[i] = rng:NextInteger(0, 1) == 0 and "L" or "R"
	end
	return r
end

local function hintFor(step: number): string
	local r = route()
	local dir = r[step + 1]
	if not dir then
		return Content.CastleEnd
	end
	local pool = dir == "L" and Content.CastleLeft or Content.CastleRight
	return pool[(step % #pool) + 1]
end

local castleStep = {} -- [player] = turns done correctly in a row
local solvedRun = {} -- [player] = true once they reach the brick wall

---------------------------------------------------------------------
-- Building
---------------------------------------------------------------------
local function buildHouse()
	-- A plain, default-looking house. Grey walls, red roof, nothing else. It does not belong here.
	local c = WorldService.sp(HOUSE_RAW)
	local base = CFrame.new(c)
	local grey = Color3.fromRGB(163, 162, 165)
	part({ Name = "OddHouseFloor", Size = Vector3.new(20, 1, 20), CFrame = base, Color = Color3.fromRGB(99, 95, 98), Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseWall", Size = Vector3.new(20, 12, 1), CFrame = base * CFrame.new(0, 6.5, 10), Color = grey, Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseWall", Size = Vector3.new(1, 12, 20), CFrame = base * CFrame.new(10, 6.5, 0), Color = grey, Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseWall", Size = Vector3.new(1, 12, 20), CFrame = base * CFrame.new(-10, 6.5, 0), Color = grey, Material = Enum.Material.SmoothPlastic })
	-- front wall with an open doorway (facing town)
	part({ Name = "OddHouseWall", Size = Vector3.new(7, 12, 1), CFrame = base * CFrame.new(-6.5, 6.5, -10), Color = grey, Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseWall", Size = Vector3.new(7, 12, 1), CFrame = base * CFrame.new(6.5, 6.5, -10), Color = grey, Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseWall", Size = Vector3.new(6, 4, 1), CFrame = base * CFrame.new(0, 10.5, -10), Color = grey, Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseRoof", Size = Vector3.new(22, 1.2, 22), CFrame = base * CFrame.new(0, 13, 0), Color = Color3.fromRGB(196, 40, 28), Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseRoof", Size = Vector3.new(16, 1.2, 16), CFrame = base * CFrame.new(0, 14.2, 0), Color = Color3.fromRGB(196, 40, 28), Material = Enum.Material.SmoothPlastic })
	part({ Name = "OddHouseRoof", Size = Vector3.new(10, 1.2, 10), CFrame = base * CFrame.new(0, 15.4, 0), Color = Color3.fromRGB(196, 40, 28), Material = Enum.Material.SmoothPlastic })
	-- the hole
	local hole = part({ Name = "TheHole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 7, 7), CFrame = base * CFrame.new(0, 0.55, 3) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.new(0, 0, 0), Material = Enum.Material.SmoothPlastic, CanCollide = false })
	local trigger = part({ Name = "HoleTrigger", Size = Vector3.new(5, 2, 5), CFrame = base * CFrame.new(0, 1.5, 3), Transparency = 1, CanCollide = false })
	local _ = hole
	local falling = {}
	trigger.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		if not player or falling[player] then
			return
		end
		falling[player] = true
		Net.send(player, "voidFall", {})
		task.delay(2.4, function()
			tp(player, WHITE + Vector3.new(0, 4, 30))
			task.wait(1)
			falling[player] = nil
		end)
	end)
	WorldService.Spots.oddhouse = HOUSE_RAW + Vector3.new(0, 3, -24)
end

local boxPleas = 1
local function buildWhiteRoom()
	-- flat, empty, white. One box. One sign.
	part({ Name = "WhiteFloor", Size = Vector3.new(200, 1, 200), CFrame = CFrame.new(WHITE - Vector3.new(0, 0.5, 0)), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic })
	for _, d in ipairs({ Vector3.new(100, 0, 0), Vector3.new(-100, 0, 0), Vector3.new(0, 0, 100), Vector3.new(0, 0, -100) }) do
		part({ Name = "WhiteWall", Size = Vector3.new(d.X == 0 and 200 or 1, 120, d.Z == 0 and 200 or 1), CFrame = CFrame.new(WHITE + d + Vector3.new(0, 60, 0)), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic, Transparency = 0 })
	end
	local box = part({ Name = "CardboardBox", Size = Vector3.new(6, 4.5, 6), CFrame = CFrame.new(WHITE + Vector3.new(0, 2.25, 0)), Color = Color3.fromRGB(190, 145, 90), Material = Enum.Material.Cardboard })
	part({ Name = "BoxTape", Size = Vector3.new(6.05, 0.1, 1), CFrame = CFrame.new(WHITE + Vector3.new(0, 4.5, 0)), Color = Color3.fromRGB(210, 180, 130), Material = Enum.Material.SmoothPlastic, CanCollide = false })
	local post = part({ Name = "SignPost", Size = Vector3.new(0.3, 5, 0.3), CFrame = CFrame.new(WHITE + Vector3.new(6, 2.5, 0)), Color = Color3.fromRGB(120, 85, 50), Material = Enum.Material.Wood })
	local _ = post
	local board = part({ Name = "PleaseSign", Size = Vector3.new(5, 2.4, 0.2), CFrame = CFrame.new(WHITE + Vector3.new(6, 5.6, 0)), Color = Color3.fromRGB(250, 250, 245), Material = Enum.Material.SmoothPlastic })
	text(board, "please $1 more", Color3.fromRGB(40, 40, 40), Enum.Font.Cartoon, Enum.NormalId.Back)
	text(board, "please $1 more", Color3.fromRGB(40, 40, 40), Enum.Font.Cartoon, Enum.NormalId.Front)
	prompt(box, "Climb in", "📦 Cardboard Box", function(player)
		Net.send(player, "castleEnter", {})
		task.delay(1.2, function()
			tp(player, CASTLE + Vector3.new(0, 4, 18))
			BrainService.toast(player, "🏰 The Endless Castle. (The sign was a joke. Nothing here is for sale.)", "LibrarianChime")
		end)
	end)
end

local function door(pos: Vector3, facing: Vector3, label: string, fn)
	local cf = CFrame.lookAt(pos, pos + facing)
	local frame = part({ Name = "DoorArch", Size = Vector3.new(7, 10, 0.6), CFrame = cf * CFrame.new(0, 5, 0), Color = Color3.fromRGB(70, 45, 30), Material = Enum.Material.Wood })
	part({ Name = "DoorDark", Size = Vector3.new(5.6, 8.6, 0.2), CFrame = cf * CFrame.new(0, 4.4, -0.35), Color = Color3.fromRGB(15, 10, 20), Material = Enum.Material.SmoothPlastic, CanCollide = false })
	local plate = part({ Name = "DoorPlate", Size = Vector3.new(6, 1.2, 0.1), CFrame = cf * CFrame.new(0, 10.8, -0.4), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false })
	text(plate, label, Color3.fromRGB(50, 30, 10), Enum.Font.Fantasy, Enum.NormalId.Front)
	prompt(frame, "Enter", label, fn)
	return frame
end

local function backDoor(roomCenter: Vector3, z: number)
	door(roomCenter + Vector3.new(0, 0, z), Vector3.new(0, 0, z > 0 and -1 or 1), "Back to the hall", function(player)
		tp(player, CASTLE + Vector3.new(0, 4, 10))
	end)
end

local function painting(cf: CFrame, str: string, size: Vector3?)
	local s = size or Vector3.new(5, 4, 0.3)
	part({ Name = "Frame", Size = s + Vector3.new(0.6, 0.6, -0.1), CFrame = cf, Color = GOLD, Material = Enum.Material.Metal, CanCollide = false })
	local canvas = part({ Name = "Canvas", Size = s, CFrame = cf * CFrame.new(0, 0, -0.15), Color = Color3.fromRGB(235, 225, 200), Material = Enum.Material.Fabric, CanCollide = false })
	return text(canvas, str, Color3.fromRGB(40, 30, 30), Enum.Font.Garamond, Enum.NormalId.Front)
end

local boxSign: TextLabel = nil

local function buildCastle()
	-- ENTRANCE HALL
	room(CASTLE, Vector3.new(80, 22, 50))
	part({ Name = "Carpet", Size = Vector3.new(8, 0.1, 48), CFrame = CFrame.new(CASTLE + Vector3.new(0, 0.05, 0)), Color = CARPET, Material = Enum.Material.Fabric, CanCollide = false })
	for x = -36, 36, 12 do
		candle(CASTLE + Vector3.new(x, 0.7, 23))
		candle(CASTLE + Vector3.new(x, 0.7, -23))
	end
	local chandelier = part({ Name = "Chandelier", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(CASTLE + Vector3.new(0, 17, 0)), Color = Color3.fromRGB(255, 220, 140), Material = Enum.Material.Neon, CanCollide = false })
	local cl = Instance.new("PointLight")
	cl.Range = 50
	cl.Brightness = 1.3
	cl.Color = Color3.fromRGB(255, 200, 130)
	cl.Parent = chandelier
	local title = part({ Name = "HallTitle", Size = Vector3.new(30, 4, 0.2), CFrame = CFrame.new(CASTLE + Vector3.new(0, 16, 24.4)) * CFrame.Angles(0, math.pi, 0), Color = DARKSTONE, CanCollide = false })
	text(title, "THE ENDLESS CASTLE", GOLD, Enum.Font.Fantasy)

	-- the Endless Hallway door (north wall)
	door(CASTLE + Vector3.new(0, 0, -24.6), Vector3.new(0, 0, 1), "The Endless Hallway", function(player)
		castleStep[player] = 0
		tp(player, HALL + Vector3.new(0, 4, -6))
		Net.send(player, "castleStep", { step = 0, steps = Config.Castle.Steps, hint = hintFor(0) })
	end)
	-- exit (south wall)
	door(CASTLE + Vector3.new(0, 0, 24.6), Vector3.new(0, 0, -1), "Back to Brainville", function(player)
		castleStep[player] = nil
		WorldService.teleport(player, "lobby")
	end)

	-- SECRET ROOMS (east + west walls of the hall)
	local ROOMS = {
		{ x = -39.6, z = -12, name = "The Upside-Down Room" },
		{ x = -39.6, z = 0, name = "The Gallery" },
		{ x = -39.6, z = 12, name = "The Clickbait Room" },
		{ x = 39.6, z = -12, name = "The Royal Chicken" },
		{ x = 39.6, z = 0, name = "Credits" },
		{ x = 39.6, z = 12, name = "The Box Room" },
	}
	local roomCenters = {}
	for i, r in ipairs(ROOMS) do
		local center = CASTLE + Vector3.new(-200 + i * 60, 0, 200)
		roomCenters[r.name] = center
		room(center, Vector3.new(36, 16, 36))
		candle(center + Vector3.new(15, 0.7, 15))
		candle(center + Vector3.new(-15, 0.7, 15))
		backDoor(center, 17.6)
		door(CASTLE + Vector3.new(r.x, 0, r.z), Vector3.new(r.x > 0 and -1 or 1, 0, 0), r.name, function(player)
			tp(player, center + Vector3.new(0, 4, 10))
		end)
	end

	-- Upside-Down Room: the furniture is on the ceiling
	do
		local c = roomCenters["The Upside-Down Room"]
		local top = c + Vector3.new(0, 16, 0)
		part({ Name = "CeilingRug", Size = Vector3.new(16, 0.1, 12), CFrame = CFrame.new(top - Vector3.new(0, 0.05, 0)), Color = Color3.fromRGB(60, 90, 160), Material = Enum.Material.Fabric, CanCollide = false })
		part({ Name = "CeilingTable", Size = Vector3.new(8, 0.6, 5), CFrame = CFrame.new(top - Vector3.new(0, 3, 0)), Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood })
		for _, x in ipairs({ -3.5, 3.5 }) do
			for _, z in ipairs({ -2, 2 }) do
				part({ Name = "CeilingLeg", Size = Vector3.new(0.5, 2.7, 0.5), CFrame = CFrame.new(top + Vector3.new(x, -1.35, z)), Color = Color3.fromRGB(100, 65, 40), Material = Enum.Material.Wood })
			end
		end
		for _, x in ipairs({ -6, 6 }) do
			part({ Name = "CeilingChair", Size = Vector3.new(2.4, 0.4, 2.4), CFrame = CFrame.new(top + Vector3.new(x, -2, 0)), Color = Color3.fromRGB(150, 40, 40), Material = Enum.Material.Fabric })
			part({ Name = "CeilingChairBack", Size = Vector3.new(0.4, 3, 2.4), CFrame = CFrame.new(top + Vector3.new(x + (x > 0 and 1 or -1), -3.3, 0)), Color = Color3.fromRGB(150, 40, 40), Material = Enum.Material.Fabric })
		end
		local s = part({ Name = "Sign", Size = Vector3.new(14, 2.5, 0.2), CFrame = CFrame.new(c + Vector3.new(0, 7, -17.9)), Color = DARKSTONE, CanCollide = false })
		text(s, "Gravity is optional in here.", Color3.fromRGB(240, 230, 210))
	end
	-- The Gallery: every animal stage, and they watch you
	do
		local c = roomCenters["The Gallery"]
		local i = 0
		for _, st in ipairs(Brain.Stages) do
			if st.key ~= "human" and st.key ~= "dead" then
				i += 1
				local x = -14 + ((i - 1) % 5) * 7
				local y = (i <= 5) and 9 or 4
				painting(CFrame.new(c + Vector3.new(x, y, -17.6)), st.emoji .. "\n" .. st.name .. "\n👀")
			end
		end
		local s = part({ Name = "Sign", Size = Vector3.new(12, 1.5, 0.2), CFrame = CFrame.new(c + Vector3.new(0, 13.5, -17.8)), Color = DARKSTONE, CanCollide = false })
		text(s, "Their eyes follow you. That's normal. Probably.", Color3.fromRGB(240, 230, 210))
	end
	-- Clickbait Room: every clickbait ever shown… and here they're all true
	do
		local c = roomCenters["The Clickbait Room"]
		local baits = {}
		for _, h in ipairs(Content.Headlines or {}) do
			if typeof(h) == "table" and h.bait and #baits < 12 then
				table.insert(baits, h)
			end
		end
		for i, h in ipairs(baits) do
			local title = h.text
			local x = -14 + ((i - 1) % 4) * 9.3
			local y = 3 + math.floor((i - 1) / 4) * 4.2
			local card = part({ Name = "ClickbaitCard", Size = Vector3.new(8.4, 3.6, 0.2), CFrame = CFrame.new(c + Vector3.new(x, y, -17.8)), Color = Color3.fromRGB(255, 60, 60), CanCollide = false })
			text(card, "✅ TRUE: " .. tostring(title), Color3.new(1, 1, 1), Enum.Font.GothamBlack)
		end
	end
	-- The Royal Chicken: the rubber chicken's home, with a chicken-sized throne
	do
		local c = roomCenters["The Royal Chicken"]
		part({ Name = "ThroneSeat", Size = Vector3.new(2, 0.6, 2), CFrame = CFrame.new(c + Vector3.new(0, 1.2, -14)), Color = GOLD, Material = Enum.Material.Metal })
		part({ Name = "ThroneBack", Size = Vector3.new(2, 3, 0.4), CFrame = CFrame.new(c + Vector3.new(0, 2.6, -15)), Color = GOLD, Material = Enum.Material.Metal })
		for _, x in ipairs({ -0.9, 0.9 }) do
			part({ Name = "ThroneLeg", Size = Vector3.new(0.3, 0.9, 0.3), CFrame = CFrame.new(c + Vector3.new(x, 0.45, -14)), Color = GOLD, Material = Enum.Material.Metal })
		end
		local body = part({ Name = "RoyalChicken", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.3, 1.6), CFrame = CFrame.new(c + Vector3.new(0, 2.1, -14)), Color = Color3.fromRGB(255, 230, 60), Material = Enum.Material.SmoothPlastic })
		part({ Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), CFrame = CFrame.new(c + Vector3.new(0, 3, -13.6)), Color = Color3.fromRGB(255, 230, 60), Material = Enum.Material.SmoothPlastic })
		part({ Name = "Crown", Size = Vector3.new(0.6, 0.4, 0.6), CFrame = CFrame.new(c + Vector3.new(0, 3.55, -13.6)), Color = GOLD, Material = Enum.Material.Neon })
		prompt(body, "Bow", "👑 The Royal Rubber Chicken", function(player)
			BrainService.toast(player, "🐔 The Royal Rubber Chicken accepts your bow. *squeak*", "CartoonBoing")
		end)
	end
	-- Credits room
	do
		local c = roomCenters["Credits"]
		local wall = part({ Name = "CreditsWall", Size = Vector3.new(30, 12, 0.2), CFrame = CFrame.new(c + Vector3.new(0, 7, -17.8)), Color = Color3.fromRGB(20, 18, 25), CanCollide = false })
		text(wall, "LOSE A BRAIN CELL / GAIN A BRAIN CELL\n\nMade by the Cult of the 39 community\nDesigned by the owner, built with the help of Claude\nHead Moderator: the friend whose computer this was made on\n\nThank you for finding this room.\nYou are officially too curious. 💛\n— the owner", Color3.fromRGB(240, 230, 210), Enum.Font.Garamond)
	end
	-- Box Room: the "please $1 more" box is back, and the sign keeps escalating
	do
		local c = roomCenters["The Box Room"]
		local box = part({ Name = "CardboardBox", Size = Vector3.new(5, 4, 5), CFrame = CFrame.new(c + Vector3.new(0, 2, -8)), Color = Color3.fromRGB(190, 145, 90), Material = Enum.Material.Cardboard })
		local board = part({ Name = "PleaseSign", Size = Vector3.new(6, 2.4, 0.2), CFrame = CFrame.new(c + Vector3.new(0, 6.5, -11)), Color = Color3.fromRGB(250, 250, 245) })
		boxSign = text(board, "please $2 more", Color3.fromRGB(40, 40, 40), Enum.Font.Cartoon)
		prompt(box, "Look inside", "📦 Box", function(player)
			boxPleas += 1
			local steps = { "please $2 more", "please $3 more", "please $4 more", "ok fine it's free", "it was always free", "please $1 more (again)" }
			boxSign.Text = steps[(boxPleas % #steps) + 1]
			BrainService.toast(player, "📦 Inside the box: another, smaller box. Inside that: a note that says \"lol\".", "CartoonBoing")
		end)
	end
	-- A tiny door only worm-stage (or tiny) players fit through
	do
		local tiny = part({ Name = "TinyDoor", Size = Vector3.new(1.2, 1.4, 0.3), CFrame = CFrame.new(CASTLE + Vector3.new(20, 0.7, -24.4)), Color = Color3.fromRGB(70, 45, 30), Material = Enum.Material.Wood })
		local wormRoom = CASTLE + Vector3.new(200, 0, 260)
		room(wormRoom, Vector3.new(10, 6, 10), Color3.fromRGB(120, 90, 60))
		local s = part({ Name = "Sign", Size = Vector3.new(8, 2, 0.2), CFrame = CFrame.new(wormRoom + Vector3.new(0, 3, -4.8)), Color = Color3.fromRGB(240, 220, 180), CanCollide = false })
		text(s, "🪱 WORMS ONLY. Congratulations, worm.", Color3.fromRGB(60, 40, 20), Enum.Font.Cartoon)
		backDoor(wormRoom, 4.4)
		prompt(tiny, "Squeeze in", "🚪 A very small door", function(player)
			local data = DataService.get(player)
			local stage = data and Brain.stage(data.cells)
			if stage and (stage.scale or 1) <= 0.5 then
				tp(player, wormRoom + Vector3.new(0, 2, 2))
			else
				BrainService.toast(player, "🚪 You're way too big. Something tiny could fit…", "CartoonBoing")
			end
		end, 6)
	end

	-- THE ENDLESS HALLWAY
	local H = HALL
	-- corridor: 14 wide, 80 long, running -Z, then a T junction
	part({ Name = "Floor", Size = Vector3.new(14, 1, 84), CFrame = CFrame.new(H + Vector3.new(0, -0.5, -40)), Color = DARKSTONE, Material = Enum.Material.Cobblestone })
	part({ Name = "Carpet", Size = Vector3.new(5, 0.1, 82), CFrame = CFrame.new(H + Vector3.new(0, 0.05, -40)), Color = CARPET, Material = Enum.Material.Fabric, CanCollide = false })
	part({ Name = "Ceiling", Size = Vector3.new(14, 1, 84), CFrame = CFrame.new(H + Vector3.new(0, 16.5, -40)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(1, 16, 84), CFrame = CFrame.new(H + Vector3.new(7.5, 8, -40)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(1, 16, 84), CFrame = CFrame.new(H + Vector3.new(-7.5, 8, -40)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(14, 16, 1), CFrame = CFrame.new(H + Vector3.new(0, 8, 2.5)), Color = STONE, Material = Enum.Material.Brick })
	-- junction (cross piece from x=-34 to x=34)
	local J = H + Vector3.new(0, 0, -90)
	part({ Name = "Floor", Size = Vector3.new(70, 1, 14), CFrame = CFrame.new(J + Vector3.new(0, -0.5, 0)), Color = DARKSTONE, Material = Enum.Material.Cobblestone })
	part({ Name = "Ceiling", Size = Vector3.new(70, 1, 14), CFrame = CFrame.new(J + Vector3.new(0, 16.5, 0)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(70, 16, 1), CFrame = CFrame.new(J + Vector3.new(0, 8, -7.5)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(28, 16, 1), CFrame = CFrame.new(J + Vector3.new(-21, 8, 7.5)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(28, 16, 1), CFrame = CFrame.new(J + Vector3.new(21, 8, 7.5)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(1, 16, 14), CFrame = CFrame.new(J + Vector3.new(35.5, 8, 0)), Color = STONE, Material = Enum.Material.Brick })
	part({ Name = "Wall", Size = Vector3.new(1, 16, 14), CFrame = CFrame.new(J + Vector3.new(-35.5, 8, 0)), Color = STONE, Material = Enum.Material.Brick })
	for z = -10, -75, -13 do
		candle(H + Vector3.new(6.4, 0.7, z))
		candle(H + Vector3.new(-6.4, 0.7, z))
	end
	candle(J + Vector3.new(-30, 0.7, -6))
	candle(J + Vector3.new(30, 0.7, -6))
	-- arrows painted above each arm
	local la = part({ Name = "ArrowLeft", Size = Vector3.new(6, 3, 0.2), CFrame = CFrame.new(J + Vector3.new(-14, 12, -6.9)), Color = DARKSTONE, CanCollide = false })
	text(la, "⬅", Color3.fromRGB(200, 190, 170))
	local ra = part({ Name = "ArrowRight", Size = Vector3.new(6, 3, 0.2), CFrame = CFrame.new(J + Vector3.new(14, 12, -6.9)), Color = DARKSTONE, CanCollide = false })
	text(ra, "➡", Color3.fromRGB(200, 190, 170))
	-- Hints: graffiti on the junction wall + a painting in the corridor (text is set
	-- on each player's own screen, so everyone sees the hint for THEIR next turn)
	local graffiti = part({ Name = "CastleGraffiti", Size = Vector3.new(26, 6, 0.2), CFrame = CFrame.new(J + Vector3.new(0, 6, -6.9)), Color = DARKSTONE, Transparency = 0.2, CanCollide = false })
	text(graffiti, "", Color3.fromRGB(255, 240, 120), Enum.Font.PermanentMarker)
	local hintPainting = painting(CFrame.new(H + Vector3.new(-6.9, 8, -45)) * CFrame.Angles(0, math.rad(90), 0), "", Vector3.new(9, 6, 0.3))
	hintPainting.Parent.Parent.Name = "CastleHintPainting"
	local counter = part({ Name = "CastleCounter", Size = Vector3.new(10, 2, 0.2), CFrame = CFrame.new(H + Vector3.new(0, 13, 1.9)) * CFrame.Angles(0, math.pi, 0), Color = DARKSTONE, CanCollide = false })
	text(counter, "", Color3.fromRGB(200, 190, 170))
	-- the humming knight
	local knightBase = H + Vector3.new(5, 0, -30)
	part({ Name = "KnightLegs", Size = Vector3.new(2, 3, 1), CFrame = CFrame.new(knightBase + Vector3.new(0, 1.5, 0)), Color = Color3.fromRGB(170, 170, 180), Material = Enum.Material.Metal })
	part({ Name = "KnightBody", Size = Vector3.new(2.6, 2.6, 1.4), CFrame = CFrame.new(knightBase + Vector3.new(0, 4.3, 0)), Color = Color3.fromRGB(180, 180, 190), Material = Enum.Material.Metal })
	local helm = part({ Name = "KnightHelm", Size = Vector3.new(1.6, 1.8, 1.6), CFrame = CFrame.new(knightBase + Vector3.new(0, 6.5, 0)), Color = Color3.fromRGB(190, 190, 200), Material = Enum.Material.Metal })
	part({ Name = "KnightPlume", Size = Vector3.new(0.3, 1.2, 1.4), CFrame = CFrame.new(knightBase + Vector3.new(0, 7.9, 0)), Color = CARPET, Material = Enum.Material.Fabric })
	prompt(helm, "Listen", "🛡 The Humming Knight", function(player)
		local step = castleStep[player] or 0
		BrainService.toast(player, "🛡🎵 The knight hums: \"" .. hintFor(step) .. "\"", "LibrarianChime")
	end, 12)

	-- turn triggers at the end of each arm
	local debounce = {}
	for _, side in ipairs({ { dir = "L", x = -32 }, { dir = "R", x = 32 } }) do
		local trig = part({ Name = "TurnTrigger" .. side.dir, Size = Vector3.new(4, 12, 12), CFrame = CFrame.new(J + Vector3.new(side.x, 6, 0)), Transparency = 1, CanCollide = false })
		part({ Name = "ArchDark", Size = Vector3.new(0.3, 10, 8), CFrame = CFrame.new(J + Vector3.new(side.x * 1.09, 5, 0)), Color = Color3.new(0, 0, 0), CanCollide = false })
		trig.Touched:Connect(function(hit)
			local char = hit.Parent
			local player = char and Players:GetPlayerFromCharacter(char)
			if not player or castleStep[player] == nil then
				return
			end
			if (debounce[player] or 0) > os.clock() then
				return
			end
			debounce[player] = os.clock() + 1.5
			local r = route()
			local step = castleStep[player]
			if r[step + 1] == side.dir then
				step += 1
				castleStep[player] = step
				if step >= #r then
					solvedRun[player] = true
					tp(player, WALL_ROOM + Vector3.new(0, 4, 14))
					Net.send(player, "castleStep", { step = step, steps = #r, hint = Content.CastleEnd, atWall = true })
				else
					tp(player, H + Vector3.new(0, 4, -6))
					Net.send(player, "castleStep", { step = step, steps = #r, hint = hintFor(step) })
				end
			else
				castleStep[player] = 0
				tp(player, H + Vector3.new(0, 4, -6))
				Net.send(player, "castleStep", { step = 0, steps = #r, hint = hintFor(0), wrong = Content.CastleWrong[math.random(1, #Content.CastleWrong)] })
			end
		end)
	end

	-- THE BRICK WALL ROOM
	room(WALL_ROOM, Vector3.new(30, 16, 36))
	candle(WALL_ROOM + Vector3.new(-12, 0.7, 14))
	candle(WALL_ROOM + Vector3.new(12, 0.7, 14))
	local bricks = Instance.new("Model")
	bricks.Name = "CastleBrickWall"
	bricks.Parent = folder
	for row = 0, 7 do
		for col = -3, 3 do
			local off = (row % 2 == 0) and 0 or 1
			part({ Name = "Brick", Size = Vector3.new(3.8, 1.8, 1.2), CFrame = CFrame.new(WALL_ROOM + Vector3.new(col * 4 + off, 1 + row * 2, -6)), Color = Color3.fromRGB(150, 70, 55), Material = Enum.Material.Brick, Parent = bricks })
		end
	end
	local knock = part({ Name = "KnockSpot", Size = Vector3.new(4, 4, 0.4), CFrame = CFrame.new(WALL_ROOM + Vector3.new(0, 4, -5.2)), Transparency = 1, CanCollide = false })
	prompt(knock, "Knock", "🧱 The old brick wall", function(player)
		if not solvedRun[player] then
			BrainService.toast(player, "🧱 *knock knock* … nothing. You didn't come the right way.", "CartoonBoing")
			return
		end
		Net.send(player, "castleWallOpen", {})
	end, 12)
	-- the treasure behind the wall
	local chest = part({ Name = "CastleChest", Size = Vector3.new(5, 3, 3.4), CFrame = CFrame.new(WALL_ROOM + Vector3.new(0, 1.5, -14)), Color = Color3.fromRGB(120, 70, 30), Material = Enum.Material.Wood })
	part({ Name = "ChestLid", Size = Vector3.new(5.2, 0.8, 3.6), CFrame = CFrame.new(WALL_ROOM + Vector3.new(0, 3.4, -14)), Color = GOLD, Material = Enum.Material.Metal })
	local glow = Instance.new("PointLight")
	glow.Color = GOLD
	glow.Range = 18
	glow.Parent = chest
	prompt(chest, "Open", "🗝 The Castle's Treasure", function(player)
		CastleService.reward(player)
	end, 10)
	door(WALL_ROOM + Vector3.new(0, 0, 17.6), Vector3.new(0, 0, -1), "Back to the hall", function(player)
		castleStep[player] = nil
		solvedRun[player] = nil
		tp(player, CASTLE + Vector3.new(0, 4, 10))
	end)
end

---------------------------------------------------------------------
-- Rewards
---------------------------------------------------------------------
function CastleService.reward(player)
	local data = DataService.get(player)
	if not data or not solvedRun[player] then
		BrainService.toast(player, "🔒 The chest is locked. Only people who found the brick wall the right way can open it.")
		return
	end
	solvedRun[player] = nil
	castleStep[player] = nil
	local season = seasonId()
	local first = not data.badges.LostAndFound
	data.castleMap = true
	BrainService.awardBadge(player, "LostAndFound")
	if data.castleSeason == season then
		BrainService.toast(player, "🗝 You already took this season's treasure. The route changes next season!", "LibrarianChime")
		return
	end
	data.castleSeason = season
	local minutes = Config.Castle.BoostMinutes
	if data.path == "Lose" and not data.dead then
		data.castleBoostUntil = os.time() + minutes * 60
		BrainService.lose(player, Config.Castle.RewardPoints, "castle")
		BrainService.toast(player, "🏰 The castle's treasure… was a brain vacuum. BIG brain cell loss + 2× LOSS speed for " .. minutes .. " minutes!", "RecordScratch")
	elseif data.path == "Gain" then
		data.castleBoostUntil = os.time() + minutes * 60
		BrainService.gain(player, Config.Castle.RewardPoints, "castle")
		BrainService.toast(player, "🏰 TREASURE! Big brain cell bonus + 2× brain cells for " .. minutes .. " minutes!", "BadgeSparkle")
	end
	Net.send(player, "confetti", {})
	if first then
		BrainService.toast(player, "🗺 You got the CASTLE MAP: your taxi never has to wait again (fast travel anywhere).", "LevelUp")
	end
	BrainService.push(player)
end

function CastleService.start()
	buildHouse()
	buildWhiteRoom()
	buildCastle()
	Players.PlayerRemoving:Connect(function(p)
		castleStep[p] = nil
		solvedRun[p] = nil
	end)
	-- the void: anything that falls under the castle/white room is caught, never killed
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if root and root.Position.Y > 1500 and root.Position.Y < 2900 and (root.Position - WHITE).Magnitude < 4000 then
					tp(player, WHITE + Vector3.new(0, 4, 30))
				end
			end
		end
	end)
	local _ = FriendService
end

return CastleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">ConversationService</string><ProtectedString name="Source"><![CDATA[-- ConversationService (update 1.5): CONVERSATION SCENES.
-- Walk up to someone in a room (Rooms.convSpot) and talk. The server keeps the
-- conversation (so choices can't be faked); the client (Client/Conversation) shows
-- the camera cuts, the typed lines and the choices in the bottom-left.
--
-- Text: Content.Conversations. Numbers: Config.Conversations.
-- Being dumb changes it: low-brain players get degraded choice text, animals only
-- get animal noises (same effects, so they're picking blind).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local Rooms = require(script.Parent.Rooms)

local ConversationService = {}

local CC = Config.Conversations
local UI = Content.ConvUI
local sessions = {} -- [player] = { key, scene, cfg, node, meter, opts = {text}, spotId }
local lastEnd = {} -- [player] = os.clock()

local function stageKey(data): string
	return Brain.stage(data.cells, BrainService.secretAnimals).key
end

local function isAnimal(data): boolean
	local k = stageKey(data)
	return k ~= "human" and k ~= "barelyhuman" and k ~= "dead"
end

-- The text the player sees for choice i
local function choiceText(data, opt, i: number): string
	if isAnimal(data) then
		local list = Content.AnimalTalk[stageKey(data)] or Content.AnimalTalk.default
		return list[i] or list[1]
	end
	local t = opt.t
	if typeof(t) == "table" then
		t = t[data.path] or t.Gain
	end
	return Brain.degradeText(t, data.cells)
end

local function nodePayload(data, s)
	local node = s.scene.nodes[s.node]
	s.opts = {}
	for i, o in ipairs(node.opts) do
		s.opts[i] = choiceText(data, o, i)
	end
	return { say = node.say, opts = s.opts }
end

-- Where the wide shot camera goes: beside the two people, toward the middle of the room
local function wideShot(spot): Vector3
	local stand, npc = spot.stand.Position, spot.npc.Position
	local mid = (stand + npc) / 2
	local key = Rooms.buildingAt(mid)
	local dir
	if key then
		local c = Rooms.Buildings[key].cf.Position
		local flat = Vector3.new(c.X - mid.X, 0, c.Z - mid.Z)
		if flat.Magnitude > 1 then
			dir = flat.Unit
		end
	end
	dir = dir or spot.stand.RightVector
	return mid + dir * 8 + Vector3.new(0, 6.5, 0)
end

local function sceneKeyFor(spot, path: string?): string?
	if typeof(spot.conv) == "table" then
		return spot.conv[path]
	end
	return spot.conv
end

local function start(player: Player, spotId: string)
	local spot = Rooms.ConvSpots[spotId]
	local data = DataService.get(player)
	if not spot or not data then
		return
	end
	if sessions[player] then
		BrainService.toast(player, UI.Busy)
		return
	end
	if not data.path then
		BrainService.toast(player, Content.Rooms.PickPath)
		return
	end
	local key = sceneKeyFor(spot, data.path)
	if not key then
		BrainService.toast(player, data.path == "Lose" and Content.Rooms.SmartOnly or Content.Rooms.DumbOnly)
		return
	end
	local scene, cfg = Content.Conversations[key], CC.Scenes[key]
	if not scene or not cfg then
		warn("[Conversation] missing scene " .. tostring(key))
		return
	end
	local blocked = BrainService.blocked(player)
	if blocked and not (cfg.allowFrozen and BrainService.isFrozen(player)) then
		BrainService.toast(player, "⛔ " .. blocked)
		return
	end
	if lastEnd[player] and os.clock() - lastEnd[player] < CC.Cooldown then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then
		return
	end
	if (root.Position - spot.stand.Position).Magnitude > CC.StartRadius then
		BrainService.toast(player, UI.TooFar)
		return
	end
	-- stand up from any seat, then stand at the spot facing them
	Rooms.standUp(hum)
	char:PivotTo(spot.stand * CFrame.new(0, 3, 0))

	local s = { key = key, scene = scene, cfg = cfg, node = "a", meter = cfg.meter, spotId = spotId }
	sessions[player] = s
	data.convSeen = data.convSeen or {}
	Net.send(player, "conv_open", {
		key = key,
		who = scene.who,
		meterName = scene.meter,
		meter = s.meter,
		stand = spot.stand,
		npc = spot.npc,
		wide = wideShot(spot),
		seen = data.convSeen[key] == true,
		node = nodePayload(data, s),
	})
end

local function giveRewards(player: Player, data, r)
	if r.coins then
		data.coins += r.coins
	end
	if r.gain then
		BrainService.gain(player, r.gain, "conversation")
	end
	if r.lose then
		BrainService.lose(player, r.lose, "conversation")
	end
	if r.path then
		if data.path == "Gain" then
			BrainService.gain(player, r.path, "conversation")
		else
			BrainService.lose(player, r.path, "conversation")
		end
	end
	if r.stress then
		BrainService.stress(player, r.stress) -- only does something on the Gain path
	end
	if r.embarrass then
		if r.embarrass > 0 then
			BrainService.embarrass(player, r.embarrass, UI.EmbarrassMoment)
		elseif data.path == "Lose" then
			data.embarrass = math.max(0, data.embarrass + r.embarrass)
		end
	end
	if r.idea then
		-- fills the idea meter; the next job task sets off the Eureka moment
		data.ideaMeter = math.min((data.ideaMeter or 0) + r.idea, Config.EurekaTasks - 1)
	end
	if r.confetti then
		Net.send(player, "confetti", {})
	end
	BrainService.push(player)
end

Net.on("conv_pick", function(player, d)
	local s = sessions[player]
	local data = DataService.get(player)
	if not s or not data or s.ended then
		return { ok = false }
	end
	local i = tonumber(d.i)
	local node = s.scene.nodes[s.node]
	local nums = s.cfg[s.node]
	if not i or i % 1 ~= 0 or not node.opts[i] or not nums or not nums[i] then
		return { ok = false }
	end
	local opt = node.opts[i]
	local m, b = nums[i][1], nums[i][2]
	local said = s.opts[i]
	s.meter = math.clamp(s.meter + m, 0, 100)
	if b > 0 then
		BrainService.gain(player, b * CC.BrainScale, "conversation")
	elseif b < 0 then
		BrainService.lose(player, -b * CC.BrainScale, "conversation")
	end
	local out = { ok = true, said = said, delta = m, meter = s.meter, slam = opt.slam == true }
	if opt.n then
		s.node = opt.n
		out.next = nodePayload(data, s)
	else
		s.ended = true
		local tier = s.meter >= CC.GoodAt and "good" or (s.meter <= CC.BadAt and "bad" or "mid")
		giveRewards(player, data, s.cfg[tier] or {})
		data.convSeen = data.convSeen or {}
		data.convSeen[s.key] = true
		BrainService.awardBadge(player, "SmallTalk")
		out.ended = { tier = tier, line = s.scene.ends[tier].line, result = s.scene.ends[tier].result }
	end
	return out
end)

function ConversationService.stop(player: Player)
	if sessions[player] then
		sessions[player] = nil
		lastEnd[player] = os.clock()
		Net.send(player, "conv_close", {})
	end
end

function ConversationService.active(player: Player): boolean
	return sessions[player] ~= nil
end

Net.on("conv_close", function(player)
	if sessions[player] then
		sessions[player] = nil
		lastEnd[player] = os.clock()
	end
	return { ok = true }
end)

function ConversationService.start()
	Rooms.onConv = start
	-- prompt text per path (the client picks the one for its path)
	for _, spot in pairs(Rooms.ConvSpots) do
		if spot.prompt then
			for _, path in ipairs({ "Lose", "Gain" }) do
				local key = sceneKeyFor(spot, path)
				local scene = key and Content.Conversations[key]
				if scene then
					spot.prompt:SetAttribute(path .. "Action", scene.action)
				end
			end
		end
	end
	Players.PlayerRemoving:Connect(function(p)
		sessions[p] = nil
		lastEnd[p] = nil
	end)
	-- dying or respawning ends the conversation
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			ConversationService.stop(p)
		end)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		p.CharacterAdded:Connect(function()
			ConversationService.stop(p)
		end)
	end
end

return ConversationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: loads and saves every player's progress (with a session lock,
-- so the same account in two servers can't duplicate or lose progress).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store = nil
local okStore = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local profiles = {} -- [player] = data
local noSave = {} -- [player] = true if saving isn't available (Studio without API access)

local function defaultData()
	return {
		version = 1,
		path = nil, -- "Lose" or "Gain"
		cells = Config.LoseStartCells,
		coins = 0,
		badges = {},
		gatesPassed = {},
		job = nil,
		embarrass = 0,
		stress = 0,
		position = nil,
		settings = { music = 0.5, sfx = 0.8, reduceFlashing = false, largeText = false, extraTime = false },
		manualRank = 0,
		perks = {},
		comeback = false,
		runStart = os.time(),
		bestRunSeconds = nil,
		viralCount = 0,
		clickbaitClicks = 0,
		warnings = {},
		stats = { textsSkipped = 0, textsRead = 0, clickbaitClicked = 0, commentsPosted = 0, gatesFailed = 0 },
		embarrassingMoments = {},
		inventions = {}, -- secret inventions owned
		ideaMeter = 0, -- fills by doing job tasks; full = Eureka cutscene
		eurekaChoices = nil,
		focusCharges = 0,
		bonusHints = 0,
		jobTasksDone = 0,
		convSeen = {}, -- 1.5: conversation scenes you've finished (older saves get this automatically)
	}
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			if typeof(v) == "table" then
				local copy = {}
				for k2, v2 in pairs(v) do
					copy[k2] = v2
				end
				data[k] = copy
			else
				data[k] = v
			end
		elseif typeof(v) == "table" and typeof(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

local function key(userId: number): string
	return "p_" .. tostring(userId)
end

function DataService.load(player: Player)
	if not okStore or not store then
		noSave[player] = true
		profiles[player] = defaultData()
		return profiles[player], false
	end

	local loaded = nil
	local attempts = 0
	while attempts < 6 and player.Parent do
		attempts += 1
		local locked = false
		local ok, err = pcall(function()
			store:UpdateAsync(key(player.UserId), function(old)
				old = old or defaultData()
				local lock = old.lock
				local force = attempts >= 6
				if lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < 120 and not force then
					locked = true
					return nil -- cancel, another server still has it
				end
				old.lock = { job = game.JobId, time = os.time() }
				loaded = old
				return old
			end)
		end)
		if ok and loaded then
			break
		end
		if not ok then
			warn("[DataService] Load failed: " .. tostring(err))
			if RunService:IsStudio() then
				break
			end
		end
		if locked then
			task.wait(3)
		else
			task.wait(1)
		end
	end

	if not loaded then
		noSave[player] = true
		loaded = defaultData()
		profiles[player] = loaded
		return loaded, false
	end

	reconcile(loaded, defaultData())
	profiles[player] = loaded
	return loaded, true
end

function DataService.get(player: Player)
	return profiles[player]
end

function DataService.canSave(player: Player): boolean
	return not noSave[player]
end

local function snapshotPosition(player: Player, data)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
		local p = root.Position
		data.position = { x = p.X, y = p.Y, z = p.Z }
	end
end

function DataService.save(player: Player, release: boolean?)
	local data = profiles[player]
	if not data or noSave[player] or not store then
		return
	end
	snapshotPosition(player, data)
	local ok, err = pcall(function()
		store:UpdateAsync(key(player.UserId), function(old)
			if old and old.lock and old.lock.job ~= game.JobId then
				-- another server took over; don't overwrite their newer data
				return nil
			end
			data.lock = (not release) and { job = game.JobId, time = os.time() } or nil
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Save failed: " .. tostring(err))
	end
end

function DataService.release(player: Player)
	DataService.save(player, true)
	profiles[player] = nil
	noSave[player] = nil
end

-- Admin: delete a player's data (Roblox data-deletion requests)
function DataService.wipe(userId: number): boolean
	if not store then
		return false
	end
	local ok = pcall(function()
		store:RemoveAsync(key(userId))
	end)
	return ok
end

-- Admin: read another player's manual rank while they're offline is not needed in 1.0.

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for _, p in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.save, p)
			end
		end
	end)
	game:BindToClose(function()
		local threads = 0
		for _, p in ipairs(Players:GetPlayers()) do
			threads += 1
			task.spawn(function()
				DataService.save(p, true)
				threads -= 1
			end)
		end
		local t = os.clock()
		while threads > 0 and os.clock() - t < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">FriendService</string><ProtectedString name="Source"><![CDATA[-- FriendService: builds REAL avatar models for each player's NPC friends,
-- using the player's actual Roblox friends (their avatars and display names).
-- Falls back to default people if the friends list can't be loaded.
-- Models are stored in ReplicatedStorage > FriendModels > <UserId>; only that
-- player's screen clones and shows them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FriendService = {}

local folder = Instance.new("Folder")
folder.Name = "FriendModels"
folder.Parent = ReplicatedStorage

local FALLBACK = {
	{ name = "Kyle", skin = Color3.fromRGB(234, 184, 146), shirt = Color3.fromRGB(220, 60, 60), pants = Color3.fromRGB(40, 50, 90) },
	{ name = "Mia", skin = Color3.fromRGB(160, 110, 80), shirt = Color3.fromRGB(80, 160, 240), pants = Color3.fromRGB(30, 30, 40) },
	{ name = "Zeke", skin = Color3.fromRGB(250, 214, 180), shirt = Color3.fromRGB(250, 200, 50), pants = Color3.fromRGB(70, 110, 60) },
}

local function defaultDescription(i: number): HumanoidDescription
	local f = FALLBACK[i]
	local d = Instance.new("HumanoidDescription")
	d.HeadColor = f.skin
	d.LeftArmColor = f.skin
	d.RightArmColor = f.skin
	d.TorsoColor = f.shirt
	d.LeftLegColor = f.pants
	d.RightLegColor = f.pants
	return d
end

function FriendService.makeModel(desc: HumanoidDescription, name: string): Model?
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[FriendService] couldn't build avatar: " .. tostring(model))
		return nil
	end
	model.Name = name
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	return model
end

function FriendService.build(player: Player)
	task.spawn(function()
		local list = {}
		pcall(function()
			local pages = Players:GetFriendsAsync(player.UserId)
			for _, fr in ipairs(pages:GetCurrentPage()) do
				table.insert(list, fr)
			end
		end)
		for i = #list, 2, -1 do
			local j = math.random(1, i)
			list[i], list[j] = list[j], list[i]
		end
		local f = Instance.new("Folder")
		f.Name = tostring(player.UserId)
		for i = 1, 3 do
			local fr = list[i]
			local desc, name = nil, FALLBACK[i].name
			if fr then
				local ok, d = pcall(function()
					return Players:GetHumanoidDescriptionFromUserId(fr.Id)
				end)
				if ok and d then
					desc = d
					name = fr.DisplayName or fr.Username or name
				end
			end
			desc = desc or defaultDescription(i)
			local model = FriendService.makeModel(desc, "Friend" .. i)
			if not model and desc ~= nil then
				model = FriendService.makeModel(defaultDescription(i), "Friend" .. i)
				name = FALLBACK[i].name
			end
			if model then
				model:SetAttribute("FriendName", name)
				model.Parent = f
			end
		end
		if player.Parent then
			f.Parent = folder
		end
	end)
end

function FriendService.cleanup(player: Player)
	local f = folder:FindFirstChild(tostring(player.UserId))
	if f then
		f:Destroy()
	end
end

-- A plain grey person for the Perfectly Average guy and other NPCs
function FriendService.npc(name: string, skin: Color3?, shirt: Color3?, pants: Color3?): Model?
	local d = Instance.new("HumanoidDescription")
	local s = skin or Color3.fromRGB(200, 170, 140)
	d.HeadColor = s
	d.LeftArmColor = s
	d.RightArmColor = s
	d.TorsoColor = shirt or Color3.fromRGB(150, 150, 150)
	d.LeftLegColor = pants or Color3.fromRGB(110, 110, 110)
	d.RightLegColor = pants or Color3.fromRGB(110, 110, 110)
	return FriendService.makeModel(d, name)
end

return FriendService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">GainService</string><ProtectedString name="Source"><![CDATA[-- GainService: everything on the Gain path (library, Jack B Movies,
-- Skill Gates, jobs, genius habits, the cash-grab joke shop).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)
local ProjectService = require(script.Parent.ProjectService)

local GainService = {}

local sessions = {} -- [player] = { library, theater, gate, gateCooldown, job, nap, pigeons }

local function s(player)
	local x = sessions[player]
	if not x then
		x = {}
		sessions[player] = x
	end
	return x
end

local function onGain(player): boolean
	local data = DataService.get(player)
	return data ~= nil and data.path == "Gain"
end

local function guard(player, feature: string, allowFrozen: boolean?)
	if not onGain(player) then
		return { ok = false, msg = "This is for the Gain path." }
	end
	if not BrainService.feature(feature) then
		return { ok = false, msg = "This is turned off right now." }
	end
	local blocked = BrainService.blocked(player)
	if blocked and not (allowFrozen and string.find(blocked, "stressed")) then
		return { ok = false, msg = blocked }
	end
	return nil
end

local function pick(list)
	return list[math.random(1, #list)]
end

---------------------------------------------------------------------
-- Library and Jack B Movies
---------------------------------------------------------------------
Net.on("library_get", function(player)
	local bad = guard(player, "Library")
	if bad then
		return bad
	end
	local item = pick(Content.Library)
	s(player).library = { item = item, issued = os.clock() }
	return { ok = true, text = item.text, q = item.q, options = item.options, wait = Config.ReadingSeconds }
end)

Net.on("library_answer", function(player, d)
	local sess = s(player).library
	if not sess then
		return { ok = false }
	end
	if os.clock() - sess.issued < Config.ReadingSeconds - 0.5 then
		return { ok = false, msg = "Read it first! (10 seconds)" }
	end
	s(player).library = nil
	local correct = tonumber(d.choice) == sess.item.answer
	if correct then
		local data = DataService.get(player)
		local points = 2
		if data.focusCharges and data.focusCharges > 0 then
			data.focusCharges -= 1
			points = 3
		end
		BrainService.gain(player, points, "library")
		BrainService.stress(player, 2)
		BrainService.narrate(player, "gained")
	else
		BrainService.stress(player, 4)
	end
	return { ok = true, correct = correct, answer = sess.item.answer }
end)

Net.on("theater_get", function(player)
	local bad = guard(player, "Theater")
	if bad then
		return bad
	end
	local item = pick(Content.Theater)
	s(player).theater = { item = item, issued = os.clock() }
	return { ok = true, text = item.text, q = item.q, options = item.options, wait = 6 }
end)

Net.on("theater_answer", function(player, d)
	local sess = s(player).theater
	if not sess then
		return { ok = false }
	end
	if os.clock() - sess.issued < 5.5 then
		return { ok = false, msg = "Watch the video first!" }
	end
	s(player).theater = nil
	local correct = tonumber(d.choice) == sess.item.answer
	if correct then
		local data = DataService.get(player)
		local points = 2
		if data.focusCharges and data.focusCharges > 0 then
			data.focusCharges -= 1
			points = 3
		end
		BrainService.gain(player, points, "theater")
		BrainService.stress(player, 2)
	else
		BrainService.stress(player, 3)
	end
	return { ok = true, correct = correct, answer = sess.item.answer }
end)

---------------------------------------------------------------------
-- Skill Gates
---------------------------------------------------------------------
Net.on("gate_status", function(player)
	local gate = BrainService.nextGate(player)
	local cd = s(player).gateCooldown or 0
	return {
		ok = true,
		gate = gate and gate.name or nil,
		iq = gate and gate.iq or nil,
		atGate = BrainService.atGate(player),
		cooldown = math.max(0, math.ceil(cd - os.clock())),
	}
end)

Net.on("gate_start", function(player)
	local bad = guard(player, "Gates")
	if bad then
		return bad
	end
	local gate = BrainService.nextGate(player)
	if not gate then
		return { ok = false, msg = "No gate ahead. You've passed them all (for now)!" }
	end
	if not BrainService.atGate(player) then
		return { ok = false, msg = "Reach " .. gate.iq .. " IQ first. Keep learning!" }
	end
	local sess = s(player)
	if sess.gateCooldown and os.clock() < sess.gateCooldown then
		return { ok = false, msg = "Cool down for " .. math.ceil(sess.gateCooldown - os.clock()) .. " more seconds." }
	end
	local pool = {}
	for i, q in ipairs(Content.GateQuestions) do
		if q.tier == gate.tier then
			table.insert(pool, i)
		end
	end
	for i = #pool, 2, -1 do
		local j = math.random(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local chosen = {}
	for i = 1, math.min(Config.GateQuestionCount, #pool) do
		chosen[i] = pool[i]
	end
	local data = DataService.get(player)
	local seconds = Config.GateSeconds * (data.settings.extraTime and Config.GateExtraTimeMultiplier or 1)
	local hints = Config.GateHints + (data.perks.ExtraHints and 2 or 0) + (data.bonusHints or 0)
	data.bonusHints = 0
	sess.gate = { gate = gate, questions = chosen, started = os.clock(), seconds = seconds, hints = hints }
	BrainService.stress(player, 10)
	local out = {}
	for i, qi in ipairs(chosen) do
		local q = Content.GateQuestions[qi]
		out[i] = { q = q.q, options = q.options }
	end
	return { ok = true, name = gate.name, questions = out, seconds = seconds, hints = hints }
end)

Net.on("gate_hint", function(player, d)
	local sess = s(player).gate
	if not sess or sess.hints <= 0 then
		return { ok = false, msg = "No hints left." }
	end
	local qi = sess.questions[tonumber(d.index) or 0]
	if not qi then
		return { ok = false }
	end
	local q = Content.GateQuestions[qi]
	local wrong = {}
	for i = 1, #q.options do
		if i ~= q.answer then
			table.insert(wrong, i)
		end
	end
	sess.hints -= 1
	BrainService.lose(player, Config.HintCostFraction / 0.002, "hint")
	return { ok = true, remove = wrong[math.random(1, #wrong)], hints = sess.hints }
end)

Net.on("gate_submit", function(player, d)
	local sess = s(player)
	local g = sess.gate
	if not g then
		return { ok = false }
	end
	sess.gate = nil
	local data = DataService.get(player)
	local inTime = os.clock() - g.started <= g.seconds + 3
	local correctCount = 0
	if typeof(d.answers) == "table" then
		for i, qi in ipairs(g.questions) do
			if tonumber(d.answers[i]) == Content.GateQuestions[qi].answer then
				correctCount += 1
			end
		end
	end
	if inTime and correctCount == #g.questions then
		data.gatesPassed[g.gate.id] = true
		BrainService.resetGateNotice(player)
		local badgeKey = "Gate" .. string.sub(g.gate.id, 5)
		BrainService.awardBadge(player, badgeKey)
		BrainService.narrate(player, "gatePass")
		BrainService.push(player)
		return { ok = true, passed = true, correct = correctCount }
	end
	data.stats.gatesFailed += 1
	sess.gateCooldown = os.clock() + Config.GateFailCooldown
	BrainService.stress(player, 15)
	BrainService.narrate(player, "gateFail")
	return { ok = true, passed = false, correct = correctCount, total = #g.questions, late = not inTime }
end)

---------------------------------------------------------------------
-- Jobs (done at real workplaces in town)
---------------------------------------------------------------------
local function jobById(id)
	for _, j in ipairs(Content.Jobs) do
		if j.id == id then
			return j
		end
	end
	return nil
end

local function jobAvailable(data, job): boolean
	if job.comebackOnly and not data.comeback then
		return false
	end
	return Brain.iq(data.cells) >= job.minIQ
end

local function atWork(player, job): boolean
	local pos = WorldService.Workplaces[job.place]
	return pos ~= nil and WorldService.near(player, pos, Config.WorkRadius)
end

Net.on("jobs_list", function(player)
	local bad = guard(player, "Jobs")
	if bad then
		return bad
	end
	local data = DataService.get(player)
	local list = {}
	for _, j in ipairs(Content.Jobs) do
		if not j.comebackOnly or data.comeback then
			table.insert(list, {
				id = j.id,
				name = j.name,
				coins = j.coinsPerMinute,
				available = jobAvailable(data, j),
				current = data.job == j.id,
				minIQ = j.minIQ,
				placeName = j.placeName,
			})
		end
	end
	local current = jobById(data.job)
	return {
		ok = true,
		jobs = list,
		atWork = current ~= nil and atWork(player, current),
		workplace = current and current.placeName or nil,
		idea = data.ideaMeter,
		ideaMax = Config.EurekaTasks,
	}
end)

Net.on("job_take", function(player, d)
	local data = DataService.get(player)
	local job = jobById(d.id)
	if not data or not job or not onGain(player) or not jobAvailable(data, job) then
		return { ok = false, msg = "You can't take that job right now." }
	end
	data.job = job.id
	BrainService.awardBadge(player, "FirstJob")
	BrainService.push(player)
	Net.send(player, "workMarker", { pos = WorldService.Workplaces[job.place], name = job.placeName })
	return { ok = true, msg = "You're now a " .. job.name .. "! Go to " .. job.placeName .. " to work. 🚕" }
end)

-- Taxi: quick travel around town (both paths)
Net.on("taxi", function(player, d)
	local sess = s(player)
	-- standing on a 🌀 teleport pad (Teleportation invention) = free, instant taxi
	local onPad = false
	if d.free then
		local inv = workspace:FindFirstChild("Inventions")
		for _, pad in ipairs(inv and inv:GetChildren() or {}) do
			if pad.Name == "TeleportPad" and WorldService.near(player, pad.Position, 14) then
				onPad = true
			end
		end
	end
	local tdata = DataService.get(player)
	if onPad or (tdata and tdata.castleMap) then
		sess.taxi = nil -- teleport pad, or the Endless Castle Map (1.4): no waiting
	end
	if sess.taxi and os.clock() < sess.taxi then
		return { ok = false, msg = "The taxi is on its way… " .. math.ceil(sess.taxi - os.clock()) .. "s" }
	end
	local key = tostring(d.key)
	if key == "work" then
		local data = DataService.get(player)
		local job = data and jobById(data.job)
		if not job then
			return { ok = false, msg = "You don't have a job yet." }
		end
		local pos = WorldService.Workplaces[job.place]
		if player.Character and pos then
			player.Character:PivotTo(CFrame.new(pos + Vector3.new(0, 3, -8)))
		end
	elseif WorldService.Spots[key] then
		WorldService.teleport(player, key)
	else
		return { ok = false, msg = "Unknown place." }
	end
	sess.taxi = os.clock() + Config.TaxiCooldown
	return { ok = true, msg = "🚕 Here you go!" }
end)

Net.on("places", function(player)
	local list, extent = WorldService.placeList()
	local me = nil
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		me = { x = root.Position.X, z = root.Position.Z }
	end
	return { ok = true, places = list, extent = extent, me = me }
end)

local function shuffledOptions(correctText, wrongTexts)
	local options = { correctText }
	for _, w in ipairs(wrongTexts) do
		table.insert(options, w)
	end
	local answer = 1
	for i = #options, 2, -1 do
		local j = math.random(1, i)
		options[i], options[j] = options[j], options[i]
		if answer == i then
			answer = j
		elseif answer == j then
			answer = i
		end
	end
	return options, answer
end

local function makeTask(job)
	local t = { kind = job.task }
	if job.task == "cashier" then
		local price = math.random(3, 18)
		local paid = 20
		local change = paid - price
		t.title = "🛒 Cashier"
		t.prompt = "The item costs $" .. price .. ". The customer pays $" .. paid .. ". How much change?"
		t.options, t.answer = shuffledOptions("$" .. change, { "$" .. (change + 1), "$" .. (change - 1), "$" .. (change + 2) })
	elseif job.task == "office" then
		local words = { "Banana", "Apple", "Cherry", "Mango", "Kiwi", "Grape", "Lemon", "Peach" }
		local chosen = {}
		for i = 1, 4 do
			chosen[i] = table.remove(words, math.random(1, #words))
		end
		local first = 1
		for i = 2, 4 do
			if chosen[i] < chosen[first] then
				first = i
			end
		end
		t.title = "🏢 Sort the files"
		t.prompt = "Which file comes FIRST alphabetically?"
		t.options = chosen
		t.answer = first
	elseif job.task == "teacher" then
		local hw = pick(Content.HomeworkMistakes)
		t.title = "📝 Grade the homework"
		t.prompt = "Tap the WRONG line."
		t.options = hw.lines
		t.answer = hw.wrong
	elseif job.task == "lawyer" then
		local w = pick(Content.Testimony)
		t.title = "⚖️ Cross-examination"
		t.prompt = "Find the contradiction in the witness's story."
		t.options = w.lines
		t.answer = w.wrong
	elseif job.task == "doctor" then
		local dx = pick(Content.Diagnoses)
		t.title = "🩺 Diagnose the patient"
		t.prompt = dx.symptoms
		t.options = dx.options
		t.answer = dx.answer
	elseif job.task == "scientist" then
		local ex = pick(Content.LabExperiments)
		t.title = "🔬 Run the experiment"
		t.prompt = ex.q
		t.options = ex.options
		t.answer = ex.answer
	else -- janitor / sweeper
		local spot = math.random(1, 4)
		t.title = "🧹 Clean up"
		t.prompt = "Tap the dirty spot!"
		t.options = { "✨", "✨", "✨", "✨" }
		t.options[spot] = "🟫 dirty"
		t.answer = spot
	end
	return t
end

Net.on("job_task", function(player)
	local bad = guard(player, "Jobs")
	if bad then
		return bad
	end
	local data = DataService.get(player)
	local job = jobById(data.job)
	if not job then
		return { ok = false, msg = "Get a job at the Job Center first." }
	end
	if not atWork(player, job) then
		Net.send(player, "workMarker", { pos = WorldService.Workplaces[job.place], name = job.placeName })
		return { ok = false, msg = "You're not at work! Go to " .. job.placeName .. " (or take the 🚕 taxi).", notAtWork = true }
	end
	local t = makeTask(job)
	s(player).job = t
	return { ok = true, title = t.title, prompt = t.prompt, options = t.options, kind = t.kind }
end)

local function eureka(player, data)
	local locked = {}
	for _, inv in ipairs(Content.Inventions) do
		if not data.inventions[inv.key] then
			table.insert(locked, inv)
		end
	end
	if #locked == 0 then
		data.coins += 100
		BrainService.toast(player, "💡 Eureka! …but you've invented everything already. +100 coins instead.", "LevelUp")
		return
	end
	for i = #locked, 2, -1 do
		local j = math.random(1, i)
		locked[i], locked[j] = locked[j], locked[i]
	end
	local choices = {}
	for i = 1, math.min(3, #locked) do
		choices[i] = locked[i].key
	end
	data.eurekaChoices = choices
	local cards = {}
	for i, key in ipairs(choices) do
		for _, inv in ipairs(Content.Inventions) do
			if inv.key == key then
				cards[i] = { key = inv.key, icon = inv.icon, name = inv.name, desc = inv.desc }
			end
		end
	end
	Net.send(player, "eureka", { choices = cards })
end

local function finishTask(player, data, job, correct)
	if correct then
		data.coins += job.coinsPerMinute * 2
		data.jobTasksDone += 1
		BrainService.gain(player, 0.5, "job")
		BrainService.stress(player, 4)
		data.ideaMeter += 1
		if data.ideaMeter >= Config.EurekaTasks then
			data.ideaMeter = 0
			eureka(player, data)
		end
	else
		BrainService.stress(player, 4)
	end
	BrainService.push(player)
end

Net.on("job_answer", function(player, d)
	local t = s(player).job
	if not t then
		return { ok = false }
	end
	s(player).job = nil
	local data = DataService.get(player)
	local job = jobById(data.job)
	if not job then
		return { ok = false }
	end
	local correct = tonumber(d.choice) == t.answer
	finishTask(player, data, job, correct)
	return { ok = true, correct = correct, answer = t.answer, idea = data.ideaMeter, ideaMax = Config.EurekaTasks }
end)

-- Re-offer a Eureka choice if the player left during the cutscene
Net.on("eureka_pending", function(player)
	local data = DataService.get(player)
	if data and data.eurekaChoices then
		local cards = {}
		for i, key in ipairs(data.eurekaChoices) do
			for _, inv in ipairs(Content.Inventions) do
				if inv.key == key then
					cards[i] = { key = inv.key, icon = inv.icon, name = inv.name, desc = inv.desc }
				end
			end
		end
		return { ok = true, choices = cards }
	end
	return { ok = false }
end)

---------------------------------------------------------------------
-- Secret inventions
---------------------------------------------------------------------
local function inventionByKey(key)
	for _, inv in ipairs(Content.Inventions) do
		if inv.key == key then
			return inv
		end
	end
	return nil
end

Net.on("invention_choose", function(player, d)
	local data = DataService.get(player)
	if not data or not data.eurekaChoices or not table.find(data.eurekaChoices, d.key) then
		return { ok = false }
	end
	local inv = inventionByKey(d.key)
	data.eurekaChoices = nil
	data.inventions[inv.key] = true
	BrainService.awardBadge(player, "Eureka")
	local count = 0
	for _ in pairs(data.inventions) do
		count += 1
	end
	if count >= #Content.Inventions then
		BrainService.awardBadge(player, "AllInventions")
	end
	if inv.key == "duck" then
		player:SetAttribute("DuckPet", true)
	end
	BrainService.push(player)
	return { ok = true, icon = inv.icon, name = inv.name, desc = inv.desc }
end)

Net.on("inventions_list", function(player)
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	local sess = s(player)
	sess.cooldowns = sess.cooldowns or {}
	local list = {}
	for _, inv in ipairs(Content.Inventions) do
		local owned = data.inventions[inv.key] == true
		table.insert(list, {
			key = inv.key,
			icon = owned and inv.icon or "❓",
			name = owned and inv.name or "??? (secret)",
			desc = owned and inv.desc or "Work jobs to fill your idea meter and unlock secret inventions.",
			owned = owned,
			cooldown = math.max(0, math.ceil((sess.cooldowns[inv.key] or 0) - os.clock())),
		})
	end
	return { ok = true, inventions = list, idea = data.ideaMeter, ideaMax = Config.EurekaTasks, places = WorldService.Places }
end)

Net.on("invention_use", function(player, d)
	local data = DataService.get(player)
	local inv = inventionByKey(d.key)
	if not data or not inv or not data.inventions[inv.key] then
		return { ok = false, msg = "You don't own that invention." }
	end
	local sess = s(player)
	sess.cooldowns = sess.cooldowns or {}
	if (sess.cooldowns[inv.key] or 0) > os.clock() then
		return { ok = false, msg = "Recharging… " .. math.ceil(sess.cooldowns[inv.key] - os.clock()) .. "s" }
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local msg
	if inv.key == "duck" then
		data.bonusHints = math.min(3, (data.bonusHints or 0) + 1)
		msg = "🦆 *quack* You explained your problem out loud. +1 Skill Gate hint (" .. data.bonusHints .. "/3)."
	elseif inv.key == "coffee" then
		if data.path ~= "Gain" then
			return { ok = false, msg = "Coffee only helps on the Gain path." }
		end
		BrainService.stress(player, -40)
		msg = "☕ Infinite coffee! Stress way down."
	elseif inv.key == "pigeons" then
		if root then
			WorldService.pigeonBurst(root.Position)
		end
		msg = "🐦 PIGEONS LAUNCHED."
	elseif inv.key == "rain" then
		if root then
			WorldService.brainRain(10, root.Position)
		end
		msg = "🧠 It's raining brains!"
	elseif inv.key == "boots" then
		Net.send(player, "lowGravity", { seconds = 30 })
		msg = "🥾 Anti-gravity ON for 30 seconds."
	elseif inv.key == "remote" then
		local key = tostring(d.place)
		if not WorldService.Spots[key] then
			return { ok = false, msg = "Pick a place." }
		end
		WorldService.teleport(player, key)
		msg = "📡 Bzzzt! Teleported."
	elseif inv.key == "goggles" then
		data.focusCharges = 3
		msg = "🥽 Focus! Your next 3 library/cinema answers give 1.5× brain cells."
	elseif inv.key == "rewind" then
		local hist = sess.history
		if char and hist and #hist >= 5 then
			char:PivotTo(hist[#hist - 4])
		end
		msg = "⏪ Rewound 5 seconds."
	elseif inv.key == "robot" then
		local job = jobById(data.job)
		if not job then
			return { ok = false, msg = "The robot needs you to have a job first." }
		end
		finishTask(player, data, job, true)
		msg = "🤖 Beep boop. Job task done. +" .. (job.coinsPerMinute * 2) .. " coins."
	end
	sess.cooldowns[inv.key] = os.clock() + inv.cooldown * (ProjectService.isActive("battery") and 0.5 or 1)
	return { ok = true, msg = msg }
end)

---------------------------------------------------------------------
-- Genius habits (lower stress)
---------------------------------------------------------------------
Net.on("habit_coffee", function(player, d)
	local bad = guard(player, "Habits", true)
	if bad then
		return bad
	end
	local count = tonumber(d.count) or 0
	if count == 60 then
		BrainService.stress(player, -35)
		BrainService.awardBadge(player, "Coffee60")
		return { ok = true, msg = "Exactly 60 beans. Beethoven nods approvingly. ☕ Stress down!" }
	end
	return { ok = true, msg = "You counted " .. count .. ". Beethoven counted EXACTLY 60. No stress relief." }
end)

Net.on("habit_nap_start", function(player)
	local bad = guard(player, "Habits", true)
	if bad then
		return bad
	end
	local delay = math.random(30, 80) / 10
	s(player).nap = { issued = os.clock(), delay = delay }
	return { ok = true, delay = delay }
end)

Net.on("habit_nap_tap", function(player)
	local nap = s(player).nap
	if not nap then
		return { ok = false }
	end
	s(player).nap = nil
	local elapsed = os.clock() - nap.issued
	if elapsed < nap.delay - 0.25 then
		return { ok = true, msg = "Too early! You didn't even fall asleep." }
	elseif elapsed > nap.delay + 1.5 then
		return { ok = true, msg = "You overslept! Edison is disappointed." }
	end
	BrainService.stress(player, -30)
	return { ok = true, msg = "Perfect power nap! 😴 Stress down!" }
end)

Net.on("habit_pigeons", function(player)
	local bad = guard(player, "Habits", true)
	if bad then
		return bad
	end
	local sess = s(player)
	if sess.pigeons and os.clock() < sess.pigeons then
		return { ok = true, msg = "The pigeons are full. Come back in " .. math.ceil(sess.pigeons - os.clock()) .. "s." }
	end
	sess.pigeons = os.clock() + 45
	BrainService.stress(player, -15)
	return { ok = true, msg = "🐦 The pigeons love you. Tesla would be proud. Stress down!" }
end)

---------------------------------------------------------------------
-- Cash-grab joke shop and the Perfectly Average guy
---------------------------------------------------------------------
function GainService.cashGrab(player, btn)
	local data = DataService.get(player)
	if not data then
		return
	end
	if btn.key == "iq" then
		data.perks.DunceCap = true
		BrainService.applyCharacter(player)
	end
	BrainService.toast(player, btn.result, "SadTrombone")
	if Brain.artTier(data.cells) == "cashgrab" then
		BrainService.say(player, "Imagine falling for a BUY NOW button. 💀")
	else
		BrainService.say(player, "You can read the disclaimer now. It says the button does nothing.")
	end
end

function GainService.averageGuy(player)
	BrainService.awardBadge(player, "PerfectlyAverage")
	BrainService.toast(player, "\"I have exactly 86,000,000,000 brain cells. Not one more. Not one less.\"", "NotificationPing")
end

---------------------------------------------------------------------
-- Loops
---------------------------------------------------------------------
function GainService.reset(player)
	sessions[player] = nil
end

function GainService.start()
	Players.PlayerRemoving:Connect(function(p)
		sessions[p] = nil
	end)
	-- position history for the Pocket Time Machine
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local sess = s(player)
					sess.history = sess.history or {}
					table.insert(sess.history, root.CFrame)
					if #sess.history > 10 then
						table.remove(sess.history, 1)
					end
				end
			end
		end
	end)
	-- passive job pay + slow stress recovery
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.get(player)
				if data and data.path == "Gain" then
					local job = jobById(data.job)
					if job then
						data.coins += job.coinsPerMinute
						BrainService.push(player)
					end
					if data.stress > 0 then
						BrainService.stress(player, -3)
					end
				end
			end
		end
	end)
end

return GainService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000011"><Properties><string name="Name">LoseService</string><ProtectedString name="Source"><![CDATA[-- LoseService: everything on the Lose path (reading popups, clickbait,
-- Steal A / Fix A / Make A, comments, scroller, zones, the death ending).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)

local LoseService = {}

local sessions = {} -- [player] = { reading, nextReading, clickbait, steal, comment, lastSwipe }
local journalistHeadlines = {} -- { text, author } written by Gain players (update 1.2)
LoseService.onDumbAction = nil -- set by SocialService: maybe get sued

function LoseService.addJournalistHeadline(text: string, author: number)
	table.insert(journalistHeadlines, 1, { text = text, author = author })
	while #journalistHeadlines > 20 do
		table.remove(journalistHeadlines)
	end
end

local function dumbAction(player)
	if LoseService.onDumbAction then
		LoseService.onDumbAction(player)
	end
end
local nextId = 0

local function s(player)
	local x = sessions[player]
	if not x then
		x = { nextReading = os.clock() + math.random(Config.ReadingPopupMin, Config.ReadingPopupMax) }
		sessions[player] = x
	end
	return x
end

local function newId(): number
	nextId += 1
	return nextId
end

local function onLose(player): boolean
	local data = DataService.get(player)
	return data ~= nil and data.path == "Lose" and not data.dead
end

local function tierFor(cells: number): number
	if cells >= 70e9 then
		return 1
	elseif cells >= Config.HumanFloorCells then
		return 2
	elseif cells >= 1e9 then
		return 3
	end
	return 4
end

local function shuffle(t)
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function guard(player, feature: string)
	if not onLose(player) then
		return { ok = false, msg = "This is for the Lose path." }
	end
	if not BrainService.feature(feature) then
		return { ok = false, msg = "This is turned off right now." }
	end
	local blocked = BrainService.blocked(player)
	if blocked then
		return { ok = false, msg = blocked }
	end
	return nil
end

---------------------------------------------------------------------
-- Reading popups
---------------------------------------------------------------------
local function sendReading(player)
	local data = DataService.get(player)
	local sess = s(player)
	if not data or sess.reading then
		return
	end
	local isTOS = math.random() < Config.TOSChance and not data.badges.ReadTOS
	local text = isTOS and Content.TermsOfService or Content.ReadingTexts[math.random(1, #Content.ReadingTexts)]
	local id = newId()
	sess.reading = { id = id, issued = os.clock(), tos = isTOS }
	Net.send(player, "reading", {
		id = id,
		text = isTOS and text or Brain.degradeText(text, data.cells),
		tos = isTOS,
		tier = tierFor(data.cells),
	})
end

Net.on("reading_done", function(player, d)
	local sess = s(player)
	local r = sess.reading
	if not r or r.id ~= d.id then
		return { ok = false }
	end
	sess.reading = nil
	sess.nextReading = os.clock() + math.random(Config.ReadingPopupMin, Config.ReadingPopupMax)
	local data = DataService.get(player)
	if not data or not onLose(player) then
		return { ok = true }
	end
	local elapsed = os.clock() - r.issued
	if r.tos then
		if elapsed >= Config.TOSSeconds then
			BrainService.awardBadge(player, "ReadTOS")
			BrainService.gain(player, 1, "reading")
			return { ok = true, result = "You read the whole Terms of Service. Respect. (+brain cells, oops)" }
		end
		BrainService.lose(player, 2, "reading")
		data.stats.textsSkipped += 1
		return { ok = true, result = "Skipped the Terms of Service. Classic." }
	end
	if elapsed < Config.ReadingSeconds then
		data.stats.textsSkipped += 1
		BrainService.lose(player, 1.5, "reading")
		if math.random() < 0.3 then
			BrainService.narrate(player, "lost")
		end
		return { ok = true, result = "Skipped! 🧠📉" }
	end
	data.stats.textsRead += 1
	BrainService.gain(player, 1, "reading")
	BrainService.narrate(player, "gained")
	return { ok = true, result = "You actually READ it… you got smarter. 😭" }
end)

---------------------------------------------------------------------
-- Clickbait cards
---------------------------------------------------------------------
Net.on("clickbait_get", function(player)
	local bad = guard(player, "Clickbait")
	if bad then
		return bad
	end
	local data = DataService.get(player)
	local tier = tierFor(data.cells)
	local pool = {}
	for _, h in ipairs(Content.Headlines) do
		if h.tier == tier then
			table.insert(pool, h)
		end
	end
	shuffle(pool)
	local cards = {}
	local hasBait = false
	for i = 1, math.min(3, #pool) do
		cards[i] = pool[i]
		hasBait = hasBait or pool[i].bait
	end
	if not hasBait then
		for _, h in ipairs(pool) do
			if h.bait then
				cards[1] = h
				break
			end
		end
	end
	if tier <= 2 and #journalistHeadlines > 0 and math.random() < 0.4 then
		local j = journalistHeadlines[math.random(1, #journalistHeadlines)]
		cards[math.random(1, #cards)] = { tier = tier, bait = true, text = j.text, article = "Written by a journalist from the Gain path. It's bait. You clicked it.", author = j.author }
	end
	if tier == 4 then
		cards = { cards[1] }
	end
	local sess = s(player)
	sess.clickbait = { cards = cards, open = nil }
	local out = {}
	for i, c in ipairs(cards) do
		out[i] = { id = i, text = c.text }
	end
	return { ok = true, cards = out }
end)

Net.on("clickbait_open", function(player, d)
	local sess = s(player)
	local cb = sess.clickbait
	if not cb or not cb.cards[d.id] then
		return { ok = false }
	end
	cb.open = { id = d.id, t = os.clock() }
	return { ok = true, article = cb.cards[d.id].article, text = cb.cards[d.id].text }
end)

Net.on("clickbait_close", function(player)
	local sess = s(player)
	local cb = sess.clickbait
	if not cb or not cb.open then
		return { ok = false }
	end
	local data = DataService.get(player)
	local card = cb.cards[cb.open.id]
	local elapsed = os.clock() - cb.open.t
	sess.clickbait = nil
	if not data or not onLose(player) then
		return { ok = true }
	end
	if card.bait then
		data.clickbaitClicks += 1
		data.stats.clickbaitClicked += 1
		if data.clickbaitClicks >= 25 then
			BrainService.awardBadge(player, "ClickedEverything")
		end
		if card.author then
			local author = Players:GetPlayerByUserId(card.author)
			if author and author ~= player then
				BrainService.gain(author, 0.5, "journal")
				BrainService.toast(author, "📰 Someone clicked your clickbait headline! +brain cells")
			end
		end
		dumbAction(player)
		if elapsed < Config.ReadingSeconds then
			BrainService.lose(player, 3, "clickbait")
			BrainService.embarrass(player, 8, "You believed \"" .. card.text .. "\"")
			return { ok = true, result = "You fell for it! 🧠📉" }
		end
		BrainService.gain(player, 1, "clickbait")
		return { ok = true, result = "You clicked the bait… but then READ it. Smart. Ew." }
	end
	if elapsed < Config.ReadingSeconds then
		BrainService.lose(player, 1, "clickbait")
		return { ok = true, result = "That one was real news. You skipped it anyway. 📉" }
	end
	BrainService.gain(player, 1, "clickbait")
	return { ok = true, result = "You read real news. Your brain grew. Gross." }
end)

Net.on("clickbait_ignore", function(player)
	local sess = s(player)
	sess.clickbait = nil
	if onLose(player) then
		BrainService.gain(player, 0.3, "clickbait")
	end
	return { ok = true, result = "You ignored the clickbait. That was… smart. 🤢" }
end)

---------------------------------------------------------------------
-- Steal A / Fix A / Make A
---------------------------------------------------------------------
Net.on("steal_get", function(player)
	local bad = guard(player, "StealA")
	if bad then
		return bad
	end
	local data = DataService.get(player)
	local tier = tierFor(data.cells)
	local word = Content.StealWords[math.random(1, #Content.StealWords)]
	local options
	if tier == 1 and math.random() < 0.6 then
		local t = Content.StealTricky[math.random(1, #Content.StealTricky)]
		options = { { kind = "steal", text = t.steal }, { kind = "fix", text = t.fix }, { kind = "make", text = t.make } }
	elseif tier == 4 then
		options = { { kind = "steal", text = "STEEL A" } }
	elseif tier == 3 then
		options = { { kind = "steal", text = "Steal A Rock" }, { kind = "steal", text = "Steal A Rock 2" } }
	else
		options = {
			{ kind = "steal", text = "Steal A " .. word },
			{ kind = "fix", text = "Fix A " .. word },
			{ kind = "make", text = "Make A " .. word },
		}
	end
	shuffle(options)
	s(player).steal = { options = options, word = word }
	local out = {}
	for i, o in ipairs(options) do
		out[i] = { id = i, text = o.text }
	end
	return { ok = true, options = out }
end)

Net.on("steal_choose", function(player, d)
	local sess = s(player)
	local st = sess.steal
	if not st or not st.options[d.id] then
		return { ok = false }
	end
	sess.steal = nil
	local opt = st.options[d.id]
	if not onLose(player) then
		return { ok = true }
	end
	if opt.kind == "steal" then
		dumbAction(player)
		BrainService.lose(player, 3, "steal")
		return { ok = true, kind = "steal", word = st.word, result = "Another copycat game! 🧠📉" }
	end
	BrainService.gain(player, 0.5, "steal")
	BrainService.say(player, "Wow, original! (You gained a few brain cells by accident.)")
	return { ok = true, kind = opt.kind, result = "Wow, original! 📈 (that's bad)" }
end)

---------------------------------------------------------------------
-- Dumb internet comments
---------------------------------------------------------------------
Net.on("comments_get", function(player)
	local bad = guard(player, "Comments")
	if bad then
		return bad
	end
	local data = DataService.get(player)
	local tier = tierFor(data.cells)
	local words = {}
	for i, w in ipairs(Content.CommentWords) do
		if tier < 3 or w.dumb >= 2 or #w.text <= 4 then
			table.insert(words, { id = i, text = w.text })
		end
	end
	local post = Content.Posts[math.random(1, #Content.Posts)]
	s(player).comment = true
	return { ok = true, post = post, words = words }
end)

Net.on("comments_post", function(player, d)
	local sess = s(player)
	if not sess.comment then
		return { ok = false }
	end
	sess.comment = nil
	local data = DataService.get(player)
	if not data or not onLose(player) or typeof(d.ids) ~= "table" then
		return { ok = false }
	end
	local textParts = {}
	local score = 0
	for i, id in ipairs(d.ids) do
		if i > 5 then
			break
		end
		local w = Content.CommentWords[tonumber(id) or -1]
		if w then
			table.insert(textParts, w.text)
			score += w.dumb
		end
	end
	if #textParts == 0 then
		return { ok = false, msg = "Pick some words first." }
	end
	local comment = table.concat(textParts, " ")
	data.stats.commentsPosted += 1
	BrainService.lose(player, 1 + score / 3, "comment")
	local viral = math.random() < math.min(0.5, score * 0.03)
	if viral then
		data.viralCount += 1
		if data.viralCount >= Config.ViralBadgeCount then
			BrainService.awardBadge(player, "Ratiod")
		end
		BrainService.narrate(player, "viral")
		BrainService.embarrass(player, 40, "Your comment \"" .. comment .. "\" went viral")
		Net.send(player, "viral", { comment = comment, youtuber = Content.ReactionYoutuber })
	end
	return { ok = true, comment = comment, viral = viral }
end)

---------------------------------------------------------------------
-- Short video scroller
---------------------------------------------------------------------
Net.on("scroll_swipe", function(player)
	local bad = guard(player, "Scroller")
	if bad then
		return bad
	end
	local sess = s(player)
	local now = os.clock()
	if sess.lastSwipe and now - sess.lastSwipe < 0.25 then
		return { ok = false }
	end
	sess.lastSwipe = now
	BrainService.lose(player, 0.25, "scroll")
	return { ok = true }
end)

---------------------------------------------------------------------
-- Death ending
---------------------------------------------------------------------
function LoseService.death(player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local seconds = math.max(0, os.time() - (data.runStart or os.time()))
	if not data.bestRunSeconds or seconds < data.bestRunSeconds then
		data.bestRunSeconds = seconds
	end
	BrainService.awardBadge(player, "SmoothBrain")
	if seconds < 3600 then
		BrainService.awardBadge(player, "Speedrun")
	end
	Net.send(player, "death", {
		seconds = seconds,
		best = data.bestRunSeconds,
		clickbait = data.stats.clickbaitClicked,
		skipped = data.stats.textsSkipped,
		moments = data.embarrassingMoments,
		loud = data.perks.ExtraLoudDeath == true,
	})
	task.delay(5, function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = 0
		end
	end)
end

Net.on("death_again", function(player)
	local data = DataService.get(player)
	if not data or not data.dead then
		return { ok = false }
	end
	data.stats = { textsSkipped = 0, textsRead = 0, clickbaitClicked = 0, commentsPosted = 0, gatesFailed = 0 }
	data.embarrassingMoments = {}
	BrainService.startPath(player, "Lose")
	task.delay(1, function()
		WorldService.teleport(player, "lose")
	end)
	return { ok = true }
end)

Net.on("death_comeback", function(player)
	local data = DataService.get(player)
	if not data or not data.dead then
		return { ok = false }
	end
	Net.send(player, "comebackCutscene", {})
	BrainService.startPath(player, "Gain", true)
	task.delay(6, function()
		WorldService.teleport(player, "gain")
		BrainService.say(player, "i wnt 2 be smrt")
	end)
	return { ok = true }
end)

Net.on("switch_path", function(player, d)
	local data = DataService.get(player)
	if not data or (d.path ~= "Lose" and d.path ~= "Gain") then
		return { ok = false }
	end
	BrainService.startPath(player, d.path)
	BrainService.narrate(player, d.path == "Lose" and "choseLose" or "choseGain")
	WorldService.teleport(player, string.lower(d.path))
	return { ok = true }
end)

---------------------------------------------------------------------
-- Loops: reading popups and slow-loss zones
---------------------------------------------------------------------
function LoseService.reset(player)
	sessions[player] = nil
end

function LoseService.start()
	BrainService.hooks.onDeath = LoseService.death
	Players.PlayerRemoving:Connect(function(p)
		sessions[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				if onLose(player) and BrainService.feature("ReadingTests") and not BrainService.blocked(player) then
					local sess = s(player)
					if not sess.reading and os.clock() >= sess.nextReading then
						sendReading(player)
					elseif sess.reading and os.clock() - sess.reading.issued > 120 then
						-- left it open forever: that counts as reading it
						sess.reading = nil
						sess.nextReading = os.clock() + Config.ReadingPopupMin
						BrainService.gain(player, 1, "reading")
					end
				end
			end
		end
	end)
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(5)
			tick += 1
			if BrainService.feature("Zones") then
				for _, player in ipairs(Players:GetPlayers()) do
					if onLose(player) and not BrainService.blocked(player) then
						if WorldService.inZone(player, "microwave") then
							BrainService.lose(player, 0.5, "microwave")
							if tick % 4 == 0 then
								BrainService.say(player, "🍿 *mmmmmmmmmm* (the microwave hums)")
							end
						elseif WorldService.inZone(player, "wall") then
							BrainService.lose(player, 0.5, "wall")
							if tick % 4 == 0 then
								BrainService.say(player, "🧱 The wall is winning.")
							end
						end
					end
				end
			end
		end
	end)
end

return LoseService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000012"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Net: one RemoteFunction for requests from players, one RemoteEvent to send to players.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"
folder.Parent = ReplicatedStorage

local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = folder

local toClient = Instance.new("RemoteEvent")
toClient.Name = "ToClient"
toClient.Parent = folder

local handlers = {}
local rate = {} -- [player] = {count, windowStart}

function Net.on(action: string, handler)
	handlers[action] = handler
end

request.OnServerInvoke = function(player, action, data)
	if typeof(action) ~= "string" then
		return nil
	end
	-- simple rate limit: 25 requests per second
	local now = os.clock()
	local r = rate[player]
	if not r or now - r[2] > 1 then
		r = { 0, now }
		rate[player] = r
	end
	r[1] += 1
	if r[1] > 25 then
		return { ok = false, msg = "Slow down!" }
	end
	local handler = handlers[action]
	if not handler then
		return { ok = false, msg = "Unknown action" }
	end
	local ok, result = pcall(handler, player, typeof(data) == "table" and data or {})
	if not ok then
		warn("[Net] " .. action .. " failed: " .. tostring(result))
		return { ok = false, msg = "Something went wrong." }
	end
	return result
end

function Net.send(player: Player, kind: string, payload)
	toClient:FireClient(player, kind, payload)
end

function Net.broadcast(kind: string, payload)
	toClient:FireAllClients(kind, payload)
end

game:GetService("Players").PlayerRemoving:Connect(function(p)
	rate[p] = nil
end)

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">ProjectService</string><ProtectedString name="Source"><![CDATA[-- ProjectService (update 1.3): Major Projects, the Noble Prize, the Hall of Inventors,
-- world firsts, and inventions that change the world.
--
-- Who gets an invention:
--   inventor          -> permanent (their own record)
--   inventor's server -> active until that server closes
--   every server      -> active for 1 hour; each extra inventor of the same thing adds 15 minutes
--   world first       -> "First Invented" badge + a statue in the Hall of Inventors (permanent)

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Content = require(Shared.Content)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)
local FriendService = require(script.Parent.FriendService)
local Props = require(script.Parent.Props)

local ProjectService = {}

local firstsStore, activeStore = nil, nil
pcall(function()
	firstsStore = DataStoreService:GetDataStore("BrainWorldFirsts_v1")
	activeStore = DataStoreService:GetDataStore("BrainActiveInventions_v1")
end)

local GLOBAL_HOUR = 3600
local EXTRA = 900
local MAX_GLOBAL = 3 * 3600

local active = {} -- [key] = expiry unix time (global hour)
local serverForever = {} -- [key] = true: invented in THIS server (until it closes)
local applied = {} -- [key] = true when the world effect is built
local steps = {} -- [player] = current step { kind, answer, ... }

local function projectByKey(key)
	for _, p in ipairs(Content.Projects) do
		if p.key == key then
			return p
		end
	end
	for _, p in ipairs(Content.SpaceProjects or {}) do
		if p.key == key then
			return p
		end
	end
	return nil
end

-- World firsts that have EVER happened (any player, any server). Used by 1.4:
-- once anyone invents Space Travel, the Astronaut job unlocks for everybody.
local everInvented = {}
function ProjectService.everInvented(key: string): boolean
	return everInvented[key] == true
end
-- Space projects need an Astronaut standing in the Space Lab (set by SpaceService)
ProjectService.spaceCheck = function(_player): (boolean, string?)
	return false, "Space projects are done in the Space Lab on the Moon."
end

local function isActive(key: string): boolean
	return serverForever[key] == true or (active[key] or 0) > os.time()
end
ProjectService.isActive = isActive

local function canDoProjects(player): (boolean, string?)
	local data = DataService.get(player)
	if not data or data.path ~= "Gain" then
		return false, "Major Projects are on the Gain path."
	end
	if data.job ~= "scientist" and Brain.iq(data.cells) < 135 then
		return false, "Become a 🔬 Scientist (or reach IQ 135) to run Major Projects."
	end
	return true
end

---------------------------------------------------------------------
-- World effects of active inventions
---------------------------------------------------------------------
local effectFolder = Instance.new("Folder")
effectFolder.Name = "Inventions"
effectFolder.Parent = workspace

local function sp(v: Vector3): Vector3
	return WorldService.sp(v)
end

local function signPart(cf: CFrame, text: string, size: Vector3?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Size = size or Vector3.new(10, 3, 0.4)
	p.CFrame = cf
	p.Color = Color3.fromRGB(30, 30, 45)
	p.Parent = effectFolder
	local sg = Instance.new("SurfaceGui")
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.Parent = p
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = Color3.fromRGB(255, 235, 150)
	l.Text = text
	l.Parent = sg
	return p
end

local function promptOn(part: BasePart, action: string, object: string, fn)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.RequiresLineOfSight = false
	pp.MaxActivationDistance = 12
	pp.Parent = part
	pp.Triggered:Connect(fn)
end

local robots = {}

local EFFECTS = {}
EFFECTS.teleport = function(on)
	for _, spot in ipairs({ Vector3.new(0, 0.6, 50), Vector3.new(-100, 0.6, -40), Vector3.new(100, 0.6, -40), Vector3.new(300, 0.6, 240) }) do
		if on then
			local pad = Instance.new("Part")
			pad.Name = "TeleportPad"
			pad.Anchored = true
			pad.Shape = Enum.PartType.Cylinder
			pad.Size = Vector3.new(0.6, 8, 8)
			pad.CFrame = CFrame.new(sp(spot) + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
			pad.Color = Color3.fromRGB(120, 80, 255)
			pad.Material = Enum.Material.ForceField
			pad.Parent = effectFolder
			promptOn(pad, "Teleport", "🌀 Teleport Pad", function(player)
				Net.send(player, "freeTaxi", {})
			end)
		end
	end
end
EFFECTS.space = function(on)
	if not on then
		return
	end
	local base = CFrame.new(sp(Vector3.new(-30, 0.6, 50)))
	local body = Instance.new("Part")
	body.Anchored = true
	body.Shape = Enum.PartType.Cylinder
	body.Size = Vector3.new(26, 7, 7)
	body.CFrame = base * CFrame.new(0, 13, 0) * CFrame.Angles(0, 0, math.rad(90))
	body.Color = Color3.fromRGB(235, 235, 240)
	body.Material = Enum.Material.Metal
	body.Parent = effectFolder
	local nose = Instance.new("Part")
	nose.Anchored = true
	nose.Shape = Enum.PartType.Ball
	nose.Size = Vector3.new(7, 7, 7)
	nose.CFrame = base * CFrame.new(0, 26, 0)
	nose.Color = Color3.fromRGB(220, 40, 40)
	nose.Parent = effectFolder
	signPart(base * CFrame.new(0, 3, -6), "🚀 SPACE TRAVEL IS REAL. Astronauts (IQ 160+) launch from the Launch Pad, east of town")
end
EFFECTS.fusion = function(on)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == "LampHead" and d:IsA("BasePart") then
			d.Color = on and Color3.fromRGB(150, 230, 255) or Color3.fromRGB(255, 240, 200)
			local l = d:FindFirstChildOfClass("PointLight")
			if l then
				l.Range = on and 40 or 26
				l.Brightness = on and 1.6 or 0.8
			end
		end
	end
end
local function foodStand(spot: Vector3, label: string)
	local m = Props.vending(CFrame.new(sp(spot)), label, Color3.fromRGB(60, 170, 80))
	m.Parent = effectFolder
	local hit = Instance.new("Part")
	hit.Anchored = true
	hit.CanCollide = false
	hit.Transparency = 1
	hit.Size = Vector3.new(4, 4, 1)
	hit.CFrame = CFrame.new(sp(spot)) * CFrame.new(0, 3, -2.5)
	hit.Parent = effectFolder
	promptOn(hit, "Eat", label, function(player)
		BrainService.stress(player, -10)
		BrainService.toast(player, "😋 Free food from the inventors! Stress down.")
	end)
end
EFFECTS.hunger = function(on)
	if on then
		foodStand(Vector3.new(-40, 0.6, -45), "🌾 FREE FOOD")
	end
end
EFFECTS.labfood = function(on)
	if on then
		foodStand(Vector3.new(40, 0.6, -45), "🍔 LAB SNACKS")
	end
end
EFFECTS.water = function(on)
	local water = workspace:FindFirstChild("Town") and workspace.Town:FindFirstChild("FountainWater")
	if water and on then
		local pe = Instance.new("ParticleEmitter")
		pe.Rate = 30
		pe.Speed = NumberRange.new(6, 10)
		pe.Lifetime = NumberRange.new(1, 1.6)
		pe.Color = ColorSequence.new(Color3.fromRGB(160, 220, 255))
		pe.Size = NumberSequence.new(0.4)
		pe.Parent = water
	end
end
EFFECTS.cure = function(on)
	if on then
		signPart(CFrame.new(sp(Vector3.new(300, 0.6, 40))) * CFrame.new(0, 12, 0), "🧬 CANCER: CURED ✅", Vector3.new(16, 4, 0.4))
		for _, p in ipairs(Players:GetPlayers()) do
			BrainService.stress(p, -20)
		end
	end
end
EFFECTS.translator = function(on)
	if on then
		signPart(CFrame.new(sp(Vector3.new(0, 0.6, -70))) * CFrame.new(0, 22, 0), "🗣 Hola • Bonjour • Shalom • 你好 • Hello", Vector3.new(20, 3, 0.4))
	end
end
EFFECTS.climate = function(on)
	if on then
		Net.broadcast("weather", { kind = "sun", seconds = 3600 })
	end
end
EFFECTS.robots = function(on)
	if not on then
		return
	end
	for i = 1, 3 do
		local bot = FriendService.npc("Robot" .. i, Color3.fromRGB(180, 185, 195), Color3.fromRGB(90, 100, 120), Color3.fromRGB(60, 65, 80))
		if bot then
			bot:PivotTo(CFrame.new(sp(Vector3.new(-20 + i * 10, 4, 20))))
			bot.Parent = effectFolder
			table.insert(robots, bot)
		end
	end
	task.spawn(function()
		while #robots > 0 do
			for _, bot in ipairs(robots) do
				local hum = bot:FindFirstChildOfClass("Humanoid")
				if hum and bot.Parent then
					hum:MoveTo(sp(Vector3.new(math.random(-60, 60), 1, math.random(-60, 60))))
				end
			end
			task.wait(4)
		end
	end)
end
EFFECTS.superconductor = function()
	for _, p in ipairs(Players:GetPlayers()) do
		BrainService.applyCharacter(p)
	end
end
-- battery is checked by GainService (gadget cooldowns)

ProjectService.EFFECTS = EFFECTS
ProjectService.effectFolder = effectFolder
ProjectService.signPart = signPart

local function applyEffect(key: string)
	if applied[key] or not EFFECTS[key] then
		applied[key] = true
		return
	end
	applied[key] = true
	pcall(EFFECTS[key], true)
end

ProjectService.speedBonus = function(): number
	return isActive("superconductor") and 6 or 0
end

---------------------------------------------------------------------
-- Hall of Inventors (statues of world firsts)
---------------------------------------------------------------------
local hallCount = 0
local function addStatue(userId: number, name: string, project)
	hallCount += 1
	local i = hallCount
	local x = -66 + ((i - 1) % 12) * 12
	local base = CFrame.new(sp(Vector3.new(x, 0.6, -95))) * CFrame.Angles(0, math.pi, 0)
	local plinth = Instance.new("Part")
	plinth.Anchored = true
	plinth.Size = Vector3.new(5, 3, 5)
	plinth.CFrame = base * CFrame.new(0, 1.5, 0)
	plinth.Color = Color3.fromRGB(235, 232, 225)
	plinth.Material = Enum.Material.Marble
	plinth.Parent = effectFolder
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = plinth
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.Garamond
	l.TextColor3 = Color3.fromRGB(60, 50, 30)
	l.Text = project.icon .. " " .. project.name .. "\nFirst invented by\n" .. name
	l.Parent = sg
	task.spawn(function()
		local ok, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(userId)
		end)
		local model = ok and desc and FriendService.makeModel(desc, "Statue_" .. name)
		if model then
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.Material = Enum.Material.Marble
					d.Color = Color3.fromRGB(230, 228, 220)
				elseif d:IsA("Decal") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
					d:Destroy()
				end
			end
			model:PivotTo(base * CFrame.new(0, 6, 0))
			model.Parent = effectFolder
		end
	end)
end

ProjectService.addStatue = function(userId: number, name: string, icon: string, title: string)
	addStatue(userId, name, { icon = icon, name = title })
end

local function loadHall()
	if not firstsStore then
		return
	end
	local ok, firsts = pcall(function()
		return firstsStore:GetAsync("firsts")
	end)
	if ok and typeof(firsts) == "table" then
		for k in pairs(firsts) do
			everInvented[k] = true
		end
		for _, project in ipairs(Content.Projects) do
			local f = firsts[project.key]
			if f then
				addStatue(f.userId, f.name, project)
			end
		end
	end
end

-- Atomic world-first claim (two players can't both get it)
local function claimWorldFirst(player, project): boolean
	if not firstsStore then
		return false
	end
	local won = false
	pcall(function()
		firstsStore:UpdateAsync("firsts", function(old)
			old = old or {}
			if old[project.key] then
				won = false
				return nil
			end
			old[project.key] = { userId = player.UserId, name = player.DisplayName, time = os.time() }
			won = true
			return old
		end)
	end)
	return won
end

---------------------------------------------------------------------
-- Global invention hour
---------------------------------------------------------------------
local function extendGlobal(key: string): number
	local now = os.time()
	local newExpiry = now + GLOBAL_HOUR
	if activeStore then
		pcall(function()
			activeStore:UpdateAsync("active", function(old)
				old = old or {}
				local cur = old[key] or 0
				if cur > now then
					cur = math.min(cur + EXTRA, now + MAX_GLOBAL)
				else
					cur = now + GLOBAL_HOUR
				end
				old[key] = cur
				newExpiry = cur
				return old
			end)
		end)
	end
	return newExpiry
end

local function onGlobal(key: string, expiry: number, by: string?)
	if (active[key] or 0) < expiry then
		active[key] = expiry
	end
	applyEffect(key)
	if by then
		local p = projectByKey(key)
		Net.broadcast("announce", { text = "🎉 " .. by .. " just invented " .. (p and (p.icon .. " " .. p.name) or key) .. "! Active in every server for a while.", by = "Dr. Wrinkles", global = true })
	end
end

---------------------------------------------------------------------
-- Project steps
---------------------------------------------------------------------
-- phases: 1-2 grant, 3-4 research, 5 peer review, 6 test day
local PHASES = 6
local PHASE_NAMES = { "💰 Grant proposal", "💰 Grant proposal", "🔬 Research", "🔬 Research", "📝 Peer review", "🚀 Test day" }

local function makeStep(project, phase: number)
	if phase <= 2 then
		local args = {}
		for _, a in ipairs(Content.GrantArguments) do
			table.insert(args, a)
		end
		for i = #args, 2, -1 do
			local j = math.random(1, i)
			args[i], args[j] = args[j], args[i]
		end
		local opts, best = {}, 1
		for i = 1, 3 do
			opts[i] = args[i].text
			if args[i].strength > args[best].strength then
				best = i
			end
		end
		return { prompt = "Convince the funding committee. Pick your STRONGEST argument.", options = opts, answer = best }
	elseif phase <= 4 then
		local q = project.qs[phase - 2] or project.qs[1]
		return { prompt = q.q, options = q.options, answer = q.answer }
	elseif phase == 5 then
		local pr = Content.PeerReview[math.random(1, #Content.PeerReview)]
		return { prompt = "Another scientist reviewed your paper. Tap the line with the FLAW.", options = pr.lines, answer = pr.wrong }
	end
	return { prompt = "Everything is ready. The whole server is watching. Launch the prototype?", options = { "🚀 LAUNCH!" }, answer = 1 }
end

Net.on("project_list", function(player)
	local ok, why = canDoProjects(player)
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	data.projectsDone = data.projectsDone or {}
	local list = {}
	for _, p in ipairs(Content.Projects) do
		table.insert(list, { key = p.key, icon = p.icon, name = p.name, unlock = p.unlock, done = data.projectsDone[p.key] == true, globalActive = isActive(p.key) })
	end
	local spaceOk = ProjectService.spaceCheck(player)
	for _, p in ipairs(Content.SpaceProjects or {}) do
		table.insert(list, { key = p.key, icon = p.icon, name = p.name, unlock = "🌙 SPACE LAB ONLY. " .. p.unlock, space = true, locked = not spaceOk, done = data.projectsDone[p.key] == true, globalActive = isActive(p.key) })
	end
	local act = data.project and projectByKey(data.project.key)
	return {
		ok = true,
		allowed = ok,
		why = why,
		projects = list,
		active = act and { key = act.key, name = act.name, icon = act.icon, phase = data.project.phase, phases = PHASES, phaseName = PHASE_NAMES[data.project.phase] } or nil,
		timeMachineFails = data.timeMachineFails or 0,
	}
end)

Net.on("project_start", function(player, d)
	local ok, why = canDoProjects(player)
	if not ok then
		return { ok = false, msg = why }
	end
	local data = DataService.get(player)
	if d.key == "timemachine" then
		data.timeMachineFails = (data.timeMachineFails or 0) + 1
		BrainService.stress(player, 5)
		if data.timeMachineFails >= 10 then
			BrainService.awardBadge(player, "MaybeNextTime")
		end
		return { ok = true, timeMachine = true, msg = "⏳ " .. Content.TimeMachineFails[math.random(1, #Content.TimeMachineFails)] .. "  (fail #" .. data.timeMachineFails .. ")" }
	end
	if data.project then
		return { ok = false, msg = "Finish your current project first." }
	end
	local p = projectByKey(d.key)
	if not p then
		return { ok = false }
	end
	if p.space then
		local okSpace, whySpace = ProjectService.spaceCheck(player)
		if not okSpace then
			return { ok = false, msg = whySpace }
		end
	end
	data.project = { key = p.key, phase = 1 }
	return { ok = true }
end)

Net.on("project_abandon", function(player)
	local data = DataService.get(player)
	if data then
		data.project = nil
	end
	return { ok = true, msg = "Project abandoned. The lab is quiet again." }
end)

Net.on("project_step", function(player)
	local data = DataService.get(player)
	if not data or not data.project then
		return { ok = false, msg = "No active project." }
	end
	if BrainService.blocked(player) then
		return { ok = false, msg = BrainService.blocked(player) }
	end
	local p = projectByKey(data.project.key)
	local step = makeStep(p, data.project.phase)
	steps[player] = step
	return { ok = true, icon = p.icon, name = p.name, phase = data.project.phase, phases = PHASES, phaseName = PHASE_NAMES[data.project.phase], prompt = step.prompt, options = step.options }
end)

local function complete(player, p)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.project = nil
	data.projectsDone = data.projectsDone or {}
	data.projectsDone[p.key] = true
	BrainService.awardBadge(player, "Inventor")
	BrainService.gain(player, 6, "project")
	serverForever[p.key] = true
	local real = not data.adminTouched -- staff-boosted accounts don't count as real inventions
	if real then
		everInvented[p.key] = true
	end
	applyEffect(p.key)
	local expiry = extendGlobal(p.key)
	onGlobal(p.key, expiry, player.DisplayName)
	pcall(function()
		MessagingService:PublishAsync("BrainInvention", { key = p.key, expiry = expiry, by = player.DisplayName, from = game.JobId, real = real })
	end)
	if real and ProjectService.onInvented then
		task.spawn(ProjectService.onInvented, p.key)
	end
	local first = (not data.adminTouched) and claimWorldFirst(player, p)
	if first then
		BrainService.awardBadge(player, "FirstInvented")
		addStatue(player.UserId, player.DisplayName, p)
	end
	Net.send(player, "prize", { icon = p.icon, name = p.name, unlock = p.unlock, first = first })
end

Net.on("project_answer", function(player, d)
	local data = DataService.get(player)
	local step = steps[player]
	if not data or not data.project or not step then
		return { ok = false }
	end
	steps[player] = nil
	local p = projectByKey(data.project.key)
	local correct = tonumber(d.choice) == step.answer
	if not correct then
		BrainService.stress(player, 12)
		return { ok = true, correct = false, msg = "💥 KABOOM. The experiment exploded. Your hair is singed. Try again." }
	end
	BrainService.gain(player, 1, "project")
	BrainService.stress(player, 5)
	if data.project.phase >= PHASES then
		-- test day: the whole server gets a countdown
		Net.broadcast("announce", { text = "🚀 " .. player.DisplayName .. " is testing " .. p.icon .. " " .. p.name .. " at the Science Lab!", by = "Dr. Wrinkles" })
		Net.broadcast("testDay", { name = p.name, icon = p.icon, by = player.DisplayName })
		task.delay(6, function()
			if player.Parent then
				complete(player, p)
			end
		end)
		return { ok = true, correct = true, testDay = true }
	end
	data.project.phase += 1
	return { ok = true, correct = true, phase = data.project.phase }
end)

Net.on("prize_refuse", function(player)
	BrainService.awardBadge(player, "RefusedPrize")
	return { ok = true, msg = "You refused the Noble Prize. Like Perelman. Legendary." }
end)

-- Admin: start a global invention hour without the project
function ProjectService.adminInvent(key: string, by: string): boolean
	local p = projectByKey(key)
	if not p then
		return false
	end
	serverForever[key] = true
	local expiry = extendGlobal(key)
	onGlobal(key, expiry, by)
	pcall(function()
		MessagingService:PublishAsync("BrainInvention", { key = key, expiry = expiry, by = by, from = game.JobId })
	end)
	return true
end

function ProjectService.start()
	BrainService.extraSpeed = ProjectService.speedBonus
	Players.PlayerRemoving:Connect(function(p)
		steps[p] = nil
	end)
	task.spawn(loadHall)
	task.spawn(function()
		while true do
			task.wait(300)
			if firstsStore then
				local ok, firsts = pcall(function()
					return firstsStore:GetAsync("firsts")
				end)
				if ok and typeof(firsts) == "table" then
					for k in pairs(firsts) do
						if not everInvented[k] then
							everInvented[k] = true
							if ProjectService.onInvented then
								task.spawn(ProjectService.onInvented, k)
							end
						end
					end
				end
			end
		end
	end)
	-- inventions still running from other servers
	task.spawn(function()
		if not activeStore then
			return
		end
		local ok, cur = pcall(function()
			return activeStore:GetAsync("active")
		end)
		if ok and typeof(cur) == "table" then
			for key, expiry in pairs(cur) do
				if typeof(expiry) == "number" and expiry > os.time() then
					onGlobal(key, expiry, nil)
				end
			end
		end
	end)
	pcall(function()
		MessagingService:SubscribeAsync("BrainInvention", function(msg)
			local d = msg.Data
			if typeof(d) == "table" and d.from ~= game.JobId then
				if d.real then
					everInvented[d.key] = true
					if ProjectService.onInvented then
						task.spawn(ProjectService.onInvented, d.key)
					end
				end
				onGlobal(d.key, d.expiry, d.by)
			end
		end)
	end)
	local _ = Debris
end

return ProjectService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000014"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[-- Props: detailed, real-looking furniture and objects built from parts
-- (microwaves, cars, desks, arcade machines, bookshelves, vending machines...).
--
-- WANT REAL 3D MODELS? Drag any model from the Studio Toolbox into
-- ServerStorage > Props and name it exactly like a prop below (e.g. "Car",
-- "Microwave", "Desk"). The game will use YOUR model instead, sized to fit.
-- Scripts inside Toolbox models are removed automatically for safety.
--
-- Every builder takes a CFrame on the floor, facing -Z (the front), and returns a Model.

local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")

local Props = {}

local folder = Instance.new("Folder")
folder.Name = "Props"
folder.Parent = workspace

local function newModel(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = folder
	return m
end

local function box(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, extra)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CFrame = cf
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(extra or {}) do
		p[k] = v
	end
	p:SetAttribute("Role", "prop")
	CollectionService:AddTag(p, "Styled")
	p.Parent = model
	return p
end

-- vertical cylinder standing on its base
local function cyl(model: Model, cf: CFrame, height: number, diameter: number, color: Color3, material: Enum.Material?, extra)
	local e = extra or {}
	e.Shape = Enum.PartType.Cylinder
	return box(model, cf * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(height, diameter, diameter), color, material, e)
end

local function ball(model: Model, cf: CFrame, d: number, color: Color3, material: Enum.Material?)
	return box(model, cf, Vector3.new(d, d, d), color, material, { Shape = Enum.PartType.Ball })
end

local function screen(part: BasePart, text: string, face: Enum.NormalId?, bg: Color3?, fg: Color3?)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundColor3 = bg or Color3.fromRGB(10, 10, 14)
	l.BackgroundTransparency = bg and 0 or 1
	l.TextColor3 = fg or Color3.fromRGB(120, 255, 140)
	l.TextScaled = true
	l.Font = Enum.Font.Code
	l.Text = text
	l.Parent = sg
	return l
end

local WOOD = Color3.fromRGB(140, 95, 60)
local DARKWOOD = Color3.fromRGB(90, 60, 40)
local STEEL = Color3.fromRGB(170, 172, 178)
local BLACK = Color3.fromRGB(25, 25, 30)
local WHITE = Color3.fromRGB(240, 240, 240)

---------------------------------------------------------------------
-- Toolbox override: use the owner's model if one is in ServerStorage > Props
---------------------------------------------------------------------
local function custom(name: string, cf: CFrame, targetSize: number): Model?
	local src = ServerStorage:FindFirstChild("Props")
	local template = src and src:FindFirstChild(name)
	if not template or not template:IsA("Model") then
		return nil
	end
	local m = template:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	local _, size = m:GetBoundingBox()
	local biggest = math.max(size.X, size.Z)
	if biggest > 0 then
		pcall(function()
			m:ScaleTo(m:GetScale() * targetSize / biggest)
		end)
	end
	m:PivotTo(cf)
	local bbCf, bbSize = m:GetBoundingBox()
	local bottom = bbCf.Position.Y - bbSize.Y / 2
	m:PivotTo(m:GetPivot() + Vector3.new(0, cf.Position.Y - bottom, 0))
	m.Parent = folder
	return m
end

---------------------------------------------------------------------
-- Builders
---------------------------------------------------------------------
function Props.microwave(cf: CFrame, s: number?)
	s = s or 1
	local m = custom("Microwave", cf, 6 * s)
	if m then
		return m, nil
	end
	m = newModel("Microwave")
	local c = cf * CFrame.new(0, 0, 0)
	box(m, c * CFrame.new(0, 2 * s, 0), Vector3.new(6, 4, 4) * s, Color3.fromRGB(215, 215, 220), Enum.Material.Metal)
	box(m, c * CFrame.new(-0.8 * s, 2 * s, -2.02 * s), Vector3.new(3.8, 3.2, 0.1) * s, Color3.fromRGB(20, 20, 25), Enum.Material.Glass, { Transparency = 0.25 })
	box(m, c * CFrame.new(1.25 * s, 2 * s, -2.03 * s), Vector3.new(0.15, 2.8, 0.2) * s, STEEL, Enum.Material.Metal) -- handle
	local panel = box(m, c * CFrame.new(2.2 * s, 2 * s, -2.02 * s), Vector3.new(1.4, 3.6, 0.1) * s, Color3.fromRGB(40, 40, 45))
	local display = box(m, c * CFrame.new(2.2 * s, 3.25 * s, -2.08 * s), Vector3.new(1.1, 0.5, 0.05) * s, BLACK)
	local label = screen(display, "10:00", Enum.NormalId.Front, BLACK, Color3.fromRGB(80, 255, 120))
	for row = 0, 3 do
		for col = 0, 2 do
			box(m, c * CFrame.new((1.85 + col * 0.35) * s, (2.6 - row * 0.4) * s, -2.08 * s), Vector3.new(0.25, 0.25, 0.05) * s, Color3.fromRGB(200, 200, 205))
		end
	end
	cyl(m, c * CFrame.new(-0.8 * s, 0.55 * s, 0), 0.1 * s, 3 * s, Color3.fromRGB(230, 230, 230), Enum.Material.Glass, { Transparency = 0.3 })
	local _ = panel
	return m, label
end

function Props.desk(cf: CFrame, withComputer: boolean?)
	local m = custom("Desk", cf, 7)
	if m then
		return m
	end
	m = newModel("Desk")
	box(m, cf * CFrame.new(0, 3.3, 0), Vector3.new(7, 0.3, 3.5), WOOD, Enum.Material.WoodPlanks)
	for _, x in ipairs({ -3.2, 3.2 }) do
		for _, z in ipairs({ -1.5, 1.5 }) do
			box(m, cf * CFrame.new(x, 1.6, z), Vector3.new(0.3, 3.2, 0.3), DARKWOOD, Enum.Material.Wood)
		end
	end
	box(m, cf * CFrame.new(2.2, 2.4, 0), Vector3.new(2, 1.6, 3.2), WOOD, Enum.Material.WoodPlanks) -- drawers
	box(m, cf * CFrame.new(2.2, 2.4, -1.62), Vector3.new(0.6, 0.12, 0.05), STEEL, Enum.Material.Metal)
	-- chair (behind the desk, facing it)
	box(m, cf * CFrame.new(0, 1.8, 2.8), Vector3.new(2, 0.3, 2), Color3.fromRGB(40, 40, 50), Enum.Material.Fabric)
	box(m, cf * CFrame.new(0, 3.1, 3.7), Vector3.new(2, 2.4, 0.3), Color3.fromRGB(40, 40, 50), Enum.Material.Fabric)
	cyl(m, cf * CFrame.new(0, 0.9, 2.8), 1.6, 0.3, BLACK, Enum.Material.Metal)
	cyl(m, cf * CFrame.new(0, 0.1, 2.8), 0.2, 1.8, BLACK, Enum.Material.Metal)
	if withComputer ~= false then
		box(m, cf * CFrame.new(-1, 3.6, 0.6), Vector3.new(0.6, 0.3, 0.5), BLACK)
		box(m, cf * CFrame.new(-1, 4.2, 0.7), Vector3.new(0.2, 1, 0.2), BLACK)
		local mon = box(m, cf * CFrame.new(-1, 5.1, 0.6), Vector3.new(3, 1.8, 0.15), BLACK)
		screen(mon, "C:\\>_", Enum.NormalId.Back, Color3.fromRGB(20, 60, 120), Color3.fromRGB(200, 230, 255))
		box(m, cf * CFrame.new(-1, 3.5, -0.6), Vector3.new(2.4, 0.1, 0.8), Color3.fromRGB(50, 50, 55))
	end
	return m
end

function Props.arcade(cf: CFrame, title: string)
	local m = custom("ArcadeMachine", cf, 4)
	if m then
		return m
	end
	m = newModel("ArcadeMachine")
	local body = Color3.fromRGB(40, 20, 70)
	box(m, cf * CFrame.new(0, 3.5, 0.3), Vector3.new(3.4, 7, 2.6), body)
	box(m, cf * CFrame.new(-1.75, 3.5, 0.3), Vector3.new(0.12, 7.1, 2.7), Color3.fromRGB(255, 60, 200), Enum.Material.Neon)
	box(m, cf * CFrame.new(1.75, 3.5, 0.3), Vector3.new(0.12, 7.1, 2.7), Color3.fromRGB(255, 60, 200), Enum.Material.Neon)
	local scr = box(m, cf * CFrame.new(0, 4.8, -1.05) * CFrame.Angles(math.rad(-12), 0, 0), Vector3.new(2.8, 2.2, 0.1), BLACK)
	screen(scr, "🎮 " .. title, Enum.NormalId.Front, Color3.fromRGB(10, 10, 40), Color3.fromRGB(255, 230, 80)).Font = Enum.Font.Arcade
	box(m, cf * CFrame.new(0, 3, -1.4), Vector3.new(3.2, 0.4, 1.2), Color3.fromRGB(30, 30, 35))
	cyl(m, cf * CFrame.new(-0.7, 3.4, -1.5), 0.6, 0.15, BLACK)
	ball(m, cf * CFrame.new(-0.7, 3.8, -1.5), 0.4, Color3.fromRGB(220, 30, 30))
	for i, col in ipairs({ Color3.fromRGB(255, 60, 60), Color3.fromRGB(60, 160, 255), Color3.fromRGB(255, 220, 60) }) do
		cyl(m, cf * CFrame.new(0.2 + i * 0.4, 3.25, -1.5), 0.15, 0.3, col)
	end
	local marquee = box(m, cf * CFrame.new(0, 7.3, -0.2), Vector3.new(3.4, 1, 1.4), BLACK)
	screen(marquee, title, Enum.NormalId.Front, Color3.fromRGB(255, 200, 0), Color3.fromRGB(40, 20, 70)).Font = Enum.Font.FredokaOne
	return m
end

function Props.newsstand(cf: CFrame)
	local m = custom("Newsstand", cf, 8)
	if m then
		return m
	end
	m = newModel("Newsstand")
	box(m, cf * CFrame.new(0, 1.8, 0), Vector3.new(8, 3.6, 3), Color3.fromRGB(30, 90, 60), Enum.Material.Metal)
	for _, x in ipairs({ -3.8, 3.8 }) do
		box(m, cf * CFrame.new(x, 4.5, 0.5), Vector3.new(0.3, 9, 0.3), Color3.fromRGB(30, 90, 60), Enum.Material.Metal)
	end
	box(m, cf * CFrame.new(0, 9.1, 0), Vector3.new(9, 0.4, 5), Color3.fromRGB(200, 40, 40), Enum.Material.Fabric)
	-- magazine rack on the front
	local covers = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 160, 255), Color3.fromRGB(255, 220, 60), Color3.fromRGB(120, 220, 120), Color3.fromRGB(240, 120, 240) }
	local headlines = { "SHOCKING!", "YOU WON'T BELIEVE", "SKIBIDI?!", "FREE BRAIN", "😱 WOW" }
	for i = 1, 5 do
		local cover = box(m, cf * CFrame.new(-3.2 + i * 1.07, 5.5, 0.9) * CFrame.Angles(math.rad(-10), 0, 0), Vector3.new(0.9, 1.3, 0.08), covers[i], Enum.Material.SmoothPlastic)
		screen(cover, headlines[i], Enum.NormalId.Front, covers[i], Color3.new(1, 1, 1)).Font = Enum.Font.GothamBlack
	end
	for i = 1, 4 do
		box(m, cf * CFrame.new(-3 + i * 1.2, 3.75, -0.8), Vector3.new(1, 0.15, 1.4), Color3.fromRGB(235, 230, 220), Enum.Material.SmoothPlastic)
	end
	return m
end

function Props.phoneTable(cf: CFrame)
	local m = custom("PhoneDisplay", cf, 8)
	if m then
		return m
	end
	m = newModel("PhoneDisplay")
	box(m, cf * CFrame.new(0, 3, 0), Vector3.new(8, 0.3, 3.5), WHITE, Enum.Material.SmoothPlastic)
	box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(7.4, 3, 3), Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic)
	local emojis = { "🐱", "🕺", "🍜", "🦆", "🚀" }
	for i = 1, 5 do
		local stand = box(m, cf * CFrame.new(-3.6 + i * 1.2, 3.75, 0) * CFrame.Angles(math.rad(-20), 0, 0), Vector3.new(0.8, 1.5, 0.1), BLACK)
		screen(stand, emojis[i], Enum.NormalId.Front, Color3.fromRGB(math.random(60, 200), math.random(60, 200), 255), Color3.new(1, 1, 1))
	end
	return m
end

function Props.shopCounter(cf: CFrame, productColors: { Color3 }?)
	local m = custom("ShopCounter", cf, 9)
	if m then
		return m
	end
	m = newModel("ShopCounter")
	box(m, cf * CFrame.new(0, 1.8, 0), Vector3.new(9, 3.6, 2.6), Color3.fromRGB(240, 238, 230), Enum.Material.Marble)
	box(m, cf * CFrame.new(0, 3.65, 0), Vector3.new(9.4, 0.2, 3), DARKWOOD, Enum.Material.WoodPlanks)
	-- cash register
	box(m, cf * CFrame.new(2.5, 4.2, 0), Vector3.new(1.8, 0.9, 1.6), Color3.fromRGB(50, 50, 55))
	local reg = box(m, cf * CFrame.new(2.5, 5, 0.3) * CFrame.Angles(math.rad(-25), 0, 0), Vector3.new(1.4, 0.8, 0.1), BLACK)
	screen(reg, "$ 0.00", Enum.NormalId.Front, BLACK, Color3.fromRGB(100, 255, 120))
	-- shelves with products behind
	local colors = productColors or { Color3.fromRGB(230, 70, 70), Color3.fromRGB(70, 140, 230), Color3.fromRGB(250, 200, 50), Color3.fromRGB(90, 200, 120) }
	box(m, cf * CFrame.new(0, 4, 4), Vector3.new(9, 8, 1.2), WOOD, Enum.Material.WoodPlanks)
	for row = 0, 2 do
		box(m, cf * CFrame.new(0, 1.8 + row * 2.4, 3.3), Vector3.new(9, 0.2, 1.4), DARKWOOD, Enum.Material.Wood)
		for i = 0, 6 do
			box(m, cf * CFrame.new(-3.9 + i * 1.3, 2.5 + row * 2.4, 3.3), Vector3.new(0.9, 1.2, 0.8), colors[((i + row) % #colors) + 1], Enum.Material.SmoothPlastic)
		end
	end
	return m
end

function Props.bookshelf(cf: CFrame, width: number?)
	local w = width or 6
	local m = custom("Bookshelf", cf, w)
	if m then
		return m
	end
	m = newModel("Bookshelf")
	box(m, cf * CFrame.new(0, 4, 0.6), Vector3.new(w, 8, 0.2), DARKWOOD, Enum.Material.Wood)
	for _, x in ipairs({ -w / 2, w / 2 }) do
		box(m, cf * CFrame.new(x, 4, 0), Vector3.new(0.3, 8, 1.4), DARKWOOD, Enum.Material.Wood)
	end
	local bookColors = { Color3.fromRGB(150, 40, 40), Color3.fromRGB(40, 70, 140), Color3.fromRGB(40, 110, 60), Color3.fromRGB(180, 140, 40), Color3.fromRGB(90, 50, 110), Color3.fromRGB(200, 200, 190) }
	for row = 0, 3 do
		local y = 0.3 + row * 2
		box(m, cf * CFrame.new(0, y, 0), Vector3.new(w, 0.2, 1.4), DARKWOOD, Enum.Material.Wood)
		local x = -w / 2 + 0.3
		while x < w / 2 - 0.5 do
			local bw = 0.25 + math.random() * 0.25
			local bh = 1.2 + math.random() * 0.5
			box(m, cf * CFrame.new(x + bw / 2, y + 0.1 + bh / 2, 0), Vector3.new(bw, bh, 1), bookColors[math.random(1, #bookColors)], Enum.Material.Fabric)
			x += bw + 0.03
		end
	end
	return m
end

function Props.ticketBooth(cf: CFrame)
	local m = custom("TicketBooth", cf, 7)
	if m then
		return m
	end
	m = newModel("TicketBooth")
	box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(6, 7, 4), Color3.fromRGB(160, 30, 40), Enum.Material.Fabric)
	box(m, cf * CFrame.new(0, 4.2, -2.02), Vector3.new(3.5, 2.2, 0.1), Color3.fromRGB(180, 210, 230), Enum.Material.Glass, { Transparency = 0.4 })
	local top = box(m, cf * CFrame.new(0, 7.6, -0.5), Vector3.new(6.6, 1.2, 0.4), Color3.fromRGB(240, 200, 60), Enum.Material.Metal)
	screen(top, "🎟 TICKETS", Enum.NormalId.Front, Color3.fromRGB(240, 200, 60), Color3.fromRGB(120, 20, 30)).Font = Enum.Font.FredokaOne
	-- popcorn machine
	box(m, cf * CFrame.new(4.6, 1.5, 0), Vector3.new(2, 3, 2), Color3.fromRGB(200, 30, 30), Enum.Material.Metal)
	box(m, cf * CFrame.new(4.6, 4, 0), Vector3.new(2, 2, 2), Color3.fromRGB(230, 240, 250), Enum.Material.Glass, { Transparency = 0.5 })
	for _ = 1, 10 do
		ball(m, cf * CFrame.new(4.6 + (math.random() - 0.5) * 1.4, 3.3 + math.random() * 0.6, (math.random() - 0.5) * 1.4), 0.35, Color3.fromRGB(255, 240, 180))
	end
	return m
end

function Props.examDesk(cf: CFrame)
	local m = Props.desk(cf, false)
	box(m, cf * CFrame.new(-1, 3.48, 0), Vector3.new(1.2, 0.05, 1.6), WHITE)
	box(m, cf * CFrame.new(0, 3.5, 0.2) * CFrame.Angles(0, math.rad(30), 0), Vector3.new(0.1, 0.1, 1.2), Color3.fromRGB(240, 200, 40))
	local stand = box(m, cf * CFrame.new(0, 6.5, 0.9), Vector3.new(5, 2, 0.2), Color3.fromRGB(40, 40, 60))
	screen(stand, "📝 EXAM IN PROGRESS", Enum.NormalId.Front, Color3.fromRGB(40, 40, 60), Color3.fromRGB(255, 230, 120)).Font = Enum.Font.GothamBold
	return m
end

function Props.bulletinBoard(cf: CFrame)
	local m = custom("BulletinBoard", cf, 8)
	if m then
		return m
	end
	m = newModel("BulletinBoard")
	box(m, cf * CFrame.new(0, 4.5, 0), Vector3.new(8, 5, 0.3), Color3.fromRGB(170, 120, 70), Enum.Material.Fabric)
	box(m, cf * CFrame.new(0, 4.5, 0.1), Vector3.new(8.4, 5.4, 0.2), DARKWOOD, Enum.Material.Wood)
	for _, x in ipairs({ -3.8, 3.8 }) do
		box(m, cf * CFrame.new(x, 1.5, 0.1), Vector3.new(0.4, 3, 0.4), DARKWOOD, Enum.Material.Wood)
	end
	local notes = { "HIRING: CASHIER", "TEACHER WANTED", "LAB ASSISTANT", "LAWYER NEEDED", "DOCTOR 🩺", "OFFICE JOB" }
	for i, n in ipairs(notes) do
		local x = -2.7 + ((i - 1) % 3) * 2.7
		local y = 5.6 - math.floor((i - 1) / 3) * 2.2
		local paper = box(m, cf * CFrame.new(x, y, -0.2) * CFrame.Angles(0, 0, math.rad(math.random(-6, 6))), Vector3.new(2.2, 1.8, 0.05), Color3.fromRGB(250, 248, 235))
		screen(paper, n, Enum.NormalId.Front, Color3.fromRGB(250, 248, 235), Color3.fromRGB(40, 40, 40)).Font = Enum.Font.Gotham
	end
	return m
end

function Props.cafeCounter(cf: CFrame)
	local m = custom("CafeCounter", cf, 8)
	if m then
		return m
	end
	m = newModel("CafeCounter")
	box(m, cf * CFrame.new(0, 1.8, 0), Vector3.new(8, 3.6, 2.6), DARKWOOD, Enum.Material.WoodPlanks)
	box(m, cf * CFrame.new(0, 3.65, 0), Vector3.new(8.4, 0.2, 3), Color3.fromRGB(230, 225, 215), Enum.Material.Marble)
	-- espresso machine
	box(m, cf * CFrame.new(-2, 4.6, 0.4), Vector3.new(2.4, 1.8, 1.6), STEEL, Enum.Material.Metal)
	for i = 0, 1 do
		cyl(m, cf * CFrame.new(-2.5 + i, 3.95, -0.3), 0.5, 0.25, BLACK, Enum.Material.Metal)
	end
	-- cups
	for i = 0, 3 do
		cyl(m, cf * CFrame.new(1 + i * 0.6, 4, -0.5), 0.5, 0.4, WHITE, Enum.Material.SmoothPlastic)
	end
	-- coffee bean jar
	cyl(m, cf * CFrame.new(3.4, 4.3, 0.3), 1.1, 0.8, Color3.fromRGB(220, 230, 240), Enum.Material.Glass, { Transparency = 0.4 })
	for _ = 1, 8 do
		ball(m, cf * CFrame.new(3.4 + (math.random() - 0.5) * 0.4, 3.9 + math.random() * 0.4, 0.3 + (math.random() - 0.5) * 0.4), 0.18, Color3.fromRGB(70, 40, 20))
	end
	local menu = box(m, cf * CFrame.new(0, 8, 2.5), Vector3.new(6, 2.6, 0.2), BLACK)
	screen(menu, "☕ MENU\nEspresso • Latte • 60 Beans Special", Enum.NormalId.Front, Color3.fromRGB(30, 30, 30), WHITE).Font = Enum.Font.Gotham
	return m
end

function Props.birdFeeder(cf: CFrame)
	local m = newModel("BirdFeeder")
	cyl(m, cf * CFrame.new(0, 2.5, 0), 5, 0.3, DARKWOOD, Enum.Material.Wood)
	box(m, cf * CFrame.new(0, 5.1, 0), Vector3.new(3, 0.2, 3), WOOD, Enum.Material.WoodPlanks)
	for _ = 1, 10 do
		ball(m, cf * CFrame.new((math.random() - 0.5) * 2.6, 5.25, (math.random() - 0.5) * 2.6), 0.15, Color3.fromRGB(220, 190, 110))
	end
	-- pigeons on the ground
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local pcf = cf * CFrame.new(math.cos(a) * 3, 0, math.sin(a) * 3) * CFrame.Angles(0, -a, 0)
		box(m, pcf * CFrame.new(0, 0.5, 0), Vector3.new(0.6, 0.6, 1), Color3.fromRGB(140, 140, 150), Enum.Material.SmoothPlastic)
		ball(m, pcf * CFrame.new(0, 0.95, -0.5), 0.45, Color3.fromRGB(90, 110, 120))
		box(m, pcf * CFrame.new(0, 0.9, -0.8), Vector3.new(0.12, 0.1, 0.25), Color3.fromRGB(230, 170, 60))
	end
	return m
end

function Props.labBench(cf: CFrame)
	local m = custom("LabBench", cf, 8)
	if m then
		return m
	end
	m = newModel("LabBench")
	box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(8, 3.4, 3), WHITE, Enum.Material.SmoothPlastic)
	box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(8.2, 0.2, 3.2), BLACK, Enum.Material.Slate)
	local liquids = { Color3.fromRGB(90, 255, 160), Color3.fromRGB(255, 90, 200), Color3.fromRGB(90, 180, 255), Color3.fromRGB(255, 220, 80) }
	for i, col in ipairs(liquids) do
		cyl(m, cf * CFrame.new(-3 + i * 1.3, 4.3, -0.3), 1.4, 0.7, Color3.fromRGB(220, 235, 245), Enum.Material.Glass, { Transparency = 0.6 })
		cyl(m, cf * CFrame.new(-3 + i * 1.3, 4, -0.3), 0.7, 0.6, col, Enum.Material.Neon, { Transparency = 0.2 })
	end
	-- microscope
	box(m, cf * CFrame.new(3, 3.8, 0.6), Vector3.new(0.9, 0.3, 1.1), BLACK)
	box(m, cf * CFrame.new(3, 4.6, 0.9), Vector3.new(0.25, 1.5, 0.25), BLACK)
	cyl(m, cf * CFrame.new(3, 5, 0.5) * CFrame.Angles(math.rad(25), 0, 0), 1.1, 0.3, STEEL, Enum.Material.Metal)
	return m
end

function Props.hospitalBed(cf: CFrame)
	local m = custom("HospitalBed", cf, 9)
	if m then
		return m
	end
	m = newModel("HospitalBed")
	box(m, cf * CFrame.new(0, 2, 0), Vector3.new(4, 0.8, 8), Color3.fromRGB(235, 240, 255), Enum.Material.Fabric)
	box(m, cf * CFrame.new(0, 2.6, 3.2), Vector3.new(3, 0.6, 1.3), WHITE, Enum.Material.Fabric) -- pillow
	box(m, cf * CFrame.new(0, 2.5, 4.1), Vector3.new(4.2, 2.4, 0.3), STEEL, Enum.Material.Metal)
	for _, x in ipairs({ -1.8, 1.8 }) do
		for _, z in ipairs({ -3.6, 3.6 }) do
			box(m, cf * CFrame.new(x, 0.8, z), Vector3.new(0.2, 1.6, 0.2), STEEL, Enum.Material.Metal)
		end
	end
	box(m, cf * CFrame.new(2.6, 3.5, 3), Vector3.new(0.15, 7, 0.15), STEEL, Enum.Material.Metal) -- IV pole
	box(m, cf * CFrame.new(2.6, 6.3, 3), Vector3.new(0.6, 1, 0.3), Color3.fromRGB(220, 240, 255), Enum.Material.Glass, { Transparency = 0.4 })
	return m
end

function Props.cleaningCart(cf: CFrame)
	local m = newModel("CleaningCart")
	box(m, cf * CFrame.new(0, 2, 0), Vector3.new(3, 2.4, 2), Color3.fromRGB(240, 200, 40), Enum.Material.SmoothPlastic)
	cyl(m, cf * CFrame.new(-0.6, 3.6, 0), 1, 1, Color3.fromRGB(60, 120, 220), Enum.Material.SmoothPlastic) -- bucket
	box(m, cf * CFrame.new(0.9, 4.5, 0), Vector3.new(0.15, 5, 0.15), WOOD, Enum.Material.Wood) -- mop handle
	box(m, cf * CFrame.new(0.9, 2.1, 0), Vector3.new(0.9, 0.3, 0.6), Color3.fromRGB(230, 230, 220), Enum.Material.Fabric)
	for _, x in ipairs({ -1.2, 1.2 }) do
		for _, z in ipairs({ -0.8, 0.8 }) do
			ball(m, cf * CFrame.new(x, 0.35, z), 0.6, BLACK)
		end
	end
	return m
end

function Props.vending(cf: CFrame, label: string, color: Color3)
	local m = custom("VendingMachine", cf, 4)
	if m then
		return m
	end
	m = newModel("VendingMachine")
	box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(4, 7, 3), color, Enum.Material.Metal)
	box(m, cf * CFrame.new(-0.4, 4, -1.52), Vector3.new(2.8, 5, 0.1), Color3.fromRGB(200, 230, 255), Enum.Material.Glass, { Transparency = 0.45 })
	local snack = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 220, 60), Color3.fromRGB(120, 230, 120) }
	for row = 0, 3 do
		for col = 0, 3 do
			box(m, cf * CFrame.new(-1.4 + col * 0.65, 2.2 + row * 1.15, -1.2), Vector3.new(0.5, 0.7, 0.4), snack[((row + col) % 4) + 1])
		end
	end
	local panel = box(m, cf * CFrame.new(1.45, 4.5, -1.52), Vector3.new(0.8, 2.4, 0.1), BLACK)
	screen(panel, "R$", Enum.NormalId.Front, BLACK, Color3.fromRGB(80, 255, 120))
	local top = box(m, cf * CFrame.new(0, 7.4, -0.8), Vector3.new(4.2, 0.9, 0.3), Color3.fromRGB(255, 230, 40), Enum.Material.SmoothPlastic)
	screen(top, label, Enum.NormalId.Front, Color3.fromRGB(255, 230, 40), Color3.fromRGB(200, 0, 80)).Font = Enum.Font.FredokaOne
	return m
end

local CAR_COLORS = { Color3.fromRGB(190, 30, 35), Color3.fromRGB(30, 70, 170), Color3.fromRGB(235, 235, 235), Color3.fromRGB(30, 30, 35), Color3.fromRGB(230, 190, 40), Color3.fromRGB(70, 130, 90) }
function Props.car(cf: CFrame)
	local m = custom("Car", cf, 13)
	if m then
		return m
	end
	m = newModel("Car")
	local color = CAR_COLORS[math.random(1, #CAR_COLORS)]
	box(m, cf * CFrame.new(0, 1.9, 0), Vector3.new(6, 1.8, 13), color, Enum.Material.Metal) -- lower body
	box(m, cf * CFrame.new(0, 3.4, 0.6), Vector3.new(5.6, 1.6, 6.5), color, Enum.Material.Metal) -- cabin
	box(m, cf * CFrame.new(0, 3.4, -2.75), Vector3.new(5.2, 1.4, 0.2), Color3.fromRGB(40, 50, 60), Enum.Material.Glass, { Transparency = 0.2 }) -- windshield
	box(m, cf * CFrame.new(0, 3.4, 3.9), Vector3.new(5.2, 1.3, 0.2), Color3.fromRGB(40, 50, 60), Enum.Material.Glass, { Transparency = 0.2 })
	for _, x in ipairs({ -2.82, 2.82 }) do
		box(m, cf * CFrame.new(x, 3.45, 0.6), Vector3.new(0.1, 1.2, 5.6), Color3.fromRGB(40, 50, 60), Enum.Material.Glass, { Transparency = 0.2 })
	end
	for _, x in ipairs({ -2.2, 2.2 }) do
		box(m, cf * CFrame.new(x, 2.1, -6.52), Vector3.new(1.1, 0.5, 0.1), Color3.fromRGB(255, 250, 220), Enum.Material.Neon) -- headlights
		box(m, cf * CFrame.new(x, 2.1, 6.52), Vector3.new(1.1, 0.4, 0.1), Color3.fromRGB(200, 20, 20), Enum.Material.Neon) -- taillights
	end
	box(m, cf * CFrame.new(0, 1.2, -6.6), Vector3.new(6.2, 0.6, 0.4), Color3.fromRGB(40, 40, 45)) -- bumpers
	box(m, cf * CFrame.new(0, 1.2, 6.6), Vector3.new(6.2, 0.6, 0.4), Color3.fromRGB(40, 40, 45))
	for _, x in ipairs({ -2.9, 2.9 }) do
		for _, z in ipairs({ -4, 4 }) do
			box(m, cf * CFrame.new(x, 1.15, z), Vector3.new(1, 2.3, 2.3), Color3.fromRGB(20, 20, 22), Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder })
			box(m, cf * CFrame.new(x + (x > 0 and 0.45 or -0.45), 1.15, z), Vector3.new(0.15, 1.2, 1.2), STEEL, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
		end
	end
	return m
end

function Props.bench(cf: CFrame)
	local m = custom("Bench", cf, 7)
	if m then
		return m
	end
	m = newModel("Bench")
	for i = 0, 2 do
		box(m, cf * CFrame.new(0, 1.7, -0.6 + i * 0.6), Vector3.new(7, 0.2, 0.5), WOOD, Enum.Material.WoodPlanks)
	end
	for i = 0, 1 do
		box(m, cf * CFrame.new(0, 2.6 + i * 0.6, 1.1), Vector3.new(7, 0.45, 0.15), WOOD, Enum.Material.WoodPlanks)
	end
	for _, x in ipairs({ -3, 3 }) do
		box(m, cf * CFrame.new(x, 0.85, 0), Vector3.new(0.3, 1.7, 1.8), BLACK, Enum.Material.Metal)
		box(m, cf * CFrame.new(x, 2.4, 1.15), Vector3.new(0.3, 1.8, 0.2), BLACK, Enum.Material.Metal)
	end
	return m
end

return Props
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000015"><Properties><string name="Name">Rooms</string><ProtectedString name="Source"><![CDATA[-- Rooms (update 1.5): REAL PLACES.
-- Furnishes the inside of every building that has a use, using web/src/rooms.js as the
-- reference: furniture, people with name tags, chairs you can sit on, and small things
-- to do. Buildings with no use (houses) stay closed (see WorldService.house).
--
-- Coordinates in the layouts are REAL studs from the building's center:
--   x = left/right, z = from the front door (negative) to the back wall (positive).
-- Every builder faces -Z (toward the door) at yaw 0. Yaw PI faces the back wall.
--
-- Conversation spots (feature 2) and exit doors (feature 3) are registered here too, so
-- other services can find them: Rooms.ConvSpots, Rooms.Buildings.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Content = require(ReplicatedStorage.Shared.Content)

local Props = require(script.Parent.Props)
local FriendService = require(script.Parent.FriendService)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)

local Rooms = {}
Rooms.Buildings = {} -- [key] = { cf = CFrame (real, center on the floor), half = Vector3 (real), outside = Vector3 (design spot key) }
Rooms.ConvSpots = {} -- [id] = { id, stand = CFrame, npc = CFrame, conv = string | {Lose=, Gain=}, who = string, prompt = ProximityPrompt }
Rooms.onJobs = nil -- function(player) set by WorldService
Rooms.onConv = nil -- function(player, spotId) set by ConversationService
Rooms.onLeave = nil -- function(player, buildingKey) set by WorldService (exit doors)

local R = Content.Rooms
local C = Config.Rooms
local PI = math.pi

local folder = Instance.new("Folder")
folder.Name = "Rooms"
folder.Parent = workspace

local WOOD = Color3.fromRGB(154, 106, 66)
local DARKWOOD = Color3.fromRGB(106, 69, 40)
local METAL = Color3.fromRGB(170, 176, 184)
local WHITE = Color3.fromRGB(244, 244, 242)
local FABRIC = Color3.fromRGB(192, 72, 63)
local LEAF = Color3.fromRGB(70, 150, 70)

---------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------
local function box(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, extra)
	local p = Instance.new((extra and extra.ClassName) or "Part")
	p.Anchored = true
	p.CFrame = cf
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(extra or {}) do
		if k ~= "ClassName" then
			p[k] = v
		end
	end
	p:SetAttribute("Role", "prop")
	CollectionService:AddTag(p, "Styled")
	p.Parent = parent
	return p
end

local function model(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = folder
	return m
end

-- Billboard name tag / sign (tagged "Sign" so dumb players see it scrambled)
local function tag(adornee: Instance, text: string, offsetY: number, width: number?, height: number?, color: Color3?)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new((width or 200) / 20, 0, (height or 30) / 20, 0)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.Parent = adornee
	local l = Instance.new("TextLabel")
	l.Name = "SignText"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.2
	l.Text = text
	l:SetAttribute("BaseText", text)
	CollectionService:AddTag(l, "Sign")
	l.Parent = gui
	return l
end

-- Painted text on a part's front face (whiteboards, screens)
local function painted(part: BasePart, text: string, bg: Color3, fg: Color3, font: Enum.Font?)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0.2
	sg.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundColor3 = bg
	l.TextColor3 = fg
	l.TextScaled = true
	l.Font = font or Enum.Font.FredokaOne
	l.Text = text
	l.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.15, 0)
	pad.PaddingBottom = UDim.new(0.15, 0)
	pad.Parent = l
	return l
end

local lastUse = {} -- [player] = { [spotName] = os.clock() }
local function cooled(player: Player, name: string): boolean
	local t = lastUse[player]
	if not t then
		t = {}
		lastUse[player] = t
	end
	local now = os.clock()
	if t[name] and now - t[name] < C.SpotCooldown then
		return false
	end
	t[name] = now
	return true
end
game:GetService("Players").PlayerRemoving:Connect(function(p)
	lastUse[p] = nil
end)

-- Invisible part with a proximity prompt
local function spot(cf: CFrame, name: string, actionText: string, objectText: string, onUse, distance: number?)
	local p = box(folder, cf * CFrame.new(0, 3, 0), Vector3.new(2, 2, 2), WHITE, nil, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	p.Name = "Spot_" .. name
	CollectionService:RemoveTag(p, "Styled")
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText
	pp.HoldDuration = 0
	pp.MaxActivationDistance = distance or C.PromptDistance
	pp.RequiresLineOfSight = false
	pp.Parent = p
	pp.Triggered:Connect(function(player)
		if cooled(player, name) then
			onUse(player, pp)
		end
	end)
	return p, pp
end

local function pathOf(player: Player): string?
	local d = DataService.get(player)
	return d and d.path or nil
end

-- Is the player allowed here? Shows the reason if not.
local function guard(player: Player, path: string?): boolean
	local mine = pathOf(player)
	if not mine then
		BrainService.toast(player, R.PickPath)
		return false
	end
	if path and path ~= "Any" and mine ~= path then
		BrainService.toast(player, path == "Gain" and R.SmartOnly or R.DumbOnly)
		return false
	end
	local blocked = BrainService.blocked(player)
	if blocked then
		BrainService.toast(player, "⛔ " .. blocked)
		return false
	end
	return true
end

---------------------------------------------------------------------
-- Furniture kit (real size, facing -Z)
---------------------------------------------------------------------
local K = {}

function K.table(cf: CFrame, w: number?, d: number?, color: Color3?)
	w, d = w or 5, d or 3
	local m = model("Table")
	box(m, cf * CFrame.new(0, 2.6, 0), Vector3.new(w, 0.3, d), color or WOOD, Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			box(m, cf * CFrame.new(sx * (w / 2 - 0.3), 1.3, sz * (d / 2 - 0.3)), Vector3.new(0.3, 2.6, 0.3), DARKWOOD, Enum.Material.Wood)
		end
	end
	return m
end

-- A real Seat. Walking into it doesn't sit you down (CanTouch off); use the prompt.
local function makeSeat(m: Model, cf: CFrame, size: Vector3, color: Color3, objectText: string)
	local seat = box(m, cf, size, color, Enum.Material.Fabric, { ClassName = "Seat", CanTouch = false })
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = R.Sit
	pp.ObjectText = objectText
	pp.HoldDuration = 0
	pp.MaxActivationDistance = C.SeatPromptDistance
	pp.RequiresLineOfSight = false
	pp.Parent = seat
	pp.Triggered:Connect(function(player)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum and not seat.Occupant and hum.Health > 0 then
			seat:Sit(hum)
		end
	end)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		pp.Enabled = seat.Occupant == nil
	end)
	return seat
end

function K.chair(cf: CFrame, color: Color3?)
	local m = model("Chair")
	local c = color or FABRIC
	makeSeat(m, cf * CFrame.new(0, 1.6, 0), Vector3.new(1.8, 0.3, 1.8), c, R.Seat)
	box(m, cf * CFrame.new(0, 2.7, 0.8), Vector3.new(1.8, 2, 0.3), c, Enum.Material.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			box(m, cf * CFrame.new(sx * 0.75, 0.75, sz * 0.75), Vector3.new(0.2, 1.5, 0.2), DARKWOOD, Enum.Material.Wood)
		end
	end
	return m
end

function K.couch(cf: CFrame, color: Color3?)
	local m = model("Couch")
	local c = color or Color3.fromRGB(91, 111, 179)
	makeSeat(m, cf * CFrame.new(0, 1.3, -0.2), Vector3.new(5.4, 0.8, 2.2), c, R.Couch)
	box(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(6, 0.9, 2.6), c, Enum.Material.Fabric)
	box(m, cf * CFrame.new(0, 2.3, 1.1), Vector3.new(6, 2, 0.6), c, Enum.Material.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		box(m, cf * CFrame.new(sx * 3, 1.4, 0), Vector3.new(0.6, 1.8, 2.6), c, Enum.Material.Fabric)
	end
	return m
end

function K.counter(cf: CFrame, w: number, top: Color3?)
	local m = model("Counter")
	box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(w, 3, 2.2), DARKWOOD, Enum.Material.Wood)
	box(m, cf * CFrame.new(0, 3.1, 0), Vector3.new(w + 0.2, 0.25, 2.5), top or WHITE, Enum.Material.Marble)
	return m
end

function K.plant(cf: CFrame)
	local m = model("Plant")
	box(m, cf * CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, PI / 2), Vector3.new(1.4, 1.4, 1.4), Color3.fromRGB(181, 101, 58), Enum.Material.Slate, { Shape = Enum.PartType.Cylinder })
	box(m, cf * CFrame.new(0, 2.3, 0), Vector3.new(2.6, 2.6, 2.6), LEAF, Enum.Material.LeafyGrass, { Shape = Enum.PartType.Ball })
	return m
end

function K.rug(cf: CFrame, w: number, d: number, color: Color3)
	local m = model("Rug")
	box(m, cf * CFrame.new(0, 0.03, 0), Vector3.new(w, 0.06, d), color, Enum.Material.Fabric, { CanCollide = false })
	return m
end

-- Whiteboard on a wall; returns the text label so it can be written on
function K.whiteboard(cf: CFrame, w: number, text: string)
	local m = model("Whiteboard")
	box(m, cf * CFrame.new(0, 5, 0), Vector3.new(w + 0.4, 4.8, 0.3), METAL, Enum.Material.Metal)
	local board = box(m, cf * CFrame.new(0, 5, -0.2), Vector3.new(w, 4.4, 0.1), Color3.fromRGB(253, 253, 251))
	return painted(board, text, Color3.fromRGB(253, 253, 251), Color3.fromRGB(29, 78, 216))
end

function K.fridge(cf: CFrame)
	local m = model("Fridge")
	box(m, cf * CFrame.new(0, 3.5, 0.15), Vector3.new(3, 7, 2.3), WHITE, Enum.Material.SmoothPlastic)
	box(m, cf * CFrame.new(0, 3.5, -0.95), Vector3.new(2.6, 6.4, 0.1), Color3.fromRGB(120, 200, 255), Enum.Material.Neon, { Transparency = 0.5 }) -- the light inside
	local hinge = cf * CFrame.new(-1.5, 0, -1.1) -- left front edge
	local door = box(m, hinge * CFrame.new(1.5, 3.5, -0.1), Vector3.new(3, 6.8, 0.2), Color3.fromRGB(232, 232, 232), Enum.Material.SmoothPlastic)
	local handle = box(m, hinge * CFrame.new(2.7, 4, -0.3), Vector3.new(0.15, 1.6, 0.15), METAL, Enum.Material.Metal)
	return { model = m, hinge = hinge, door = door, handle = handle, open = false }
end

function K.seatRow(cf: CFrame, n: number)
	local m = model("SeatRow")
	for i = 0, n - 1 do
		local c = cf * CFrame.new(-(n - 1) * 1.3 + i * 2.6, 0, 0)
		makeSeat(m, c * CFrame.new(0, 1.4, 0), Vector3.new(2.2, 0.5, 2), FABRIC, R.Seat)
		box(m, c * CFrame.new(0, 0.6, 0), Vector3.new(2.2, 1.2, 2), FABRIC, Enum.Material.Fabric)
		box(m, c * CFrame.new(0, 2.2, 0.9), Vector3.new(2.2, 2.4, 0.4), FABRIC, Enum.Material.Fabric)
	end
	return m
end

function K.stage(cf: CFrame, w: number, d: number, color: Color3)
	local m = model("Stage")
	box(m, cf * CFrame.new(0, 0.4, 0), Vector3.new(w, 0.8, d), color, Enum.Material.WoodPlanks)
	return m
end

function K.podium(cf: CFrame, color: Color3?)
	local m = model("Podium")
	box(m, cf * CFrame.new(0, 2, 0), Vector3.new(3, 4, 2), color or Color3.fromRGB(43, 58, 103), Enum.Material.Wood)
	box(m, cf * CFrame.new(0, 4.1, 0.1) * CFrame.Angles(math.rad(15), 0, 0), Vector3.new(3.2, 0.3, 2.2), DARKWOOD, Enum.Material.Wood)
	return m
end

function K.judgeBench(cf: CFrame)
	local m = model("JudgeBench")
	box(m, cf * CFrame.new(0, 2.5, 0), Vector3.new(10, 5, 3), DARKWOOD, Enum.Material.Wood)
	box(m, cf * CFrame.new(0, 5.1, 0), Vector3.new(10.4, 0.3, 3.4), WOOD, Enum.Material.WoodPlanks)
	box(m, cf * CFrame.new(0, 1, 3), Vector3.new(10, 2, 4), DARKWOOD, Enum.Material.Wood) -- platform behind for the judge
	box(m, cf * CFrame.new(3, 5.5, -0.6), Vector3.new(0.8, 0.4, 0.4), DARKWOOD, Enum.Material.Wood) -- gavel
	return m
end

-- Glass maze with a little mouse (lab experiment)
function K.maze(cf: CFrame)
	local m = model("MouseMaze")
	box(m, cf * CFrame.new(0, 1.2, 0), Vector3.new(5, 2.4, 5), DARKWOOD, Enum.Material.Wood)
	box(m, cf * CFrame.new(0, 3.2, 0), Vector3.new(5, 1.6, 5), Color3.fromRGB(200, 230, 255), Enum.Material.Glass, { Transparency = 0.7 })
	for i = -1, 1 do
		box(m, cf * CFrame.new(i * 1.2, 3, (i % 2 == 0) and 0.8 or -0.8), Vector3.new(0.15, 1.1, 3), WHITE)
	end
	box(m, cf * CFrame.new(1.8, 2.75, 1.6), Vector3.new(0.9, 0.9, 0.9), Color3.fromRGB(201, 201, 207), nil, { Shape = Enum.PartType.Ball })
	box(m, cf * CFrame.new(-1.8, 2.6, -1.8), Vector3.new(0.6, 0.4, 0.6), Color3.fromRGB(255, 210, 60), Enum.Material.SmoothPlastic) -- cheese
	return m
end

-- A person standing at cf (feet on the floor), with a name tag. Built in the background.
local function person(cf: CFrame, name: string, shirt: Color3, raise: number?)
	local holder = {}
	task.spawn(function()
		local m = FriendService.npc(name, Color3.fromRGB(232, 185, 143), shirt, Color3.fromRGB(43, 43, 58))
		local root
		if m then
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
				end
			end
			m:PivotTo(cf * CFrame.new(0, 3.2 + (raise or 0), 0))
			m.Parent = folder
			root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
		else
			m = model("Person")
			root = box(m, cf * CFrame.new(0, 2.5 + (raise or 0), 0), Vector3.new(2, 5, 1.2), shirt)
			m.PrimaryPart = root
		end
		m.Name = name
		if root then
			tag(root, name, 3.6, 150, 24)
		end
		holder.model = m
	end)
	return holder
end

---------------------------------------------------------------------
-- Interactions
---------------------------------------------------------------------
local function action(cf: CFrame, key: string)
	local text = R.Actions[key]
	local cfg = C.Actions[key]
	spot(cf, key, text.action, text.object, function(player)
		if not guard(player, cfg.path) then
			return
		end
		if cfg.lose then
			BrainService.lose(player, cfg.lose, key)
		end
		if cfg.gain then
			BrainService.gain(player, cfg.gain, key)
		end
		BrainService.toast(player, text.toast, "CartoonBoing")
	end)
end

local function writableBoard(cf: CFrame, label: TextLabel)
	spot(cf, "board", R.Board.action, R.Board.object, function(player)
		if not guard(player, "Any") then
			return
		end
		local path = pathOf(player)
		local lines = R.BoardLines[path]
		local line = lines[math.random(1, #lines)]
		label.Text = line
		label.TextColor3 = path == "Lose" and Color3.fromRGB(221, 17, 34) or Color3.fromRGB(29, 78, 216)
		if path == "Lose" then
			BrainService.lose(player, C.BoardPoints.Lose, "board")
		else
			BrainService.gain(player, C.BoardPoints.Gain, "board")
		end
		BrainService.toast(player, string.format(R.Board.toast, line))
	end)
end

local function fridgeSpot(cf: CFrame, fridge)
	local _, pp = spot(cf, "fridge", R.Fridge.open, R.Fridge.object, function(player, prompt)
		fridge.open = not fridge.open
		local angle = fridge.open and math.rad(C.FridgeOpenAngle) or 0
		local h = fridge.hinge * CFrame.Angles(0, angle, 0)
		fridge.door.CFrame = h * CFrame.new(1.5, 3.5, -0.1)
		fridge.handle.CFrame = h * CFrame.new(2.7, 4, -0.3)
		prompt.ActionText = fridge.open and R.Fridge.close or R.Fridge.open
		if fridge.open then
			BrainService.toast(player, R.Fridge.toast, "CartoonBoing")
		end
	end, 8)
	return pp
end

-- A conversation spot: a person at npcCf facing the player, who stands `dist` studs in front.
-- The prompt is switched on by ConversationService (feature 2).
local function convSpot(id: string, npcCf: CFrame, who: string, shirt: Color3, conv, signText: string?, opts)
	opts = opts or {}
	local dist = opts.dist or 6
	local standCf = npcCf * CFrame.new(0, 0, -dist) * CFrame.Angles(0, PI, 0) -- facing the person
	local npc = person(npcCf, who, shirt, opts.raise)
	if opts.table ~= false then
		K.table(npcCf * CFrame.new(0, 0, -dist / 2), 4, 2.2)
	end
	local p, pp = spot(standCf, "conv_" .. id, R.Talk, who, function(player)
		if Rooms.onConv then
			Rooms.onConv(player, id)
		end
	end)
	if signText then
		tag(p, signText, 5.5, 260, 36, Color3.fromRGB(255, 225, 120))
	end
	Rooms.ConvSpots[id] = { id = id, stand = standCf, npc = npcCf * CFrame.new(0, opts.raise or 0, 0), npcHolder = npc, conv = conv, who = who, prompt = pp, labels = opts.labels }
	return Rooms.ConvSpots[id]
end
Rooms.convSpot = convSpot

local function roomSign(cf: CFrame, text: string)
	local p = box(folder, cf * CFrame.new(0, 7.5, 0), Vector3.new(1, 1, 1), WHITE, nil, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	CollectionService:RemoveTag(p, "Styled")
	tag(p, text, 0, 260, 38, Color3.fromRGB(255, 210, 60))
	return p
end

---------------------------------------------------------------------
-- Layouts: only buildings that have a use. Existing stations and workplaces
-- (WorldService) stay where they were; these fill the empty floor around them.
---------------------------------------------------------------------
local P = Content.Rooms.People
local LAYOUT = {}

-- 🛍 Brainrot Mall (Lose): arcade zone, product shelves, plushie display
LAYOUT.lose = function(at)
	for i, title in ipairs(R.ArcadeTitles) do
		Props.arcade(at(-36 + (i - 1) * 5, 29, 0), title)
	end
	roomSign(at(-28.5, 29, 0), R.Signs.arcade)
	action(at(-28.5, 24, 0), "arcade")
	Props.shopCounter(at(33, 0, PI / 2))
	Props.shopCounter(at(33, 12, PI / 2))
	K.counter(at(24, 26, 0), 8, Color3.fromRGB(255, 90, 180))
	Props.bench(at(-34, 2, -PI / 2))
	local plush = box(folder, at(24, 26, 0) * CFrame.new(0, 4.4, 0), Vector3.new(2.4, 2.4, 2.4), Color3.fromRGB(255, 210, 60), nil, { Shape = Enum.PartType.Ball })
	tag(plush, R.Signs.plushie, 2.5, 220, 30)
	action(at(24, 22, 0), "plushie")
	K.plant(at(-38, -30, 0))
	K.plant(at(38, -30, 0))
end

-- 🍿 Microwave Diner (Lose): counter, fridge, chairs at the tables
LAYOUT.diner = function(at)
	K.counter(at(-13, 14.5, 0), 10, Color3.fromRGB(255, 143, 163))
	local fridge = K.fridge(at(17, 14.5, 0))
	fridgeSpot(at(17, 10.5, 0), fridge)
	for _, x in ipairs({ -12.1, 0, 12.1 }) do
		K.chair(at(x - 1.8, -7.6, 0), Color3.fromRGB(230, 60, 80))
		K.chair(at(x + 1.8, -7.6, 0), Color3.fromRGB(230, 60, 80))
	end
	K.rug(at(0, -3.3, 0), 36, 9, Color3.fromRGB(34, 34, 34))
end

-- 🛒 Supermarket: aisles (Lose players shake the cereal; Gain players work the register)
LAYOUT.supermarket = function(at)
	for _, x in ipairs({ -24, -12, 12, 24 }) do
		Props.shopCounter(at(x, -1, 0))
	end
	action(at(-12, -5, 0), "cereal")
	K.plant(at(30, -21, 0))
end

-- 🏫 School: classroom with a whiteboard, students and the teacher
LAYOUT.gain = function(at)
	local board = K.whiteboard(at(16, 32.1, 0), 12, R.BoardStart.school.Gain)
	writableBoard(at(9, 29, 0), board)
	roomSign(at(16, 32, 0) * CFrame.new(0, 1.5, 0), R.Signs.classroom)
	Props.desk(at(16, 25.5, 0), true) -- teacher's desk
	local shirts = { Color3.fromRGB(255, 143, 163), Color3.fromRGB(143, 211, 255), Color3.fromRGB(255, 210, 122), Color3.fromRGB(168, 240, 176), Color3.fromRGB(208, 176, 255), Color3.fromRGB(255, 179, 138) }
	local i = 0
	for _, z in ipairs({ 11.5, 18.5 }) do
		for _, x in ipairs({ 4, 12, 30.5 }) do
			i += 1
			Props.desk(at(x, z, PI), false)
			if x ~= 12 then -- students stand beside the outer desks
				person(at(x == 4 and x - 5.5 or x + 5.4, z - 1, PI), P.student, shirts[i])
			end
		end
	end
	convSpot("classroom", at(16, 30.6, 0), P.teacher, Color3.fromRGB(58, 123, 255), { Lose = "classroomL", Gain = "classroomG" }, nil, { table = false, dist = 8, labels = true })
end

-- 🎓 University: lecture hall around the Skill Gate
LAYOUT.university = function(at)
	K.whiteboard(at(0, 29.4, 0), 14, R.BoardStart.university)
	roomSign(at(0, 29.4, 0) * CFrame.new(0, 1.5, 0), R.Signs.lecture)
	for _, z in ipairs({ 18, 24.5 }) do
		for _, x in ipairs({ -22, -13, 13, 22 }) do
			Props.desk(at(x, z, PI), false)
		end
	end
	K.plant(at(-30, 27, 0))
	K.plant(at(30, 27, 0))
end

-- 🎬 Jack B Cinema: seats facing the screen, the Debate Show stage, snacks
LAYOUT.cinema = function(at)
	for _, z in ipairs({ 5, 8.5, 12 }) do
		K.seatRow(at(0, z, PI), 6)
	end
	K.stage(at(-18, 13, 0), 10, 8, Color3.fromRGB(58, 42, 58))
	convSpot("debate", at(-18, 14, 0), P.host, Color3.fromRGB(210, 76, 76), "debate", R.Signs.debate, { table = false, raise = 0.8, dist = 8 })
	K.counter(at(19, 12, PI / 2), 8, Color3.fromRGB(255, 210, 60))
	roomSign(at(19, 12, 0), R.Signs.snacks)
end

-- ☕ Beethoven's Café: tables, couch, barista
LAYOUT.cafe = function(at)
	for _, x in ipairs({ -8, 8 }) do
		K.table(at(x, -4, 0), 3.4, 3.4)
		K.chair(at(x, -6.6, PI))
		K.chair(at(x, -1.4, 0))
	end
	K.couch(at(-8.5, 10.3, 0), Color3.fromRGB(150, 100, 70))
	person(at(0, 8, 0), P.barista, Color3.fromRGB(107, 66, 38))
	K.plant(at(11, 10, 0))
end

-- 🏥 Hospital: check-ups (Lose), a patient (Gain), and Dr. Calm's therapy corner (everyone)
LAYOUT.hospital = function(at)
	convSpot("doctor", at(-18, -4, 0), P.doctor, Color3.fromRGB(233, 242, 255), { Lose = "doctorL" }, R.Signs.checkup)
	convSpot("patient", at(-14.5, 10, 0), P.patient, Color3.fromRGB(255, 143, 163), { Gain = "doctorG" }, R.Signs.patient, { table = false })
	K.rug(at(22, 12, 0), 14, 12, Color3.fromRGB(127, 178, 160))
	convSpot("therapist", at(22, 17, 0), P.therapist, Color3.fromRGB(160, 200, 184), "therapist", R.Signs.therapy, { table = false })
	K.couch(at(29, 9, PI / 2), Color3.fromRGB(127, 178, 160))
	K.plant(at(30, 24, 0))
	K.plant(at(-30, -24, 0))
end

-- 🏢 Office Tower: desks and the Brainville Times newsroom
LAYOUT.office = function(at)
	for _, x in ipairs({ -11, 11 }) do
		for _, z in ipairs({ -8, 6 }) do
			Props.desk(at(x, z, 0), true)
		end
	end
	convSpot("journalist", at(0, 15, 0), P.editor, Color3.fromRGB(68, 68, 68), { Lose = "journalistL", Gain = "journalistG" }, R.Signs.newsroom)
	K.plant(at(-16, 16, 0))
	K.plant(at(16, 16, 0))
end

-- 💼 Job Center: counselor desk, waiting bench
LAYOUT.jobcenter = function(at)
	Props.desk(at(-8, 7, 0), true)
	person(at(-8, 11.4, 0), P.counselor, Color3.fromRGB(47, 154, 88))
	roomSign(at(-8, 7, 0), R.Signs.counselor)
	spot(at(-8, 3.5, 0), "counselor", R.Counselor.action, R.Counselor.object, function(player)
		if guard(player, "Gain") and Rooms.onJobs then
			Rooms.onJobs(player)
		end
	end)
	Props.desk(at(8, 7, 0), true)
	Props.bench(at(-10, -6, -PI / 2))
	K.plant(at(11, -10, 0))
end

-- ⚖️ Courthouse: judge, tables, gallery, election podium
LAYOUT.courthouse = function(at)
	K.judgeBench(at(0, 19, 0))
	convSpot("court", at(0, 21.5, 0), P.judge, Color3.fromRGB(29, 29, 36), { Lose = "courtL", Gain = "courtG" }, R.Signs.court, { table = false, raise = 2, dist = 9, labels = true })
	for _, x in ipairs({ -12, 12 }) do
		K.table(at(x, 9, 0), 7, 3)
		K.chair(at(x, 6.5, PI))
		Props.bench(at(x, -12, PI))
	end
	K.podium(at(-22, 2, 0))
	convSpot("election", at(-22, 8, 0), P.voter, Color3.fromRGB(85, 119, 170), "election", R.Signs.election, { table = false })
end

-- 🔬 Science Lab: the mouse maze experiment
LAYOUT.lab = function(at)
	K.maze(at(18, -6, 0))
	convSpot("experiment", at(18, -2.5, 0), P.assistant, Color3.fromRGB(230, 251, 255), "experiment", R.Signs.maze, { table = false, dist = 7 })
	K.plant(at(27, -22, 0))
	K.plant(at(-27, -22, 0))
end

-- Furnish one building. rcf = real CFrame at the building's center on the ground, half = real half size.
function Rooms.furnish(key: string, rcf: CFrame, half: Vector3, outsideKey: string?)
	Rooms.Buildings[key] = { cf = rcf, half = half, outside = outsideKey or key }
	local build = LAYOUT[key]
	if not build then
		return
	end
	local function at(x: number, z: number, yaw: number?): CFrame
		return rcf * CFrame.new(x, 0.5, z) * CFrame.Angles(0, yaw or 0, 0)
	end
	local ok, err = pcall(build, at)
	if not ok then
		warn("[Rooms] " .. key .. ": " .. tostring(err))
	end
	-- Exit door: a lit EXIT sign above the doorway (inside) and a Leave prompt by the door
	local exitSign = box(folder, rcf * CFrame.new(0, 14.6, -half.Z + 0.9) * CFrame.Angles(0, PI, 0), Vector3.new(6, 1.6, 0.3), Color3.fromRGB(40, 200, 90), Enum.Material.Neon)
	exitSign.Name = "ExitSign_" .. key
	CollectionService:RemoveTag(exitSign, "Styled")
	painted(exitSign, R.Exit.sign, Color3.fromRGB(30, 170, 70), Color3.new(1, 1, 1), Enum.Font.FredokaOne)
	spot(rcf * CFrame.new(0, 0.5, -half.Z + 3.5), "exit_" .. key, R.Exit.action, R.Exit.object, function(player)
		if Rooms.onLeave then
			Rooms.onLeave(player, key)
		end
	end)
end

-- Gets a player out of any seat (so teleports don't drag the seat along).
-- If they were sitting, waits a moment so the player's own game lets go of the seat
-- before anything moves them.
function Rooms.standUp(hum: Humanoid)
	local seat = hum.SeatPart
	hum.Sit = false
	if seat then
		local weld = seat:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
		task.wait(Config.Rooms.StandUpDelay)
	end
end

-- Which furnished building is this position in? (nil = outside)
function Rooms.buildingAt(pos: Vector3): string?
	for key, b in pairs(Rooms.Buildings) do
		local rel = b.cf:PointToObjectSpace(pos)
		if math.abs(rel.X) <= b.half.X and math.abs(rel.Z) <= b.half.Z and rel.Y > -5 and rel.Y < 40 then
			return key
		end
	end
	return nil
end

return Rooms
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000016"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- ShopService: game passes (honest joke passes on the Lose path, fair ones on the Gain path)
-- and pass perks that staff can gift.

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)

local ShopService = {}

local function passKeyById(id: number): string?
	for key, pass in pairs(Config.GamePasses) do
		if pass.id ~= 0 and pass.id == id then
			return key
		end
	end
	return nil
end

-- Applies a pass's effect. chargeCells = true on a real purchase.
function ShopService.grant(player, key: string, chargeCells: boolean)
	local data = DataService.get(player)
	local pass = Config.GamePasses[key]
	if not data or not pass then
		return false
	end
	data.perks[key] = true
	if key == "BuyBrain" then
		data.perks.DunceCap = true
	end
	if chargeCells and pass.cellsLost > 0 and data.path == "Lose" and not data.dead then
		BrainService.setCells(player, data.cells - pass.cellsLost)
		BrainService.toast(player, "🧠📉 " .. pass.name .. " cost you " .. require(ReplicatedStorage.Shared.Brain).formatNumber(pass.cellsLost) .. " brain cells.", "RecordScratch")
	end
	BrainService.applyCharacter(player)
	BrainService.push(player)
	BrainService.toast(player, "✅ You got: " .. pass.name, "BadgeSparkle")
	return true
end

Net.on("shop_list", function(player)
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	local list = {}
	-- Astronaut Early Access (1.4) is only offered at IQ 160+ while nobody has invented Space Travel
	local Brain = require(ReplicatedStorage.Shared.Brain)
	local astroOffered = data.perks.AstronautEarly == true
		or (not BrainService.spaceInvented() and Brain.iq(data.cells) >= Config.Space.AstronautIQ)
	for key, pass in pairs(Config.GamePasses) do
		if pass.path == data.path and (key ~= "AstronautEarly" or astroOffered) then
			table.insert(list, {
				key = key,
				id = pass.id,
				name = pass.name,
				desc = pass.desc,
				price = pass.price,
				cellsLost = pass.cellsLost,
				owned = data.perks[key] == true,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.price < b.price
	end)
	return {
		ok = true,
		passes = list,
		enabled = BrainService.feature("Purchases"),
		reminder = data.path == "Lose" and "Reminder: passes are optional. You can finish the whole game for free." or "Passes never help with Skill Gates.",
	}
end)

function ShopService.checkOwned(player)
	for key, pass in pairs(Config.GamePasses) do
		if pass.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			local data = DataService.get(player)
			if ok and owns and data and not data.perks[key] then
				ShopService.grant(player, key, false)
			end
		end
	end
end

function ShopService.start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById(passId)
		if key then
			ShopService.grant(player, key, true)
		end
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000017"><Properties><string name="Name">SocialService</string><ProtectedString name="Source"><![CDATA[-- SocialService (update 1.2): Smart vs Dumb.
-- Players join an activity as a role (opt-in). If nobody joins the other role
-- within a few seconds, an NPC plays it. Every activity uses preset choices only.
--   Classroom, Courtroom, Debate Show, Doctor, Therapist, Animal Experiments,
--   Journalist (solo) and the Election (server event).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Brain = require(Shared.Brain)

local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local BrainService = require(script.Parent.BrainService)
local WorldService = require(script.Parent.WorldService)
local LoseService = require(script.Parent.LoseService)

local SocialService = {}

local STEP_SECONDS = 15
local NPC_WAIT = 10

local function pick(list)
	return list[math.random(1, #list)]
end

local function shuffle(t)
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function iqOf(player): number
	local d = DataService.get(player)
	return d and Brain.iq(d.cells) or 0
end

local function stageOf(player): string
	local d = DataService.get(player)
	return d and Brain.stage(d.cells, BrainService.secretAnimals).key or "human"
end

local function pathOf(player): string?
	local d = DataService.get(player)
	return d and not d.dead and d.path or nil
end

local function jobOf(player): string?
	local d = DataService.get(player)
	return d and d.job or nil
end

---------------------------------------------------------------------
-- Content for the activities
---------------------------------------------------------------------
local TRICK_QUESTIONS = {
	{ q = "Pick the WRONG answer: 2 + 2 = ?", options = { "4", "5" }, correct = 2 },
	{ q = "Which is NOT not a fruit?", options = { "Apple", "Chair" }, correct = 1 },
	{ q = "True or false: \"false\" is not true.", options = { "True", "False" }, correct = 1 },
	{ q = "Do NOT pick the answer that isn't 7. What is 3 + 4?", options = { "7", "8" }, correct = 1 },
	{ q = "This time the dumb answer is correct: what color is the sky?", options = { "Blue", "Banana" }, correct = 2 },
	{ q = "Which is the SMALLEST: 0.5, 1/3 or 0.4?", options = { "0.5", "1/3", "0.4" }, correct = 2 },
	{ q = "Pick the answer that is NOT wrong: 10 − 3 = ?", options = { "7", "13" }, correct = 1 },
	{ q = "Reverse question: pick the LONGEST word.", options = { "Cat", "Hippopotamus" }, correct = 2 },
}

local CASES = {
	"left a banana peel in the hallway",
	"microwaved a fork",
	"drove a shopping cart into the fountain",
	"tried to pay for pizza with a leaf",
	"walked into the mayor. Twice.",
}

local STATEMENTS = {
	{ text = "The banana told me to do it.", kind = "dumb", dumb = 3 },
	{ text = "I thought the fork was a spoon.", kind = "dumb", dumb = 2 },
	{ text = "I wasn't even there. I was a rock that day.", kind = "deny", dumb = 2 },
	{ text = "That wasn't me, that was my twin, Me 2.", kind = "deny", dumb = 3 },
	{ text = "Here is my evidence: a sock.", kind = "weird", dumb = 3 },
	{ text = "I have a video of a cat. It proves nothing.", kind = "weird", dumb = 2 },
}

local MOVES = {
	{ text = "🗣 OBJECTION!", best = "deny" },
	{ text = "🧠 \"Your Honor, my client has the brain of a fruit fly. Literally.\"", best = "dumb" },
	{ text = "📁 \"Let's look at that evidence very closely…\"", best = "weird" },
}

local DEBATE_TOPICS = {
	"Should homework be optional?",
	"Is a hot dog a sandwich?",
	"Should we build the teleporter?",
	"Are pigeons secretly geniuses?",
}

local ARGUMENTS = {
	{ text = "Here's the evidence, and here's why it matters.", strength = 3 },
	{ text = "Let's compare both sides fairly.", strength = 2 },
	{ text = "Because I said so.", strength = 1 },
	{ text = "My cousin told me.", strength = 1 },
	{ text = "Studies show both pros and cons; on balance, yes.", strength = 3 },
	{ text = "What if… we just didn't?", strength = 1 },
}

local SYMPTOMS = {
	{ text = "🧠💧 Brain cells are leaking out of the ears.", treat = "🧩 Brain-builder puzzle pill" },
	{ text = "😵 Keeps walking into walls on purpose.", treat = "📚 Two chapters of a book, twice a day" },
	{ text = "📱 Can't stop scrolling.", treat = "📵 Phone-free afternoon" },
}

local FEELINGS = {
	{ text = "😰 Stressed about the Skill Gate", answer = "🌬 Slow breathing: in 4, out 6" },
	{ text = "🥱 Exhausted from work", answer = "😴 A short nap, like Edison" },
	{ text = "🤯 Overwhelmed by too many facts", answer = "📝 Write things down, one at a time" },
}

local EXPERIMENTS = {
	dog = { title = "🐶 Pavlov's Bell", scientist = { "🔔 Ring the bell", "🍖 Show food", "🔔🍖 Bell, then food" }, animal = { smart = "🤤 Drool at the bell", dumb = "🐕 Chase your tail", other = "🐾 Sit" } },
	octopus = { title = "🐙 The Escape Tank", scientist = { "🔓 Leave the lid open", "🔒 Lock the lid", "🍤 Put a shrimp outside" }, animal = { smart = "🚪 Escape", dumb = "🫧 Stay stuck forever", other = "🎨 Change color" } },
	mouse = { title = "🐭 The Maze", scientist = { "🧀 Cheese on the left", "🧀 Cheese on the right", "🧀 Cheese straight ahead" }, animal = { smart = "👃 Follow the smell", dumb = "🌀 Run in circles", other = "😴 Nap" } },
	bee = { title = "🐝 The Waggle Dance", scientist = { "🌸 Point at the flowers", "📝 Take notes", "🎥 Film the dance" }, animal = { smart = "💃 Dance the real directions", dumb = "🌀 Dance total nonsense", other = "🍯 Make honey" } },
	fly = { title = "🪰 The Genetics Lab", scientist = { "🔬 Use the microscope", "🧬 Check the DNA", "🍌 Offer a banana" }, animal = { smart = "🍌 Go to the banana", dumb = "💡 Fly into the lamp", other = "🪟 Bump the window" } },
	worm = { title = "🪱 Darwin's Worm Concert", scientist = { "🎺 Play the bassoon", "🎹 Play the piano", "📣 Shout" }, animal = { smart = "🕺 Wiggle to the beat", dumb = "😐 Ignore the music", other = "🌱 Dig" } },
	microbe = { title = "🦠 The Microscope", scientist = { "🔬 Zoom in", "💧 Add a drop", "🧫 New petri dish" }, animal = { smart = "➡️ Swim to the food", dumb = "🌀 Spin aimlessly", other = "🫧 Split in two" } },
	tardigrade = { title = "🐛 Extreme Survival Test", scientist = { "🧊 Freeze it", "🔥 Heat it", "🚀 Space vacuum" }, animal = { smart = "🛡 Survive cleverly", dumb = "😴 Just sleep through it", other = "🐾 Walk away" } },
}

---------------------------------------------------------------------
-- Activity definitions: role a = smart side, role b = dumb side
---------------------------------------------------------------------
local ACT = {}

ACT.classroom = {
	name = "🏫 Classroom",
	desc = "The teacher asks trick questions. The student must FAIL.",
	a = { label = "Teacher", path = "Gain", minIQ = 105, jobs = { "teacher", "professor" } },
	b = { label = "Student", path = "Lose", humanOnly = true },
	rounds = 3,
	round = function(sess)
		return {
			{
				role = "a",
				prompt = function()
					sess.cands = { TRICK_QUESTIONS[math.random(1, #TRICK_QUESTIONS)], TRICK_QUESTIONS[math.random(1, #TRICK_QUESTIONS)], TRICK_QUESTIONS[math.random(1, #TRICK_QUESTIONS)] }
					return "Pick a trick question. Make it HARD for them to fail."
				end,
				options = function()
					return { sess.cands[1].q, sess.cands[2].q, sess.cands[3].q }
				end,
				onPick = function(i)
					sess.q = sess.cands[i]
				end,
			},
			{
				role = "b",
				prompt = function()
					return "❓ " .. sess.q.q .. "\n(You want to get it WRONG.)"
				end,
				options = function()
					return sess.q.options
				end,
				onPick = function(i)
					if i == sess.q.correct then
						sess:gain("b", 1)
						sess:gain("a", 1.5)
						sess:line("😭 The student accidentally got it RIGHT. Teacher wins this round.")
					else
						sess:lose("b", 2)
						sess:line("✅ The student failed perfectly. 🧠📉")
					end
				end,
			},
		}
	end,
}

ACT.courtroom = {
	name = "⚖️ Courtroom",
	desc = "A dumb player gets sued. The lawyer defends them. The defendant says dumb things.",
	a = { label = "Lawyer", path = "Gain", minIQ = 120, jobs = { "lawyer" } },
	b = { label = "Defendant", path = "Lose" },
	rounds = 3,
	setup = function(sess)
		sess.case = pick(CASES)
		sess.wins = 0
		sess:line("👨‍⚖️ Case: the defendant " .. sess.case .. ".")
	end,
	round = function(sess)
		return {
			{
				role = "b",
				prompt = function()
					sess.st = shuffle({ STATEMENTS[1], STATEMENTS[3], STATEMENTS[5], pick(STATEMENTS) })
					return "🧑‍⚖️ The judge asks what happened. Say something DUMB."
				end,
				options = function()
					return { sess.st[1].text, sess.st[2].text, sess.st[3].text }
				end,
				onPick = function(i)
					sess.said = sess.st[i]
					sess:lose("b", 1 + sess.said.dumb / 2)
					sess:line("🗣 Defendant: \"" .. sess.said.text .. "\"")
				end,
			},
			{
				role = "a",
				prompt = function()
					return "Your client just said: \"" .. sess.said.text .. "\"\nPick the best defense move."
				end,
				options = function()
					return { MOVES[1].text, MOVES[2].text, MOVES[3].text }
				end,
				onPick = function(i)
					if MOVES[i].best == sess.said.kind then
						sess.wins += 1
						sess:line("⚖️ Lawyer: " .. MOVES[i].text .. "  (the jury nods)")
					else
						sess:line("⚖️ Lawyer: " .. MOVES[i].text .. "  (the jury is confused)")
					end
				end,
			},
		}
	end,
	finish = function(sess)
		if sess.wins >= 2 then
			sess:gain("a", 4)
			sess:line("🔨 NOT GUILTY! The lawyer wins big.")
		else
			sess:line("🔨 GUILTY! Community service: picking up banana peels.")
			local p = sess.players.b
			if p then
				p:SetAttribute("PunishSign", "I " .. string.upper(sess.case))
				BrainService.applyCharacter(p)
				task.delay(60, function()
					if p.Parent then
						p:SetAttribute("PunishSign", nil)
						BrainService.applyCharacter(p)
					end
				end)
			end
		end
	end,
}

ACT.debate = {
	name = "🎙 Debate Show",
	desc = "Live TV! The smart one wants to win the argument. The dumb one wins by losing it badly.",
	a = { label = "Smart Debater", path = "Gain", minIQ = 95 },
	b = { label = "Dumb Debater", path = "Lose" },
	rounds = 3,
	setup = function(sess)
		sess.topic = pick(DEBATE_TOPICS)
		sess.aScore, sess.bScore = 0, 0
		sess:line("📺 Tonight's topic: " .. sess.topic)
	end,
	round = function(sess)
		local function opts()
			local o = shuffle({ ARGUMENTS[1], ARGUMENTS[3], ARGUMENTS[math.random(1, #ARGUMENTS)] })
			return o
		end
		return {
			{
				role = "a",
				prompt = function()
					sess.ao = opts()
					return "Make your strongest argument."
				end,
				options = function()
					return { sess.ao[1].text, sess.ao[2].text, sess.ao[3].text }
				end,
				onPick = function(i)
					local s = sess.ao[i].strength
					sess.aScore += s
					sess:gain("a", s * 0.6)
					sess:line("🤓 \"" .. sess.ao[i].text .. "\"")
				end,
			},
			{
				role = "b",
				prompt = function()
					sess.bo = opts()
					return "Make your WORST argument."
				end,
				options = function()
					return { sess.bo[1].text, sess.bo[2].text, sess.bo[3].text }
				end,
				onPick = function(i)
					local weak = 4 - sess.bo[i].strength
					sess.bScore += weak
					sess:lose("b", weak * 0.8)
					sess:line("🤪 \"" .. sess.bo[i].text .. "\"")
				end,
			},
		}
	end,
	finish = function(sess)
		local total = math.max(1, sess.aScore + (9 - sess.bScore))
		local pct = math.floor(sess.aScore / total * 100 + 0.5)
		sess:line("🗳 Audience vote: Smart " .. pct .. "% • Dumb " .. (100 - pct) .. "%. Everyone got what they wanted.")
	end,
}

ACT.doctor = {
	name = "🏥 Doctor",
	desc = "The doctor treats a leaking brain. The patient must avoid the medicine.",
	a = { label = "Doctor", path = "Gain", minIQ = 115, jobs = { "doctor" } },
	b = { label = "Patient", path = "Lose" },
	rounds = 2,
	round = function(sess)
		return {
			{
				role = "a",
				prompt = function()
					sess.sym = pick(SYMPTOMS)
					local opts = { sess.sym.treat }
					for _, s in ipairs(SYMPTOMS) do
						if s ~= sess.sym then
							table.insert(opts, s.treat)
						end
					end
					sess.treats = shuffle(opts)
					return "Patient symptoms: " .. sess.sym.text .. "\nPrescribe the right treatment."
				end,
				options = function()
					return sess.treats
				end,
				onPick = function(i)
					sess.correct = sess.treats[i] == sess.sym.treat
					sess:line("🩺 Doctor prescribes: " .. sess.treats[i])
				end,
			},
			{
				role = "b",
				prompt = function()
					return "The doctor hands you medicine. What do you do?"
				end,
				options = function()
					return { "💊 Take it", "🫣 Hide it in your sock", "🤮 Spit it out" }
				end,
				onPick = function(i)
					if i == 1 and sess.correct then
						sess:gain("b", 1)
						sess:gain("a", 2)
						sess:line("✅ The patient took the right medicine. Brain cells restored (oops).")
					elseif i == 1 then
						sess:line("🤷 The patient took the wrong medicine. Nothing happened.")
					else
						sess:lose("b", 1.5)
						if sess.correct then
							sess:gain("a", 0.5)
						end
						sess:line("🫣 The patient refused the medicine. Classic.")
					end
				end,
			},
		}
	end,
}

