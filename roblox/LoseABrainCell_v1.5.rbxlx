		text = "**Get a job, go to work.** Jobs unlock with IQ: **Cashier**, **Teacher**, **Doctor**, **Scientist**… You don't click a button: you go to the **real building** (🚕 taxi) and do the **real task**.",
		art = { "💼", "🚕", "🏥", "✅" },
		color = Color3.fromRGB(70, 180, 100),
	},
	workIdeas = {
